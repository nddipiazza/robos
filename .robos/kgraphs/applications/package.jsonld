    {
      "@id": "urn:robos:frontend-app:getemgigs",
      "@type": [
        "oslc_am:Resource",
        "robos:FrontEndApp",
        "schema:WebApplication"
      ],
      "dcterms:description": "Buddy Gigs for local bands: trade attendance, lock a deposit, get scanned in at the door (Venmo-style QR); Venue Stay-To-Play instead of pay-to-play.",
      "dcterms:title": "Get 'Em Gigs (The Gig Bandit)",
      "robos:abuseControls": [
        "rate-limits",
        "honeypot",
        "form-timing",
        "disposable-email-block",
        "password-policy",
        "same-origin-csrf",
        "csp",
        "audit-log",
        "rotating-hmac-checkin-codes"
      ],
      "robos:appTemplate": "robos:template:nextjs-vercel-web@1 (reference implementation)",
      "robos:authStrategy": "Email + password, server-side sessions (bcrypt, SHA-256 hashed tokens)",
      "robos:captchaProvider": "reCAPTCHA v3 (wired, disabled)",
      "robos:crawlerPolicy": "Search engines, AI search/agents and link-preview bots allowed on public pages; /api, /dashboard, /account, /deals, /scan, /gigs/new disallowed",
      "robos:databaseEngine": "Neon serverless Postgres (PGlite locally)",
      "robos:domainStandard": "https://schema.org/WebApplication",
      "robos:e2eEvidence": "https://rowbose.com/assets/videos/getemgigs/getemgigs-e2e-evidence-reel.mp4",
      "robos:frontendFramework": "Next.js",
      "robos:hostingPlatform": "Vercel",
      "robos:llmsTxtUrl": "https://www.getemgigs.com/llms.txt",
      "robos:namespace": "robos.applications",
      "robos:package": "applications",
      "robos:productionUrl": "https://www.getemgigs.com",
      "robos:repository": "github.com/nddipiazza/thegigbandit",
      "robos:schemaOrgType": "https://schema.org/WebApplication",
      "robos:sitemapUrl": "https://www.getemgigs.com/sitemap.xml",
      "robos:structuredData": [
