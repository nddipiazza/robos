{
  "@context": {
    "oslc": "http://open-services.net/ns/core#",
    "oslc_am": "http://open-services.net/ns/am#",
    "oslc_cm": "http://open-services.net/ns/cm#",
    "oslc_rm": "http://open-services.net/ns/rm#",
    "oslc_qm": "http://open-services.net/ns/qm#",
    "robos": "https://robos.dev/ns/sdlc#",
    "c4": "https://c4model.com/ns#",
    "dcterms": "http://purl.org/dc/terms/",
    "schema": "https://schema.org/",
    "pact": "https://pact.io/ns#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "robos:sourceSummary": {
      "@id": "robos:sourceSummary",
      "@type": "@json"
    },
    "robos:provenance": {
      "@id": "robos:provenance",
      "@type": "@json"
    },
    "robos:relationshipEvidence": {
      "@id": "robos:relationshipEvidence",
      "@container": "@set",
      "@context": {
        "predicate": {
          "@id": "robos:predicate",
          "@type": "@vocab"
        },
        "target": {
          "@id": "robos:target",
          "@type": "@id"
        },
        "evidence": {
          "@id": "robos:evidence",
          "@container": "@set",
          "@context": {
            "repository": "robos:sourceRepository",
            "path": "robos:sourcePath",
            "line": {
              "@id": "robos:sourceLine",
              "@type": "xsd:integer"
            },
            "revision": "robos:sourceRevision",
            "sha256": "robos:sourceHash",
            "workingTreeStatus": "robos:workingTreeStatus"
          }
        },
        "note": "dcterms:description",
        "condition": "robos:condition",
        "status": "robos:evidenceStatus"
      }
    },
    "robos:evidence": {
      "@id": "robos:evidence",
      "@container": "@set",
      "@context": {
        "repository": "robos:sourceRepository",
        "path": "robos:sourcePath",
        "line": {
          "@id": "robos:sourceLine",
          "@type": "xsd:integer"
        },
        "revision": "robos:sourceRevision",
        "sha256": "robos:sourceHash",
        "workingTreeStatus": "robos:workingTreeStatus"
      }
    },
    "robos:technologyReference": {
      "@id": "robos:technologyReference",
      "@type": "@id"
    },
    "robos:protocolReference": {
      "@id": "robos:protocolReference",
      "@type": "@id"
    }
  },
  "@id": "urn:robos:package:learning",
  "@type": [
    "oslc:ServiceProvider",
    "robos:Package"
  ],
  "robos:package": "learning",
  "robos:namespace": "robos.learning",
  "robos:version": "1.0.0",
  "dcterms:title": "Interactive eLearning Curriculums & Knowledge Modules",
  "dcterms:description": "Interactive developer courses, tutorials, and architectural training modules.",
  "robos:nodes": [
    {
      "@id": "urn:robos:elearning:course:sdlc-fundamentals",
      "@type": [
        "oslc_am:Resource",
        "robos:ELearningCourse",
        "robos:ELearning",
        "schema:Course"
      ],
      "dcterms:title": "RobOS Dual-State SDLC Fundamentals",
      "dcterms:description": "Mastering the knowledge graph, branch diffing, and automated E2E verification in RobOS.",
      "robos:topic": "SDLC Fundamentals",
      "robos:level": "Intermediate",
      "robos:modulesCount": 4,
      "robos:gitopsFile": ".robos/elearning.yaml",
      "robos:modules": [
        {
          "title": "Module 1: Dual-State Architecture",
          "labFile": "labs/01-dual-state.md"
        }
      ],
      "robos:package": "learning",
      "robos:namespace": "robos.learning",
      "robos:schemaOrgType": "https://schema.org/Course",
      "robos:domainStandard": "https://schema.org/Course"
    },
    {
      "@id": "urn:robos:source:import-skill",
      "@type": [
        "robos:AgentSkill",
        "schema:HowTo"
      ],
      "dcterms:title": "Evidence-backed graph import skill",
      "robos:package": "learning",
      "robos:sourcePath": "plugins/robos/skills/import-company-kgraph/SKILL.md",
      "robos:sourceKind": "implementation",
      "robos:inRepository": {
        "@id": "urn:robos:source:workspace"
      },
      "robos:evidence": [
        {
          "repository": "robos",
          "path": "plugins/robos/skills/import-company-kgraph/SKILL.md",
          "line": 1
        }
      ],
      "robos:skillName": "import-company-kgraph",
      "robos:uses": {
        "@id": "urn:robos:source:source-extractor"
      }
    }
  ],
  "@graph": [
    {
      "@id": "urn:robos:elearning:course:sdlc-fundamentals",
      "@type": [
        "oslc_am:Resource",
        "robos:ELearningCourse",
        "robos:ELearning",
        "schema:Course"
      ],
      "dcterms:title": "RobOS Dual-State SDLC Fundamentals",
      "dcterms:description": "Mastering the knowledge graph, branch diffing, and automated E2E verification in RobOS.",
      "robos:topic": "SDLC Fundamentals",
      "robos:level": "Intermediate",
      "robos:modulesCount": 4,
      "robos:gitopsFile": ".robos/elearning.yaml",
      "robos:modules": [
        {
          "title": "Module 1: Dual-State Architecture",
          "labFile": "labs/01-dual-state.md"
        }
      ],
      "robos:package": "learning",
      "robos:namespace": "robos.learning",
      "robos:schemaOrgType": "https://schema.org/Course",
      "robos:domainStandard": "https://schema.org/Course"
    }
  ]
}
