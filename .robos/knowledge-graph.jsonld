      "@id": "urn:robos:service:billing-api",
      "@type": [
        "oslc_am:Resource",
        "robos:Microservice",
        "schema:SoftwareApplication"
      ],
      "dcterms:title": "Billing API Service",
      "robos:technology": "Go 1.22 / Gin",
      "robos:repository": "github.com/acme/billing-api",
      "robos:package": "services",
      "robos:namespace": "robos.services",
      "robos:ownerTeam": "urn:robos:team:order-processing",
      "robos:usesDatabase": "urn:robos:db:acme-orders-postgres",
      "robos:publishesTo": "urn:robos:broker:acme-event-kafka",
      "robos:hasPipeline": "urn:robos:pipeline:checkout-service-ci",
      "robos:deployedTo": "urn:robos:gitops:checkout-service-argocd",
      "robos:implementsContract": [
        "urn:robos:contract:orders-grpc"
      ],
      "robos:schemaOrgType": "https://schema.org/SoftwareApplication",
      "robos:domainStandard": "https://w3id.org/c4/Container",
      "robos:ports": [
        8080
      ],
      "robos:healthCheckUrl": "/healthz",
      "robos:endpoints": [
        {
          "path": "/api/v1/billing/invoices",
          "method": "GET",
          "description": "List customer billing invoices with payment status filtering",
          "parameters": [
            {
              "name": "status",
              "in": "query",
              "type": "string",
              "description": "Filter by invoice status (PAID, PENDING, OVERDUE)"
            },
            {
              "name": "limit",
              "in": "query",
              "type": "integer",
              "default": 20,
              "description": "Maximum number of records to return"
            }
          ],
          "responses": {
            "200": {
              "description": "Successful invoice query result"
            }
          }
        },
        {
          "path": "/api/v1/billing/invoices",
          "method": "POST",
          "description": "Create new billing invoice",
          "requestBody": {
            "customerId": "cust_98234",
            "amount": 149.5,
            "currency": "USD",
            "description": "Enterprise Subscription - Sep 2026"
          },
          "responses": {
            "201": {
              "description": "Invoice issued successfully"
            }
          }
        },
        {
          "path": "/api/v1/billing/invoices/{id}",
          "method": "GET",
          "description": "Get invoice details by identifier",
          "parameters": [
            {
              "name": "id",
              "in": "path",
              "required": true,
              "type": "string",
              "description": "Unique invoice identifier"
            }
          ],
          "responses": {
            "200": {
              "description": "Invoice found"
            },
            "404": {
              "description": "Invoice not found"
            }
          }
        },
        {
          "path": "/healthz",
          "method": "GET",
          "description": "Liveness and readiness probe",
          "responses": {
            "200": {
              "description": "Service healthy"
            }
          }
        }
      ]
    },
    {
      "@id": "urn:robos:contract:orders-grpc",
      "@type": [
        "robos:Contract",
        "robos:ProtobufContract",
        "robos:GRPCContract",
        "schema:DigitalDocument"
      ],
      "dcterms:title": "Acme Orders gRPC Protobuf Contract",
      "dcterms:description": "High-performance binary gRPC interface definition for transactional order lifecycle.",
      "robos:protocol": "grpc-protobuf",
      "robos:specFile": "proto/orders/v1/orders.proto",
      "robos:packageName": "acme.orders.v1",
      "robos:rpcMethods": [
        "CreateOrder",
        "GetOrderStatus",
        "CancelOrder",
        "StreamOrderEvents"
      ],
      "robos:package": "services",
      "robos:namespace": "robos.services",
      "robos:schemaOrgType": "https://schema.org/DigitalDocument",
      "robos:domainStandard": "http://open-services.net/ns/am#Resource",
      "robos:rpcDetails": {
        "CreateOrder": {
          "description": "Submit cart for payment processing and fulfillment",
          "request": {
            "customerId": "cust_88190",
            "items": [
              {
                "sku": "SKU-PRO-42",
                "quantity": 1,
                "unitPrice": 89
              }
            ],
            "shippingAddress": "123 Market St, San Francisco CA"
          },
          "response": {
            "orderId": "ord_99014",
            "status": "ORDER_PLACED",
            "total": 89
          }
        },
        "GetOrderStatus": {
          "description": "Query order status and tracking number",
          "request": {
            "orderId": "ord_99014"
          },
          "response": {
            "orderId": "ord_99014",
            "status": "PROCESSING",
            "estimatedDelivery": "2026-09-15"
          }
        },
        "CancelOrder": {
          "description": "Abort pending order prior to carrier dispatch",
          "request": {
            "orderId": "ord_99014",
            "reason": "Customer requested cancellation"
          },
          "response": {
            "orderId": "ord_99014",
            "status": "CANCELLED"
          }
        },
        "StreamOrderEvents": {
          "description": "Server-side stream of live fulfillment and tracking telemetry",
          "request": {
            "orderId": "ord_99014"
          },
          "response": {
            "eventId": "evt_7701",
            "state": "CARRIER_PICKED_UP",
            "carrier": "FedEx Express"
          }
        }
      }
    },
    {
      "@id": "urn:robos:contract:catalog-graphql",
      "@type": [
        "robos:Contract",
        "robos:GraphQLContract",
        "robos:GraphQLSchema",
        "schema:DigitalDocument"
      ],
      "dcterms:title": "Acme Catalog GraphQL SDL Schema",
      "dcterms:description": "Apollo Federation subgraph schema defining products, pricing, and category queries.",
      "robos:protocol": "graphql",
      "robos:specFile": "schemas/catalog.graphql",
      "robos:schemaType": "federated-subgraph",
      "robos:package": "services",
      "robos:namespace": "robos.services",
      "robos:schemaOrgType": "https://schema.org/DigitalDocument",
      "robos:domainStandard": "http://open-services.net/ns/am#Resource",
      "robos:sdlSchema": "type Query {\n  product(id: ID!): Product\n  products(category: String, limit: Int = 20): [Product!]!\n  searchCatalog(term: String!): [Product!]!\n}\n\ntype Mutation {\n  createProduct(input: ProductInput!): Product!\n  updatePrice(id: ID!, newPrice: Float!): Product!\n}\n\ntype Product {\n  id: ID!\n  name: String!\n  sku: String!\n  category: String!\n  price: Float!\n  inStock: Boolean!\n}\n\ninput ProductInput {\n  name: String!\n  sku: String!\n  category: String!\n  price: Float!\n}",
      "robos:graphqlOperations": [
        {
          "name": "ListCatalogProducts",
          "type": "query",
          "query": "query ListCatalogProducts {\n  products(limit: 5) {\n    id\n    name\n    price\n    inStock\n  }\n}"
        },
        {
          "name": "GetProductById",
          "type": "query",
          "query": "query GetProductById($id: ID!) {\n  product(id: $id) {\n    id\n    name\n    sku\n    price\n    inStock\n  }\n}",
          "variables": {
            "id": "prod_101"
          }
        }
      ]
    },
    {
      "@id": "urn:robos:contract:payment-gateway-v1",
      "@type": [
        "robos:Contract",
        "c4:Component",
        "oslc:Resource"
      ],
      "dcterms:title": "Payment Gateway OpenAPI 3.1 Spec",
      "robos:specFile": "specs/contracts/payment-gateway-v1.yaml",
      "robos:protocol": "OpenAPI 3.1",
      "robos:contractYaml": "openapi: 3.1.0\ninfo:\n  title: Payment Gateway REST API\n  description: High-performance microservice contract for Payment Gateway in RobOS Universe.\n  version: 1.0.0\nservers:\n  - url: https://github.com/api/v1/payment-gateway\n    description: Production Gateway\n  - url: http://localhost:8080\n    description: Local Dev Container\ntags:\n  - name: Core\n    description: Primary operations\n  - name: Health\n    description: Service diagnostics and liveliness\npaths:\n  /api/v1/payment-gateway:\n    get:\n      tags: [Core]\n      summary: Retrieve all payment-gateway items\n      operationId: listPayment-gatewayItems\n      parameters:\n        - name: limit\n          in: query\n          required: false\n          schema:\n            type: integer\n            default: 50\n      responses:\n        '200':\n          description: Successful query result\n          content:\n            application/json:\n              schema:\n                type: array\n                items:\n                  $ref: '#/components/schemas/Payment-gatewayItem'\n    post:\n      tags: [Core]\n      summary: Create new payment-gateway entry\n      operationId: createPayment-gatewayItem\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/Payment-gatewayItem'\n      responses:\n        '201':\n          description: Resource created successfully\n  /api/v1/payment-gateway/{id}:\n    get:\n      tags: [Core]\n      summary: Get payment-gateway by identifier\n      operationId: getPayment-gatewayById\n      parameters:\n        - name: id\n          in: path\n          required: true\n          schema:\n            type: string\n      responses:\n        '200':\n          description: Resource found\n        '404':\n          description: Item not found\n  /healthz:\n    get:\n      tags: [Health]\n      summary: Liveness and readiness probe\n      responses:\n        '200':\n          description: Service is healthy and operational\ncomponents:\n  schemas:\n    Payment-gatewayItem:\n      type: object\n      required:\n        - id\n        - name\n        - createdAt\n      properties:\n        id:\n          type: string\n          format: uuid\n        name:\n          type: string\n          example: 'Primary payment-gateway record'\n        status:\n          type: string\n          enum: [ACTIVE, PENDING, ARCHIVED]\n          default: ACTIVE\n        createdAt:\n          type: string\n          format: date-time\n",
      "robos:repository": "github.com/acme-payments/payment-gateway",
      "robos:endpoints": [
        {
          "path": "/api/v1/payment-gateway",
          "method": "GET",
          "description": "List Payment Gateway records"
        },
        {
          "path": "/api/v1/payment-gateway",
          "method": "POST",
          "description": "Create Payment Gateway record"
        },
        {
          "path": "/api/v1/payment-gateway/{id}",
          "method": "GET",
          "description": "Get Payment Gateway by ID"
        },
        {
          "path": "/healthz",
          "method": "GET",
          "description": "Health check"
        }
      ],
      "robos:inOrganization": "urn:robos:git-org:acme-payments",
      "robos:package": "services",
      "robos:namespace": "robos.services",
      "robos:schemaOrgType": "https://schema.org/DigitalDocument",
      "robos:domainStandard": "http://open-services.net/ns/am#Resource"
    },
    {
      "@id": "urn:robos:service:payment-gateway",
      "@type": [
        "oslc_am:Resource",
        "c4:Container",
        "robos:Microservice"
      ],
      "dcterms:title": "Payment Gateway Service",
      "dcterms:description": "Backend microservice powering Payment Gateway capabilities with containerized deployment.",
      "robos:repository": "github.com/acme-payments/payment-gateway",
      "robos:technology": "Node.js 20 / TypeScript",
      "robos:implementsContract": "urn:robos:contract:payment-gateway-v1",
      "robos:ownerTeam": "urn:robos:team:core-platform",
      "robos:hasProject": "urn:robos:project:enterprise-core",
      "robos:ports": [
        8080
      ],
      "robos:healthCheckUrl": "/healthz",
      "robos:inOrganization": "urn:robos:git-org:acme-payments",
      "robos:package": "services",
      "robos:namespace": "robos.services",
      "robos:schemaOrgType": "https://schema.org/SoftwareApplication",
      "robos:domainStandard": "https://w3id.org/c4/Container"
    },
    {
      "@id": "urn:robos:contract:fraud-detector-v1",
      "@type": [
        "robos:Contract",
        "c4:Component",
        "oslc:Resource"
      ],
      "dcterms:title": "Fraud Detector OpenAPI 3.1 Spec",
      "robos:specFile": "specs/contracts/fraud-detector-v1.yaml",
      "robos:protocol": "OpenAPI 3.1",
      "robos:contractYaml": "openapi: 3.1.0\ninfo:\n  title: Fraud Detector REST API\n  description: High-performance microservice contract for Fraud Detector in RobOS Universe.\n  version: 1.0.0\nservers:\n  - url: https://github.com/api/v1/fraud-detector\n    description: Production Gateway\n  - url: http://localhost:8080\n    description: Local Dev Container\ntags:\n  - name: Core\n    description: Primary operations\n  - name: Health\n    description: Service diagnostics and liveliness\npaths:\n  /api/v1/fraud-detector:\n    get:\n      tags: [Core]\n      summary: Retrieve all fraud-detector items\n      operationId: listFraud-detectorItems\n      parameters:\n        - name: limit\n          in: query\n          required: false\n          schema:\n            type: integer\n            default: 50\n      responses:\n        '200':\n          description: Successful query result\n          content:\n            application/json:\n              schema:\n                type: array\n                items:\n                  $ref: '#/components/schemas/Fraud-detectorItem'\n    post:\n      tags: [Core]\n      summary: Create new fraud-detector entry\n      operationId: createFraud-detectorItem\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/Fraud-detectorItem'\n      responses:\n        '201':\n          description: Resource created successfully\n  /api/v1/fraud-detector/{id}:\n    get:\n      tags: [Core]\n      summary: Get fraud-detector by identifier\n      operationId: getFraud-detectorById\n      parameters:\n        - name: id\n          in: path\n          required: true\n          schema:\n            type: string\n      responses:\n        '200':\n          description: Resource found\n        '404':\n          description: Item not found\n  /healthz:\n    get:\n      tags: [Health]\n      summary: Liveness and readiness probe\n      responses:\n        '200':\n          description: Service is healthy and operational\ncomponents:\n  schemas:\n    Fraud-detectorItem:\n      type: object\n      required:\n        - id\n        - name\n        - createdAt\n      properties:\n        id:\n          type: string\n          format: uuid\n        name:\n          type: string\n          example: 'Primary fraud-detector record'\n        status:\n          type: string\n          enum: [ACTIVE, PENDING, ARCHIVED]\n          default: ACTIVE\n        createdAt:\n          type: string\n          format: date-time\n",
      "robos:repository": "github.com/acme-payments/fraud-detector",
      "robos:endpoints": [
