[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS AI Multiplayer Game Theater
Comment=Dynamically generate and evolve multiplayer game servers and Godot 4 HTTPS web clients with per-player Google Doc launch links
Exec=/usr/bin/electron /usr/local/share/robos/game-theater/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/game-theater/icon.svg
Terminal=false
Categories=Game;X-PartyGame;
X-RobOS-Category=Party Games
StartupWMClass=robos-game-theater
