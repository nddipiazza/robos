    {
      "@id": "urn:robos:crpg:event:evt-martyr-sacrifice",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:description": "Interposing yourself to shield Gorion from Sarevok lethal spear thrust.",
      "dcterms:title": "The Martyr's Sacrifice",
      "robos:eventType": "cutscene",
