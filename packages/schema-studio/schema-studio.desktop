[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=Schema Studio & Definitive Registry
Comment=Schema.org Ontology Explorer, TypeSpec Domain Modeling & W3C SHACL Code Generator
Exec=/usr/bin/electron /usr/local/share/robos/schema-studio/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/schema-studio/icon.svg
Terminal=false
Categories=Development;
X-RobOS-Category=Architecture
StartupWMClass=robos-schema-studio
