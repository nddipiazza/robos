{
  "@context": {
    "c4": "https://c4model.com/ns#",
    "dcterms": "http://purl.org/dc/terms/",
    "oslc": "http://open-services.net/ns/core#",
    "oslc_am": "http://open-services.net/ns/am#",
    "oslc_cm": "http://open-services.net/ns/cm#",
    "oslc_qm": "http://open-services.net/ns/qm#",
    "oslc_rm": "http://open-services.net/ns/rm#",
    "pact": "https://pact.io/ns#",
    "robos": "https://robos.dev/ns/sdlc#",
    "robos:annotations": {
      "@id": "robos:annotations",
      "@type": "@json"
    },
    "robos:arguments": {
      "@id": "robos:arguments",
      "@type": "@json"
    },
    "robos:chatServer": {
      "@id": "robos:chatServer",
      "@type": "@id"
    },
    "robos:classification": {
      "@container": "@set",
      "@id": "robos:classification",
      "@type": "@id"
    },
    "robos:evidence": {
      "@container": "@set",
      "@context": {
        "line": {
          "@id": "robos:sourceLine",
          "@type": "xsd:integer"
        },
        "path": "robos:sourcePath",
        "repository": "robos:sourceRepository",
        "revision": "robos:sourceRevision",
        "sha256": "robos:sourceHash",
        "workingTreeStatus": "robos:workingTreeStatus"
      },
      "@id": "robos:evidence"
    },
    "robos:inputSchema": {
      "@id": "robos:inputSchema",
      "@type": "@json"
    },
    "robos:issueType": {
      "@id": "robos:issueType",
      "@type": "@id"
    },
    "robos:issueTypes": {
      "@id": "robos:issueTypes",
      "@type": "@json"
    },
    "robos:mcpServer": {
      "@id": "robos:mcpServer",
      "@type": "@id"
    },
    "robos:outputSchema": {
      "@id": "robos:outputSchema",
      "@type": "@json"
    },
    "robos:parameters": {
      "@id": "robos:parameters",
      "@type": "@json"
    },
    "robos:promptsProvided": {
      "@container": "@set",
      "@id": "robos:promptsProvided",
      "@type": "@id"
    },
    "robos:protocolReference": {
      "@id": "robos:protocolReference",
      "@type": "@id"
    },
    "robos:provenance": {
      "@id": "robos:provenance",
      "@type": "@json"
    },
    "robos:relationshipEvidence": {
      "@container": "@set",
      "@context": {
        "condition": "robos:condition",
        "evidence": {
          "@container": "@set",
          "@context": {
            "line": {
              "@id": "robos:sourceLine",
              "@type": "xsd:integer"
            },
            "path": "robos:sourcePath",
            "repository": "robos:sourceRepository",
            "revision": "robos:sourceRevision",
            "sha256": "robos:sourceHash",
            "workingTreeStatus": "robos:workingTreeStatus"
          },
          "@id": "robos:evidence"
        },
        "note": "dcterms:description",
        "predicate": {
          "@id": "robos:predicate",
          "@type": "@vocab"
        },
        "status": "robos:evidenceStatus",
        "target": {
          "@id": "robos:target",
          "@type": "@id"
        }
      },
      "@id": "robos:relationshipEvidence"
    },
    "robos:resourcesProvided": {
      "@container": "@set",
      "@id": "robos:resourcesProvided",
      "@type": "@id"
    },
    "robos:sourceSummary": {
      "@id": "robos:sourceSummary",
      "@type": "@json"
    },
    "robos:states": {
      "@id": "robos:states",
      "@type": "@json"
    },
    "robos:taskServer": {
      "@id": "robos:taskServer",
      "@type": "@id"
    },
    "robos:technologyReference": {
      "@id": "robos:technologyReference",
      "@type": "@id"
    },
    "robos:toolAnnotations": {
      "@id": "robos:toolAnnotations",
      "@type": "@json"
    },
    "robos:transitions": {
      "@id": "robos:transitions",
      "@type": "@json"
    },
    "robos:workflow": {
      "@id": "robos:workflow",
      "@type": "@id"
    },
    "robos:workflows": {
      "@id": "robos:workflows",
      "@type": "@json"
    },
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@id": "urn:robos:package:core-platform",
  "@type": [
    "robos:KGraphPackage"
  ],
  "dcterms:title": "RobOS Platform Core & Base SDLC Architecture",
  "robos:namespace": "robos.platform",
  "robos:nodes": [],
  "robos:package": "core-platform"
}
