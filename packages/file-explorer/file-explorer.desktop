[Desktop Entry]
X-RobOS-Category=RobOS System
X-RobOS-App=true
Name=RobOS File Explorer
Comment=RobOS File Manager
Exec=/usr/local/bin/robos-launch file-explorer
Icon=/usr/local/share/robos/file-explorer/icon.svg
Terminal=false
Type=Application
Categories=System;FileManager;
StartupNotify=true
StartupWMClass=file-explorer
