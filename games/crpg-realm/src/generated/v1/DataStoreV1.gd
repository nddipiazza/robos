func _ready() -> void:
	load_all_data()

func load_json(rel_path: String) -> Variant:
	var path = "res://" + rel_path
	if not FileAccess.file_exists(path):
		push_error("DataStore: File not found: " + path)
		return null
	var file = FileAccess.open(path, FileAccess.READ)
	var text = file.get_as_text()
	var parsed = JSON.parse_string(text)
	return parsed

func load_all_data() -> void:
	game_config = load_json("data/v1/game.json")
	
	var race_list = load_json("data/v1/races.json")
	if race_list is Array:
		for r in race_list:
			races[r["id"]] = r

	var class_list = load_json("data/v1/classes.json")
	if class_list is Array:
		for c in class_list:
			classes[c["id"]] = c

	var npc_list = load_json("data/v1/npcs.json")
	if npc_list is Array:
		for n in npc_list:
			npcs[n["id"]] = NPCData.from_dict(n)

	var monster_list = load_json("data/v1/monsters.json")
	if monster_list is Array:
		for m in monster_list:
			monsters[m["id"]] = MonsterData.from_dict(m)

	var spell_list = load_json("data/v1/spells.json")
	if spell_list is Array:
		for s in spell_list:
			spells[s["id"]] = SpellData.from_dict(s)

	var item_list = load_json("data/v1/items.json")
	if item_list is Array:
		for i in item_list:
			items[i["id"]] = ItemData.from_dict(i)

	var zone_list = load_json("data/v1/zones.json")
	if zone_list is Array:
		for z in zone_list:
			zones[z["id"]] = z

	var dial_list = load_json("data/v1/dialogue.json")
	if dial_list is Array:
		for d in dial_list:
			dialogue_trees[d["id"]] = d

	var quest_list = load_json("data/v1/quests.json")
	if quest_list is Array:
		for q in quest_list:
			quests[q["id"]] = q

	print("DataStoreV1: Loaded ", monsters.size(), " monsters, ", spells.size(), " spells, ", items.size(), " items, ", npcs.size(), " npcs.")
