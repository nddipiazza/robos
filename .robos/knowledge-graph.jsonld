                "type": "string"
              },
              "nodeId": {
                "description": "Target URN",
                "type": "string"
              }
            },
            "required": [
              "nodeId"
            ],
            "type": "object"
          },
          "name": "blast_radius"
        }
      ],
      "robos:toolsProvided": [
        "query_nodes",
        "get_blast_radius",
        "validate_shacl"
      ],
      "robos:transport": "stdio"
