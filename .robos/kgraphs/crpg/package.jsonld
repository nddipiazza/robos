    {
      "@id": "urn:robos:crpg:event:evt-candlekeep-gate-departure",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:description": "Passing through Candlekeep main gate onto the Coast Way as night envelops the monastery.",
      "dcterms:title": "The Iron Gates Clang Shut",
      "robos:eventType": "area_transition",
      "robos:infinityInteraction": {
        "robos:bcsAction": "SetGlobal(\"gate_unlocked\", \"GLOBAL\", 1)\nSetGlobal(\"Chapter\", \"GLOBAL\", 1)\nStartCutSceneMode()\nStartCutScene(\"Cut01A\")",
        "robos:bcsTrigger": "AreaCheck(\"candlekeep-exterior\") && Entered(\"ExitCoastWay\")",
        "robos:cutsceneRef": "Cut01A",
        "robos:dialogueMachine": "urn:robos:infinity:subsystem:dialogue-state-machine",
        "robos:interactionType": "area_transition",
        "robos:journalEntry": "Departed Candlekeep into the dark fog of the Coast Way alongside Gorion.",
        "robos:scriptVm": "urn:robos:infinity:subsystem:bcs-script-vm"
      },
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:stateMutations": {
        "setFlags": {
          "departed_candlekeep": true,
          "gate_unlocked": true
        }
      }
    },
    {
      "@id": "urn:robos:crpg:event:evt-coastway-flee-wilderness",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:description": "Heeding Gorion desperate order and escaping into the dense Coast Way woods.",
      "dcterms:title": "Flight into the Foggy Wilderness",
      "robos:eventType": "area_transition",
      "robos:infinityInteraction": {
        "robos:bcsAction": "SetGlobal(\"fled_into_woods\", \"GLOBAL\", 1)\nEscapeAreaMove(\"AR2700\", 350, 420, 0)",
        "robos:bcsTrigger": "HPPercentLT(Player1, 100) || Global(\"GorionCommandsFlee\", \"GLOBAL\", 1)",
        "robos:cutsceneRef": "Cut01B",
        "robos:dialogueMachine": "urn:robos:infinity:subsystem:dialogue-state-machine",
        "robos:interactionType": "bcs_script_action",
        "robos:journalEntry": "Fled into the dark forest as lightning ripped through the tree canopy.",
        "robos:scriptVm": "urn:robos:infinity:subsystem:bcs-script-vm"
      },
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:stateMutations": {
        "setFlags": {
          "fled_into_woods": true
        }
      }
    },
    {
      "@id": "urn:robos:crpg:event:evt-coastway-stand-with-gorion",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:description": "Standing firm with weapons drawn to confront Sarevok and his ogre mercenaries.",
      "dcterms:title": "The Valorous Stand Alongside Gorion",
      "robos:eventType": "decision_branch",
      "robos:infinityInteraction": {
        "robos:bcsAction": "SetGlobal(\"stood_with_gorion\", \"GLOBAL\", 1)\nAttack(\"sarevok\")\nPlaySong(22)",
        "robos:bcsTrigger": "Global(\"SarevokAmbush\", \"GLOBAL\", 1)",
        "robos:dialogueMachine": "urn:robos:infinity:subsystem:dialogue-state-machine",
        "robos:dialogueRef": "SAREVOK.DLG:1:3",
        "robos:interactionType": "dialogue_branch",
        "robos:journalEntry": "Refused Gorion's command to flee; stood with him against the armored warlord Sarevok.",
        "robos:scriptVm": "urn:robos:infinity:subsystem:bcs-script-vm"
      },
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:stateMutations": {
        "setFlags": {
          "stood_with_gorion": true
        }
      }
    },
    {
      "@id": "urn:robos:crpg:event:evt-dw-dark-pact-accepted",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:description": "Accepting the Dragonlord offer to rule half the realm in shadow.",
      "dcterms:title": "The Dark Pact of Charlock",
      "robos:eventType": "dialogue",
      "robos:infinityInteraction": {
        "robos:bcsAction": "SetGlobal(\"dark_pact_accepted\", \"GLOBAL\", 1)\nKill(\"king-loric\")\nStartCutScene(\"CutDarkReign\")",
        "robos:bcsTrigger": "Global(\"DRAGONLORD_OFFER\", \"GLOBAL\", 1)",
        "robos:dialogueMachine": "urn:robos:infinity:subsystem:dialogue-state-machine",
        "robos:dialogueRef": "DRAGONLORD.DLG:2:2",
        "robos:interactionType": "dialogue_branch",
        "robos:journalEntry": "Accepted the Dragonlord bargain; betrayed King Loric to rule Alefgard in shadow.",
        "robos:scriptVm": "urn:robos:infinity:subsystem:bcs-script-vm"
      },
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:stateMutations": {
        "setFlags": {
          "dark_pact_accepted": true
        }
      }
    },
    {
      "@id": "urn:robos:crpg:event:evt-dw-dragonlord-slain",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:description": "Striking down the Dragonlord atop Charlock throne and recovering the radiant Ball of Light.",
      "dcterms:title": "Dragonlord Defeated & Ball of Light Restored",
      "robos:eventType": "combat_victory",
      "robos:infinityInteraction": {
        "robos:bcsAction": "SetGlobal(\"dragonlord_slain\", \"GLOBAL\", 1)\nSetGlobal(\"ball_of_light_restored\", \"GLOBAL\", 1)\nGiveItemCreate(\"BALL_OF_LIGHT\", Player1, 1, 0, 0)\nStartMovie(\"ALEFGARD_RESTORED\")",
        "robos:bcsTrigger": "Dead(\"dragonlord\")",
        "robos:dialogueMachine": "urn:robos:infinity:subsystem:dialogue-state-machine",
        "robos:interactionType": "combat_encounter",
        "robos:journalEntry": "Vanquished the Dragonlord! The Ball of Light returns radiant dawn to Alefgard.",
        "robos:scriptVm": "urn:robos:infinity:subsystem:bcs-script-vm"
      },
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:stateMutations": {
        "setFlags": {
          "ball_of_light_restored": true,
          "dragonlord_slain": true
        },
        "xpAward": 2500
      }
    },
    {
      "@id": "urn:robos:crpg:event:evt-dw-green-dragon-slain",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:description": "Slaying the fearsome Green Dragon deep in the swamp cave and freeing Princess Gwaelin.",
      "dcterms:title": "Green Dragon Slain & Princess Rescued",
      "robos:eventType": "combat_victory",
      "robos:infinityInteraction": {
        "robos:bcsAction": "SetGlobal(\"green_dragon_slain\", \"GLOBAL\", 1)\nSetGlobal(\"princess_rescued\", \"GLOBAL\", 1)\nGiveItemCreate(\"GWAELIN_LOVE\", Player1, 1, 0, 0)\nAddJournalEntry(4004, QUEST_DONE)",
        "robos:bcsTrigger": "Dead(\"green-dragon\")",
        "robos:dialogueMachine": "urn:robos:infinity:subsystem:dialogue-state-machine",
        "robos:interactionType": "combat_encounter",
        "robos:journalEntry": "Slew the Green Dragon and rescued Princess Gwaelin from her cage.",
        "robos:scriptVm": "urn:robos:infinity:subsystem:bcs-script-vm"
      },
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:stateMutations": {
        "setFlags": {
          "green_dragon_slain": true,
          "princess_rescued": true
        },
        "xpAward": 950
      }
    },
    {
      "@id": "urn:robos:crpg:event:evt-dw-hero-slain-charlock",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:description": "Falling in battle against the Dragonlord infernal breath.",
      "dcterms:title": "Ashes in Charlock",
      "robos:eventType": "cutscene",
      "robos:infinityInteraction": {
        "robos:bcsAction": "SetGlobal(\"hero_slain_charlock\", \"GLOBAL\", 1)\nGameOver(DEFEAT)",
        "robos:bcsTrigger": "HP(Player1, 0) && AreaCheck(\"castle-charlock-throne\")",
        "robos:dialogueMachine": "urn:robos:infinity:subsystem:dialogue-state-machine",
        "robos:interactionType": "cutscene_trigger",
        "robos:journalEntry": "Fell in Charlock Castle; darkness claims Alefgard.",
        "robos:scriptVm": "urn:robos:infinity:subsystem:bcs-script-vm"
      },
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:stateMutations": {
        "setFlags": {
          "hero_slain_charlock": true
        }
      }
    },
    {
      "@id": "urn:robos:crpg:event:evt-dw-loric-decree",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:description": "King Loric charges the descendant of Erdrick with retrieving the stolen Ball of Light.",
      "dcterms:title": "King Loric's Royal Mandate",
      "robos:eventType": "dialogue",
      "robos:infinityInteraction": {
        "robos:bcsAction": "SetGlobal(\"received_royal_blessing\", \"GLOBAL\", 1)\nGiveGoldForce(120)\nGiveItemCreate(\"TORCH\", Player1, 1, 0, 0)\nGiveItemCreate(\"HERB\", Player1, 1, 0, 0)",
        "robos:bcsTrigger": "NumTimesTalkedTo(0) && AreaCheck(\"tantegel-throne-room\")",
        "robos:dialogueMachine": "urn:robos:infinity:subsystem:dialogue-state-machine",
        "robos:dialogueRef": "LORIC.DLG:1:1",
        "robos:interactionType": "dialogue_branch",
        "robos:journalEntry": "King Loric blessed our quest and provided 120 gold, a torch, and healing herbs.",
        "robos:scriptVm": "urn:robos:infinity:subsystem:bcs-script-vm"
      },
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:stateMutations": {
        "goldChange": 120,
        "setFlags": {
          "received_royal_blessing": true,
          "spoke_to_king_loric": true
        }
      }
    },
    {
      "@id": "urn:robos:crpg:event:evt-dw-rainbow-bridge-created",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:description": "Combining the Staff of Rain and Sunstone at the sacred shrine to forge the Rainbow Drop.",
      "dcterms:title": "The Rainbow Bridge Spanned",
      "robos:eventType": "item_acquisition",
      "robos:infinityInteraction": {
        "robos:bcsAction": "SetGlobal(\"rainbow_bridge_created\", \"GLOBAL\", 1)\nTakePartyItem(\"staff-of-rain\")\nTakePartyItem(\"sunstone\")\nGiveItemCreate(\"RAINBOW_DROP\", Player1, 1, 0, 0)\nStartCutScene(\"CutRainbowBridge\")",
        "robos:bcsTrigger": "PartyHasItem(\"staff-of-rain\") && PartyHasItem(\"sunstone\")",
        "robos:cutsceneRef": "CutRainbowBridge",
        "robos:dialogueMachine": "urn:robos:infinity:subsystem:dialogue-state-machine",
        "robos:interactionType": "bcs_script_action",
        "robos:journalEntry": "Forged the Rainbow Drop and created the bridge of light across the sea to Castle Charlock.",
        "robos:scriptVm": "urn:robos:infinity:subsystem:bcs-script-vm"
      },
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:stateMutations": {
        "setFlags": {
          "rainbow_bridge_created": true
        }
      }
    },
    {
      "@id": "urn:robos:crpg:event:evt-dw-relic-search",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:description": "Setting out across Rimuldar and Cantlin to unearth the Staff of Rain and Sunstone.",
      "dcterms:title": "Quest for Erdrick's Sacred Relics",
      "robos:eventType": "quest_milestone",
      "robos:infinityInteraction": {
        "robos:bcsAction": "SetGlobal(\"quest_for_relics\", \"GLOBAL\", 1)\nAddJournalEntry(4003, QUEST)",
        "robos:bcsTrigger": "PartyHasItem(\"erdrick-tablet\")",
        "robos:dialogueMachine": "urn:robos:infinity:subsystem:dialogue-state-machine",
        "robos:interactionType": "bcs_script_action",
        "robos:journalEntry": "Set out across Alefgard to locate the sacred Staff of Rain and Sunstone.",
        "robos:scriptVm": "urn:robos:infinity:subsystem:bcs-script-vm"
      },
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:stateMutations": {
        "setFlags": {
          "quest_for_relics": true
        }
      }
    },
    {
      "@id": "urn:robos:crpg:event:evt-dw-swamp-cave-discovery",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:description": "Descending into the noxious swamp cave south of Tantegel Castle.",
      "dcterms:title": "Descent into the Swamp Cave",
      "robos:eventType": "area_transition",
      "robos:infinityInteraction": {
        "robos:bcsAction": "SetGlobal(\"discovered_swamp_cave\", \"GLOBAL\", 1)\nAddJournalEntry(4002, QUEST)",
        "robos:bcsTrigger": "AreaCheck(\"tantegel-exterior\") && Entered(\"ExitSwampCave\")",
        "robos:dialogueMachine": "urn:robos:infinity:subsystem:dialogue-state-machine",
        "robos:interactionType": "area_transition",
        "robos:journalEntry": "Entered the subterranean swamp cave searching for Princess Gwaelin.",
