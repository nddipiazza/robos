[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS eLearning
Comment=RobOS Interactive eLearning Player, Hands-On Lab Runner, and Completion Certificate Hub
Exec=/usr/bin/electron /usr/local/share/robos/robos-elearning/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/robos-elearning/icon.svg
Terminal=false
Categories=Education;Development;
X-RobOS-Category=Education
StartupWMClass=robos-elearning
