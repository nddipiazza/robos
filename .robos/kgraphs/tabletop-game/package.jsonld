      "robos:portraitAsset": "assets/portraits/card_bg_wizard.png",
      "robos:audioLines": {
        "turnStart": [
          {
            "text": "The winds of magic gather at my staff.",
            "audio": "res://assets/audio/heroes/wizard_turn_start.ogg"
          }
        ],
        "attacking": [
          {
            "text": "Back, foul fiend, before my arcane staff!",
            "audio": "res://assets/audio/heroes/wizard_attacking.ogg"
          }
        ],
        "attacked": [
          {
            "text": "Gah! My ward-cloak falters!",
            "audio": "res://assets/audio/heroes/wizard_attacked.ogg"
          }
        ],
        "defended": [
          {
            "text": "My arcane barrier deflects your strike!",
