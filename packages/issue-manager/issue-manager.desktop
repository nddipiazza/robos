[Desktop Entry]
X-RobOS-App=true
X-RobOS-Category=Development
Type=Application
Name=Issue Manager
Comment=GitHub Issues client with workflow transitions and AI assistance
Exec=/usr/bin/electron /usr/local/share/robos/issue-manager/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/issue-manager/icon.svg
Terminal=false
Categories=Development;
StartupWMClass=robos-issue-manager
