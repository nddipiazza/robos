    {
      "@id": "urn:robos:tabletop:hero:bernie-sanders",
      "@type": [
        "oslc_am:Resource",
        "robos:TabletopHero",
        "robos:GameCharacter",
        "schema:Person"
      ],
      "dcterms:title": "Bernie Sanders",
      "robos:category": "Midterms 2026",
      "robos:heroClass": "Wizard",
      "robos:bodyPoints": 4,
      "robos:mindPoints": 6,
      "robos:attackDice": 1,
      "robos:defendDice": 2,
      "robos:startingWeapon": "urn:robos:game:item:dagger",
      "robos:equippedWeapon": "Gnarled Oak Staff of the 99% (1 Combat Die)",
      "robos:equippedArmor": "Starry Wizard Hat & Vermont Wool Mittens (2 Defend Dice)",
      "robos:specialAbility": "Master Spellcaster (3 Colleges, 9 Spells)",
      "robos:gold": 99,
      "robos:tokenColor": "#2563eb",
      "robos:tokenAsset": "assets/tokens/token_bernie_sanders.png",
      "robos:portraitAsset": "assets/portraits/card_bg_bernie_sanders.png",
      "robos:icon": "\ud83e\ude84",
      "robos:startingPosition": [
        1,
        13
      ],
      "robos:inventory": [
        {
          "id": "item-mittens-bernie",
          "name": "Enchanted Vermont Mittens",
          "type": "relic",
          "effect": "Channels crackling elemental lightning & warmth",
          "value": 200
        },
        {
          "id": "item-pot-heal-bernie",
          "name": "Universal Healthcare Potion",
          "type": "potion",
          "effect": "Restores up to 4 BP",
          "value": 100
        }
      ],
      "dcterms:description": "Ancient Elemental Wizard in a tall starry wizard hat and iconic patterned wool mittens. Commands 3 full elemental spell colleges (9 spells) against Super PAC demons and Hydras.",
      "robos:package": "tabletop-game",
      "robos:namespace": "robos.tabletop",
      "robos:audioLines": {
        "turnStart": [
          {
            "text": "They're starving to death right now!",
            "audio": "res://assets/audio/heroes/bernie_quote_1.ogg"
          },
          {
            "text": "You have to be a wealthy person to send your kid to college!",
            "audio": "res://assets/audio/heroes/bernie_quote_2.ogg"
          },
          {
            "text": "They've had socialist governments for decades!",
            "audio": "res://assets/audio/heroes/bernie_quote_3.ogg"
          },
          {
            "text": "Mr. Speaker, I've got a problem!",
            "audio": "res://assets/audio/heroes/bernie_quote_4.ogg"
          },
          {
            "text": "Two million people sleeping out on the streets!",
            "audio": "res://assets/audio/heroes/bernie_quote_5.ogg"
          },
          {
            "text": "Let's not keep putting poor people into jail!",
            "audio": "res://assets/audio/heroes/bernie_quote_6.ogg"
          },
          {
            "text": "The rich get richer, the poor get poorer!",
            "audio": "res://assets/audio/heroes/bernie_quote_7.ogg"
          },
          {
            "text": "Let's talk about welfare for the rich and the powerful!",
            "audio": "res://assets/audio/heroes/bernie_quote_8.ogg"
          }
        ],
        "moving": [
          {
            "text": "From 46 states in America!",
            "audio": "res://assets/audio/heroes/bernie_move_1.ogg"
          },
          {
            "text": "What we are saying very loud and clear!",
            "audio": "res://assets/audio/heroes/bernie_move_2.ogg"
          },
          {
            "text": "80 or 90% of the people voting!",
            "audio": "res://assets/audio/heroes/bernie_move_3.ogg"
          },
          {
            "text": "Getting tough on crime!",
            "audio": "res://assets/audio/heroes/bernie_move_4.ogg"
          },
          {
            "text": "Jobs for the jobless!",
            "audio": "res://assets/audio/heroes/bernie_move_5.ogg"
          },
          {
            "text": "Who is gaining that income?!",
            "audio": "res://assets/audio/heroes/bernie_move_6.ogg"
          }
        ],
        "attacking": [
          {
            "text": "I will be damned if I will vote for that!",
            "audio": "res://assets/audio/heroes/bernie_atk_1.ogg"
          },
          {
            "text": "Let's deal with the causes of crime!",
            "audio": "res://assets/audio/heroes/bernie_atk_2.ogg"
          },
          {
            "text": "They buy and sell politicians!",
            "audio": "res://assets/audio/heroes/bernie_atk_3.ogg"
          },
          {
            "text": "Evolving into an oligarchy!",
            "audio": "res://assets/audio/heroes/bernie_atk_4.ogg"
          },
          {
            "text": "Huge tax breaks to the wealthy!",
            "audio": "res://assets/audio/heroes/bernie_atk_5.ogg"
          },
          {
            "text": "Ronald Reagan and his billionaire friends!",
            "audio": "res://assets/audio/heroes/bernie_atk_6.ogg"
          }
        ],
        "castingMagic": [
          {
            "text": "I will be damned if I will vote for that!",
            "audio": "res://assets/audio/heroes/bernie_atk_1.ogg"
          },
          {
            "text": "Let's deal with the causes of crime!",
            "audio": "res://assets/audio/heroes/bernie_atk_2.ogg"
          },
          {
            "text": "They buy and sell politicians!",
            "audio": "res://assets/audio/heroes/bernie_atk_3.ogg"
          },
          {
            "text": "Evolving into an oligarchy!",
            "audio": "res://assets/audio/heroes/bernie_atk_4.ogg"
          },
          {
            "text": "Huge tax breaks to the wealthy!",
            "audio": "res://assets/audio/heroes/bernie_atk_5.ogg"
          },
          {
            "text": "Ronald Reagan and his billionaire friends!",
            "audio": "res://assets/audio/heroes/bernie_atk_6.ogg"
          }
        ],
        "attacked": [
          {
            "text": "Mr. Speaker, I've got a problem!",
            "audio": "res://assets/audio/heroes/bernie_react_1.ogg"
          },
          {
            "text": "Grows wider!",
            "audio": "res://assets/audio/heroes/bernie_react_2.ogg"
          },
          {
            "text": "Who are hungry!",
            "audio": "res://assets/audio/heroes/bernie_react_3.ogg"
          },
          {
            "text": "Politicians!",
            "audio": "res://assets/audio/heroes/bernie_react_4.ogg"
          },
          {
            "text": "I will be damned!",
            "audio": "res://assets/audio/heroes/bernie_react_5.ogg"
          },
          {
            "text": "Out on the street!",
            "audio": "res://assets/audio/heroes/bernie_react_6.ogg"
          }
        ],
        "defended": [
          {
            "text": "Mr. Speaker, I've got a problem!",
            "audio": "res://assets/audio/heroes/bernie_react_1.ogg"
          },
          {
            "text": "Grows wider!",
            "audio": "res://assets/audio/heroes/bernie_react_2.ogg"
          },
          {
            "text": "Who are hungry!",
            "audio": "res://assets/audio/heroes/bernie_react_3.ogg"
          },
          {
            "text": "Politicians!",
            "audio": "res://assets/audio/heroes/bernie_react_4.ogg"
          },
          {
            "text": "I will be damned!",
            "audio": "res://assets/audio/heroes/bernie_react_5.ogg"
          },
          {
            "text": "Out on the street!",
            "audio": "res://assets/audio/heroes/bernie_react_6.ogg"
