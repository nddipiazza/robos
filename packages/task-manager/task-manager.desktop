[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Task Manager
Comment=View and kill running RobOS processes
Exec=/usr/local/bin/robos-launch task-manager
Icon=/usr/local/share/robos/task-manager/icon.svg
Terminal=false
Categories=System;
Keywords=tasks;processes;kill;manager;monitor;
X-RobOS-Category=RobOS System
StartupNotify=false
StartupWMClass=task-manager
