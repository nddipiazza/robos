          ],
          "attackDice": 1,
          "bodyPoints": 4,
          "category": "Midterms 2026",
          "characterName": "Bernie Sanders",
          "dcterms:title": "Bernie Sanders",
          "defendDice": 2,
          "equippedArmor": "Starry Wizard Hat & Vermont Wool Mittens (2 Defend Dice)",
          "equippedWeapon": "Gnarled Oak Staff of the 99% (1 Combat Die)",
          "gold": 99,
          "heroClass": "Wizard",
          "icon": "🪄",
          "id": "urn:robos:tabletop:hero:bernie-sanders",
          "inventory": [
            {
              "effect": "Channels crackling elemental lightning & warmth",
              "id": "item-mittens-bernie",
              "name": "Enchanted Vermont Mittens",
              "type": "relic",
              "value": 200
            },
            {
              "effect": "Restores up to 4 BP",
              "id": "item-pot-heal-bernie",
              "name": "Universal Healthcare Potion",
              "type": "potion",
              "value": 100
            }
          ],
          "mindPoints": 6,
          "name": "Bernie Sanders",
          "portraitAsset": "assets/portraits/card_bg_bernie_sanders.png",
          "robos:attackDice": 1,
          "robos:audioLines": {
            "attacked": [
              {
                "audio": "res://assets/audio/heroes/bernie_quote_1.ogg",
                "text": "We live in a world today where there are several hundred million people starving to death — they're starving to death right now!"
              },
              {
                "audio": "res://assets/audio/heroes/bernie_quote_2.ogg",
                "text": "In some of the largest cities in America, 50% of the kids are not graduating high school! The cost of college education is zooming up, so you have to be a wealthy person to send your kid to college!"
              },
              {
                "audio": "res://assets/audio/heroes/bernie_quote_3.ogg",
                "text": "In Sweden, they've had socialist governments for decades — 80 or 90% of the people voting, strong labor unions, and a health care system guaranteeing health care to all people!"
              },
              {
                "audio": "res://assets/audio/heroes/bernie_quote_4.ogg",
                "text": "They say we're getting tough on crime — if you want to get tough on crime, let's deal with the causes of crime! Let's demand that every man, woman, and child have a decent standard of living!"
              },
              {
                "audio": "res://assets/audio/heroes/bernie_quote_5.ogg",
                "text": "We have an approach to campaign financing which allows wealthy people and major corporations to buy and sell politicians! The rich get richer and the poor get poorer!"
              },
              {
                "audio": "res://assets/audio/heroes/bernie_quote_6.ogg",
                "text": "The chief executive officers are seeing their salaries soar, and the gap between the rich and the poor grows wider! Ten million Americans are unemployed!"
              },
              {
                "audio": "res://assets/audio/heroes/bernie_quote_7.ogg",
                "text": "We give huge tax breaks to the wealthy and you have two million people sleeping out on the street! Billions of dollars in obsolete weapon systems, and five million children who are hungry!"
              },
              {
                "audio": "res://assets/audio/heroes/bernie_quote_8.ogg",
                "text": "Workers in the United States today are working significantly longer hours, taking less vacation time — is there any wonder why so many millions of Americans feel stressed out?!"
              }
            ],
            "attacking": [
              {
                "audio": "res://assets/audio/heroes/bernie_quote_1.ogg",
                "text": "We live in a world today where there are several hundred million people starving to death — they're starving to death right now!"
              },
              {
                "audio": "res://assets/audio/heroes/bernie_quote_2.ogg",
                "text": "In some of the largest cities in America, 50% of the kids are not graduating high school! The cost of college education is zooming up, so you have to be a wealthy person to send your kid to college!"
              },
              {
                "audio": "res://assets/audio/heroes/bernie_quote_3.ogg",
