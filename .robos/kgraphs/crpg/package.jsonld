    {
      "@id": "urn:robos:crpg:event:evt-coastway-flee-wilderness",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:title": "Flight into the Foggy Wilderness",
      "dcterms:description": "Heeding Gorion desperate order and escaping into the dense Coast Way woods.",
      "robos:eventType": "area_transition",
      "robos:infinityInteraction": {
        "robos:interactionType": "bcs_script_action",
        "robos:scriptVm": "urn:robos:infinity:subsystem:bcs-script-vm",
        "robos:dialogueMachine": "urn:robos:infinity:subsystem:dialogue-state-machine",
        "robos:bcsTrigger": "HPPercentLT(Player1, 100) || Global(\"GorionCommandsFlee\", \"GLOBAL\", 1)",
        "robos:bcsAction": "SetGlobal(\"fled_into_woods\", \"GLOBAL\", 1)\nEscapeAreaMove(\"AR2700\", 350, 420, 0)",
        "robos:journalEntry": "Fled into the dark forest as lightning ripped through the tree canopy.",
        "robos:cutsceneRef": "Cut01B"
      },
      "robos:stateMutations": {
        "setFlags": {
          "fled_into_woods": true
        }
      },
      "robos:package": "crpg",
