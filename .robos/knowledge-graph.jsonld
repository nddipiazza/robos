      "robos:contractYaml": "openapi: 3.1.0\ninfo:\n  title: Oauth Server REST API\n  description: High-performance microservice contract for Oauth Server in RobOS Universe.\n  version: 1.0.0\nservers:\n  - url: https://github.com/api/v1/oauth-server\n    description: Production Gateway\n  - url: http://localhost:8080\n    description: Local Dev Container\ntags:\n  - name: Core\n    description: Primary operations\n  - name: Health\n    description: Service diagnostics and liveliness\npaths:\n  /api/v1/oauth-server:\n    get:\n      tags: [Core]\n      summary: Retrieve all oauth-server items\n      operationId: listOauth-serverItems\n      parameters:\n        - name: limit\n          in: query\n          required: false\n          schema:\n            type: integer\n            default: 50\n      responses:\n        '200':\n          description: Successful query result\n          content:\n            application/json:\n              schema:\n                type: array\n                items:\n                  $ref: '#/components/schemas/Oauth-serverItem'\n    post:\n      tags: [Core]\n      summary: Create new oauth-server entry\n      operationId: createOauth-serverItem\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/Oauth-serverItem'\n      responses:\n        '201':\n          description: Resource created successfully\n  /api/v1/oauth-server/{id}:\n    get:\n      tags: [Core]\n      summary: Get oauth-server by identifier\n      operationId: getOauth-serverById\n      parameters:\n        - name: id\n          in: path\n          required: true\n          schema:\n            type: string\n      responses:\n        '200':\n          description: Resource found\n        '404':\n          description: Item not found\n  /healthz:\n    get:\n      tags: [Health]\n      summary: Liveness and readiness probe\n      responses:\n        '200':\n          description: Service is healthy and operational\ncomponents:\n  schemas:\n    Oauth-serverItem:\n      type: object\n      required:\n        - id\n        - name\n        - createdAt\n      properties:\n        id:\n          type: string\n          format: uuid\n        name:\n          type: string\n          example: 'Primary oauth-server record'\n        status:\n          type: string\n          enum: [ACTIVE, PENDING, ARCHIVED]\n          default: ACTIVE\n        createdAt:\n          type: string\n          format: date-time\n",
      "robos:repository": "github.com/acme-identity/oauth-server",
