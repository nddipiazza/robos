        {
          "uri": "robos://workspace-manager/workspace/all",
          "name": "All Registered Workspaces",
          "mimeType": "application/json",
          "description": ""
        }
      ]
    },
    {
      "package": "packages/ci-monitor-mcp",
      "factory": "createCIMonitorMCPServer",
      "appId": "ci-monitor",
      "serverInfo": {
        "name": "CI Monitor MCP Server",
        "version": "1.3.0"
      },
      "protocolVersion": "2024-11-05",
      "description": "RobOS Continuous Integration & Deployment Pipeline MCP Server",
      "note": null,
      "tools": [
        {
          "name": "robos_ci_get_status",
          "description": "Get the latest configured Buildkite run on an exact branch. Returns null if no matching recent run exists.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "branch": {
                "type": "string",
                "description": "Branch name (e.g. main, feat/task-101-flow)"
              }
            }
          }
        },
        {
          "name": "robos_ci_list_runs",
          "description": "List up to 30 real builds from the configured Buildkite organization/pipeline. Returns stable run IDs for log and failure tools.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "description": "Filter by status (SUCCESS, FAILURE, RUNNING)"
              },
              "branch": {
                "type": "string",
                "description": "Filter by branch"
              }
            }
          }
        },
        {
          "name": "robos_ci_get_logs",
          "description": "Fetch actual failed-job logs for a Buildkite run. Individual log access failures are reported, not hidden.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string",
                "description": "Run ID returned by robos_ci_list_runs (buildkite:organization:pipeline:number)"
              }
            },
            "required": [
              "runId"
            ]
          }
        },
        {
          "name": "robos_ci_get_failures",
          "description": "Retrieve failed Buildkite jobs, commit, observed log excerpts and artifact link. Excerpts are log text, not an inferred root cause.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string",
                "description": "Run ID returned by robos_ci_list_runs"
              }
            },
            "required": [
              "runId"
            ]
          }
        },
        {
          "name": "robos_ci_retry_run",
          "description": "Buildkite retries are not supported by this read-only integration. Returns an explicit error without retrying or changing status.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string",
                "description": "Run ID returned by robos_ci_list_runs"
              }
            },
            "required": [
              "runId"
            ]
          }
        },
        {
          "name": "robos_ci_get_deployments",
          "description": "Deployments are not tracked by the Buildkite integration; returns an empty list.",
          "inputSchema": {
            "type": "object",
            "properties": {}
          }
        }
      ],
      "resources": [
        {
          "uri": "robos://ci-monitor-mcp/ci/current",
          "name": "Current CI Status",
          "mimeType": "application/json",
          "description": ""
        },
        {
          "uri": "robos://ci-monitor-mcp/ci/deployments/latest",
          "name": "Latest Deployment Info",
          "mimeType": "application/json",
          "description": ""
        }
      ]
    },
    {
      "package": "packages/ide-bridge-mcp",
      "factory": "createIDEBridgeMCPServer",
      "appId": "ide-bridge",
      "serverInfo": {
        "name": "IDE Bridge MCP Server",
        "version": "2.0.0"
      },
      "protocolVersion": "2024-11-05",
      "description": "RobOS IDE IPC Bridge Model Context Protocol Server with Breakpoint Webhook, Secrets & Multi-Project Workspaces",
      "note": "Talks to the IntelliJ IDEA plugin on port 63343. Tools that drive the IDE need IntelliJ running with the RobOS plugin installed.",
      "tools": [
        {
          "name": "robos_ide_create_run_config",
          "description": "Create a run/debug configuration in IntelliJ with secure GPG pass secret resolution.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Run configuration name"
              },
              "type": {
                "type": "string",
                "description": "Type: Application, JUnit, Maven, Gradle"
              },
              "projectPath": {
                "type": "string",
                "description": "Path to project directory"
              },
              "mainClassOrCommand": {
                "type": "string",
                "description": "Target main class, test class, or CLI command"
              },
              "env": {
                "type": "object",
                "description": "Environment variables"
              },
              "passSecrets": {
                "type": "object",
                "description": "GPG pass references (e.g. { \"DB_PASS\": \"pass:db/prod_password\" })"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "name": "robos_ide_run_config",
          "description": "Start a run/debug configuration in the IDE.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Run configuration name"
              },
