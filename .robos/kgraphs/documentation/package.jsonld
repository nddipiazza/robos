    {
      "@id": "urn:robos:diagram:checkout-payment-flow",
      "@type": [
        "robos:FlowDiagram",
        "oslc:Resource"
      ],
      "dcterms:description": "End-to-end transactional sequence from customer checkout to payment settlement.",
      "dcterms:title": "Checkout and Payment Processing Flowchart",
      "robos:diagramType": "sequence",
      "robos:domainStandard": "https://schema.org/ImageObject",
      "robos:imagePath": "assets/diagrams/checkout-payment-flow.png",
      "robos:mermaidText": "sequenceDiagram\n  autonumber\n  actor Customer as Customer SPA\n  participant Checkout as Checkout API (Java)\n  participant Payments as Payment Gateway (Java)\n  participant Kafka as Apache Kafka\n  Customer->>Checkout: POST /api/v1/checkout/orders\n  Checkout->>Payments: POST /api/v1/payments/charge\n  Payments-->>Checkout: 200 OK (Transaction Approved)\n  Checkout->>Kafka: Publish \"orders.created\" event\n  Checkout-->>Customer: 201 Created (Order Confirmed)",
      "robos:namespace": "robos.docs",
      "robos:package": "documentation",
      "robos:schemaOrgType": "https://schema.org/ImageObject",
      "robos:slug": "checkout-payment-flow",
      "robos:sourceUrl": "https://confluence.acme.corp/display/ARCH#page-103",
      "robos:tooltip": "Interactive sequence diagram for checkout order validation and payment capture"
    },
    {
      "@id": "urn:robos:diagram:order-lifecycle-flow",
      "@type": [
        "oslc_am:Resource",
        "robos:FlowDiagram",
        "schema:ImageObject"
      ],
      "dcterms:description": "End-to-end workflow tracing customer order ingestion from Webhook to Kafka events, payment capture, and inventory deduction.",
      "dcterms:title": "Order Lifecycle & Event Processing Flow",
      "robos:aspectRatio": "16:9",
      "robos:diagramType": "sequence",
      "robos:domainStandard": "https://schema.org/ImageObject",
      "robos:imagePath": "assets/images/architecture/order-lifecycle-flow.jpg",
      "robos:mermaidText": "sequenceDiagram\n    participant Client\n    participant Gateway\n    participant OrderService\n    participant Kafka\n    Client->>Gateway: POST /orders\n    Gateway->>OrderService: Validate & Route\n    OrderService->>Kafka: Emit OrderCreated\n",
      "robos:namespace": "robos.docs",
      "robos:package": "documentation",
      "robos:schemaOrgType": "https://schema.org/ImageObject",
      "robos:tags": [
        "Architecture",
        "Ordering",
        "EventDriven"
      ],
      "robos:targetComponent": "urn:robos:service:forms-api",
      "robos:tooltip": "Visual sequence of order validation, distributed transaction, and event routing"
    },
    {
      "@id": "urn:robos:diagram:skill-commons-assembler-loop",
      "@type": [
        "oslc_am:Resource",
        "robos:FlowDiagram",
        "schema:ImageObject"
      ],
      "dcterms:description": "Five steps: describe, break down, look up, check the fit, run the pieces' own tests. A missing piece is built once through the gate and the lookup runs again.",
      "dcterms:title": "How a small local model assembles an app",
      "robos:aspectRatio": "1600:660",
      "robos:diagramType": "architecture",
      "robos:domainStandard": "https://schema.org/ImageObject",
      "robos:imagePath": "assets/future/ai/assembler-loop.jpg",
      "robos:mermaidText": "flowchart LR\n    U[\"1. You describe the job\"] --> M[\"2. The model breaks it into smaller jobs\"]\n    M --> S[\"3. Look up each job: company first, then the catalog\"]\n    S -->|\"nothing matches\"| GAP[\"A person or an AI builds that piece once; it passes the gate and joins the catalog\"]\n    GAP --> S\n    S --> CHK[\"4. Machines check the fit\"]\n    CHK --> T[\"5. Pieces run their own tests\"]\n    T --> APP[\"Working app\"]",
      "robos:namespace": "robos.docs",
      "robos:package": "documentation",
      "robos:schemaOrgType": "https://schema.org/ImageObject",
      "robos:tooltip": "How a small local model assembles an app"
    },
    {
      "@id": "urn:robos:diagram:skill-commons-commons-map",
      "@type": [
        "oslc_am:Resource",
        "robos:FlowDiagram",
        "schema:ImageObject"
      ],
      "dcterms:description": "People, AI agents and companies add skills through one gate; a job is broken down to base tasks that other apps reuse; a small local model assembles them with private company knowledge.",
      "dcterms:title": "The Skill Commons",
      "robos:aspectRatio": "1600:1030",
      "robos:diagramType": "architecture",
      "robos:domainStandard": "https://schema.org/ImageObject",
      "robos:imagePath": "assets/future/ai/commons-map.jpg",
      "robos:mermaidText": "flowchart LR\n    P[\"People\"] --> G\n    A[\"AI agents\"] --> G\n    C[\"Companies\"] --> G\n    G{\"The one rule: not already there, passes its tests, built and signed\"} --> APP\n    subgraph COMMONS[\"The Commons: a shared, searchable catalog\"]\n        APP[\"Clinic reminder app\"] --> J1[\"Find who to remind\"]\n        APP --> J2[\"Write the message\"]\n        APP --> J3[\"Send a text\"]\n        APP --> J4[\"Log what was sent\"]\n        J1 --> B1[\"Convert time zone\"]\n        J2 --> B2[\"Fill a template\"]\n        J3 --> B3[\"Format phone number\"]\n        J3 --> B4[\"Call the text service\"]\n        J4 --> B5[\"Save a record\"]\n    end\n    B1 -->|\"local copy of the catalog\"| LAPTOP[\"Your computer with a small AI model\"]\n    PRIV[\"Your company private knowledge\"] --> LAPTOP\n    LAPTOP --> OUT[\"Your finished app\"]",
      "robos:namespace": "robos.docs",
      "robos:package": "documentation",
      "robos:schemaOrgType": "https://schema.org/ImageObject",
      "robos:tooltip": "The Skill Commons"
    },
    {
      "@id": "urn:robos:diagram:skill-commons-skill-lifecycle",
      "@type": [
        "oslc_am:Resource",
        "robos:FlowDiagram",
        "schema:ImageObject"
      ],
      "dcterms:description": "Propose, look for a twin, check, build reproducibly, sign and log, then share to mirrors; duplicates link to the existing skill and failing tests send the submission back.",
      "dcterms:title": "How a skill enters the commons",
      "robos:aspectRatio": "1600:660",
      "robos:diagramType": "architecture",
      "robos:domainStandard": "https://schema.org/ImageObject",
      "robos:imagePath": "assets/future/ai/skill-lifecycle.jpg",
      "robos:mermaidText": "flowchart LR\n    P[\"1. Propose\"] --> T[\"2. Find a twin\"]\n    T -->|\"already exists\"| L[\"Link to the existing skill\"]\n    T --> C[\"3. Check: tests, sandbox, time and step limits\"]\n    C -->|\"a test fails\"| X[\"Sent back with the failing test\"]\n    C --> B[\"4. Reproducible build for each target\"]\n    B --> S[\"5. Sign and log\"]\n    S --> M[\"6. Share to mirrors\"]",
      "robos:namespace": "robos.docs",
      "robos:package": "documentation",
      "robos:schemaOrgType": "https://schema.org/ImageObject",
      "robos:tooltip": "How a skill enters the commons"
    },
    {
      "@id": "urn:robos:diagram:skill-commons-worked-example",
      "@type": [
        "oslc_am:Resource",
        "robos:FlowDiagram",
        "schema:ImageObject"
      ],
      "dcterms:description": "The request becomes four smaller jobs and seven base tasks: five reused from the commons, one from the clinic's private graph, one missing and built once.",
      "dcterms:title": "A worked example: appointment reminders",
      "robos:aspectRatio": "16:9",
      "robos:diagramType": "architecture",
      "robos:domainStandard": "https://schema.org/ImageObject",
      "robos:imagePath": "assets/future/ai/worked-example.jpg",
      "robos:mermaidText": "flowchart TB\n    ROOT[\"Send appointment reminders (wiring only)\"] --> F[\"Find tomorrow's appointments\"]\n    ROOT --> W[\"Write the message\"]\n    ROOT --> SND[\"Send the text\"]\n    ROOT --> R[\"Record that it was sent\"]\n    F --> F1[\"Read clinic schedule (company, private)\"]\n    F --> F2[\"Convert time zone (found)\"]\n    W --> W1[\"Fill a template (found)\"]\n    SND --> S1[\"Format phone number (found)\"]\n    SND --> S2[\"Call the text service (found)\"]\n    SND --> S3[\"Respect quiet hours (NEW: built once)\"]\n    R --> R1[\"Save a record (found)\"]",
      "robos:namespace": "robos.docs",
      "robos:package": "documentation",
      "robos:schemaOrgType": "https://schema.org/ImageObject",
      "robos:tooltip": "A worked example: appointment reminders"
    },
