[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Task Planner
Comment=Create tasks on your task server using AI prompts
Exec=/usr/bin/electron /usr/local/share/robos/task-planner/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/task-planner/icon.svg
Terminal=false
Categories=Development;
X-RobOS-Category=AI
StartupWMClass=robos-task-planner
