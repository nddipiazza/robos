[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=Deploy Tracker
Comment=Deployment history, MTTR metrics, and deployment frequency tracking
Exec=/usr/bin/electron /usr/local/share/robos/deploy-tracker/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/deploy-tracker/icon.svg
Terminal=false
Categories=Development;
X-RobOS-Category=Management
StartupWMClass=deploy-tracker
