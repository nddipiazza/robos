    {
      "@id": "urn:robos:contract:checkout-api-v1",
      "@type": [
        "robos:Contract",
        "c4:Component",
        "oslc:Resource",
        "schema:DigitalDocument"
      ],
      "dcterms:title": "Checkout API Microservice OpenAPI 3.1 Spec",
      "robos:specFile": "specs/contracts/checkout-api-v1.yaml",
      "robos:protocol": "OpenAPI 3.1",
      "robos:contractYaml": "openapi: 3.1.0\ninfo:\n  title: Checkout API Microservice REST API\n  description: High-performance microservice contract for Checkout API Microservice in RobOS Universe.\n  version: 1.0.0\nservers:\n  - url: https://github.com/api/v1/checkout-api\n    description: Production Gateway\n  - url: http://localhost:8080\n    description: Local Dev Container\ntags:\n  - name: Core\n    description: Primary operations\n  - name: Health\n    description: Service diagnostics and liveliness\npaths:\n  /api/v1/checkout-api:\n    get:\n      tags: [Core]\n      summary: Retrieve all checkout-api items\n      operationId: listCheckout-apiItems\n      parameters:\n        - name: limit\n          in: query\n          required: false\n          schema:\n            type: integer\n            default: 50\n      responses:\n        '200':\n          description: Successful query result\n          content:\n            application/json:\n              schema:\n                type: array\n                items:\n                  $ref: '#/components/schemas/Checkout-apiItem'\n    post:\n      tags: [Core]\n      summary: Create new checkout-api entry\n      operationId: createCheckout-apiItem\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/Checkout-apiItem'\n      responses:\n        '201':\n          description: Resource created successfully\n  /api/v1/checkout-api/{id}:\n    get:\n      tags: [Core]\n      summary: Get checkout-api by identifier\n      operationId: getCheckout-apiById\n      parameters:\n        - name: id\n          in: path\n          required: true\n          schema:\n            type: string\n      responses:\n        '200':\n          description: Resource found\n        '404':\n          description: Item not found\n  /healthz:\n    get:\n      tags: [Health]\n      summary: Liveness and readiness probe\n      responses:\n        '200':\n          description: Service is healthy and operational\ncomponents:\n  schemas:\n    Checkout-apiItem:\n      type: object\n      required:\n        - id\n        - name\n        - createdAt\n      properties:\n        id:\n          type: string\n          format: uuid\n        name:\n          type: string\n          example: 'Primary checkout-api record'\n        status:\n          type: string\n          enum: [ACTIVE, PENDING, ARCHIVED]\n          default: ACTIVE\n        createdAt:\n          type: string\n          format: date-time\n",
      "robos:repository": "github.com/acme-retail/checkout-api",
      "robos:endpoints": [
        {
          "path": "/api/v1/checkout-api",
          "method": "GET",
          "description": "List Checkout API Microservice records"
        },
        {
          "path": "/api/v1/checkout-api",
          "method": "POST",
          "description": "Create Checkout API Microservice record"
        },
        {
          "path": "/api/v1/checkout-api/{id}",
          "method": "GET",
          "description": "Get Checkout API Microservice by ID"
        },
        {
          "path": "/healthz",
          "method": "GET",
          "description": "Health check"
        }
      ],
      "robos:package": "services",
      "robos:namespace": "robos.services",
      "robos:schemaOrgType": "https://schema.org/DigitalDocument",
      "robos:domainStandard": "http://open-services.net/ns/am#Resource"
    },
