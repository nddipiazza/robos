#!/usr/bin/env bash
# robos-profile — manage ephemeral agent user profiles via robos-profiled
#
# Usage:
#   robos-profile create <name> [--role ROLE] [--model MODEL]
#   robos-profile list
#   robos-profile inspect <name>
#   robos-profile terminate <name>

set -euo pipefail

HOME="${HOME:-/home/robos}"
SOCKET_PATH="$HOME/.config/robos/profiled/profiled.sock"

show_help() {
  cat <<'EOF'
Usage: robos-profile COMMAND [OPTIONS]

Manage ephemeral Linux agent user profiles with direct display bridging.

Commands:
  create NAME        Provision a new ephemeral agent profile (my-agent-<name>)
  list               List all active and recent agent profiles
  inspect NAME       Show detailed status and subsystem mappings for a profile
  terminate NAME     Terminate an active agent profile session
  --help             Show this help

Options:
  --role ROLE        Agent role (default: Autonomous Review Agent)
  --model MODEL      LLM model (default: claude-sonnet-4-20250514)

Examples:
  robos-profile create reviewer --role "Code Reviewer"
  robos-profile list
  robos-profile inspect my-agent-reviewer
  robos-profile terminate my-agent-reviewer
EOF
  exit 0
}

CMD="${1:-}"
if [ -z "$CMD" ] || [ "$CMD" = "--help" ] || [ "$CMD" = "-h" ]; then
  show_help
fi
shift

send_sock() {
  local payload="$1"
  python3 -c "
import socket, json, sys, os
sock_path = '$SOCKET_PATH'
if not os.path.exists(sock_path):
    print(json.dumps({'ok': False, 'error': 'robos-profiled socket not found at ' + sock_path}))
    sys.exit(0)
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
try:
    s.connect(sock_path)
    s.sendall(json.dumps($payload).encode())
    res = s.recv(8192).decode()
    print(res.strip())
except Exception as e:
    print(json.dumps({'ok': False, 'error': str(e)}))
finally:
    s.close()
"
}

case "$CMD" in
  create)
    NAME="${1:-}"
    if [ -z "$NAME" ]; then
      echo "Error: Profile name required" >&2
      echo "Usage: robos-profile create NAME [--role ROLE] [--model MODEL]" >&2
      exit 1
    fi
    shift
    ROLE="Autonomous Review Agent"
    MODEL="claude-sonnet-4-20250514"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --role) ROLE="$2"; shift 2 ;;
        --model) MODEL="$2"; shift 2 ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
      esac
    done
    send_sock "{\"command\":\"create\", \"name\":\"$NAME\", \"options\":{\"role\":\"$ROLE\", \"model\":\"$MODEL\"}}"
    ;;
  list)
    send_sock "{\"command\":\"list\"}"
    ;;
  inspect)
    NAME="${1:-}"
    if [ -z "$NAME" ]; then
      echo "Error: Profile name required" >&2
      exit 1
    fi
    send_sock "{\"command\":\"inspect\", \"name\":\"$NAME\"}"
    ;;
  terminate)
    NAME="${1:-}"
    if [ -z "$NAME" ]; then
      echo "Error: Profile name required" >&2
      exit 1
    fi
    send_sock "{\"command\":\"terminate\", \"name\":\"$NAME\"}"
    ;;
  *)
    echo "Unknown command: $CMD" >&2
    echo "Run 'robos-profile --help' for usage" >&2
    exit 1
    ;;
esac
