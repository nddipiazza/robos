            ],
            "attacked": [
              {
                "text": "Mr. Speaker, I've got a problem!",
                "audio": "res://assets/audio/heroes/bernie_react_1.ogg"
              },
              {
                "text": "Grows wider!",
                "audio": "res://assets/audio/heroes/bernie_react_2.ogg"
              },
              {
                "text": "Who are hungry!",
                "audio": "res://assets/audio/heroes/bernie_react_3.ogg"
