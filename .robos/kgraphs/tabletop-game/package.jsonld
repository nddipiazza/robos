          "robos:spells": [
            {
              "id": "urn:robos:tabletop:spell:water-of-healing",
              "slug": "water-of-healing",
              "name": "Water of Healing",
              "element": "water",
              "category": "Base Game",
              "icon": "\ud83d\udca7",
              "description": "Restores up to 4 lost Body Points to any Hero.",
              "effect": "heal-bp",
