[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Camera Watch
Comment=Watch and record the IP cameras on your network, with motion detection
Exec=/usr/bin/electron /usr/local/share/robos/camera-watch/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/camera-watch/icon.svg
Terminal=false
Categories=AudioVideo;Video;Security;
X-RobOS-Category=Security
StartupWMClass=robos-camera-watch
