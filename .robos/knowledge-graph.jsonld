              "agentPrompt": "Run python3 ~/Downloads/ff1/build_ff1_godot_game.py followed by godot4 --headless --path ~/Downloads/ff1/ff1-game --import and confirm all scenes and textures import cleanly.",
              "explain": "build_ff1_godot_game.py writes project.godot, data/v1/milestones.json, and all GDScript controllers; godot4 --import compiles the PNG textures into .godot/imported/*.ctex.",
