        }
      }
    },
    {
      "@id": "urn:robos:crpg:event:evt-martyr-sacrifice",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:description": "Interposing yourself to shield Gorion from Sarevok lethal spear thrust.",
      "dcterms:title": "The Martyr's Sacrifice",
      "robos:eventType": "cutscene",
      "robos:infinityInteraction": {
        "robos:bcsAction": "SetGlobal(\"sacrificed_for_gorion\", \"GLOBAL\", 1)\nKill(Player1)\nStartCutScene(\"CutSacrifice\")",
        "robos:bcsTrigger": "Range(\"sarevok\", 5) && HP(\"gorion\", 1)",
        "robos:cutsceneRef": "CutSacrifice",
        "robos:dialogueMachine": "urn:robos:infinity:subsystem:dialogue-state-machine",
        "robos:interactionType": "cutscene_trigger",
        "robos:journalEntry": "Gave my mortal life to save Gorion; the prophecy is broken by selflessness.",
        "robos:scriptVm": "urn:robos:infinity:subsystem:bcs-script-vm"
      },
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:stateMutations": {
        "setFlags": {
          "sacrificed_for_gorion": true
        }
      }
    },
    {
      "@id": "urn:robos:crpg:event:evt-sanctuary-cutthroats-slain",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:description": "Defeating the two assassins lying in ambush within the darkened Candlekeep storehouse.",
      "dcterms:title": "Cutthroats Shank & Carbos Slain",
