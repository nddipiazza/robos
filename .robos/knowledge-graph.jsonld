      "robos:domainStandard": "https://cucumber.io/docs/gherkin/reference/#scenario-outline",
      "robos:examplesTable": "urn:robos:examples:checkout-loyalty-tiers",
      "robos:inFeature": "urn:robos:gherkin:checkout-cart-validation",
