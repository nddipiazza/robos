[Desktop Entry]
Version=1.0
X-RobOS-Category=RobOS Dev
X-RobOS-App=true
Name=RobOS Task Servers
Comment=Configure Jira and GitHub Issues connections
Exec=/usr/bin/electron /usr/local/share/robos/task-servers/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/task-servers/icon.svg
Terminal=false
Type=Application
Categories=Development;
StartupWMClass=task-servers
