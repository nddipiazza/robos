  # Plank autostart — skipped for now, add later

  # ── robos-topbar: custom GNOME extension (hides Activities, clock→right, workspaces→left)
  - path: /etc/skel/.local/share/gnome-shell/extensions/robos-topbar@robos/metadata.json
    permissions: '0644'
    content: |
      {
        "name": "RobOS Top Bar",
        "description": "Hides Activities, moves clock to right, workspace selector to left",
        "uuid": "robos-topbar@robos",
        "shell-version": ["42"],
        "version": 1
      }

  - path: /etc/skel/.local/share/gnome-shell/extensions/robos-topbar@robos/extension.js
    permissions: '0644'
    content: |
      const Main = imports.ui.main;

      let _activitiesHidden = false;
      let _clockMoved = false;
      let _wsMoved = false;
      let _appMenuHidden = false;

      function init() {}

      function enable() {
          let activities = Main.panel.statusArea.activities;
          if (activities) {
              activities.container.hide();
              _activitiesHidden = true;
          }

          let appMenu = Main.panel.statusArea.appMenu;
          if (appMenu) {
              appMenu.container.hide();
              _appMenuHidden = true;
          }

          let dateMenu = Main.panel.statusArea.dateMenu;
          if (dateMenu && Main.panel._centerBox.contains(dateMenu.container)) {
              Main.panel._centerBox.remove_actor(dateMenu.container);
              Main.panel._rightBox.insert_child_at_index(dateMenu.container, 0);
              _clockMoved = true;
          }

          let wsIndicator = Main.panel.statusArea['workspace-indicator'];
          if (wsIndicator && Main.panel._rightBox.contains(wsIndicator.container)) {
              Main.panel._rightBox.remove_actor(wsIndicator.container);
              Main.panel._leftBox.add_actor(wsIndicator.container);
              _wsMoved = true;
          }
      }

      function disable() {
          let activities = Main.panel.statusArea.activities;
          if (_activitiesHidden && activities)
              activities.container.show();

          let appMenu = Main.panel.statusArea.appMenu;
          if (_appMenuHidden && appMenu)
              appMenu.container.show();

          let dateMenu = Main.panel.statusArea.dateMenu;
          if (_clockMoved && dateMenu && Main.panel._rightBox.contains(dateMenu.container)) {
              Main.panel._rightBox.remove_actor(dateMenu.container);
              Main.panel._centerBox.add_actor(dateMenu.container);
          }

          let wsIndicator = Main.panel.statusArea['workspace-indicator'];
          if (_wsMoved && wsIndicator && Main.panel._leftBox.contains(wsIndicator.container)) {
              Main.panel._leftBox.remove_actor(wsIndicator.container);
              Main.panel._rightBox.add_actor(wsIndicator.container);
          }

          _activitiesHidden = false;
          _appMenuHidden = false;
          _clockMoved = false;
          _wsMoved = false;
      }

  # ── dash-to-panel dconf settings ────────────────────────────────────────────
  - path: /etc/dconf/db/local.d/03-robos-panel
    permissions: '0644'
    content: |
      [org/gnome/shell/extensions/dash-to-panel]
      stockgs-keep-top-panel=true
      panel-positions='{"0":"BOTTOM"}'
      panel-sizes='{"0":32}'
      appicon-margin=4
      dot-position='BOTTOM'
      panel-element-positions='{"0":[{"element":"showAppsButton","visible":true,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"stackedTL"},{"element":"centerBox","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":false,"position":"stackedBR"},{"element":"rightBox","visible":false,"position":"stackedBR"},{"element":"dateMenu","visible":false,"position":"stackedBR"},{"element":"systemMenu","visible":false,"position":"stackedBR"},{"element":"desktopButton","visible":false,"position":"stackedBR"}]}'

  # ── dconf locks: prevent stale user-db values from overriding panel config ───
  - path: /etc/dconf/db/local.d/locks/robos-panel.txt
    permissions: '0644'
    content: |
      /org/gnome/shell/extensions/dash-to-panel/panel-element-positions
      /org/gnome/shell/extensions/dash-to-panel/panel-positions
      /org/gnome/shell/extensions/dash-to-panel/panel-sizes
      /org/gnome/shell/extensions/dash-to-panel/stockgs-keep-top-panel

# ── Run commands ──────────────────────────────────────────────────────────────
runcmd:
  # Set password
  - echo 'robos:robos' | chpasswd

  # Start the Python progress splash on tty1
  - chvt 1
  - python3 /usr/local/share/robos/install_splash.py >/dev/tty1 2>&1 &
  - echo $! > /tmp/robos-splash-pid

  # ── Install GNOME + dash-to-panel + Chrome ────────────────────────────────
  - echo "Installing GNOME desktop" > /tmp/robos-install-status
  - echo "1" >> /tmp/robos-install-status
  - DEBIAN_FRONTEND=noninteractive apt-get install -y --fix-missing -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" ubuntu-desktop-minimal gdm3 gnome-tweaks dconf-cli gnome-shell-extensions 2>&1 | tee /tmp/gnome-install.log | tail -3
  - DEBIAN_FRONTEND=noninteractive apt-get install -f -y 2>&1 | tail -3

  # ── Developer build tools ─────────────────────────────────────────────────
  - echo "Installing build tools" > /tmp/robos-install-status
  - echo "2" >> /tmp/robos-install-status
  - DEBIAN_FRONTEND=noninteractive apt-get install -y --fix-missing
    build-essential gcc g++ clang llvm
    cmake cmake-curses-gui ninja-build
    make automake autoconf autotools-dev libtool pkg-config
    meson
    git git-lfs
    gdb valgrind strace ltrace
    python3-dev python3-venv python3-pip
    libssl-dev libffi-dev zlib1g-dev
    jq curl wget unzip zip
    2>&1 | tail -5
  - echo "Installing Google Chrome" > /tmp/robos-install-status
  - echo "3" >> /tmp/robos-install-status
  - wget -qO /tmp/google-chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
  - DEBIAN_FRONTEND=noninteractive apt-get install -y /tmp/google-chrome.deb
  - rm -f /tmp/google-chrome.deb

  # ── dash-to-panel v56 (last GNOME 42 compatible release) ─────────────────
  - echo "Installing dash-to-panel" > /tmp/robos-install-status
  - echo "3" >> /tmp/robos-install-status
  - |
    set -e
    DTP_DIR=/usr/share/gnome-shell/extensions/dash-to-panel@jderose9.github.com
    mkdir -p "$DTP_DIR"
    wget -qO /tmp/dtp.zip "https://github.com/home-sweet-gnome/dash-to-panel/releases/download/v56/dash-to-panel%40jderose9.github.com_v56.zip"
    unzip -qo /tmp/dtp.zip -d "$DTP_DIR"
    rm -f /tmp/dtp.zip
    # Compile schemas system-wide
    cp "$DTP_DIR/schemas/org.gnome.shell.extensions.dash-to-panel.gschema.xml" /usr/share/glib-2.0/schemas/
    glib-compile-schemas /usr/share/glib-2.0/schemas/
    # Patch 1 — null guard for _signalsHandler (race with ubuntu-dock)
    sed -i 's/this\._signalsHandler\.destroy();/if (this._signalsHandler) { this._signalsHandler.destroy(); }/' "$DTP_DIR/panelManager.js"
    # Patch 2 — _initialized flag to prevent re-entrant disable() crash
    python3 - <<'PYEOF'
    import pathlib
    f = pathlib.Path('/usr/share/gnome-shell/extensions/dash-to-panel@jderose9.github.com/extension.js')
    src = f.read_text()
    src = src.replace('panelManager.enable(Me);', '_initialized = false;\n        panelManager.enable(Me);\n        _initialized = true;')
    src = src.replace('disable(true);', 'if (_initialized) { disable(true); }')
    f.write_text(src)
    print('extension.js patched')
    PYEOF
    # Copy to skel for future users
    mkdir -p /etc/skel/.local/share/gnome-shell/extensions
    cp -r "$DTP_DIR" /etc/skel/.local/share/gnome-shell/extensions/
    # Also copy robos-topbar to robos home (skel copy happens after this block)
    mkdir -p /usr/share/gnome-shell/extensions/robos-topbar@robos
    cp /etc/skel/.local/share/gnome-shell/extensions/robos-topbar@robos/* /usr/share/gnome-shell/extensions/robos-topbar@robos/ 2>/dev/null || true

  # ── pass-manager: install Node app ──────────────────────────────────────
  - echo "Installing pass-manager" > /tmp/robos-install-status
  - echo "5" >> /tmp/robos-install-status
  - DEBIAN_FRONTEND=noninteractive apt-get install -y -q pass gnupg pinentry-gtk2 nodejs 2>&1 | tail -3
  - |
    set -e
    mkdir -p /usr/local/share/robos/pass-manager
    # Copy source from write_files-placed location (will be written by write_files above)
    # Install npm deps
    cd /usr/local/share/robos/pass-manager
    npm install --silent 2>&1 | tail -3
    chmod +x /usr/local/share/robos/pass-manager/pass-manager.sh
    cp /usr/local/share/robos/pass-manager/pass-manager.desktop /usr/share/applications/
    update-desktop-database 2>/dev/null || true

  # ── GPG key + pass store init for robos user ─────────────────────────────
  - echo "Initialising password store" > /tmp/robos-install-status
  - echo "6" >> /tmp/robos-install-status
  - |
    set -e
    # Run as robos (su -c runs in a login shell with correct HOME)
    su - robos -c '
      gpg --batch --gen-key <<GPGEOF
%no-protection
Key-Type: RSA
Key-Length: 4096
Subkey-Type: RSA
Subkey-Length: 4096
Name-Real: RobOS User
Name-Email: robos@localhost
Expire-Date: 0
%commit
GPGEOF
      pass init robos@localhost
      echo "Pass store initialized"
    '

  - echo "Configuring display manager" > /tmp/robos-install-status
  - echo "7" >> /tmp/robos-install-status
  - mkdir -p /etc/gdm3
  - printf '[daemon]\nAutomaticLoginEnable=true\nAutomaticLogin=robos\nWaylandEnable=false\n' > /etc/gdm3/custom.conf
  - chmod 644 /etc/gdm3/custom.conf
  - echo "/usr/sbin/gdm3" > /etc/X11/default-display-manager
  - systemctl daemon-reload
  - systemctl set-default graphical.target

  # ── dconf: compile system database so defaults apply at first login ───────
  - mkdir -p /etc/dconf/db/local.d/locks
  - dconf update

  # ── Copy skel to robos home + fix permissions ──────────────────────────────
  - mkdir -p /etc/skel/.config/gtk-3.0 /etc/skel/.config/gtk-4.0 /etc/skel/.config/autostart
  - cp -rn /etc/skel/. /home/robos/
  - chown -R robos:robos /home/robos

  # Fix .ssh permissions
  - mkdir -p /home/robos/.ssh
  - chmod 755 /home/robos
  - chmod 700 /home/robos/.ssh
  - chmod 600 /home/robos/.ssh/authorized_keys
  - chown -R robos:robos /home/robos/.ssh

  # Done
  - echo "Finalising" > /tmp/robos-install-status
  - echo "8" >> /tmp/robos-install-status
  - touch /tmp/robos-install-done
  - PID=$(cat /tmp/robos-splash-pid 2>/dev/null); [ -n "$PID" ] && kill "$PID" 2>/dev/null || true
  - echo "RobOS GNOME cloud-init complete"

# Auto-reboot so GDM3 starts fresh
power_state:
  mode: reboot
  delay: "+1"
  message: "RobOS first-boot complete — rebooting into GNOME desktop"

