[Desktop Entry]
Type=Application
Name=RobOS Setup Wizard
Comment=Unified Setup Assistant & AI Project Provisioner
Exec=/usr/bin/electron /usr/local/share/robos/robos-onboarding/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=security-setup
Terminal=false
Categories=Development;Security;System;
X-RobOS-App=true
X-RobOS-Category=Security
StartupWMClass=robos-onboarding
