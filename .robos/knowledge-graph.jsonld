    {
      "@id": "urn:robos:search:elasticsearch-telemetry-index",
      "@type": [
        "oslc_am:Resource",
        "robos:SearchIndex",
        "schema:DataStore"
      ],
      "dcterms:description": "Production Elasticsearch cluster index housing distributed traces, APM metrics, and microservice logs.",
      "dcterms:title": "Elasticsearch Observability & Telemetry Index",
