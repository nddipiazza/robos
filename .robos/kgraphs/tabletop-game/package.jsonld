          "inventory": [
            {
              "effect": "Restores up to 4 BP",
              "id": "item-pot-heal-obama",
              "name": "Potion of Executive Vigor",
              "type": "potion",
              "value": 100
            },
            {
              "effect": "+1 Mind resistance vs Spin Doctors",
              "id": "item-mic-drop-1",
              "name": "Runic Teleprompter Shard",
              "type": "relic",
              "value": 50
            }
          ],
          "mindPoints": 2,
          "name": "Barack Obama",
          "portraitAsset": "assets/portraits/card_bg_obama.png",
          "robos:attackDice": 4,
          "robos:audioLines": {
            "attacked": [
              {
                "audio": "res://assets/audio/heroes/obama_quote_1.ogg",
                "text": "Uhh... let me be clear... When you roll the dice... in this dungeon... you are not merely rolling plastic... you are rolling... the audacity... of hope."
              },
              {
                "audio": "res://assets/audio/heroes/obama_quote_2.ogg",
                "text": "Uhh... folks... Michelle and I... were talking just the other day... about how even in a dark corridor... filled with goblins... hope... always finds a way."
              },
              {
                "audio": "res://assets/audio/heroes/obama_quote_3.ogg",
                "text": "Uhh... make no mistake... The arc of the moral dungeon... is long... but it bends... toward hope... and... uhh... a modest middle-class tax cut."
              },
              {
                "audio": "res://assets/audio/heroes/obama_quote_4.ogg",
                "text": "Uhh... look... we can disagree... without being disagreeable... even when a two-headed hydra... is trying... to bite your head off... with hope."
              },
              {
                "audio": "res://assets/audio/heroes/obama_quote_5.ogg",
                "text": "Uhh... let me say this... Change does not roll in... on the wheels of inevitability... It rolls in... on two red six-sided dice... of hope."
              },
              {
                "audio": "res://assets/audio/heroes/obama_quote_6.ogg",
                "text": "Uhh... there is not a liberal dungeon... and a conservative dungeon... There is the United Dungeon... of America... and... uhh... we are lost in it."
              },
              {
                "audio": "res://assets/audio/heroes/obama_quote_7.ogg",
                "text": "Uhh... yes we can... step onto this next stone square... with the fierce urgency... of now... and the quiet dignity... of hope."
              },
              {
                "audio": "res://assets/audio/heroes/obama_quote_8.ogg",
                "text": "Uhh... if you like your broadsword... you can keep... your broadsword... Period... Full stop... Because that... is the promise... of hope."
              }
            ],
