#!/bin/bash
# Passthrough git that reports the GitHub-looking URL for `remote get-url origin`
# (RobOS requires a github.com origin) while every other command, including
# ls-remote and push, runs against the real local bare remote.
for a in "$@"; do
  if [ "$a" = "get-url" ]; then
    for b in "$@"; do
      if [ "$b" = "origin" ]; then echo "git@github.com:acme-corp/pawfinder-api.git"; exit 0; fi
    done
  fi
done
exec /usr/bin/git "$@"
