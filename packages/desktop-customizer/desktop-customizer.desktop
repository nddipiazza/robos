[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Desktop Customizer
Comment=Prompt-driven desktop customization — reshape GNOME with natural language
Exec=/usr/bin/electron /usr/local/share/robos/desktop-customizer/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/desktop-customizer/icon.svg
Terminal=false
Categories=System;
X-RobOS-Category=System
StartupWMClass=desktop-customizer
