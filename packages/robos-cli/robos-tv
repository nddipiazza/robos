#!/usr/bin/env node
'use strict';

/**
 * robos-tv — CLI tool to control Smart TVs (Roku TV, Android TV, LG webOS, Samsung Tizen) in RobOS
 *
 * Usage:
 *   robos-tv status [--ip <tv-ip>]
 *   robos-tv check [--ip <tv-ip>]
 *   robos-tv on [--ip <tv-ip>]
 *   robos-tv off [--ip <tv-ip>]
 *   robos-tv key <Up|Down|Left|Right|Select|Home|Back|VolumeUp|VolumeDown|VolumeMute> [--ip <tv-ip>]
 *   robos-tv launch <appId|ps5|youtube|netflix|plex> [--ip <tv-ip>]
 *   robos-tv list
 *
 * Without --ip, the TV comes from ROBOS_TV_IP, then the first Roku TV saved in RobOS Smart TV.
 * The Tablo commands use --ip, then ROBOS_TABLO_IP, then the Tablo address saved in RobOS Smart TV.
 */

const http = require('node:http');
const { createTvEngine, TV_PLATFORMS } = require('../robos-lib/tv-engine');

const ROKU_SHORTCUT_APPS = {
  ps5: 'tvinput.hdmi2',
  playstation: 'tvinput.hdmi2',
  hdmi1: 'tvinput.hdmi1',
  hdmi2: 'tvinput.hdmi2',
  hdmi3: 'tvinput.hdmi3',
  youtube: '837',
  youtubetv: '195316',
  netflix: '12',
  plex: '13535',
  prime: '13',
  disney: '291097',
  hulu: '2285',
  max: '61322',
  spotify: '22297',
  espn: '34376',
  appletv: '551012',
};

function postEcp(ip, endpoint) {
  return new Promise((resolve, reject) => {
    const req = http.request(
      {
        hostname: ip,
        port: 8060,
        path: endpoint,
        method: 'POST',
        timeout: 2500,
      },
      (res) => {
        res.resume();
        resolve(res.statusCode);
      }
    );
    req.on('error', reject);
    req.on('timeout', () => {
      req.destroy();
      reject(new Error('Request timed out'));
    });
    req.end();
  });
}

function printRokuBlockedHelp(ip, ecpMode, httpStatus) {
  const rokuSteps = TV_PLATFORMS.find((p) => p.id === 'roku-os')?.requiredPermissions?.[0]?.steps || [];
  console.error(`\n⚠️  ROKU TV REMOTE CONTROL BLOCKED ON ${ip}`);
  console.error(`   Reported Mode : <ecp-setting-mode>${ecpMode || 'limited'}</ecp-setting-mode> (HTTP ${httpStatus || 403})`);
  console.error(`   Why           : "Control by mobile apps -> Network access" is disabled or set to Default/Limited.`);
  console.error(`\n   How to enable on your physical Roku remote:`);
  rokuSteps.forEach((step, idx) => {
    console.error(`     ${idx + 1}. ${step}`);
  });
  console.error('');
}

function requireIp(ip, message) {
  if (ip) return ip;
  console.error(message);
  process.exit(1);
}

async function main() {
  const args = process.argv.slice(2);
  const cmd = (args[0] || 'status').toLowerCase();
  const ipIdx = args.indexOf('--ip');
  const ipArg = ipIdx >= 0 && args[ipIdx + 1] ? args[ipIdx + 1] : '';

  const engine = createTvEngine();
  const saved = engine.getSavedDevices();
  const defaultRokuIp = process.env.ROBOS_TV_IP || saved.tvs.find((tv) => tv.platformId === 'roku-os')?.ip || '';
  const rokuIp = () =>
    requireIp(ipArg || defaultRokuIp, 'No Roku TV set up. Pass --ip <tv-ip>, set ROBOS_TV_IP, or pair a TV in RobOS Smart TV.');
  const tabloAddress = () =>
    requireIp(ipArg || saved.tabloIp, 'No Tablo DVR set up. Pass --ip <tablo-ip>, set ROBOS_TABLO_IP, or save it in RobOS Smart TV.');

  if (cmd === 'list') {
    if (!saved.tvs.length) console.log('No TVs paired yet.');
    for (const tv of saved.tvs) {
      console.log(`${tv.name} — ${tv.ip} (${tv.model})`);
    }
    return;
  }

  if (cmd === 'tablo' || cmd === 'recordings') {
    const tabloIp = tabloAddress();
    const ov = await engine.getTabloOverview({ ip: tabloIp });
    if (!ov.ok) {
      console.error(`Could not connect to Tablo at ${tabloIp}: ${ov.error}`);
      process.exit(1);
    }
    console.log(`Tablo: ${ov.status.model?.name || ov.status.name} (${ov.status.serverId}) @ ${ov.ip}:${ov.port}`);
    if (ov.status.harddrives?.[0]) {
      const hd = ov.status.harddrives[0];
      console.log(`Drive: ${hd.name} — ${Math.round((hd.usage || 0) / 1e9)} GB used / ${Math.round((hd.free || 0) / 1e9)} GB free`);
    }
    console.log(`\nRecordings (${ov.recordings.length}):`);
    for (const r of ov.recordings) {
      console.log(`  [${r.id}] ${r.fullTitle} | ${r.channel?.label || ''} | ${r.durationFormatted} | ${r.sizeFormatted} | ${r.path}`);
    }
    return;
  }

  if (cmd === 'cast-tablo' || cmd === 'roku-tablo') {
    const tabloIp = tabloAddress();
    const res = await engine.castTabloToTv({ ip: tabloIp });
    console.log(JSON.stringify(res, null, 2));
    return;
  }

  if (cmd === 'watch') {
    const query = args[1] || '';
    const tabloIp = tabloAddress();
    const ov = await engine.getTabloOverview({ ip: tabloIp });
    const match =
      ov.recordings.find((r) => String(r.id) === query || r.path === query || r.fullTitle.toLowerCase().includes(query.toLowerCase())) ||
      ov.recordings[0];
    if (!match) {
      console.error('No matching Tablo recording found.');
      process.exit(1);
    }
    const res = await engine.openTabloExternal({ ip: tabloIp, itemPath: match.path, title: match.fullTitle });
    console.log(JSON.stringify(res, null, 2));
    return;
  }

  if (cmd === 'status' || cmd === 'check') {
    const ip = rokuIp();
    const st = await engine.queryRokuPowerMode(ip);
    console.log(JSON.stringify(st, null, 2));
    if (st.ok && !st.ecpAllowed) {
      printRokuBlockedHelp(ip, st.ecpMode, 403);
      process.exitCode = 2;
    }
    return;
  }

  if (cmd === 'on' || cmd === 'poweron' || cmd === 'off' || cmd === 'poweroff') {
    const action = cmd.includes('off') ? 'off' : 'on';
    const ip = rokuIp();
    const info = await engine.queryRokuPowerMode(ip);
    if (info.ok && !info.ecpAllowed) {
      printRokuBlockedHelp(ip, info.ecpMode, 403);
      process.exit(2);
    }
    const status = await postEcp(ip, `/keypress/${action === 'off' ? 'PowerOff' : 'PowerOn'}`);
    if (status === 403 || status === 401) {
      printRokuBlockedHelp(ip, info.ecpMode, status);
      process.exit(2);
    }
    const after = await engine.queryRokuPowerMode(ip);
    console.log(JSON.stringify({ ...after, action, httpStatus: status }, null, 2));
    return;
  }

  if (cmd === 'key') {
    const keyName = args[1] || 'Home';
    const ip = rokuIp();
    const info = await engine.queryRokuPowerMode(ip);
    if (info.ok && !info.ecpAllowed) {
      printRokuBlockedHelp(ip, info.ecpMode, 403);
      process.exit(2);
    }
    const status = await postEcp(ip, `/keypress/${encodeURIComponent(keyName)}`);
    if (status === 403 || status === 401) {
      printRokuBlockedHelp(ip, info.ecpMode, status);
      process.exit(2);
    }
    console.log(JSON.stringify({ ok: true, ip, key: keyName, httpStatus: status }));
    return;
  }

  if (cmd === 'launch') {
    const rawApp = (args[1] || 'Home').toLowerCase();
    const appId = ROKU_SHORTCUT_APPS[rawApp] || args[1];
    const ip = rokuIp();
    const info = await engine.queryRokuPowerMode(ip);
    if (info.ok && !info.ecpAllowed) {
      printRokuBlockedHelp(ip, info.ecpMode, 403);
      process.exit(2);
    }
    const status = await postEcp(ip, `/launch/${encodeURIComponent(appId)}`);
    if (status === 403 || status === 401) {
      printRokuBlockedHelp(ip, info.ecpMode, status);
      process.exit(2);
    }
    console.log(JSON.stringify({ ok: true, ip, launchedAppId: appId, httpStatus: status }));
    return;
  }

  console.log(`Usage:
  robos-tv on [--ip <tv-ip>]
  robos-tv off [--ip <tv-ip>]
  robos-tv status [--ip <tv-ip>]
  robos-tv check [--ip <tv-ip>]
  robos-tv key <Up|Down|Left|Right|Select|Home|Back|VolumeUp|VolumeDown|VolumeMute>
  robos-tv launch <ps5|youtube|netflix|plex|disney|hulu|max|spotify|appId>
  robos-tv list
  robos-tv recordings [--ip <tablo-ip>]
  robos-tv watch <recordingId|title> [--ip <tablo-ip>]

Without --ip, the TV comes from ROBOS_TV_IP, then the first Roku TV saved in RobOS Smart TV.`);
}

main().catch((err) => {
  console.error(err.message);
  process.exit(1);
});
