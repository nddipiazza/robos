[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Messaging
Comment=One inbox for Messenger, Instagram, Snapchat, Signal and SMS
Exec=/usr/bin/electron /usr/local/share/robos/messaging/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/messaging/icon.svg
Terminal=false
Categories=Network;InstantMessaging;
X-RobOS-Category=Internet
StartupWMClass=robos-messaging
