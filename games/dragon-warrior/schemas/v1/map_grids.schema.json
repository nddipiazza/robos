{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dragonwarrior.org/schemas/v1/map_grids.schema.json",
  "title": "MapGridsDataStoreV1",
  "description": "Schema for 2D tile matrix maps for Dragon Warrior overworld, towns, castles, and dungeons.",
  "type": "object",
  "properties": {
    "tile_size": {
      "type": "integer",
      "const": 16,
      "description": "Tile width and height in pixels (NES 16x16 standard)."
    },
    "total_unique_tiles": {
      "type": "integer",
      "minimum": 1
    },
    "maps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "rows": { "type": "integer", "minimum": 1 },
          "cols": { "type": "integer", "minimum": 1 },
          "grid": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "required": ["rows", "cols", "grid"]
      }
    }
  },
  "required": ["tile_size", "maps"]
}
