{
  "@context": {
    "oslc": "http://open-services.net/ns/core#",
    "oslc_am": "http://open-services.net/ns/am#",
    "oslc_cm": "http://open-services.net/ns/cm#",
    "oslc_rm": "http://open-services.net/ns/rm#",
    "oslc_qm": "http://open-services.net/ns/qm#",
    "robos": "https://robos.dev/ns/sdlc#",
    "c4": "https://c4model.com/ns#",
    "dcterms": "http://purl.org/dc/terms/",
    "schema": "https://schema.org/"
  },
  "@id": "urn:robos:package:organization",
  "@type": [
    "oslc:ServiceProvider",
    "robos:Package"
  ],
  "robos:package": "organization",
  "robos:namespace": "robos.org",
  "robos:version": "1.0.0",
  "dcterms:title": "Enterprise Organization, Teams & Personas",
  "dcterms:description": "People, developer profiles, team topologies, and cross-team communication channels.",
  "robos:nodes": [
