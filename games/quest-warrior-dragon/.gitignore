# ==========================================
# Godot 4+ Specific Ignores
# ==========================================
# Godot 4 stores all internal caches, imported assets, 
# and local editor settings inside this directory.
.godot/

# Prevents mobile OS gallery tools from indexing project images
.nomedia

# Godot 4.2+ specific ignores (internal Windows library handling)
~*.dll

# ==========================================
# Godot 3 Legacy Caches & Generated Asset Imports
# ==========================================
.import/
*.import

# ==========================================
# Build & Export Outputs
# ==========================================
# It is best practice to keep your final game exports out of Git.
# If you export your game into a folder named "builds", this ignores it.
builds/
export_credentials.cfg

# Keep export presets under source control *unless* they contain passwords.
# Remove the '#' below if you want to completely hide your export configs.
# export_presets.cfg

# ==========================================
# Localization & Temporary Files
# ==========================================
# Automatically re-generated by the engine from source CSVs.
*.translation
*.tmp

# Cucumber E2E Reports & Video Captures (.mp4)
tests/e2e/reports/
*.mp4
*.log
/tests/e2e/reports/

