// The apps in the RobOS phone image. The APKs are built by infra/android/robos-image.sh.
soong_namespace {}

android_app_import {
    name: "RobOSHome",
    apk: "prebuilt/RobOSHome.apk",
    certificate: "testkey",
    product_specific: true,
    dex_preopt: {
        enabled: true,
    },
    // AndroidX lists these in the manifest as optional. The build must declare the same list.
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    // RobOS Home replaces the stock home screen. The other LineageOS apps stay and show on RobOS Home.
    overrides: [
        "Launcher3QuickStep",
        "Launcher3QuickStepGo",
        "Launcher3Overlay",
        // It would replace RobOS with stock LineageOS on its next update.
        "Updater",
    ],
}

android_app_import {
    name: "RobOSSmartHome",
    apk: "prebuilt/RobOSSmartHome.apk",
    certificate: "testkey",
    product_specific: true,
    dex_preopt: {
        enabled: true,
    },
    // AndroidX lists these in the manifest as optional. The build must declare the same list.
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
}
