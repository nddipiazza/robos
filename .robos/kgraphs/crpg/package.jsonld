  ],
  "dcterms:description": "Early Access vertical slice template: 'A Night Without Memory'. Complete party-based cRPG ontology, 3-map progression, D&D 5e SRD entities, Flare RPG asset bindings, and terminal win state.",
  "dcterms:title": "cRPG Game & D&D Rules Engine Package",
  "robos:namespace": "robos.crpg",
