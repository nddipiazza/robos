[Desktop Entry]
Name=MCP Manager
Comment=Discover, Configure, and Test RobOS Model Context Protocol Servers
Exec=electron /usr/local/share/robos/mcp-manager --no-sandbox --disable-gpu --disable-dev-shm-usage
