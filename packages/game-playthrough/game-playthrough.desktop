[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Game Playthrough
GenericName=Game Playthrough
Comment=Run and watch the Quest: Warrior Dragon end-to-end AI playthrough with per-milestone videos, checkpoints and run history
Exec=/usr/bin/electron /usr/local/share/robos/game-playthrough/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/game-playthrough/icon.svg
Terminal=false
Categories=Development;Game;
Keywords=robos;game;playthrough;e2e;test;ai;quest;warrior;dragon;milestones;video;
X-RobOS-Category=Games
StartupWMClass=robos-game-playthrough
StartupNotify=true
