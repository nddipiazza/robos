[Desktop Entry]
Version=1.0
X-RobOS-Category=RobOS System
X-RobOS-App=true
Name=RobOS Preferences
Comment=System-wide settings for AI providers, IDE, notifications, and theme
Exec=/usr/bin/electron /usr/local/share/robos/robos-preferences/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/robos-preferences/icon.svg
Terminal=false
Type=Application
Categories=System;Settings;
StartupWMClass=robos-preferences
