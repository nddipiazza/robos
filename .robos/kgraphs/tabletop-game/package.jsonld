          "mindPoints": 4,
          "name": "Hillary Clinton",
          "portraitAsset": "assets/portraits/card_bg_hillary_clinton.png",
          "robos:attackDice": 3,
          "robos:audioLines": {
            "attacked": [
              {
                "audio": "res://assets/audio/heroes/hillary_quote_1.ogg",
                "text": "Saddam Hussein will continue to increase his capacity to wage biological and chemical warfare!"
              },
              {
                "audio": "res://assets/audio/heroes/hillary_quote_2.ogg",
                "text": "We came, we saw, he died! Ha ha ha!"
              },
              {
                "audio": "res://assets/audio/heroes/hillary_quote_3.ogg",
                "text": "What difference, at this point, does it make?!"
              },
              {
                "audio": "res://assets/audio/heroes/hillary_quote_4.ogg",
                "text": "As a shareholder and director of our company, I'm always proud of Walmart and what we do, and the way we do it better than anybody else!"
              },
              {
                "audio": "res://assets/audio/heroes/hillary_quote_5.ogg",
                "text": "Using clean renewable energy as the key into coal country — because we're going to put a lot of coal miners and coal companies out of business!"
              },
              {
                "audio": "res://assets/audio/heroes/hillary_quote_6.ogg",
                "text": "Don't let anybody tell you that it's corporations and businesses that create jobs! If you've got a business, you didn't build that!"
              },
              {
                "audio": "res://assets/audio/heroes/hillary_quote_7.ogg",
                "text": "We came out of the White House not only dead broke, but in debt! We had no money when we got there, and we struggled!"
              },
              {
                "audio": "res://assets/audio/heroes/hillary_quote_8.ogg",
                "text": "They're children of the Great Recession and they are living in their parents' basement... No conscience, no empathy — first we have to bring them to heel!"
              }
            ],
