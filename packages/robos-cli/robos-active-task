#!/usr/bin/env bash
# robos-active-task — get or set the active RobOS task
# Usage:
#   robos-active-task           → print current active task
#   robos-active-task "text"    → set active task
#   robos-active-task --clear   → clear active task

HOME="${HOME:-/home/robos}"
TASK_FILE="$HOME/.config/robos/active-issue"

if [[ $# -eq 0 ]]; then
  if [ -f "$TASK_FILE" ] && [ -s "$TASK_FILE" ]; then
    cat "$TASK_FILE"
  else
    echo "No active task"
  fi
elif [[ "$1" == "--clear" ]]; then
  echo -n > "$TASK_FILE"
  echo "✓ Active task cleared"
else
  mkdir -p "$(dirname "$TASK_FILE")"
  echo "$*" > "$TASK_FILE"
  echo "✓ Active task set to: $*"
fi
