          "quiz": [
            {
              "question": "When adapting harvest_jrpg_assets.py from NES Final Fantasy to another classic JRPG on VGMaps and StrategyWiki (such as Dragon Warrior III or Chrono Trigger), which parameterization avoids rewriting the scraper while preserving deterministic SHA-256 verification?",
              "options": [
                "Scraping the entire VGMaps console directory indiscriminately and filtering downloaded PNGs afterward by checking whether their pixel dimensions are powers of two",
                "Passing --vgmaps-index, --map-prefix, and --wiki-slug into the HTMLParser link-discovery pipeline so it dynamically builds and hashes sources-manifest.json before fetching",
                "Maintaining a per-game hardcoded dictionary of map filenames inside lib/maps.js and matching them against local files by fuzzy Levenshtein distance",
                "Querying the MediaWiki action=parse API for image embeds and relying on StrategyWiki thumbnail URLs as the primary tile-slicing source"
              ],
              "answer": "Passing --vgmaps-index, --map-prefix, and --wiki-slug into the HTMLParser link-discovery pipeline so it dynamically builds and hashes sources-manifest.json before fetching",
              "explanation": "Passing --vgmaps-index, --map-prefix, and --wiki-slug lets HTMLParser discover all matching 1:1 map PNGs and sub-pages dynamically and write sources-manifest.json + download-receipt.json with SHA-256 hashes. StrategyWiki thumbnails are lossy/rescaled, and downloading entire console archives wastes bandwidth and mixes games."
            },
            {
              "question": "During an automated harvest run against retro game archives (VGMaps, Zophar, ReplacementDocs), urllib.request.urlopen(url) fails with HTTP 403 Forbidden or triggers upstream rate-limiting. Which request strategy in harvest_jrpg_assets.py resolves this reliably?",
              "options": [
                "Tunneling requests over HTTP/1.0 without Host headers so legacy Apache mod_security rules treat the client as an archival crawler",
                "Switching to headless Chromium with stealth WebDriver plugins to execute JavaScript challenges before saving each PNG via canvas.toDataURL()",
                "Constructing a urllib.request.Request with a standard desktop browser User-Agent and Accept header, paired with sequential polite delays (--delay 0.5) and existing-file SHA-256 cache skips",
                "Using multi-threaded asyncio.gather() workers with randomized proxy rotation and a 50ms retry backoff across all map URLs simultaneously"
              ],
              "answer": "Constructing a urllib.request.Request with a standard desktop browser User-Agent and Accept header, paired with sequential polite delays (--delay 0.5) and existing-file SHA-256 cache skips",
              "explanation": "Static retro archives reject Python-urllib/3.x default User-Agent strings via simple mod_rewrite/WAF filters rather than JS challenges. Sending a standard browser User-Agent with sequential 0.5s rate limiting and skipping already-verified files avoids both 403 blocks and rate-limit bans."
            },
            {
              "question": "Why does the Browser DevTools Console snippet filter anchor elements with new URL(a.href, location.href).href and a GamePrefix regex before writing sources-manifest.json, rather than exporting document.images directly?",
              "options": [
                "Because document.images only returns SVG vector nodes in Chromium unless the page is scrolled to the bottom first",
                "Because StrategyWiki encrypts <img src> attributes with a session token that expires before Python urllib can download them",
                "Because new URL() automatically converts indexed-color GIFs into 32-bit RGBA PNG buffers inside the browser memory",
                "Because VGMaps index pages link to the full-resolution 1:1 pixel atlas PNGs via <a href=\"...\"> tags, whereas <img> tags on index pages are either absent or point to scaled-down preview thumbnails and UI icons"
              ],
              "answer": "Because VGMaps index pages link to the full-resolution 1:1 pixel atlas PNGs via <a href=\"...\"> tags, whereas <img> tags on index pages are either absent or point to scaled-down preview thumbnails and UI icons",
              "explanation": "On VGMaps and similar retro atlas tables, the full 1024x1024 or 4096x4096 1:1 pixel rips are linked from table <a href=\"...\"> anchors, not inline <img> elements. Resolving a.href via new URL(..., location.href) yields canonical absolute URLs for the unscaled PNGs."
            }
          ]
        },
        {
          "id": "mod-02-jrpg-kgraph-parser-and-gap-matrix",
          "title": "Module 2: Inside robos-jrpg-parser — Quote Verification, Conflict Detection & the Gap Matrix",
          "durationMinutes": 25,
          "overview": "Examine what actually happened when we ran jrpg-parser.js on the StrategyWiki and walkthrough pages: how lib/charts.js caught 220 non-NES equipment rows and 5 price conflicts, how lib/extract.js dropped 4 hallucinated LLM quotes, and why the initial Knowledge Graph still blocked battles, magic, progression, and walking.",
          "lessonHtml": "\n        <div class=\"lesson-section\">\n          <h4 class=\"lesson-subtitle\">1. Why <code>robos-jrpg-parser</code> Splits Table Parsing from AI Prose Extraction</h4>\n          <p class=\"lesson-text\">\n            If you feed a 90-kilobyte HTML page of weapon, armor, and monster tables into an LLM and ask it to output JSON, two bad things happen: it burns thousands of tokens copying numbers that are already structured in HTML <code>&lt;table&gt;</code> tags, and it occasionally substitutes a number from a different port in its training data (for instance, giving a weapon its GBA <em>Dawn of Souls</em> price instead of its 1990 NES price).\n          </p>\n          <p class=\"lesson-text\">\n            For that reason, <code>packages/robos-jrpg-parser</code> divides the work cleanly between two engines:\n          </p>\n          <p class=\"lesson-text\">\n            <strong>Deterministic Table Parsing (<code>lib/charts.js</code>):</strong> Every HTML <code>&lt;table&gt;</code> and Markdown pipe table in the input folder is parsed by deterministic JavaScript code. It inspects column headers to identify weapons, armor, spells, shops, enemies, classes, encounter zones, and treasure chests; filters out rows marked for other editions (our run filtered out <strong>220 equipment rows</strong> that belonged to GBA/PS1/PSP ports); and records any cross-file numeric disagreements in <code>parsed.json</code> under <code>conflicts</code>.\n          </p>\n          <p class=\"lesson-text\">\n            <strong>Quote-Verified AI Prose Extraction (<code>lib/extract.js</code>):</strong> Narrative walkthrough prose—where story milestones, boss triggers, and battle mechanics formulas are explained in English paragraphs—is sent through <code>robos-lib/ai-agent</code>. To prevent the model from inventing lore or pulling memories from remakes, every JSON item returned by the agent must carry a <code>quote</code> field containing the verbatim sentence from the source file. Before accepting any record, <code>lib/extract.js</code> checks whether that exact quote exists in the file's text. If it does not, the record is dropped and logged in the coverage report.\n          </p>\n          <pre class=\"code-snippet\"><code>// Look at the actual Notes printed by:\n// node packages/robos-jrpg-parser/bin/jrpg-parser.js coverage --out /home/ndipiazza/kgraphs/final-fantasy-nes\nNotes:\n  - CLV-P-NAAAE.pdf: PDFs are not read yet.\n  - shop.html: Title names another edition or a mod (\"Killing Chaos before it was cool:\n    Let's Play Dawn of Souls FF1: Mod of Balance! | Talking Time\"), so its stats and prices are not used.\n  - Final Fantasy 1 Walkthrough and stuff....html: dropped 1 agent record(s) whose quote was not in the page.\n  - strategywiki/Final_Fantasy-Items.html: dropped 1 agent record(s) whose quote was not in the page.\n  - strategywiki/Final_Fantasy-Locations.html: dropped 2 agent record(s) whose quote was not in the page.\n  - 5 equipment numbers disagree between sources; see \"conflicts\" in parsed.json.\n  - Left out 220 equipment rows that only pages about other editions list.</code></pre>\n        </div>\n\n        <div class=\"lesson-section\">\n          <h4 class=\"lesson-subtitle\">2. Reviewing the Initial Parse: Why We Still Couldn't Build the Game Yet</h4>\n          <p class=\"lesson-text\">\n            After our first parse of the StrategyWiki pages and the walkthrough HTML, the Knowledge Graph already had 80 weapons and armor pieces, 50 shops, 64 spells, 124 enemies, 12 classes, and 30 story milestones. If you only looked at entity counts, you might think you were ready to generate the Godot game.\n          </p>\n          <p class=\"lesson-text\">\n            When we actually inspected the properties on those nodes, however, we found that <strong>the graph covered what things are and what they cost, but almost nothing of how they fight, where they appear, or how the world connects</strong>:\n          </p>\n          <table style=\"width:100%; border-collapse:collapse; font-size:12px; margin:12px 0;\">\n            <thead>\n              <tr style=\"background:#21262d; color:#f0f6fc;\">\n                <th style=\"padding:8px 10px; border:1px solid #30363d;\">Area</th>\n                <th style=\"padding:8px 10px; border:1px solid #30363d;\">What the Initial Wiki Scrape Had</th>\n                <th style=\"padding:8px 10px; border:1px solid #30363d;\">What Was Missing</th>\n                <th style=\"padding:8px 10px; border:1px solid #30363d;\">Effect on the Game</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>Weapons, armor, shops</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">Stats and prices for 80 pieces, 50 shops</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">5 disputed numbers + Elfland <code>Mythril/Silver Sword</code> name mismatch</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d; color:#3fb950;\"><strong>Ready</strong></td>\n              </tr>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>Battle rules</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">37 formulas, including NES bugs</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">Unconfirmed author attribution &amp; 3 unverified NES quirks</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d; color:#f1e05a;\"><strong>Usable once verified</strong></td>\n              </tr>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>Enemies</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">124 with HP, XP, gold, weakness</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">Attack, defense, accuracy, hits, crit, evade, magic defense, morale, spells</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d; color:#f85149;\"><strong>Blocks battles</strong></td>\n              </tr>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>Encounters</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">Nothing</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">Which enemy groups appear in which overworld sector or dungeon floor</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d; color:#f85149;\"><strong>Blocks battles</strong></td>\n              </tr>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>Classes</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">12 with class-change upgrades</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">Starting stats, 49-level stat/MP growth tables, 50-level XP table</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d; color:#f85149;\"><strong>Blocks progression</strong></td>\n              </tr>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>Spells</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">64 with level, price, school, prose effect</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">Numeric Power (<code>E</code>) and Accuracy bytes needed by the spell formulas</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d; color:#f85149;\"><strong>Blocks magic</strong></td>\n              </tr>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>Maps &amp; World</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">27 VGMaps PNGs, partial chest notes</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><code>64&times;64</code> tile grids, walkable tiles, doors, warps, 256 chest <code>(x,y)</code> coords, NPCs</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d; color:#f85149;\"><strong>Blocks walking &amp; story</strong></td>\n              </tr>\n            </tbody>\n          </table>\n          <p class=\"lesson-text\">\n            That gap analysis is the heart of Knowledge Graph-driven development: instead of discovering halfway through writing GDScript combat code that StrategyWiki never listed monster Attack or Evade numbers, the parser's coverage audit tells you up front what data you still need to collect.\n          </p>\n          <div class=\"doc-figure\">\n            <img src=\"/assets/elearning/jrpg-kgraph/jrpg-kgraph-parser-and-gap-analysis.png\" alt=\"Stage 2: robos-jrpg-parser Ingestion, KGraph Ontology and Completeness Gap Matrix\" class=\"doc-img\" onclick=\"openLightbox(this.src, this.alt)\">\n            <div class=\"doc-caption\">Figure 2.1: Stage 2 architecture — deterministic table parsing (lib/charts.js), quote-verified prose extraction (lib/extract.js), OSLC JSON-LD graph output, and the Completeness Gap Audit.</div>\n          </div>\n        </div>\n      ",
          "labSteps": [
            "Run `jrpg-parser.js coverage --out /home/ndipiazza/kgraphs/final-fantasy-nes` and inspect the provenance & anti-hallucination Notes",
            "Inspect `/home/ndipiazza/kgraphs/final-fantasy-nes/parsed.json` with `jq` to review the 5 cross-source equipment conflicts and the Elfland shop mismatch",
            "Compare a Wiki-only `robos:JRPGEnemy` node (`HP, XP, Gold` only) against the full NES combat stat structure required to resolve a turn of battle",
            "Run the parser unit test suite (`node --test packages/robos-test/tests/jrpg-parser/unit.test.js`) and confirm all 63 tests pass"
          ],
          "labDetails": [
            {
              "description": "Run `jrpg-parser.js coverage` on `/home/ndipiazza/kgraphs/final-fantasy-nes` and read the `Notes:` section at the bottom of the terminal output to see which files were skipped and how many unverified LLM records were dropped.",
              "code": "node packages/robos-jrpg-parser/bin/jrpg-parser.js coverage \\\n  --out /home/ndipiazza/kgraphs/final-fantasy-nes",
              "expected": "The output lists 1,206 total nodes across 18 categories, followed by the provenance `Notes:` showing that `shop.html` was skipped as a Dawn of Souls mod, 4 agent records were dropped because their verbatim quotes did not appear in the source HTML, and 220 non-NES equipment rows were excluded.",
              "image": "/assets/elearning/jrpg-kgraph/labs/lab-m2-s1-coverage-notes.png",
              "imageAlt": "Terminal output of jrpg-parser.js coverage showing 1,206 nodes and anti-hallucination quote gate notes",
              "caption": "Lab 2.1: Auditing the coverage report and verifying that the quote gate dropped 4 ungrounded LLM records and excluded 220 remake rows.",
              "title": "Run `jrpg-parser.js coverage --out /home/ndipiazza/kgraphs/final-fantasy-nes` and inspect the provenance & anti-hallucination Notes"
            },
            {
              "description": "Use `jq` to inspect the `conflicts` array inside `/home/ndipiazza/kgraphs/final-fantasy-nes/parsed.json` and see how `lib/charts.js` surfaces numeric disagreements between different guides.",
              "code": "jq '.conflicts' /home/ndipiazza/kgraphs/final-fantasy-nes/parsed.json",
              "expected": "You will see the exact field-level disagreements (such as `CatClaw` price `65000` vs `52000` and `Gold Bracelet` defense `24` vs `34`) along with the source filenames that disagreed, plus the `Mythril/Silver Sword` naming note in Elfland.",
              "image": "/assets/elearning/jrpg-kgraph/labs/lab-m2-s2-parsed-conflicts.png",
