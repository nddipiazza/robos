    {
      "@id": "urn:robos:elearning:course:kgraph-parse-portal",
      "@type": [
        "oslc_am:Resource",
        "robos:ELearningCourse",
        "robos:ELearning",
        "schema:Course"
      ],
      "dcterms:description": "Master heavy-scale Knowledge Graph ingestion across web resources and Linux filesystems. Learn how every Linux file maps into the KGraph with cryptographic SHA-256 evidence, disambiguate ambiguous MIME types into precise architectural contracts, stream document parsing over Apache Tika 4.0 gRPC, orchestrate Hermetiq Buildbarn Helm charts (REAPI v2) for distributed build/parse clusters, and bridge nodes into the ultra-fast Luxir C++ search index with W3C SHACL validation gates.",
      "dcterms:title": "RobOS Kgraph Parse Portal Masterclass: Heavy-Scale Ingestion, Tika gRPC, Luxir Search & Buildbarn RBE",
      "robos:difficulty": "Advanced",
      "robos:domainStandard": "https://schema.org/Course",
      "robos:estimatedDuration": "50 minutes",
      "robos:modules": [
        {
          "durationMinutes": 10,
          "id": "mod-01-linux-fs-ingestion",
          "labSteps": [
            "Scan local project directory using POST /api/v1/crawl or the Portal UI",
            "Inspect the generated robos:evidence structure containing repository, path, line, and sha256 hash",
            "Verify Linux systemd unit and ELF executable classification"
          ],
          "overview": "Discover how every file, device node, Unix domain socket, named pipe, systemd service, and compiled ELF binary on a Linux operating system is extracted into the RobOS Knowledge Graph with verifiable SHA-256 evidence.",
          "quiz": [
            {
              "answer": "SHA-256 content hash, repository context, relative path, and working-tree revision",
              "explanation": "RobOS attaches cryptographic SHA-256 digests along with repository context, relative path, line number, and revision status to guarantee absolute provenance.",
              "options": [
                "SHA-256 content hash, repository context, relative path, and working-tree revision",
                "MD5 checksum only",
                "Git commit hash without line or path information",
                "No evidence is stored to conserve disk space"
              ],
              "question": "What cryptographic evidence is attached to every ingested Linux file node in RobOS?"
            },
            {
              "answer": "As robos:LinuxSocket and robos:LinuxNamedPipe with inode/socket and inode/fifo MIME types",
              "explanation": "RobOS maps Linux IPC sockets to robos:LinuxSocket and named pipes to robos:LinuxNamedPipe with accurate inode MIME types.",
              "options": [
                "As robos:LinuxSocket and robos:LinuxNamedPipe with inode/socket and inode/fifo MIME types",
                "They are ignored and discarded during filesystem scans",
                "As plain text documents",
                "As generic database tables"
              ],
              "question": "How are Unix domain sockets and named pipes represented in the KGraph?"
            }
          ],
          "title": "Module 1: Universal Linux Filesystem Ingestion & Cryptographic Evidence"
        },
        {
          "durationMinutes": 10,
          "id": "mod-02-mime-disambiguation",
          "labSteps": [
            "Test file classification in the MIME Disambiguation tab for package.json, Chart.yaml, and openapi.yaml",
            "Inspect directory archetype detection across Maven, Cargo, Go, Bazel, and Godot projects",
            "Verify W3C SHACL shape targetClass assignments"
          ],
          "overview": "Learn how the RobOS disambiguation engine parses beyond raw MIME headers to classify JSON into Node manifests vs tsconfig vs OpenAPI specs, and YAML into Helm charts vs Kubernetes manifests vs CI/CD pipelines.",
          "quiz": [
            {
              "answer": "robos:KubernetesManifest with targetClass robos:GitOpsDeployment",
              "explanation": "The disambiguation engine detects the Kubernetes schema and maps it directly to robos:GitOpsDeployment for automated cluster reconciliation.",
              "options": [
                "robos:KubernetesManifest with targetClass robos:GitOpsDeployment",
                "robos:HelmChartDefinition",
                "Generic text/plain document",
                "robos:ConfigurationFile without schema validation"
              ],
              "question": "When a YAML file contains apiVersion: and kind: Deployment, how is it classified?"
            },
            {
              "answer": "MODULE.bazel or WORKSPACE",
              "explanation": "MODULE.bazel or WORKSPACE indicates a Bazel monorepo, enabling remote execution flags and build target analysis.",
              "options": [
                "MODULE.bazel or WORKSPACE",
                "pom.xml",
                "Cargo.toml",
                "package.json"
              ],
              "question": "What marker file signals a Bazel monorepo archetype to the directory scanner?"
            }
          ],
          "title": "Module 2: Contextual MIME & Directory Archetype Disambiguation"
        },
        {
          "durationMinutes": 10,
          "id": "mod-03-tika-grpc",
          "labSteps": [
            "Inspect packages/kgraph-parse-portal/lib/tika-grpc-connector.js",
            "Test AST symbol extraction across TypeScript, Python, and Protobuf files",
            "Verify zero-downtime offline fallback when Tika daemon is offline"
          ],
          "overview": "Examine the high-throughput, non-blocking gRPC streaming protocol between RobOS and the Apache Tika 4.0 daemon on port 50051, along with resilient offline fallback handling and multi-language AST extraction.",
          "quiz": [
            {
              "answer": "Zero-copy streaming over HTTP/2 prevents workstation memory leaks and isolates parser crashes",
              "explanation": "Streaming large documents across HTTP/2 prevents Node.js heap bloat and isolates complex parser logic in an external daemon.",
              "options": [
                "Zero-copy streaming over HTTP/2 prevents workstation memory leaks and isolates parser crashes",
                "It converts all documents directly to PNG images",
                "It requires zero network configuration",
                "It eliminates the need for schema validation"
              ],
              "question": "What is the primary architectural advantage of streaming documents over tika-grpc?"
            },
            {
              "answer": "Protobuf services, RPC method signatures, and message schemas",
              "explanation": "TikaGrpcConnector identifies Protobuf service interfaces, RPC endpoints, and message schemas for microservice contract mapping.",
              "options": [
                "Protobuf services, RPC method signatures, and message schemas",
                "Only file comments and copyright notices",
                "Binary machine opcodes",
                "HTTP cookie headers"
              ],
              "question": "What symbol types does the polyglot AST parser extract from Protobuf definitions?"
            }
          ],
          "title": "Module 3: Apache Tika 4.0 Streaming tika-grpc Architecture & Polyglot AST Parsing"
        },
        {
          "durationMinutes": 10,
          "id": "mod-04-buildbarn-rbe",
          "labSteps": [
            "Generate Buildbarn Helm values.yaml using POST /api/v1/rbe/values or lib/buildbarn-rbe.js",
            "Verify the OCI Helm registry command: helm upgrade --install buildbarn oci://ghcr.io/hermetiq/buildbarn",
            "Inspect REAPI v2 component health probes for bb-frontend (8980) and bb-storage (8981)"
          ],
          "overview": "Deploy distributed Remote Build Execution (REAPI v2) for Bazel/Buck2 and heavy parse workers using Hermetiq Buildbarn Helm charts (oci://ghcr.io/hermetiq/buildbarn), configuring CAS storage, worker runners, and scheduler pools.",
          "quiz": [
            {
              "answer": "oci://ghcr.io/hermetiq/buildbarn",
              "explanation": "RobOS standardizes on Hermetiq's official OCI Helm distribution (oci://ghcr.io/hermetiq/buildbarn) for REAPI v2 cluster deployments.",
              "options": [
                "oci://ghcr.io/hermetiq/buildbarn",
                "docker.io/buildbarn/monolithic",
                "helm.elastic.co/buildbarn",
                "oci://quay.io/robos/buildbarn"
              ],
