    {
      "@id": "urn:robos:tabletop:hero:obama",
      "@type": [
        "oslc_am:Resource",
        "robos:TabletopHero",
        "robos:GameCharacter",
        "schema:Person"
      ],
      "dcterms:description": "Buff-as-hell, salt-and-pepper grey-haired Barbarian champion of the Midterms 2026 Hero Pack. Wields a rune-etched broadsword and devastating frontline melee power.",
      "dcterms:title": "Barack Obama",
      "robos:attackDice": 4,
      "robos:audioLines": {
        "attacked": [
          {
            "audio": "res://assets/audio/heroes/obama_react_1.ogg",
            "text": "Uhh... watch the suit!"
          },
          {
            "audio": "res://assets/audio/heroes/obama_react_2.ogg",
            "text": "Uhh... nice try!"
          },
          {
            "audio": "res://assets/audio/heroes/obama_react_3.ogg",
            "text": "Uhh... excuse me!"
          },
          {
            "audio": "res://assets/audio/heroes/obama_react_4.ogg",
            "text": "Uhh... hold on now!"
          },
          {
            "audio": "res://assets/audio/heroes/obama_react_5.ogg",
            "text": "Uhh... not today!"
          },
          {
            "audio": "res://assets/audio/heroes/obama_react_6.ogg",
            "text": "Uhh... folks, ouch!"
          }
        ],
        "attacking": [
          {
            "audio": "res://assets/audio/heroes/obama_atk_1.ogg",
            "text": "Uhh... taste the blade of hope!"
          },
          {
            "audio": "res://assets/audio/heroes/obama_atk_2.ogg",
            "text": "Uhh... strike for change!"
          },
          {
            "audio": "res://assets/audio/heroes/obama_atk_3.ogg",
            "text": "Uhh... feel the audacity!"
          },
          {
            "audio": "res://assets/audio/heroes/obama_atk_4.ogg",
