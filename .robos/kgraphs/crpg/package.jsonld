        {
          "id": "obj-get-antidote",
          "isOptional": false,
          "status": "active",
          "targetEntity": "temple-cabinet",
          "text": "Collect antidote from the temple pantry"
        },
        {
          "id": "obj-cure-nessa",
          "isOptional": false,
          "status": "unstarted",
          "targetEntity": "nessa",
          "text": "Administer antidote to Nessa the cow"
        }
      ],
      "robos:questStages": [
        {
          "description": "Retrieve an antidote potion from the temple stores to cure Nessa the cow.",
          "stage": 1
        }
      ],
      "robos:questType": "miscellaneous",
      "robos:rewards": {
        "experience": 50,
        "gold": 15
      },
      "robos:status": "active",
      "robos:targetMap": "candlekeep"
    },
    {
      "@id": "urn:robos:crpg:quest:firebead-scroll",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGQuest",
        "oslc_cm:ChangeRequest"
      ],
      "dcterms:title": "Firebead's Identification Scroll",
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:questCategory": "Candlekeep Side Quests",
      "robos:questGiver": "Firebead Elfmirk",
      "robos:questObjectives": [
        {
          "id": "obj-fetch-scroll",
          "isOptional": false,
          "status": "active",
          "targetEntity": "tethtoril",
          "text": "Obtain scroll of identify from Tethtoril"
        },
        {
          "id": "obj-deliver-firebead",
          "isOptional": false,
          "status": "unstarted",
          "targetEntity": "firebead",
          "text": "Deliver scroll to Firebead at Candlekeep Inn"
        }
      ],
      "robos:questStages": [
        {
          "description": "Fetch the scroll of identify from Tethtoril and bring it to Firebead inside Candlekeep Inn.",
          "stage": 1
        },
        {
          "description": "Deliver the identified scroll back to Firebead for a protection ward.",
          "stage": 2
        }
      ],
      "robos:questType": "side",
      "robos:rewards": {
        "experience": 150,
        "gold": 50,
        "items": [
          "potion-healing"
        ]
      },
      "robos:status": "active",
      "robos:targetMap": "candlekeep"
    },
    {
