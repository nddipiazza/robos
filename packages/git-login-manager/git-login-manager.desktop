[Desktop Entry]
X-RobOS-Category=RobOS Security
X-RobOS-App=true
Name=RobOS Git Login Manager
Comment=Monitor GitHub authentication and re-login when needed
Exec=/usr/local/bin/robos-launch git-login-manager
Icon=/usr/local/share/robos/git-login-manager/icon.svg
Terminal=false
Type=Application
Categories=Utility;Network;
StartupWMClass=git-login-manager
