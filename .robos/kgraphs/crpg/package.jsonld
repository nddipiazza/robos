    },
    {
      "@id": "urn:robos:crpg:quest:night-without-memory",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGQuest",
        "oslc_cm:ChangeRequest"
      ],
      "dcterms:title": "A Night Without Memory",
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:questCategory": "Main Questline",
      "robos:questGiver": "Elora",
      "robos:questObjectives": [
        {
          "id": "obj-wake-partner",
          "isOptional": false,
          "status": "completed",
          "targetEntity": "elora",
          "text": "Converse with partner Elora about the midnight summons"
        },
        {
          "id": "obj-retrieve-blade",
          "isOptional": false,
          "status": "active",
          "targetEntity": "footlocker",
          "text": "Retrieve service blade from footlocker"
        },
        {
          "id": "obj-investigate-village",
          "isOptional": false,
          "status": "unstarted",
          "targetEntity": "blacksmith-brand",
          "text": "Investigate disturbance in Village Square and speak with Blacksmith Brand"
        },
        {
          "id": "obj-defeat-malakor",
          "isOptional": false,
          "status": "unstarted",
          "targetEntity": "captain-malakor",
          "text": "Infiltrate Garrison Keep and defeat Captain Malakor"
        }
      ],
      "robos:questStages": [
        {
          "description": "Awake at home. Questioned by your partner Elora about last night's secret call to the keep.",
          "stage": 1
        },
        {
          "description": "Retrieve your service blade from the footlocker and step out into Oakhaven Village.",
          "stage": 2
        },
        {
          "description": "Investigate the village disturbance and speak with Blacksmith Brand to obtain the Garrison Side Key.",
          "stage": 3
        },
        {
          "description": "Breach the Royal Garrison Keep and defeat the corrupted skirmishers in the lower barracks.",
          "stage": 4
        },
        {
          "description": "Confront Captain Malakor in the War Room, defeat his corrupted form, and seal the Azrath vault breach.",
          "stage": 5
        }
      ],
      "robos:questType": "main",
      "robos:rewards": {
        "experience": 500,
        "gold": 120,
        "items": [
          "service-sword",
          "potion-healing"
        ]
      },
      "robos:status": "active",
      "robos:targetMap": "homestead"
    },
    {
      "@id": "urn:robos:crpg:scenario:create-fighter-vance",
      "@type": [
        "robos:Scenario",
        "schema:Action"
      ],
      "dcterms:title": "Creating Fighter Lieutenant Vance",
      "robos:inFeature": "urn:robos:crpg:feature:character-creation",
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:steps": [
        "Given the cRPG game is running and healthy",
        "When the player selects race \"human\" and class \"fighter\"",
        "And the player rolls character ability scores",
        "And the player embarks as \"Lieutenant Vance\"",
        "Then the current scene is \"Homestead\""
      ]
    },
    {
      "@id": "urn:robos:crpg:scenario:homestead-elora-confrontation",
      "@type": [
        "robos:Scenario",
        "schema:Action"
      ],
      "dcterms:title": "Confronting Elora and looting the guard footlocker",
      "robos:inFeature": "urn:robos:crpg:feature:homestead-amnesia",
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:steps": [
        "When the player speaks with partner Elora",
        "Then the active party contains 2 members",
        "And the activity log contains dialogue answer \"I... I honestly don't remember anything after midnight.\"",
        "When the player scrolls up the activity log to review conversation history",
        "Then the activity log scroll position is scrolled up",
        "When the player loots the footlocker",
        "Then the hero inventory contains \"service-sword\""
      ]
    },
    {
      "@id": "urn:robos:crpg:scenario:keep-malakor-boss-victory",
      "@type": [
        "robos:Scenario",
        "schema:Action"
      ],
      "dcterms:title": "Infiltrating the keep, defeating Captain Malakor, and achieving victory",
      "robos:inFeature": "urn:robos:crpg:feature:garrison-boss-victory",
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:steps": [
        "When the player enters the Royal Garrison Keep",
        "Then the current scene is \"GarrisonKeep\"",
        "When the player confronts Captain Malakor",
        "And the combat rounds against Captain Malakor are executed until victory",
        "Then the terminal victory screen is displayed with quest stage 5"
      ]
    },
    {
      "@id": "urn:robos:crpg:scenario:village-brand-and-hounds",
      "@type": [
        "robos:Scenario",
        "schema:Action"
      ],
      "dcterms:title": "Speaking with Blacksmith Brand and defeating corrupted hounds",
      "robos:inFeature": "urn:robos:crpg:feature:village-investigation",
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:steps": [
        "When the player speaks with Blacksmith Brand",
        "Then the blacksmith gives the \"garrison-key\" and quest advances to stage 3",
        "And the activity log contains dialogue answer \"The garrison gates are barred. Can you help me enter?\"",
        "When the player opens the shopkeeper trading window",
        "Then the shopkeeper trading window is visible",
        "When the player trades with the shopkeeper to buy \"potion-healing\"",
        "And the player closes the shopkeeper trading window",
        "When the player traverses to the eastern ruins to confront the Corrupted Shadow Hound",
        "Then the shadow hound is visible on screen",
        "When the player presses the spacebar to pause the game",
        "Then the game simulation is paused with the RTwP banner visible",
        "When the player queues action \"attack\" on the action toolbar",
        "And the player unpauses the game",
        "Then the game simulation is unpaused",
        "When the player attacks the Corrupted Shadow Hound",
        "Then the shadow hound is slain and total kills equals 1"
      ]
    },
