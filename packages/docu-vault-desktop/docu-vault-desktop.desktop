[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=DocuVault Desktop
Comment=Offline-first secure markdown notes, personal snippet vault, and encrypted local storage workstation tool.
Exec=/usr/bin/electron /usr/local/share/robos/docu-vault-desktop/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/docu-vault-desktop/icon.svg
Terminal=false
Categories=Utility;
X-RobOS-Category=Utility
StartupWMClass=docu-vault-desktop
