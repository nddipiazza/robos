                "packages/kgraph-parse-portal/bin/luxir-portal-cli.js",
                "git log"
              ],
              "question": "Which CLI tool provides direct terminal access to search, inspect, and monitor the Luxir engine?"
            }
          ],
          "title": "Module 5: Luxir C++ Hybrid Search Index Bridge & W3C SHACL Validation Gates"
        }
