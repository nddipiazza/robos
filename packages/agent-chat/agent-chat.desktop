[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Agent Chat
Comment=VS Code-like autonomous agent chat, code refactoring, and multi-app orchestration console
Exec=/usr/bin/electron /usr/local/share/robos/agent-chat/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/agent-chat/icon.svg
Terminal=false
Categories=Development;
X-RobOS-Category=AI
StartupWMClass=robos-agent-chat
