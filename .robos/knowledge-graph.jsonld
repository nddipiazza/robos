    {
      "@id": "urn:robos:diagram:stochastic-guessing-game",
      "@type": [
        "oslc_am:Resource",
        "robos:FlowDiagram",
        "schema:ImageObject"
      ],
      "dcterms:title": "Software Engineering: Stochastic Guessing Game vs. Deterministic Execution",
      "dcterms:description": "Cloud data center prompt loops burning energy in token gambling vs. deterministic compiled execution.",
      "robos:imagePath": "assets/images/stochastic-guessing-game.jpg",
      "robos:diagramType": "architecture",
      "robos:aspectRatio": "16:9",
      "robos:schemaOrgType": "https://schema.org/ImageObject",
      "robos:domainStandard": "https://schema.org/ImageObject",
      "robos:package": "documentation",
      "robos:namespace": "robos.docs",
      "robos:mermaidText": "graph TD\n    subgraph Cloud[\"Current Paradigm: Hyperscaler Cloud Treadmill\"]\n        REQ[\"Developer / Feature Prompt\"] --> LLM[\"Centralized 70B+ / 400B+ Model<br/><i>(Megawatts, Network Latency, Token Fees)</i>\"]\n        LLM --> CODE[\"Stochastically Generated Code<br/><i>(Hallucinations, Flaky Diffs)</i>\"]\n        CODE --> FAIL[\"Validation / Test Failure\"]\n        FAIL -->|Loop Back & Burn Tokens| LLM\n        CODE --> PROD[\"Fragile Production Runtime\"]\n    end",
      "robos:tooltip": "Software Engineering: Stochastic Guessing Game vs. Deterministic Execution"
    },
    {
      "@id": "urn:robos:diagram:turing-skill-architecture",
      "@type": [
        "oslc_am:Resource",
        "robos:FlowDiagram",
        "schema:ImageObject"
      ],
      "dcterms:title": "Standardized Turing Machine-Inspired Skill Architecture",
      "dcterms:description": "Formal Turing skill with typed Input Tapes, state machine invariants, leaf transition execution, and Output Tapes.",
      "robos:imagePath": "assets/images/turing-skill-architecture.jpg",
      "robos:diagramType": "flowchart",
      "robos:aspectRatio": "16:9",
      "robos:schemaOrgType": "https://schema.org/ImageObject",
      "robos:domainStandard": "https://schema.org/ImageObject",
      "robos:package": "documentation",
      "robos:namespace": "robos.docs",
      "robos:mermaidText": "flowchart LR\n    subgraph InputTape[\"Input Tape (Σ, Γ)\"]\n        IN[\"Typed Input Contract<br/><code>JSON-LD / SHACL / TypeSpec</code>\"]\n    end\n    subgraph TuringSkill[\"Standardized Turing Skill (M = ⟨Q, Σ, Γ, δ, q₀, B, F⟩)\"]\n        STATE[\"Finite State Register (Q)<br/><i>Hermetic Pre-Conditions</i>\"]\n        DELTA[\"Deterministic Transition Function (δ)<br/><i>Leaf Execution Logic</i>\"]\n        INV[\"State Invariants<br/><i>Cryptographic Sandboxing</i>\"]\n        STATE --> DELTA\n        INV -.-> DELTA\n    end\n    subgraph OutputTape[\"Output Tape & Halting (F)\"]\n        OUT[\"Typed Output Contract<br/><code>q_accept / q_reject</code>\"]\n        HALT[\"Bounded Halting Proof<br/><i>Guaranteed Termination</i>\"]\n        OUT --- HALT\n    end\n    IN --> TuringSkill\n    TuringSkill --> OUT",
      "robos:tooltip": "Standardized Turing Machine-Inspired Skill Architecture"
    },
    {
      "@id": "urn:robos:diagram:leaf-skill-compilation",
      "@type": [
        "oslc_am:Resource",
        "robos:FlowDiagram",
        "schema:ImageObject"
      ],
      "dcterms:title": "The Compilation Pipeline: Verified Leaf Skills into Native Machine Code",
      "dcterms:description": "Pipeline from exploratory generative LLMs through formal BDD verification and Turing specification into signed native binaries.",
      "robos:imagePath": "assets/images/leaf-skill-compilation.jpg",
      "robos:diagramType": "pipeline",
      "robos:aspectRatio": "16:9",
      "robos:schemaOrgType": "https://schema.org/ImageObject",
      "robos:domainStandard": "https://schema.org/ImageObject",
      "robos:package": "documentation",
      "robos:namespace": "robos.docs",
      "robos:mermaidText": "flowchart TD\n    A[\"Exploratory Prompting<br/><i>(Agent Chat / Claude / Codex)</i>\"] --> B[\"BDD Gherkin Verification<br/><i>(Input/Output Invariants)</i>\"]\n    B --> C{\"Behavioral Verification<br/>& Halting Proof\"}\n    C -->|Fails Tests| B\n    C -->|100% Proven| D[\"Turing Machine Formalization<br/><i>(Typed Input/Output Schemas)</i>\"]\n    D --> E[\"Compiler Pipeline<br/><i>(Rust / C / LLVM / Wasm AOT)</i>\"]\n    E --> F[\"Native Machine Code Leaf Skill<br/><code>.so / .dylib / ELF / Wasm</code>\"]\n    F --> G[\"Global Consortium Registry<br/><i>(Cryptographically Signed Binary)</i>\"]",
      "robos:tooltip": "The Compilation Pipeline: Verified Leaf Skills into Native Machine Code"
    },
    {
      "@id": "urn:robos:diagram:local-edge-assembly",
      "@type": [
        "oslc_am:Resource",
        "robos:FlowDiagram",
        "schema:ImageObject"
      ],
      "dcterms:title": "Local Edge Assembly on Consumer Hardware Independent of Data Centers",
      "dcterms:description": "Local open-weight model acting as Semantic Graph Linker wiring pre-compiled leaf skills into complete native applications offline.",
      "robos:imagePath": "assets/images/local-edge-assembly.jpg",
      "robos:diagramType": "architecture",
      "robos:aspectRatio": "16:9",
      "robos:schemaOrgType": "https://schema.org/ImageObject",
      "robos:domainStandard": "https://schema.org/ImageObject",
      "robos:package": "documentation",
      "robos:namespace": "robos.docs",
      "robos:mermaidText": "flowchart TB\n    USER[\"User Request\"] --> LOCAL_LLM[\"Local Open-Weight Model\"]\n    subgraph EdgeDevice[\"Local Consumer Workstation\"]\n        LOCAL_LLM --> ARCH[\"1. Synthesizes Application Topology\"]\n        ARCH --> RESOLVER[\"2. Skill Registry Lookup & Contract Matcher\"]\n        subgraph SkillRepo[\"Local Pre-Compiled Skill Cache\"]\n            S1[\"Compiled Leaf Skill: SQLite WAL Ingest\"]\n            S2[\"Compiled Leaf Skill: ChaCha20-Poly1305 Encrypt\"]\n            S3[\"Compiled Leaf Skill: Noise Protocol Handshake\"]\n            S4[\"Compiled Leaf Skill: P2P mDNS Discovery\"]\n        end\n        RESOLVER --> S1\n        RESOLVER --> S2\n        RESOLVER --> S3\n        RESOLVER --> S4\n        LINKER[\"3. RobOS Local Native Linker\"]\n        S1 --> LINKER\n        S2 --> LINKER\n        S3 --> LINKER\n        S4 --> LINKER\n        LINKER --> RUNTIME[\"4. Running Native Application\"]\n    end",
      "robos:tooltip": "Local Edge Assembly on Consumer Hardware Independent of Data Centers"
    },
