[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Dev Discussions
Comment=Discord/Slack-like chat interface for Projects, Features, Tasks & PR reviews
Exec=/usr/bin/electron /usr/local/share/robos/dev-discussions/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/dev-discussions/icon.svg
Terminal=false
Categories=Development;
X-RobOS-Category=Dev
StartupWMClass=robos-dev-discussions
