          "status": "active",
          "targetEntity": "temple-cabinet",
          "text": "Collect antidote from the temple pantry"
        },
        {
          "id": "obj-cure-nessa",
          "isOptional": false,
          "status": "unstarted",
          "targetEntity": "nessa",
          "text": "Administer antidote to Nessa the cow"
        }
      ],
      "robos:questStages": [
        {
          "description": "Retrieve an antidote potion from the temple stores to cure Nessa the cow.",
          "stage": 1
        }
      ],
      "robos:questType": "miscellaneous",
      "robos:rewards": {
        "experience": 50,
        "gold": 15
      },
      "robos:status": "active",
      "robos:targetMap": "candlekeep"
    },
    {
      "@id": "urn:robos:crpg:quest:firebead-scroll",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGQuest",
        "oslc_cm:ChangeRequest"
      ],
      "dcterms:title": "Firebead's Identification Scroll",
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
