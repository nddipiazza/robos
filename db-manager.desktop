[Desktop Entry]
Name=Relational DB Manager
Comment=RobOS Relational Database Management Studio
Exec=/usr/local/share/robos/db-manager/node_modules/.bin/electron /usr/local/share/robos/db-manager --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/db-manager/icon.svg
Terminal=false
Type=Application
Categories=Development;Database;
StartupWMClass=db-manager
