[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Documentation
Comment=RobOS Living Documentation Hub & Architecture Verifier
Exec=/usr/bin/electron /usr/local/share/robos/robos-documentation/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/robos-documentation/icon.svg
Terminal=false
Categories=Development;
X-RobOS-Category=Dev
StartupWMClass=robos-documentation
