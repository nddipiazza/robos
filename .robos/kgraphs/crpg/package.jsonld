    },
    {
      "@id": "urn:robos:crpg:event:evt-guardian-sarevok-vanquished",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:title": "Sarevok Vanquished: Savior of Candlekeep",
      "dcterms:description": "Defeating the armored warlord Sarevok and saving Candlekeep from the mercenary conspiracy.",
      "robos:eventType": "combat_victory",
      "robos:infinityInteraction": {
