      "@id": "urn:robos:crpg:quest:night-without-memory",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGQuest",
        "oslc_cm:ChangeRequest"
      ],
      "dcterms:title": "A Night Without Memory",
      "robos:questType": "main",
      "robos:questCategory": "Main Questline",
      "robos:questGiver": "Elora",
      "robos:targetMap": "homestead",
      "robos:status": "active",
      "robos:questStages": [
        {
          "stage": 1,
          "description": "Awake at home. Questioned by your partner Elora about last night's secret call to the keep."
        },
        {
          "stage": 2,
          "description": "Retrieve your service blade from the footlocker and step out into Oakhaven Village."
        },
        {
          "stage": 3,
          "description": "Investigate the village disturbance and speak with Blacksmith Brand to obtain the Garrison Side Key."
        },
        {
          "stage": 4,
          "description": "Breach the Royal Garrison Keep and defeat the corrupted skirmishers in the lower barracks."
        },
        {
          "stage": 5,
          "description": "Confront Captain Malakor in the War Room, defeat his corrupted form, and seal the Azrath vault breach."
        }
      ],
      "robos:questObjectives": [
        {
          "id": "obj-wake-partner",
          "text": "Converse with partner Elora about the midnight summons",
          "isOptional": false,
          "status": "completed",
          "targetEntity": "elora"
        },
        {
          "id": "obj-retrieve-blade",
          "text": "Retrieve service blade from footlocker",
          "isOptional": false,
          "status": "active",
          "targetEntity": "footlocker"
        },
        {
          "id": "obj-investigate-village",
          "text": "Investigate disturbance in Village Square and speak with Blacksmith Brand",
          "isOptional": false,
          "status": "unstarted",
          "targetEntity": "blacksmith-brand"
        },
        {
          "id": "obj-defeat-malakor",
          "text": "Infiltrate Garrison Keep and defeat Captain Malakor",
          "isOptional": false,
          "status": "unstarted",
          "targetEntity": "captain-malakor"
        }
      ],
      "robos:rewards": {
        "experience": 500,
        "gold": 120,
        "items": [
          "service-sword",
          "potion-healing"
        ]
      },
      "robos:package": "crpg",
      "robos:namespace": "robos.crpg"
    },
