    {
      "@id": "urn:robos:elearning:course:kgraph-parse-portal",
      "@type": [
        "oslc_am:Resource",
        "robos:ELearningCourse",
        "robos:ELearning",
        "schema:Course"
      ],
      "dcterms:description": "Master heavy-scale Knowledge Graph ingestion across web resources and Linux filesystems. Learn how every Linux file maps into the KGraph with cryptographic SHA-256 evidence, disambiguate ambiguous MIME types into precise architectural contracts, stream document parsing over Apache Tika 4.0 gRPC, orchestrate Hermetiq Buildbarn Helm charts (REAPI v2) for distributed build/parse clusters, and bridge nodes into the ultra-fast Luxir C++ search index with W3C SHACL validation gates.",
      "dcterms:title": "RobOS Kgraph Parse Portal Masterclass: Heavy-Scale Ingestion, Tika gRPC, Luxir Search & Buildbarn RBE",
      "robos:difficulty": "Advanced",
      "robos:domainStandard": "https://schema.org/Course",
      "robos:estimatedDuration": "50 minutes",
      "robos:gitopsFile": ".robos/elearning.yaml",
      "robos:modules": [
        {
          "durationMinutes": 10,
          "id": "mod-01-linux-fs-ingestion",
          "labSteps": [
            "Scan local project directory using POST /api/v1/crawl or the Portal UI",
            "Inspect the generated robos:evidence structure containing repository, path, line, and sha256 hash",
            "Verify Linux systemd unit and ELF executable classification"
          ],
          "overview": "Discover how every file, device node, Unix domain socket, named pipe, systemd service, and compiled ELF binary on a Linux operating system is extracted into the RobOS Knowledge Graph with verifiable SHA-256 evidence.",
          "quiz": [
            {
              "answer": "SHA-256 content hash, repository context, relative path, and working-tree revision",
              "explanation": "RobOS attaches cryptographic SHA-256 digests along with repository context, relative path, line number, and revision status to guarantee absolute provenance.",
              "options": [
                "SHA-256 content hash, repository context, relative path, and working-tree revision",
                "MD5 checksum only",
                "Git commit hash without line or path information",
                "No evidence is stored to conserve disk space"
              ],
              "question": "What cryptographic evidence is attached to every ingested Linux file node in RobOS?"
            },
            {
              "answer": "As robos:LinuxSocket and robos:LinuxNamedPipe with inode/socket and inode/fifo MIME types",
              "explanation": "RobOS maps Linux IPC sockets to robos:LinuxSocket and named pipes to robos:LinuxNamedPipe with accurate inode MIME types.",
              "options": [
                "As robos:LinuxSocket and robos:LinuxNamedPipe with inode/socket and inode/fifo MIME types",
                "They are ignored and discarded during filesystem scans",
                "As plain text documents",
                "As generic database tables"
              ],
              "question": "How are Unix domain sockets and named pipes represented in the KGraph?"
            }
          ],
          "title": "Module 1: Universal Linux Filesystem Ingestion & Cryptographic Evidence"
        },
        {
          "durationMinutes": 10,
          "id": "mod-02-mime-disambiguation",
          "labSteps": [
            "Test file classification in the MIME Disambiguation tab for package.json, Chart.yaml, and openapi.yaml",
            "Inspect directory archetype detection across Maven, Cargo, Go, Bazel, and Godot projects",
            "Verify W3C SHACL shape targetClass assignments"
          ],
          "overview": "Learn how the RobOS disambiguation engine parses beyond raw MIME headers to classify JSON into Node manifests vs tsconfig vs OpenAPI specs, and YAML into Helm charts vs Kubernetes manifests vs CI/CD pipelines.",
          "quiz": [
            {
              "answer": "robos:KubernetesManifest with targetClass robos:GitOpsDeployment",
              "explanation": "The disambiguation engine detects the Kubernetes schema and maps it directly to robos:GitOpsDeployment for automated cluster reconciliation.",
              "options": [
                "robos:KubernetesManifest with targetClass robos:GitOpsDeployment",
                "robos:HelmChartDefinition",
                "Generic text/plain document",
                "robos:ConfigurationFile without schema validation"
              ],
              "question": "When a YAML file contains apiVersion: and kind: Deployment, how is it classified?"
            },
            {
              "answer": "MODULE.bazel or WORKSPACE",
              "explanation": "MODULE.bazel or WORKSPACE indicates a Bazel monorepo, enabling remote execution flags and build target analysis.",
              "options": [
                "MODULE.bazel or WORKSPACE",
                "pom.xml",
                "Cargo.toml",
                "package.json"
              ],
              "question": "What marker file signals a Bazel monorepo archetype to the directory scanner?"
            }
          ],
          "title": "Module 2: Contextual MIME & Directory Archetype Disambiguation"
        },
        {
          "durationMinutes": 10,
          "id": "mod-03-tika-grpc",
          "labSteps": [
            "Inspect packages/kgraph-parse-portal/lib/tika-grpc-connector.js",
            "Test AST symbol extraction across TypeScript, Python, and Protobuf files",
            "Verify zero-downtime offline fallback when Tika daemon is offline"
          ],
          "overview": "Examine the high-throughput, non-blocking gRPC streaming protocol between RobOS and the Apache Tika 4.0 daemon on port 50051, along with resilient offline fallback handling and multi-language AST extraction.",
          "quiz": [
            {
              "answer": "Zero-copy streaming over HTTP/2 prevents workstation memory leaks and isolates parser crashes",
              "explanation": "Streaming large documents across HTTP/2 prevents Node.js heap bloat and isolates complex parser logic in an external daemon.",
              "options": [
                "Zero-copy streaming over HTTP/2 prevents workstation memory leaks and isolates parser crashes",
                "It converts all documents directly to PNG images",
                "It requires zero network configuration",
                "It eliminates the need for schema validation"
              ],
              "question": "What is the primary architectural advantage of streaming documents over tika-grpc?"
            },
            {
              "answer": "Protobuf services, RPC method signatures, and message schemas",
              "explanation": "TikaGrpcConnector identifies Protobuf service interfaces, RPC endpoints, and message schemas for microservice contract mapping.",
              "options": [
                "Protobuf services, RPC method signatures, and message schemas",
                "Only file comments and copyright notices",
                "Binary machine opcodes",
                "HTTP cookie headers"
              ],
              "question": "What symbol types does the polyglot AST parser extract from Protobuf definitions?"
            }
          ],
          "title": "Module 3: Apache Tika 4.0 Streaming tika-grpc Architecture & Polyglot AST Parsing"
        },
        {
          "durationMinutes": 10,
          "id": "mod-04-buildbarn-rbe",
          "labSteps": [
            "Generate Buildbarn Helm values.yaml using POST /api/v1/rbe/values or lib/buildbarn-rbe.js",
            "Verify the OCI Helm registry command: helm upgrade --install buildbarn oci://ghcr.io/hermetiq/buildbarn",
            "Inspect REAPI v2 component health probes for bb-frontend (8980) and bb-storage (8981)"
          ],
          "overview": "Deploy distributed Remote Build Execution (REAPI v2) for Bazel/Buck2 and heavy parse workers using Hermetiq Buildbarn Helm charts (oci://ghcr.io/hermetiq/buildbarn), configuring CAS storage, worker runners, and scheduler pools.",
          "quiz": [
            {
              "answer": "oci://ghcr.io/hermetiq/buildbarn",
              "explanation": "RobOS standardizes on Hermetiq's official OCI Helm distribution (oci://ghcr.io/hermetiq/buildbarn) for REAPI v2 cluster deployments.",
              "options": [
                "oci://ghcr.io/hermetiq/buildbarn",
                "docker.io/buildbarn/monolithic",
                "helm.elastic.co/buildbarn",
                "oci://quay.io/robos/buildbarn"
              ],
              "question": "What OCI registry chart is used to deploy Buildbarn Remote Build Execution in RobOS?"
            },
            {
              "answer": "bb-storage (CAS/AC), bb-scheduler (queue), bb-worker (runners), and bb-frontend (REAPI endpoint)",
              "explanation": "Buildbarn divides remote execution into CAS/AC storage, task scheduling queues, containerized worker execution, and frontend gRPC routing.",
              "options": [
                "bb-storage (CAS/AC), bb-scheduler (queue), bb-worker (runners), and bb-frontend (REAPI endpoint)",
                "PostgreSQL database and Redis cache only",
                "Only bb-storage without a worker pool",
                "A monolithic single-node executable"
              ],
              "question": "Which REAPI v2 components are deployed by the Hermetiq Buildbarn Helm chart?"
            }
          ],
          "title": "Module 4: Distributed Remote Build Execution (RBE) via Hermetiq Buildbarn Helm Charts"
        },
        {
          "durationMinutes": 10,
          "id": "mod-05-luxir-search-shacl",
          "labSteps": [
            "Run the Luxir CLI status command: node packages/kgraph-parse-portal/bin/luxir-portal-cli.js status",
            "Execute faceted search queries filtering by target class (robos:Contract, robos:Microservice)",
            "Inspect raw Luxir JSON index documents and verify W3C SHACL validation gates during ingestion"
          ],
          "overview": "Bridge parsed nodes into the high-performance Luxir C++ search index on port 8983, execute faceted sub-millisecond CLI queries, and validate all nodes through W3C SHACL constraint shape gates before committing to the Knowledge Graph.",
          "quiz": [
            {
              "answer": "Every node must pass through W3C SHACL shape validation gates before being committed",
              "explanation": "Ingestion endpoints enforce W3C SHACL shape validation (targetClass, required properties, datatype constraints) before mutating graph state.",
              "options": [
                "Every node must pass through W3C SHACL shape validation gates before being committed",
                "It bypasses all validation to maximize ingestion speed",
                "It requires manual human approval for every individual file",
                "It only allows ingestion of plain markdown files"
              ],
              "question": "How does the KGraph Parse Portal guarantee that ingested nodes do not corrupt the Knowledge Graph?"
            },
            {
              "answer": "packages/kgraph-parse-portal/bin/luxir-portal-cli.js",
              "explanation": "luxir-portal-cli.js enables searching, raw JSON document inspection, and daemon health checks directly from the command line.",
              "options": [
                "packages/kgraph-parse-portal/bin/luxir-portal-cli.js",
                "kubectl get pods",
                "git log",
                "npm test"
              ],
              "question": "Which CLI tool provides direct terminal access to search, inspect, and monitor the Luxir engine?"
            }
          ],
          "title": "Module 5: Luxir C++ Hybrid Search Index Bridge & W3C SHACL Validation Gates"
        }
      ],
      "robos:modulesCount": 5,
      "robos:namespace": "robos.learning",
      "robos:package": "learning",
      "robos:schemaOrgType": "https://schema.org/Course",
      "robos:status": "published",
      "robos:targetApplication": "urn:robos:app:kgraph-parse-portal",
      "robos:targetAudience": "Platform Architects, DevOps Engineers, AI Agent Harness Developers, SDLC Engineers",
      "robos:topic": "Heavy-Scale SDLC Ingestion & Connectors Architecture"
    },
    {
      "@id": "urn:robos:elearning:course:robos-crpg",
      "@type": [
        "oslc_am:Resource",
        "robos:ELearningCourse",
        "robos:ELearning",
        "schema:Course"
      ],
      "dcterms:description": "The definitive deep-dive into party-based tactical isometric cRPGs for video game nerds and D&D dungeon masters. Covers D&D 5e SRD mathematical action economy, Godot 4.3 GL Compatibility 2.5D isometric rendering, physical collision pathfinding, Flare RPG CC-BY-SA paperdoll asset pipelines, 3-mode expandable Activity Log, and autonomous Infinity AI Agent verification with 1080p video proof-of-work.",
      "dcterms:title": "Tactical cRPG Architecture: D&D 5e SRD & Godot 4 Infinity Engine Masterclass",
      "robos:difficulty": "Advanced",
      "robos:domainStandard": "https://schema.org/Course",
      "robos:engineArchitecture": "urn:robos:infinity:engine:gemrb-infinity",
      "robos:estimatedDuration": "60 minutes",
      "robos:gitopsFile": ".robos/elearning.yaml",
      "robos:modules": [
        {
          "durationMinutes": 15,
          "id": "mod-01-dnd5e-rules",
          "labSteps": [
            "Inspect games/crpg-realm/schemas/v1/classes.schema.json and data/v1/classes.json for hit dice (d6/d8/d10) and saving throw proficiencies",
            "Verify d20 attack roll, critical hit multiplier, and advantage roll resolution in games/crpg-realm/scripts/CombatEngine.gd",
            "Run automated D&D rules tests: python3 -m unittest games/crpg-realm/tests/test_dnd_rules.py or inspect dice formulas"
          ],
          "overview": "Master D&D 5e SRD mathematical combat resolution: d20 attack rolls vs AC, ability score modifiers floor((Stat - 10)/2), advantage/disadvantage probability curve, Nat 20 critical double damage dice, strict 6.0-second combat rounds, Action/Bonus Action/Reaction economy, and spell save DC = 8 + prof + modifier.",
          "quiz": [
            {
              "answer": "8 + Proficiency Bonus + Spellcasting Ability Modifier",
              "options": [
                "8 + Proficiency Bonus + Spellcasting Ability Modifier",
                "10 + Spell Level + Intelligence Modifier",
                "d20 + Proficiency Bonus + Caster Level",
                "Armor Class + Wisdom Modifier - Spell Level"
              ],
              "question": "In D&D 5e SRD, what is the exact formula for a character's Spell Save DC?"
            },
            {
              "answer": "6.0 seconds with visual round progress timer",
              "options": [
                "6.0 seconds with visual round progress timer",
                "10.0 seconds turn-based phase",
                "1.0 second real-time tick",
                "Variable based on Agility stat"
              ],
              "question": "How long is a standard D&D 5e combat round in the tactical RTwP engine?"
            },
            {
              "answer": "Roll 2d20 and take the higher value",
              "options": [
                "Roll 2d20 and take the higher value",
                "Roll 1d20 and add a flat +5 modifier",
                "Roll 2d20 and sum both values together",
                "Double the damage dice if the roll hits"
              ],
              "question": "When an attacker has Advantage on a d20 attack roll, how is the roll evaluated?"
            }
          ],
          "title": "Module 1: D&D 5e Ruleset & Mathematical Action Economy"
        },
        {
          "durationMinutes": 15,
          "id": "mod-02-godot-engine",
          "labSteps": [
            "Inspect games/crpg-realm/scenes/VillageSquare.tscn to analyze physical building StaticBody2D collision geometry across the 2560x1440 map",
            "Trace Pathfinder.gd raycast line-of-sight checks and A* corridor waypoint fallbacks avoiding house bounding boxes",
            "Inspect games/crpg-realm/shaders/FogOfWar.gdshader and verify light occluder vision reveals",
            "Launch headless Godot test runner: ./games/crpg-realm/debug.sh --scene TestRunner --headless"
          ],
          "overview": "Examine Godot 4.3's GL Compatibility renderer profile, pre-rendered 2560x1440 2.5D isometric plates with camera clamping at 1920x1080, Layer 1 StaticBody2D physical building collision footprints preventing walk-through clipping, dual-tier Pathfinder.gd obstacle avoidance, and custom FogOfWar.gdshader with circular vision masks.",
          "quiz": [
            {
              "answer": "Guarantees seamless execution across low-spec hardware, virtualized Xvfb displays (:99), and avoids shader compilation stutter",
              "options": [
                "Guarantees seamless execution across low-spec hardware, virtualized Xvfb displays (:99), and avoids shader compilation stutter",
                "Vulkan does not support 2D sprite rendering in Godot 4",
                "GL Compatibility allows higher polygon count 3D models",
                "It enables Ray Tracing and DLSS by default"
              ],
              "question": "Why does RobOS cRPG Realm use the Godot 4 GL Compatibility renderer rather than Vulkan Forward+?"
            },
            {
              "answer": "Fails direct raycast line-of-sight and routes through safe corridor waypoints via A* visibility graph",
              "options": [
                "Fails direct raycast line-of-sight and routes through safe corridor waypoints via A* visibility graph",
                "Teleports the party directly to the target point",
                "Disables building collision while moving",
                "Reverses direction until clicking stops"
              ],
              "question": "How does Pathfinder.gd prevent heroes from getting stuck when clicking on the far side of Brand's Forge?"
            }
          ],
          "title": "Module 2: Godot 4.3 Engine Runtime & 2.5D Isometric Architecture"
        },
        {
          "durationMinutes": 10,
          "id": "mod-03-assets-and-hud",
          "labSteps": [
            "Inspect Flare RPG animated 8-directional spritesheets in games/crpg-realm/assets/sprites/",
            "Examine games/crpg-realm/scripts/HUD.gd for 3-mode activity log sizing (Small 124px, Medium 240px, Large 420px)",
            "Verify in-log numbered dialogue option selection (keys 1-9 or click) without intrusive popup modals"
          ],
          "overview": "Explore CC-BY-SA 3.0 asset harvesting from Flare RPG (100+ animated 8-directional creatures and modular paperdoll gear), Game-Icons.net vector icons, and an authentic Infinity Engine HUD replica: Spacebar RTwP pause, Shift-click waypoint queuing, circle selection rings, and 3-mode expandable Activity Log with in-log dialogue.",
          "quiz": [
            {
              "answer": "Small (124px combat), Medium (240px dialogue), Large (420px history & dice breakdown)",
              "options": [
                "Small (124px combat), Medium (240px dialogue), Large (420px history & dice breakdown)",
                "Collapsed, Windowed, Fullscreen",
                "Debug, Trace, Error",
                "Combat Only, Chat Only, System Only"
              ],
              "question": "What are the three distinct modes of the Infinity Engine Activity Log in cRPG Realm?"
            },
            {
              "answer": "CC-BY-SA 3.0 / CC0 (Genuine Open Source)",
              "options": [
                "CC-BY-SA 3.0 / CC0 (Genuine Open Source)",
                "Proprietary Commercial License",
                "GPL v2 only",
                "MIT No-Attribution"
              ],
              "question": "What license governs the Flare RPG creature spritesheets and modular paperdoll assets used in the game?"
            }
          ],
          "title": "Module 3: Open-Source Asset Harvesting & Infinity Engine HUD Replica"
        },
        {
          "durationMinutes": 10,
          "id": "mod-04-infinity-ai-agent",
          "labSteps": [
            "Inspect qa_player/infinity_ai_agent.py spatial threat radar and priority target evaluation tree",
            "Review behave BDD test feature steps in games/crpg-realm/tests/e2e/features/steps/crpg_steps.py",
            "Verify automated headless container test execution via scripts/e2e-container.sh"
          ],
          "overview": "Deep dive into the autonomous InfinityAIAgent (qa_player/infinity_ai_agent.py): 140px spatial threat radar, 200px pack alerting, combined-arms tactics (tank intercept, rogue standoff kiting, wizard Magic Missile priority, cleric Cure Wounds <40% HP), and headless Xvfb :99 execution with 1080p FFmpeg video proof-of-work.",
          "quiz": [
            {
              "answer": "140px proximity trigger with 200px pack alerting radius",
              "options": [
                "140px proximity trigger with 200px pack alerting radius",
                "50px melee range only",
                "500px entire viewport scan",
                "Instant global aggro upon scene enter"
              ],
              "question": "At what proximity distance does the Infinity AI Agent threat radar trigger hostile combat detection?"
            },
            {
              "answer": "When any companion drops below 40% maximum Hit Points",
              "options": [
                "When any companion drops below 40% maximum Hit Points",
                "Only after all enemies are dead",
                "On round 1 regardless of health",
                "Only when the Cleric itself is attacked"
              ],
              "question": "In combined-arms AI tactics, when does the Cleric cast Cure Wounds during active combat?"
            }
          ],
          "title": "Module 4: Autonomous Infinity AI Agent & Headless BDD Verification"
        },
        {
          "durationMinutes": 10,
          "id": "mod-05-kgraph-architecture",
          "labSteps": [
            "Inspect .robos/kgraphs/crpg/package.jsonld entity declarations and relationship edges",
            "Run node packages/crpg-builder/bin/crpg-builder.js validate to test SHACL constraint shapes",
            "Execute node packages/crpg-builder/bin/crpg-builder.js generate to inspect generated GDScript data stores"
          ],
          "overview": "Learn RobOS Knowledge Graph-First game architecture: W3C SHACL shape validation (CRPGGameShape, CRPGMonsterShape, CRPGSpellShape), the 4-Phase Generation Pipeline, compiling JSON schemas in schemas/v1/ to typed GDScript DataStoreV1.gd singletons, zero hardcoding rule, and dual-state branch diffing.",
          "quiz": [
            {
              "answer": "Provides static type safety, autocompletion in Godot editor, and eliminates runtime KeyError crashes",
              "options": [
                "Provides static type safety, autocompletion in Godot editor, and eliminates runtime KeyError crashes",
                "Compresses textures and sound files into binary blobs",
                "Allows the game to bypass Godot engine lifecycle hooks",
                "Enables multiplayer networking over WebSockets"
              ],
              "question": "What is the primary benefit of compiling game data from JSON Schemas into typed GDScript singletons (DataStoreV1.gd)?"
            },
            {
              "answer": "Broken dialogue tree references, missing sprite asset bindings, and monster stat imbalances",
              "options": [
                "Broken dialogue tree references, missing sprite asset bindings, and monster stat imbalances",
                "Syntax errors in Python packages",
                "Network packet loss during multiplayer matchmaking",
                "GPU driver incompatibilities"
              ],
              "question": "What does RobOS dual-state semantic diffing (kgraph diff main) catch before game code is deployed?"
            }
          ],
          "title": "Module 5: Knowledge Graph-First Game Development (.robos/kgraphs/crpg)"
        }
      ],
