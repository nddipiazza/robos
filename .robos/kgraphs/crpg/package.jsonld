    {
      "@id": "urn:robos:crpg:event:evt-gorion-awakening",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:title": "Gorion's Departure Directive",
      "dcterms:description": "Gorion summons his ward to the library steps with urgent warnings of an imminent departure from Candlekeep.",
      "robos:eventType": "dialogue",
      "robos:infinityInteraction": {
        "robos:interactionType": "dialogue_branch",
        "robos:scriptVm": "urn:robos:infinity:subsystem:bcs-script-vm",
        "robos:dialogueMachine": "urn:robos:infinity:subsystem:dialogue-state-machine",
        "robos:bcsTrigger": "NumTimesTalkedTo(0) && Range(Player1, 15)",
        "robos:bcsAction": "SetGlobal(\"spoke_to_gorion\", \"GLOBAL\", 1)\nAddJournalEntry(3001, QUEST)",
        "robos:dialogueRef": "GORION.DLG:1:1",
        "robos:journalEntry": "Gorion urgently demands we gather provisions and depart Candlekeep before nightfall."
      },
      "robos:stateMutations": {
        "setFlags": {
          "spoke_to_gorion": true
        },
        "xpAward": 50
      },
      "robos:package": "crpg",
      "robos:namespace": "robos.crpg"
    },
    {
      "@id": "urn:robos:crpg:event:evt-winthrop-supplies",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:title": "Winthrop's Hospitality & Provisions",
      "dcterms:description": "Winthrop provides travel provisions and advice inside the bustling Candlekeep Inn.",
      "robos:eventType": "dialogue",
      "robos:infinityInteraction": {
        "robos:interactionType": "dialogue_branch",
        "robos:scriptVm": "urn:robos:infinity:subsystem:bcs-script-vm",
        "robos:dialogueMachine": "urn:robos:infinity:subsystem:dialogue-state-machine",
        "robos:bcsTrigger": "See(Player1) && AreaCheck(\"candlekeep-inn-interior\")",
        "robos:bcsAction": "SetGlobal(\"spoke_to_winthrop\", \"GLOBAL\", 1)\nGiveGoldForce(15)\nStartStore(\"WINTHROP\", LastTalkedToBy)",
        "robos:dialogueRef": "WINTHROP.DLG:3:1",
        "robos:journalEntry": "Purchased travel rations and iron daggers from innkeeper Winthrop."
      },
      "robos:stateMutations": {
        "setFlags": {
          "spoke_to_winthrop": true
        },
        "goldChange": -10
      },
      "robos:package": "crpg",
      "robos:namespace": "robos.crpg"
    },
    {
      "@id": "urn:robos:crpg:event:evt-hasty-departure",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:title": "Hasty Departure to Gates",
      "dcterms:description": "Choosing not to linger for preparations, heading directly to the monastery gates.",
      "robos:eventType": "area_transition",
      "robos:infinityInteraction": {
        "robos:interactionType": "bcs_script_action",
        "robos:scriptVm": "urn:robos:infinity:subsystem:bcs-script-vm",
        "robos:dialogueMachine": "urn:robos:infinity:subsystem:dialogue-state-machine",
        "robos:bcsTrigger": "True()",
        "robos:bcsAction": "SetGlobal(\"hasty_departure\", \"GLOBAL\", 1)\nMoveToPoint([1450, 920])",
        "robos:journalEntry": "Decided not to linger for provisions; heading straight for the monastery gates."
      },
      "robos:stateMutations": {
        "setFlags": {
          "hasty_departure": true
        }
      },
      "robos:package": "crpg",
      "robos:namespace": "robos.crpg"
    },
    {
      "@id": "urn:robos:crpg:event:evt-sanctuary-cutthroats-slain",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:title": "Cutthroats Shank & Carbos Slain",
      "dcterms:description": "Defeating the two assassins lying in ambush within the darkened Candlekeep storehouse.",
      "robos:eventType": "combat_victory",
      "robos:infinityInteraction": {
        "robos:interactionType": "combat_encounter",
        "robos:scriptVm": "urn:robos:infinity:subsystem:bcs-script-vm",
        "robos:dialogueMachine": "urn:robos:infinity:subsystem:dialogue-state-machine",
        "robos:bcsTrigger": "Dead(\"shank\") && Dead(\"carbos\")",
        "robos:bcsAction": "SetGlobal(\"shank_defeated\", \"GLOBAL\", 1)\nSetGlobal(\"carbos_defeated\", \"GLOBAL\", 1)\nGiveItemCreate(\"SCRL_BOUNTY\", Player1, 1, 0, 0)\nAddJournalEntry(3002, QUEST)",
        "robos:journalEntry": "Slain cutthroats Shank and Carbos in the storehouse; recovered an assassin contract scroll.",
        "robos:scenarioRef": "urn:robos:crpg:scenario:homestead-hound-pack"
      },
      "robos:stateMutations": {
        "setFlags": {
          "shank_defeated": true,
          "carbos_defeated": true,
          "bounty_scroll_found": true
        },
        "xpAward": 150
      },
      "robos:package": "crpg",
      "robos:namespace": "robos.crpg"
    },
    {
