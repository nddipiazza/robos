[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Dev Tools
Comment=Install and manage IDEs, CLI tools, and cloud SDKs
Exec=/usr/bin/electron /usr/local/share/robos/dev-tools/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/dev-tools/icon.svg
Terminal=false
Categories=Development;
X-RobOS-Category=Dev
StartupWMClass=robos-dev-tools
