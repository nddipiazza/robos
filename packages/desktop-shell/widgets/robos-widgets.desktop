[Desktop Entry]
Type=Application
Name=RobOS Desktop Widgets
Comment=Copilot quota, pass status, journal, profile, and workspace task overlays
Exec=python3 /usr/local/share/robos/robos-widgets.py
Icon=/usr/local/share/robos/icon.svg
Terminal=false
Categories=System;
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=4
NoDisplay=true
