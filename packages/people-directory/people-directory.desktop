[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS People Directory
Comment=Browse and manage the RobOS people directory
Exec=/usr/bin/electron /usr/local/share/robos/people-directory/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/people-directory/icon.svg
Terminal=false
Categories=Office;
X-RobOS-Category=RobOS People
StartupWMClass=robos-people-directory
