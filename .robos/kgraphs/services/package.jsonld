    {
      "@id": "urn:robos:contract:user-directory-sync-v1",
      "@type": [
        "robos:Contract",
        "c4:Component",
        "oslc:Resource",
        "schema:DigitalDocument"
      ],
      "dcterms:title": "User Directory Sync OpenAPI 3.1 Spec",
      "robos:specFile": "specs/contracts/user-directory-sync-v1.yaml",
      "robos:protocol": "OpenAPI 3.1",
      "robos:contractYaml": "openapi: 3.1.0\ninfo:\n  title: User Directory Sync REST API\n  description: High-performance microservice contract for User Directory Sync in RobOS Universe.\n  version: 1.0.0\nservers:\n  - url: https://github.com/api/v1/user-directory-sync\n    description: Production Gateway\n  - url: http://localhost:8080\n    description: Local Dev Container\ntags:\n  - name: Core\n    description: Primary operations\n  - name: Health\n    description: Service diagnostics and liveliness\npaths:\n  /api/v1/user-directory-sync:\n    get:\n      tags: [Core]\n      summary: Retrieve all user-directory-sync items\n      operationId: listUser-directory-syncItems\n      parameters:\n        - name: limit\n          in: query\n          required: false\n          schema:\n            type: integer\n            default: 50\n      responses:\n        '200':\n          description: Successful query result\n          content:\n            application/json:\n              schema:\n                type: array\n                items:\n                  $ref: '#/components/schemas/User-directory-syncItem'\n    post:\n      tags: [Core]\n      summary: Create new user-directory-sync entry\n      operationId: createUser-directory-syncItem\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/User-directory-syncItem'\n      responses:\n        '201':\n          description: Resource created successfully\n  /api/v1/user-directory-sync/{id}:\n    get:\n      tags: [Core]\n      summary: Get user-directory-sync by identifier\n      operationId: getUser-directory-syncById\n      parameters:\n        - name: id\n          in: path\n          required: true\n          schema:\n            type: string\n      responses:\n        '200':\n          description: Resource found\n        '404':\n          description: Item not found\n  /healthz:\n    get:\n      tags: [Health]\n      summary: Liveness and readiness probe\n      responses:\n        '200':\n          description: Service is healthy and operational\ncomponents:\n  schemas:\n    User-directory-syncItem:\n      type: object\n      required:\n        - id\n        - name\n        - createdAt\n      properties:\n        id:\n          type: string\n          format: uuid\n        name:\n          type: string\n          example: 'Primary user-directory-sync record'\n        status:\n          type: string\n          enum: [ACTIVE, PENDING, ARCHIVED]\n          default: ACTIVE\n        createdAt:\n          type: string\n          format: date-time\n",
      "robos:repository": "github.com/acme-identity/user-directory-sync",
