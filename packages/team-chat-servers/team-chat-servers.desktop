[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Team Chat Servers
Comment=Manage team chat workspaces and channels in your KGraph
Exec=/usr/bin/electron /usr/local/share/robos/team-chat-servers/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/team-chat-servers/icon.svg
Terminal=false
Categories=Network;
X-RobOS-Category=People
StartupWMClass=robos-team-chat-servers
