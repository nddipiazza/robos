config_version=5

[application]

config/name="Fantasy: Light Warriors (WIP)"
config/description="Fantasy: Light Warriors (WIP) - Clean-Room 8-Bit Party JRPG in Godot 4"
config/icon="res://icon.svg"
run/main_scene="res://scenes/TitleScreen.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

GameState="*res://scripts/GameState.gd"
GameControlServer="*res://scripts/GameControlServer.gd"
AIEngine="*res://scripts/AIEngine.gd"
PlayGameBrain="*res://scripts/PlayGameBrain.gd"
PlayGameHUD="*res://scripts/PlayGameHUD.gd"

[display]

window/size/viewport_width=512
window/size/viewport_height=568
window/size/window_width_override=1024
window/size/window_height_override=1136
window/stretch/mode="canvas_items"

