[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Task Implementer
Comment=Implement tasks from the task server using AI agents
Exec=/usr/bin/electron /usr/local/share/robos/task-implementer/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/task-implementer/icon.svg
Terminal=false
Categories=Development;
X-RobOS-Category=AI
StartupWMClass=robos-task-implementer
