#!/bin/bash
# robos-desktop-panel hide|show
#
# Hides/shows all GNOME taskbars — NO gnome-shell restart.
#
# HIDE: disables the dash-to-panel extension (removes bottom bar) and
#       applies a user-theme CSS that hides the Activities top bar.
# SHOW: re-enables dash-to-panel and restores the default theme.

ACTION="${1:-hide}"

# Detect gnome-shell user and their D-Bus session
GNOME_USER=$(ps aux | grep '[g]nome-shell' | awk '{print $1}' | head -1)
GNOME_UID=$(id -u "$GNOME_USER" 2>/dev/null)

if [ -z "$GNOME_USER" ] || [ -z "$GNOME_UID" ]; then
  echo "ERROR: could not find gnome-shell user" >&2
  exit 1
fi

DBUS_ADDR="unix:path=/run/user/${GNOME_UID}/bus"
XDG_RT="/run/user/${GNOME_UID}"
USER_THEME_SCHEMA="/usr/share/gnome-shell/extensions/user-theme@gnome-shell-extensions.gcampax.github.com/schemas"
THEME_DIR="/home/${GNOME_USER}/.themes"
NO_PANEL_CSS="${THEME_DIR}/robos-no-panel/gnome-shell/gnome-shell.css"
WITH_PANEL_CSS="${THEME_DIR}/robos-with-panel/gnome-shell/gnome-shell.css"

run_as_gnome_user() {
  sudo -u "$GNOME_USER" \
    HOME="/home/$GNOME_USER" \
    DBUS_SESSION_BUS_ADDRESS="$DBUS_ADDR" \
    XDG_RUNTIME_DIR="$XDG_RT" \
    "$@"
}

gdbus_ext() {
  run_as_gnome_user gdbus call --session \
    --dest org.gnome.Shell --object-path /org/gnome/Shell \
    --method "org.gnome.Shell.Extensions.${1}" "${2}" > /dev/null 2>&1
}

set_theme() {
  run_as_gnome_user env \
    GSETTINGS_SCHEMA_DIR="$USER_THEME_SCHEMA" \
    gsettings set org.gnome.shell.extensions.user-theme name "$1"
}

ensure_css_themes() {
  sudo -u "$GNOME_USER" mkdir -p "${THEME_DIR}/robos-no-panel/gnome-shell"
  sudo -u "$GNOME_USER" mkdir -p "${THEME_DIR}/robos-with-panel/gnome-shell"

  # Write hide-panel CSS
  printf '/* RobOS hide all panels */\n#panel {\n    opacity: 0 !important;\n    height: 0px !important;\n    min-height: 0px !important;\n}\n' \
    > "$NO_PANEL_CSS"
  chown "$GNOME_USER" "$NO_PANEL_CSS"

  # Write empty restore CSS
  printf '/* RobOS restore panels */\n' > "$WITH_PANEL_CSS"
  chown "$GNOME_USER" "$WITH_PANEL_CSS"
}

if [ "$ACTION" = "hide" ]; then
  ensure_css_themes
  # Enable user-theme extension (needed for custom CSS)
  gdbus_ext EnableExtension 'user-theme@gnome-shell-extensions.gcampax.github.com'
  # Apply CSS that hides the GNOME Activities top bar
  set_theme 'robos-no-panel'
  # Disable dash-to-panel to remove the bottom taskbar
  gdbus_ext DisableExtension 'dash-to-panel@jderose9.github.com'
  echo "Panels hidden"

elif [ "$ACTION" = "show" ]; then
  ensure_css_themes
  # Re-enable dash-to-panel (restores bottom taskbar)
  gdbus_ext EnableExtension 'dash-to-panel@jderose9.github.com'
  # Restore empty CSS theme (removes the Activities bar override)
  set_theme 'robos-with-panel'
  echo "Panels shown"

else
  echo "Usage: $0 hide|show" >&2
  exit 1
fi
