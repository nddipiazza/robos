      ],
      "dcterms:title": "Item Shop",
      "robos:package": "ui",
      "dcterms:description": "Buy consumable items for the party or exit the shop back to the town map.",
      "jrpg:commands": [
        "Buy",
        "Exit"
      ],
      "jrpg:windows": [
        {
          "name": "Shop Header",
          "x": 0.38,
          "y": 0.05,
          "width": 0.25,
          "height": 0.13,
          "contents": "Displays the shop type label 'ITEM' on a magenta background."
        },
        {
          "name": "Dialogue Box",
          "x": 0.03,
          "y": 0.12,
          "width": 0.28,
          "height": 0.41,
          "contents": "Displays shopkeeper messages, currently showing 'Welcome' on a blue background."
        },
        {
          "name": "Shop Scene",
          "x": 0.34,
          "y": 0.21,
          "width": 0.32,
          "height": 0.33,
          "contents": "Depicts the shopkeeper behind a wooden counter with three barrels on the left and the four party members standing on the right."
        },
        {
          "name": "Command Menu",
          "x": 0.19,
          "y": 0.62,
          "width": 0.28,
          "height": 0.34,
          "contents": "Lists selectable shop actions ('Buy' and 'Exit') on a blue background."
        },
        {
          "name": "Gold Display",
          "x": 0.56,
          "y": 0.84,
          "width": 0.31,
          "height": 0.13,
          "contents": "Shows the party's current gold total ('400 G') on a green background."
        }
      ],
      "jrpg:cursor": "A white gloved hand pointing right with a gray drop shadow on the left edge of the active menu item; moves vertically up and down between menu options.",
