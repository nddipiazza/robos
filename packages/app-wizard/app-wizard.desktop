[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Create Project & App Wizard
Comment=Create New Projects, Web Apps, Desktop Tools, and APIs or Import Code
Exec=/usr/bin/electron /usr/local/share/robos/app-wizard/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/app-wizard/icon.svg
Terminal=false
Categories=Development;
Keywords=create;project;new;app;wizard;scaffold;generate;
X-RobOS-Category=Dev
StartupWMClass=robos-app-wizard

