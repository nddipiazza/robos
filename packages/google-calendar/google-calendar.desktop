[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Google Calendar
Comment=Automatically install Mozilla Thunderbird and configure Google Calendar (CalDAV), Contacts (CardDAV), and optional Gmail (IMAP/SMTP) from your RobOS Cloud Account
Exec=/usr/bin/electron /usr/local/share/robos/google-calendar/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/google-calendar/icon.svg
Terminal=false
Categories=Office;Calendar;Network;
X-RobOS-Category=Internet
StartupWMClass=robos-google-calendar
