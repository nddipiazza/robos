    {
      "@id": "urn:robos:crpg:event:evt-gorion-awakening",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:description": "Gorion summons his ward to the library steps with urgent warnings of an imminent departure from Candlekeep.",
      "dcterms:title": "Gorion's Departure Directive",
      "robos:eventType": "dialogue",
      "robos:infinityInteraction": {
        "robos:bcsAction": "SetGlobal(\"spoke_to_gorion\", \"GLOBAL\", 1)\nAddJournalEntry(3001, QUEST)",
        "robos:bcsTrigger": "NumTimesTalkedTo(0) && Range(Player1, 15)",
        "robos:dialogueMachine": "urn:robos:infinity:subsystem:dialogue-state-machine",
        "robos:dialogueRef": "GORION.DLG:1:1",
        "robos:interactionType": "dialogue_branch",
        "robos:journalEntry": "Gorion urgently demands we gather provisions and depart Candlekeep before nightfall.",
        "robos:scriptVm": "urn:robos:infinity:subsystem:bcs-script-vm"
      },
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:stateMutations": {
        "setFlags": {
          "spoke_to_gorion": true
        },
        "xpAward": 50
      }
    },
    {
      "@id": "urn:robos:crpg:event:evt-guardian-sarevok-vanquished",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGGameEvent",
        "schema:Event"
      ],
      "dcterms:description": "Defeating the armored warlord Sarevok and saving Candlekeep from the mercenary conspiracy.",
      "dcterms:title": "Sarevok Vanquished: Savior of Candlekeep",
      "robos:eventType": "combat_victory",
      "robos:infinityInteraction": {
        "robos:bcsAction": "SetGlobal(\"sarevok_vanquished\", \"GLOBAL\", 1)\nSetGlobal(\"realm_saved\", \"GLOBAL\", 1)\nStartMovie(\"ENDMOVIE\")",
        "robos:bcsTrigger": "Dead(\"sarevok\") && Global(\"stood_with_gorion\", \"GLOBAL\", 1)",
        "robos:dialogueMachine": "urn:robos:infinity:subsystem:dialogue-state-machine",
        "robos:interactionType": "combat_encounter",
        "robos:journalEntry": "Sarevok lies defeated. Candlekeep and the Sword Coast are delivered from darkness.",
        "robos:scriptVm": "urn:robos:infinity:subsystem:bcs-script-vm"
      },
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:stateMutations": {
        "setFlags": {
          "realm_saved": true,
          "sarevok_vanquished": true
        },
        "xpAward": 1000
      }
    },
    {
      "@id": "urn:robos:crpg:event:evt-hasty-departure",
      "@type": [
        "oslc_am:Resource",
