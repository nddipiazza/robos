    {
      "@id": "urn:robos:tabletop:hero:trump",
      "@type": [
        "oslc_am:Resource",
        "robos:TabletopHero",
        "robos:GameCharacter",
        "schema:Person"
      ],
      "dcterms:title": "Donald Trump",
      "robos:category": "Midterms 2026",
      "robos:heroClass": "Dwarf",
      "robos:bodyPoints": 7,
      "robos:mindPoints": 3,
      "robos:attackDice": 2,
      "robos:defendDice": 2,
      "robos:startingWeapon": "urn:robos:game:item:shortsword",
      "robos:equippedWeapon": "Gilded Dwarven Battle-Axe (2 Combat Dice)",
      "robos:equippedArmor": "Gold-Plated Rune Mail (2 Defend Dice)",
      "robos:specialAbility": "Disarm Traps & Red-Tape Vaults",
      "robos:gold": 250,
      "robos:tokenColor": "#d97706",
      "robos:tokenAsset": "assets/tokens/token_trump.png",
      "robos:portraitAsset": "assets/portraits/card_bg_trump.png",
      "robos:icon": "\ud83e\ude93",
      "robos:startingPosition": [
        1,
        12
      ],
      "robos:inventory": [
        {
          "id": "item-toolkit-trump",
          "name": "Golden Dwarven Trap Toolkit",
          "type": "tool",
          "effect": "Disarms any pit, boulder, or bureaucratic trap",
          "value": 150
        },
        {
          "id": "item-pot-heal-trump",
          "name": "Elixir of Tremendous Stamina",
          "type": "potion",
          "effect": "Restores up to 4 BP",
          "value": 100
        }
      ],
      "dcterms:description": "Heavily armored Dwarf warrior sporting his signature golden hair and a magnificent braided golden Dwarven beard. Master trap disarmer and gilded dungeon builder.",
      "robos:package": "tabletop-game",
      "robos:namespace": "robos.tabletop",
      "robos:audioLines": {
        "turnStart": [
          {
            "text": "They're eating the dogs!",
            "audio": "res://assets/audio/heroes/trump_quote_1.ogg"
          },
          {
            "text": "Having built a perfect company!",
            "audio": "res://assets/audio/heroes/trump_quote_2.ogg"
          },
          {
            "text": "I do like my garbage truck!",
            "audio": "res://assets/audio/heroes/trump_quote_3.ogg"
          },
          {
            "text": "I took two cognitive tests \u2014 I aced them!",
            "audio": "res://assets/audio/heroes/trump_quote_4.ogg"
          },
          {
            "text": "Two regular club championships!",
            "audio": "res://assets/audio/heroes/trump_quote_5.ogg"
          },
          {
            "text": "She did things that nobody would ever think of!",
            "audio": "res://assets/audio/heroes/trump_quote_6.ogg"
          },
          {
            "text": "I'm not just MAGA \u2014 I'm Dark MAGA!",
            "audio": "res://assets/audio/heroes/trump_quote_7.ogg"
          },
          {
            "text": "We need Greenland for national security!",
            "audio": "res://assets/audio/heroes/trump_quote_8.ogg"
          }
        ],
        "moving": [
          {
            "text": "And I do it! He doesn't do it!",
            "audio": "res://assets/audio/heroes/trump_move_1.ogg"
          },
          {
            "text": "Hey, this is it!",
            "audio": "res://assets/audio/heroes/trump_move_2.ogg"
          },
          {
            "text": "What do you think?",
            "audio": "res://assets/audio/heroes/trump_move_3.ogg"
          },
          {
            "text": "To the Gulf of America!",
            "audio": "res://assets/audio/heroes/trump_move_4.ogg"
          },
          {
            "text": "I'd like to see him take one!",
            "audio": "res://assets/audio/heroes/trump_move_5.ogg"
          },
          {
            "text": "Would you look at what's happening?",
            "audio": "res://assets/audio/heroes/trump_move_6.ogg"
          }
        ],
        "attacking": [
          {
            "text": "He can't hit a ball 50 yards!",
            "audio": "res://assets/audio/heroes/trump_atk_1.ogg"
          },
          {
            "text": "I know how you swing!",
            "audio": "res://assets/audio/heroes/trump_atk_2.ogg"
          },
          {
            "text": "You will not take this man down!",
            "audio": "res://assets/audio/heroes/trump_atk_3.ogg"
          },
          {
            "text": "Sleepy Crooked Joe Biden!",
            "audio": "res://assets/audio/heroes/trump_atk_4.ogg"
          },
          {
            "text": "He challenged me to a golf match!",
            "audio": "res://assets/audio/heroes/trump_atk_5.ogg"
          },
          {
            "text": "That's for the free world!",
            "audio": "res://assets/audio/heroes/trump_atk_6.ogg"
          }
        ],
        "castingMagic": [
          {
            "text": "He can't hit a ball 50 yards!",
            "audio": "res://assets/audio/heroes/trump_atk_1.ogg"
          },
          {
            "text": "I know how you swing!",
            "audio": "res://assets/audio/heroes/trump_atk_2.ogg"
          },
          {
            "text": "You will not take this man down!",
            "audio": "res://assets/audio/heroes/trump_atk_3.ogg"
          },
          {
            "text": "Sleepy Crooked Joe Biden!",
            "audio": "res://assets/audio/heroes/trump_atk_4.ogg"
          },
          {
            "text": "He challenged me to a golf match!",
            "audio": "res://assets/audio/heroes/trump_atk_5.ogg"
          },
          {
            "text": "That's for the free world!",
            "audio": "res://assets/audio/heroes/trump_atk_6.ogg"
          }
        ],
        "attacked": [
          {
            "text": "Oh, no, no, no!",
            "audio": "res://assets/audio/heroes/trump_react_1.ogg"
          },
          {
            "text": "No way!",
            "audio": "res://assets/audio/heroes/trump_react_2.ogg"
          },
          {
            "text": "It's a disgrace!",
            "audio": "res://assets/audio/heroes/trump_react_3.ogg"
          },
          {
            "text": "He took none!",
            "audio": "res://assets/audio/heroes/trump_react_4.ogg"
          },
          {
            "text": "Thank you!",
            "audio": "res://assets/audio/heroes/trump_react_5.ogg"
          },
          {
            "text": "This is a persecution!",
            "audio": "res://assets/audio/heroes/trump_react_6.ogg"
          }
        ],
        "defended": [
          {
            "text": "Oh, no, no, no!",
            "audio": "res://assets/audio/heroes/trump_react_1.ogg"
          },
          {
            "text": "No way!",
            "audio": "res://assets/audio/heroes/trump_react_2.ogg"
          },
          {
            "text": "It's a disgrace!",
            "audio": "res://assets/audio/heroes/trump_react_3.ogg"
          },
          {
            "text": "He took none!",
            "audio": "res://assets/audio/heroes/trump_react_4.ogg"
          },
          {
            "text": "Thank you!",
            "audio": "res://assets/audio/heroes/trump_react_5.ogg"
          },
          {
            "text": "This is a persecution!",
            "audio": "res://assets/audio/heroes/trump_react_6.ogg"
          }
        ]
      }
