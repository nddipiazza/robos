    },
    "robos:classification": {
      "@container": "@set",
      "@id": "robos:classification",
      "@type": "@id"
    },
    "robos:evidence": {
      "@container": "@set",
      "@context": {
        "line": {
          "@id": "robos:sourceLine",
          "@type": "xsd:integer"
        },
        "path": "robos:sourcePath",
        "repository": "robos:sourceRepository",
        "revision": "robos:sourceRevision",
        "sha256": "robos:sourceHash",
        "workingTreeStatus": "robos:workingTreeStatus"
      },
      "@id": "robos:evidence"
    },
    "robos:inputSchema": {
      "@id": "robos:inputSchema",
      "@type": "@json"
    },
    "robos:mcpServer": {
      "@id": "robos:mcpServer",
      "@type": "@id"
    },
    "robos:outputSchema": {
      "@id": "robos:outputSchema",
      "@type": "@json"
    },
    "robos:parameters": {
      "@id": "robos:parameters",
      "@type": "@json"
    },
    "robos:promptsProvided": {
      "@container": "@set",
      "@id": "robos:promptsProvided",
      "@type": "@id"
    },
    "robos:protocolReference": {
      "@id": "robos:protocolReference",
      "@type": "@id"
    },
    "robos:provenance": {
      "@id": "robos:provenance",
      "@type": "@json"
    },
    "robos:relationshipEvidence": {
      "@container": "@set",
      "@context": {
        "condition": "robos:condition",
        "evidence": {
          "@container": "@set",
          "@context": {
            "line": {
              "@id": "robos:sourceLine",
              "@type": "xsd:integer"
            },
            "path": "robos:sourcePath",
            "repository": "robos:sourceRepository",
            "revision": "robos:sourceRevision",
            "sha256": "robos:sourceHash",
            "workingTreeStatus": "robos:workingTreeStatus"
          },
          "@id": "robos:evidence"
        },
        "note": "dcterms:description",
        "predicate": {
          "@id": "robos:predicate",
          "@type": "@vocab"
        },
        "status": "robos:evidenceStatus",
        "target": {
          "@id": "robos:target",
          "@type": "@id"
        }
      },
      "@id": "robos:relationshipEvidence"
    },
    "robos:resourcesProvided": {
      "@container": "@set",
      "@id": "robos:resourcesProvided",
      "@type": "@id"
    },
