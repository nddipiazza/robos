# Neon Postgres (Vercel Marketplace injects this). Leave empty locally to use embedded PGlite.
DATABASE_URL=
# Vercel Cron bearer secret for /api/cron/settle
CRON_SECRET=
# Optional: lets E2E runs skip rate limits/honeypot when sent as x-e2e-key (>= 24 chars)
E2E_BYPASS_KEY=
# reCAPTCHA v3 (disabled by default)
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
NEXT_PUBLIC_RECAPTCHA_ENABLED=false
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
