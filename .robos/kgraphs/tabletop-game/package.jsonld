          },
          {
            "text": "Uhh... executive action!",
            "audio": "res://assets/audio/heroes/obama_atk_6.ogg"
          }
        ],
        "attacked": [
          {
            "text": "Uhh... watch the suit!",
            "audio": "res://assets/audio/heroes/obama_react_1.ogg"
          },
          {
            "text": "Uhh... nice try!",
            "audio": "res://assets/audio/heroes/obama_react_2.ogg"
          },
          {
            "text": "Uhh... excuse me!",
            "audio": "res://assets/audio/heroes/obama_react_3.ogg"
          },
          {
            "text": "Uhh... hold on now!",
            "audio": "res://assets/audio/heroes/obama_react_4.ogg"
          },
          {
            "text": "Uhh... not today!",
