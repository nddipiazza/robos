#!/bin/bash
# Stub for: ssh
# Handles ssh -T git@github.com connection test

SCENARIO="${ROBOS_SCENARIO:-all-good}"

# Only intercept github.com tests
if echo "$*" | grep -q "github.com"; then
  if [ "$SCENARIO" = "ssh-not-on-github" ] || [ "$SCENARIO" = "no-ssh-key" ] || [ "$SCENARIO" = "all-broken" ] || [ "$SCENARIO" = "scope-missing" ]; then
    echo "git@github.com: Permission denied (publickey)." >&2
    exit 255
  fi
  echo "Hi testuser! You've successfully authenticated, but GitHub does not provide shell access." >&2
  exit 1  # GitHub always exits 1 even on success
fi

# Pass through all other ssh calls to real ssh
exec /usr/bin/ssh "$@"
