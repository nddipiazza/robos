[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Voice Prompt
Comment=Voice Prompt Agent — dictation to text with active RobOS app context metadata
Exec=/usr/bin/electron /usr/local/share/robos/voice-prompt/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/voice-prompt/icon.svg
Terminal=false
Categories=Development;
X-RobOS-Category=AI
StartupWMClass=robos-voice-prompt
