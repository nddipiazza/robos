[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Cloud Accounts
Comment=Unified Cloud Accounts manager for Google Workspace (Drive, Calendar, Contacts, Gmail), Microsoft 365/OneDrive, Nextcloud, Dropbox, and S3
Exec=/usr/bin/electron /usr/local/share/robos/cloud-accounts/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/cloud-accounts/icon.svg
Terminal=false
Categories=System;Settings;Network;
X-RobOS-Category=System
StartupWMClass=robos-cloud-accounts
