[Desktop Entry]
Version=1.0
X-RobOS-Category=RobOS System
X-RobOS-App=true
Name=RobOS Search Index
Comment=File system indexer for @-mention search across RobOS apps
Exec=/usr/bin/electron /usr/local/share/robos/search-index/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/search-index/icon.svg
Terminal=false
Type=Application
Categories=System;
StartupWMClass=search-index
