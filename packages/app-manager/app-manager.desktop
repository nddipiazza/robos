[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS App Manager
Comment=Choose, download, launch and remove RobOS apps
Exec=/usr/bin/electron /usr/local/share/robos/app-manager/main.js --disable-dev-shm-usage
Icon=/usr/local/share/robos/app-manager/icon.svg
Terminal=false
Categories=Utility;
X-RobOS-Category=System
StartupWMClass=robos-app-manager
