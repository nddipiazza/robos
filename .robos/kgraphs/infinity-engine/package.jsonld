    {
      "@id": "urn:robos:infinity:contract:2da",
      "@type": [
        "oslc_am:Resource",
        "robos:Contract"
      ],
      "dcterms:title": "2DA (Two-Dimensional Array Rule Matrix) Contract",
      "robos:specFile": "schemas/iesdp/2DA.md",
      "robos:protocol": "ASCII/IESDP",
      "robos:magicHeader": "2DA V1.0",
      "robos:formatSpecification": "Whitespace-separated tabular ASCII matrix. Line 1: '2DA V1.0'. Line 2: default value for missing cells (e.g., '*'). Line 3: Column headers. Subsequent lines: Row header followed by cell values. Used for THAC0 progressions, saving throws, class kits, and experience tables.",
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:contract:are",
      "@type": [
        "oslc_am:Resource",
        "robos:Contract"
      ],
      "dcterms:title": "ARE (Area / Map Structure) Contract",
      "robos:specFile": "schemas/iesdp/ARE.md",
      "robos:protocol": "Binary/IESDP",
      "robos:magicHeader": "AREA V1.0",
      "robos:binaryLayout": {
        "headerBytes": 284,
        "keyOffsets": [
          {
            "offset": 8,
            "name": "wed_resref",
            "type": "char[8]"
          },
          {
            "offset": 84,
            "name": "actors_offset",
            "type": "uint32"
          },
