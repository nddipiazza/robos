# RobOS tint2 panel configuration
# Minimal dark panel with a single RobOS Agent launcher on the left,
# open windows in the middle, system tray + JIRA widget + clock on the right.

# ── Background definitions ──────────────────────────────────────────────────
# bg 1 — panel background
rounded = 0
border_width = 0
background_color = #16213e 97
border_color = #000000 0

# bg 2 — active / hovered task
rounded = 3
border_width = 0
background_color = #2a2a5a 100
border_color = #000000 0

# bg 3 — launcher icon hover
rounded = 4
border_width = 0
background_color = #1e3a5f 100
border_color = #00bcd4 40

# bg 4 — JIRA widget background
rounded = 4
border_width = 1
background_color = #0d1a2e 100
border_color = #00bcd4 60

# ── Panel ────────────────────────────────────────────────────────────────────
panel_items = PLTSCE
panel_size = 100% 38
panel_margin = 0 0
panel_padding = 4 0 4
panel_background_id = 1
panel_position = bottom left horizontal
panel_layer = top
panel_monitor = all
wm_menu = 0
panel_dock = 0
autohide = 0
panel_window_name = tint2

# ── Desktop pager ─────────────────────────────────────────────────────────────
pager_margin = 4 3
pager_padding = 2 2 2
pager_background_id = 0
pager_active_background_id = 2
pager_desktop_name_font = sans bold 8
pager_desktop_name_font_color = #8888aa 100
pager_hilight_font_color = #00bcd4 100

# ── Launcher ─────────────────────────────────────────────────────────────────
launcher_padding = 4 3 6
launcher_background_id = 0
launcher_icon_background_id = 3
launcher_icon_size = 24
launcher_icon_asb = 100 0 0
launcher_icon_theme_override = 0
startup_notifications = 0
launcher_tooltip = 1
launcher_item_app = /usr/local/share/applications/app-launcher.desktop
launcher_item_app = /usr/local/share/applications/agents-manager.desktop
launcher_item_app = /usr/local/share/applications/copilot-cli.desktop
launcher_item_app = /usr/local/share/applications/issue-manager.desktop
launcher_item_app = /usr/local/share/applications/git-projects.desktop
launcher_item_app = /usr/share/applications/com.gexperts.Tilix.desktop
launcher_item_app = /usr/local/share/applications/robos-chrome.desktop
launcher_item_app = /usr/share/applications/code.desktop
launcher_item_app = /usr/local/share/applications/robos-gnome-sysmon.desktop

# ── Taskbar ───────────────────────────────────────────────────────────────────
taskbar_mode = single_desktop
taskbar_padding = 2 2 2
taskbar_background_id = 0
taskbar_active_background_id = 2
task_icon = 1
task_text = 1
task_maximum_size = 200 34
task_padding = 6 3 6
task_background_id = 0
task_active_background_id = 2
task_font = sans 9
task_font_color = #aaaacc 100
task_active_font_color = #e0e0ff 100
task_iconified_font_color = #666688 100
task_iconified_background_id = 0
task_tooltip = 1
task_left_click_action = toggle_iconify

# ── System tray ───────────────────────────────────────────────────────────────
systray_padding = 4 3 6
systray_background_id = 0
systray_sort = right2left
systray_icon_size = 20
systray_icon_asb = 100 0 0
systray_monitor = primary

# ── Issue widget ──────────────────────────────────────────────────────────────
execp_command = /usr/local/share/robos/task-widget.sh
execp_interval = 3
execp_has_icon = 0
execp_cache_icon = 0
execp_continuous = 0
execp_markup = 0
execp_lclick_command = python3 /usr/local/share/robos/task-search.py
execp_font = sans bold 9
execp_font_color = #00bcd4 100
execp_padding = 10 0 10
execp_background_id = 4
execp_centered = 1
execp_tooltip = Click to select active issue

# ── Clock ─────────────────────────────────────────────────────────────────────
time1_format = %H:%M
time1_font = sans bold 10
time1_timezone =
time2_format = %a %d %b
time2_font = sans 8
time2_timezone =
clock_font_color = #8888aa 100
clock_padding = 8 0 8
clock_background_id = 0

