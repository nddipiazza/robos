[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS App Wizard
Comment=Develop New Apps or Import Existing Repositories across 6 Multi-App Archetypes
Exec=/usr/bin/electron /usr/local/share/robos/app-wizard/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/app-wizard/icon.svg
Terminal=false
Categories=Development;
X-RobOS-Category=Dev
StartupWMClass=robos-app-wizard
