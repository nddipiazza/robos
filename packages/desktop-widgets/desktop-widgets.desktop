[Desktop Entry]
Version=1.0
X-RobOS-Category=RobOS System
X-RobOS-App=true
Name=RobOS Desktop Widgets
Comment=Status overlay widgets for active task, system stats, and journal
Exec=/usr/bin/electron /usr/local/share/robos/desktop-widgets/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/desktop-widgets/icon.svg
Terminal=false
Type=Application
Categories=System;
StartupWMClass=desktop-widgets
