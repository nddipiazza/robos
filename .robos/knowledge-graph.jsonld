      "@id": "urn:robos:console-app:rest-client",
      "@type": [
        "robos:ConsoleApp",
        "oslc_am:Resource",
        "c4:Container"
      ],
      "dcterms:title": "Rest Client CLI",
      "dcterms:description": "Command-line terminal tool providing automated workflows and administration for Rest Client.",
