[Desktop Entry]
X-RobOS-Category=Security
X-RobOS-App=true
Name=Security Setup
Comment=First-run GPG and SSH key initialization wizard
Exec=/usr/bin/electron /usr/local/share/robos/security-setup/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/security-setup/icon.svg
Terminal=false
Type=Application
Categories=Utility;Security;
StartupWMClass=robos-security-setup
