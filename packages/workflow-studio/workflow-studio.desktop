[Desktop Entry]
X-RobOS-App=true
X-RobOS-Category=Development
Type=Application
Name=Workflow Studio
Comment=Define issue types, workflow states, and AI agent actions
Exec=/usr/bin/electron /usr/local/share/robos/workflow-studio/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/workflow-studio/icon.svg
Terminal=false
Categories=Development;
StartupWMClass=robos-workflow-studio
