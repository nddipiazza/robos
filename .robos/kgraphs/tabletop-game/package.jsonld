      "robos:tokenAsset": "assets/tokens/token_dwarf.png",
      "robos:portraitAsset": "assets/portraits/card_bg_dwarf.png",
      "robos:audioLines": {
        "turnStart": [
          {
            "text": "Stand back! Let a Dwarf of the World's Edge Mountains handle this!",
            "audio": "res://assets/audio/heroes/dwarf_turn_start.ogg"
          }
        ],
        "attacking": [
          {
            "text": "For Grungni's beard, feel my battle-axe!",
            "audio": "res://assets/audio/heroes/dwarf_attacking.ogg"
          }
        ],
        "attacked": [
          {
            "text": "Oof! Right in the chainmail!",
            "audio": "res://assets/audio/heroes/dwarf_attacked.ogg"
          }
        ],
        "defended": [
          {
            "text": "Dwarven forged steel never yields!",
            "audio": "res://assets/audio/heroes/dwarf_defended.ogg"
          }
        ],
        "castingMagic": [
          {
            "text": "By the runes of the anvil, awaken!",
            "audio": "res://assets/audio/heroes/dwarf_casting_magic.ogg"
          }
        ]
      }
    },
    {
