[Desktop Entry]
X-RobOS-App=true
X-RobOS-Category=Development
Type=Application
Name=CI Monitor
Comment=CI/CD pipeline status, build logs, and AI failure diagnosis
Exec=/usr/bin/electron /usr/local/share/robos/ci-monitor/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/ci-monitor/icon.svg
Terminal=false
Categories=Development;
StartupWMClass=robos-ci-monitor
