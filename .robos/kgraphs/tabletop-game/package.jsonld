        "schema:Person"
      ],
      "dcterms:description": "High-born Lord of the Rings Woodland Elf noble with a sly, knowing smile, emerald leaf-brooch cloak, and silver circlet. Combines deft blade work with 1 college of spells.",
      "dcterms:title": "Hillary Clinton",
      "robos:attackDice": 3,
      "robos:audioLines": {
        "attacked": [
          {
            "audio": "res://assets/audio/heroes/hillary_react_1.ogg",
            "text": "Ha ha ha!"
          },
          {
            "audio": "res://assets/audio/heroes/hillary_react_2.ogg",
            "text": "What, like with a cloth?!"
          },
          {
            "audio": "res://assets/audio/heroes/hillary_react_3.ogg",
            "text": "Well, I don't know!"
          },
          {
            "audio": "res://assets/audio/heroes/hillary_react_4.ogg",
            "text": "No personal!"
          },
          {
            "audio": "res://assets/audio/heroes/hillary_react_5.ogg",
            "text": "What difference?!"
          },
          {
            "audio": "res://assets/audio/heroes/hillary_react_6.ogg",
            "text": "Thank you very much!"
          }
        ],
        "attacking": [
          {
            "audio": "res://assets/audio/heroes/hillary_atk_1.ogg",
            "text": "We will attack Iran!"
          },
          {
            "audio": "res://assets/audio/heroes/hillary_atk_2.ogg",
            "text": "First we have to bring them to heel!"
          },
          {
            "audio": "res://assets/audio/heroes/hillary_atk_3.ogg",
            "text": "Against Syria and Russia!"
          },
          {
            "audio": "res://assets/audio/heroes/hillary_atk_4.ogg",
            "text": "We came, we saw, he died!"
          },
          {
            "audio": "res://assets/audio/heroes/hillary_atk_5.ogg",
            "text": "I cast it with conviction!"
          },
          {
            "audio": "res://assets/audio/heroes/hillary_atk_6.ogg",
            "text": "Okay, we'll try that, super predator!"
          }
        ],
        "castingMagic": [
          {
            "audio": "res://assets/audio/heroes/hillary_atk_1.ogg",
            "text": "We will attack Iran!"
