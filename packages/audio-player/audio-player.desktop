[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Audio Player
Comment=Open-source audio player with Howler.js and zero-cloud Google Home / Cast speaker streaming
Exec=/usr/bin/electron /usr/local/share/robos/audio-player/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/audio-player/icon.svg
Terminal=false
Categories=AudioVideo;Audio;Player;
X-RobOS-Category=Tools
StartupWMClass=robos-audio-player
