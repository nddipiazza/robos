          "robos:audioLines": {
            "turnStart": [
              {
                "text": "Uhh... let me be clear... about hope.",
                "audio": "res://assets/audio/heroes/obama_quote_1.ogg"
              },
              {
                "text": "Uhh... that is the audacity... of hope.",
                "audio": "res://assets/audio/heroes/obama_quote_2.ogg"
              },
              {
                "text": "Uhh... folks... hope always finds a way.",
                "audio": "res://assets/audio/heroes/obama_quote_3.ogg"
              },
              {
                "text": "Uhh... yes we can... roll these dice.",
                "audio": "res://assets/audio/heroes/obama_quote_4.ogg"
              },
              {
                "text": "Uhh... make no mistake... hope is here.",
                "audio": "res://assets/audio/heroes/obama_quote_5.ogg"
              },
              {
                "text": "Uhh... look... we are marching... with hope.",
                "audio": "res://assets/audio/heroes/obama_quote_6.ogg"
              },
              {
                "text": "Uhh... change... has come to this dungeon.",
                "audio": "res://assets/audio/heroes/obama_quote_7.ogg"
              },
              {
                "text": "Uhh... Michelle and I... believe in hope.",
                "audio": "res://assets/audio/heroes/obama_quote_8.ogg"
              }
            ],
            "moving": [
              {
                "text": "Uhh... stepping forward.",
                "audio": "res://assets/audio/heroes/obama_move_1.ogg"
              },
              {
                "text": "Uhh... moving with hope.",
                "audio": "res://assets/audio/heroes/obama_move_2.ogg"
              },
              {
                "text": "Uhh... let's keep moving, folks.",
                "audio": "res://assets/audio/heroes/obama_move_3.ogg"
              },
              {
                "text": "Uhh... into the corridor.",
                "audio": "res://assets/audio/heroes/obama_move_4.ogg"
              },
              {
                "text": "Uhh... one step closer.",
                "audio": "res://assets/audio/heroes/obama_move_5.ogg"
              },
              {
                "text": "Uhh... on the move.",
                "audio": "res://assets/audio/heroes/obama_move_6.ogg"
              }
            ],
            "attacking": [
              {
                "text": "Uhh... taste the blade of hope!",
                "audio": "res://assets/audio/heroes/obama_atk_1.ogg"
              },
              {
                "text": "Uhh... strike for change!",
                "audio": "res://assets/audio/heroes/obama_atk_2.ogg"
              },
              {
                "text": "Uhh... feel the audacity!",
                "audio": "res://assets/audio/heroes/obama_atk_3.ogg"
              },
              {
                "text": "Uhh... take that, folks!",
                "audio": "res://assets/audio/heroes/obama_atk_4.ogg"
