[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Smart Home
Comment=Control your lights and see the status of your LG appliances
Exec=/usr/bin/electron /usr/local/share/robos/smart-home/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/smart-home/icon.svg
Terminal=false
Categories=Utility;
X-RobOS-Category=Tools
StartupWMClass=robos-smart-home
