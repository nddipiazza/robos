#!/bin/bash
# Stub for: claude (Claude Code CLI)
# Used by agents-manager to detect installation + version.

case "$1" in
  --version)
    echo "Claude Code 1.2.3 (stub)"
    exit 0
    ;;
  --help|-h)
    echo "Claude Code CLI — stub for RobOS demo tests"
    exit 0
    ;;
  *)
    if echo "$*" | grep -q -- "--output-format stream-json"; then
      echo '{"type":"assistant","message":{"content":[{"type":"text","text":"Reading task description and exploring the repo…\n"}]}}'
      sleep 0.2
      echo '{"type":"assistant","message":{"content":[{"type":"text","text":"Identified the change required.\n"}]}}'
      sleep 0.2
      echo '{"type":"assistant","message":{"content":[{"type":"text","text":"Drafting the patch in src/auth/login.ts.\n"}]}}'
      sleep 0.2
      echo '{"type":"result","result":"Done. Summary: implemented the login endpoint with rate limiting.\n"}'
    else
      echo "claude stub: $*"
    fi
    exit 0
    ;;
esac
