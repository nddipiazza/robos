[Desktop Entry]
Version=1.0
X-RobOS-Category=RobOS System
X-RobOS-App=true
Name=RobOS Notifications
Comment=Category-filtered notification history viewer with preferences editor
Exec=/usr/bin/electron /usr/local/share/robos/notifications/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/notifications/icon.svg
Terminal=false
Type=Application
Categories=System;
StartupWMClass=notifications
