#!/usr/bin/env bash
# robos-session — RobOS desktop session entry point (xfwm4-based)
# Started by LightDM as the user session.

# ── Environment ───────────────────────────────────────────────────────────────
export GTK_THEME=Adwaita:dark
export GTK2_RC_FILES="$HOME/.gtkrc-2.0"
export GTK_CSD=0

# ── Background ────────────────────────────────────────────────────────────────
xsetroot -solid "#1a1a2e" &

# ── Xresources ────────────────────────────────────────────────────────────────
[ -f ~/.Xresources ] && xrdb -merge ~/.Xresources &

# ── Resolution ───────────────────────────────────────────────────────────────
(sleep 1 && xrandr --output Virtual-1 --mode 1920x1080 2>/dev/null) &

# ── Tilix dark profile ────────────────────────────────────────────────────────
[ -x /usr/local/share/robos/configure-tilix.sh ] && /usr/local/share/robos/configure-tilix.sh &

# ── tint2 panel ───────────────────────────────────────────────────────────────
tint2 -c ~/.config/tint2/tint2rc &

# ── xfwm4 — window manager (foreground, keeps session alive) ─────────────────
# xfwm4 has its own compositor; no need for picom.
exec xfwm4 --compositor=on
