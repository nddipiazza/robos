{
  "@context": {
    "oslc": "http://open-services.net/ns/core#",
    "oslc_am": "http://open-services.net/ns/am#",
    "oslc_cm": "http://open-services.net/ns/cm#",
    "oslc_rm": "http://open-services.net/ns/rm#",
    "oslc_qm": "http://open-services.net/ns/qm#",
    "robos": "https://robos.dev/ns/sdlc#",
    "c4": "https://c4model.com/ns#",
    "pact": "https://pact.io/ns#",
    "dcterms": "http://purl.org/dc/terms/",
    "schema": "https://schema.org/"
  },
  "@id": "urn:robos:package:devops",
  "@type": [
    "oslc:ServiceProvider",
    "robos:Package"
  ],
  "robos:package": "devops",
  "robos:namespace": "robos.devops",
  "robos:version": "1.0.0",
  "dcterms:title": "devops Package",
  "dcterms:description": "",
  "robos:nodes": [
    {
      "@id": "urn:robos:devops:github:enterprise",
      "@type": [
        "oslc_config:ConfigurationItem",
        "robos:DevOpsIntegration"
      ],
      "dcterms:title": "GitHub Enterprise Server",
      "robos:category": "source-control",
      "robos:categoryName": "Source Control & Git",
      "robos:provider": "github",
      "robos:providerName": "GitHub Cloud & Enterprise",
      "robos:endpointUrl": "https://github.internal.acme.com",
      "robos:status": "connected",
      "robos:package": "devops",
      "robos:namespace": "robos.devops"
    },
    {
      "@id": "urn:robos:remote-execution:acme-buildbarn-cluster",
      "@type": [
        "robos:RemoteExecutionCluster",
        "robos:RemoteBuildCluster",
        "oslc:Resource"
      ],
      "dcterms:title": "Acme Production Buildbarn REAPI Cluster",
      "dcterms:description": "High-performance distributed remote execution & CAS caching cluster using Buildbarn suite.",
      "robos:protocol": "REAPI_v2",
      "robos:provider": "buildbarn",
      "robos:instanceName": "main",
      "robos:executionEndpoint": "grpc://re-execution.buildbarn.internal:8980",
      "robos:casEndpoint": "grpc://re-cas.buildbarn.internal:8980",
      "robos:actionCacheEndpoint": "grpc://re-cas.buildbarn.internal:8980",
      "robos:browserEndpoint": "http://re-browser.buildbarn.internal:7984",
      "robos:tlsEnabled": false,
      "robos:status": "active",
      "robos:workerPools": [
        {
          "name": "linux-x86_64-large",
          "osFamily": "linux",
          "isa": "x86-64",
          "containerImage": "docker://gcr.io/cloud-marketplace/google/debian11:latest",
          "concurrency": 64
        }
      ],
      "robos:cacheSettings": {
        "maxSizeBytes": "500GB",
        "retentionDays": 14,
        "evictionPolicy": "lru"
      },
      "robos:package": "devops",
      "robos:namespace": "robos.devops"
    }
  ],
  "@graph": [
    {
      "@id": "urn:robos:devops:github:enterprise",
      "@type": [
        "oslc_config:ConfigurationItem",
        "robos:DevOpsIntegration"
      ],
      "dcterms:title": "GitHub Enterprise Server",
      "robos:category": "source-control",
      "robos:categoryName": "Source Control & Git",
      "robos:provider": "github",
      "robos:providerName": "GitHub Cloud & Enterprise",
      "robos:endpointUrl": "https://github.internal.acme.com",
      "robos:status": "connected",
      "robos:package": "devops",
      "robos:namespace": "robos.devops"
    },
    {
      "@id": "urn:robos:remote-execution:acme-buildbarn-cluster",
      "@type": [
        "robos:RemoteExecutionCluster",
        "robos:RemoteBuildCluster",
        "oslc:Resource"
      ],
      "dcterms:title": "Acme Production Buildbarn REAPI Cluster",
      "dcterms:description": "High-performance distributed remote execution & CAS caching cluster using Buildbarn suite.",
      "robos:protocol": "REAPI_v2",
      "robos:provider": "buildbarn",
      "robos:instanceName": "main",
      "robos:executionEndpoint": "grpc://re-execution.buildbarn.internal:8980",
      "robos:casEndpoint": "grpc://re-cas.buildbarn.internal:8980",
      "robos:actionCacheEndpoint": "grpc://re-cas.buildbarn.internal:8980",
      "robos:browserEndpoint": "http://re-browser.buildbarn.internal:7984",
      "robos:tlsEnabled": false,
      "robos:status": "active",
      "robos:workerPools": [
        {
          "name": "linux-x86_64-large",
          "osFamily": "linux",
          "isa": "x86-64",
          "containerImage": "docker://gcr.io/cloud-marketplace/google/debian11:latest",
          "concurrency": 64
        }
      ],
      "robos:cacheSettings": {
        "maxSizeBytes": "500GB",
        "retentionDays": 14,
        "evictionPolicy": "lru"
      },
      "robos:package": "devops",
      "robos:namespace": "robos.devops"
    }
  ]
