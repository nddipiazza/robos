    {
      "@id": "urn:robos:tabletop:hero:hillary-clinton",
      "@type": [
        "oslc_am:Resource",
        "robos:TabletopHero",
        "robos:GameCharacter",
        "schema:Person"
      ],
      "dcterms:title": "Hillary Clinton",
      "robos:category": "Midterms 2026",
      "robos:heroClass": "Elf",
      "robos:bodyPoints": 6,
      "robos:mindPoints": 4,
      "robos:attackDice": 2,
      "robos:defendDice": 2,
      "robos:startingWeapon": "urn:robos:game:item:shortsword",
      "robos:equippedWeapon": "Lothlorien Sting-Blade (2 Combat Dice)",
      "robos:equippedArmor": "Woodland Elven Cloak & Circlet (2 Defend Dice)",
      "robos:specialAbility": "Spellcaster (1 College \u2014 3 Spells)",
      "robos:gold": 150,
      "robos:tokenColor": "#059669",
      "robos:tokenAsset": "assets/tokens/token_hillary_clinton.png",
      "robos:portraitAsset": "assets/portraits/card_bg_hillary_clinton.png",
      "robos:icon": "\ud83c\udff9",
      "robos:startingPosition": [
        0,
        13
      ],
      "robos:inventory": [
        {
          "id": "item-scroll-hillary",
          "name": "Classified Elven Parchment",
          "type": "relic",
          "effect": "Reveals hidden doors in current corridor",
          "value": 120
        },
        {
          "id": "item-pot-heal-hillary",
          "name": "Draught of Miruvor",
          "type": "potion",
          "effect": "Restores up to 4 BP",
          "value": 100
        }
      ],
      "dcterms:description": "High-born Lord of the Rings Woodland Elf noble with a sly, knowing smile, emerald leaf-brooch cloak, and silver circlet. Combines deft blade work with 1 college of spells.",
      "robos:package": "tabletop-game",
      "robos:namespace": "robos.tabletop",
      "robos:audioLines": {
        "turnStart": [
          {
            "text": "But I cast it with conviction!",
            "audio": "res://assets/audio/heroes/hillary_quote_1.ogg"
          },
          {
            "text": "We came, we saw, he died!",
            "audio": "res://assets/audio/heroes/hillary_quote_2.ogg"
          },
          {
            "text": "What difference, at this point, does it make?!",
            "audio": "res://assets/audio/heroes/hillary_quote_3.ogg"
          },
          {
            "text": "I'm always proud of Walmart and what we do!",
            "audio": "res://assets/audio/heroes/hillary_quote_4.ogg"
          },
          {
            "text": "If you've got a business, you didn't build that!",
            "audio": "res://assets/audio/heroes/hillary_quote_5.ogg"
          },
          {
            "text": "I've now been in 57 states!",
            "audio": "res://assets/audio/heroes/hillary_quote_6.ogg"
          },
          {
            "text": "Not only dead broke, but in debt!",
            "audio": "res://assets/audio/heroes/hillary_quote_7.ogg"
          },
          {
            "text": "No conscience, no empathy!",
            "audio": "res://assets/audio/heroes/hillary_quote_8.ogg"
          }
        ],
        "moving": [
          {
            "text": "I think one left to go!",
            "audio": "res://assets/audio/heroes/hillary_move_1.ogg"
          },
          {
            "text": "One left to go!",
            "audio": "res://assets/audio/heroes/hillary_move_2.ogg"
          },
          {
            "text": "I'm sure it is!",
            "audio": "res://assets/audio/heroes/hillary_move_3.ogg"
          },
          {
            "text": "There's more work to be done!",
            "audio": "res://assets/audio/heroes/hillary_move_4.ogg"
          },
          {
            "text": "Okay, back to the issues!",
            "audio": "res://assets/audio/heroes/hillary_move_5.ogg"
          },
          {
            "text": "Somebody else made that happen!",
            "audio": "res://assets/audio/heroes/hillary_move_6.ogg"
          }
        ],
        "attacking": [
          {
            "text": "We will attack Iran!",
            "audio": "res://assets/audio/heroes/hillary_atk_1.ogg"
          },
          {
            "text": "First we have to bring them to heel!",
            "audio": "res://assets/audio/heroes/hillary_atk_2.ogg"
          },
          {
            "text": "Against Syria and Russia!",
            "audio": "res://assets/audio/heroes/hillary_atk_3.ogg"
          },
          {
            "text": "We came, we saw, he died!",
            "audio": "res://assets/audio/heroes/hillary_atk_4.ogg"
          },
          {
            "text": "I cast it with conviction!",
            "audio": "res://assets/audio/heroes/hillary_atk_5.ogg"
          },
          {
            "text": "Okay, we'll try that, super predator!",
            "audio": "res://assets/audio/heroes/hillary_atk_6.ogg"
          }
        ],
        "castingMagic": [
          {
            "text": "We will attack Iran!",
            "audio": "res://assets/audio/heroes/hillary_atk_1.ogg"
          },
          {
            "text": "First we have to bring them to heel!",
            "audio": "res://assets/audio/heroes/hillary_atk_2.ogg"
          },
          {
            "text": "Against Syria and Russia!",
            "audio": "res://assets/audio/heroes/hillary_atk_3.ogg"
          },
          {
            "text": "We came, we saw, he died!",
            "audio": "res://assets/audio/heroes/hillary_atk_4.ogg"
          },
          {
            "text": "I cast it with conviction!",
            "audio": "res://assets/audio/heroes/hillary_atk_5.ogg"
          },
          {
            "text": "Okay, we'll try that, super predator!",
            "audio": "res://assets/audio/heroes/hillary_atk_6.ogg"
          }
        ],
        "attacked": [
          {
            "text": "Ha ha ha!",
            "audio": "res://assets/audio/heroes/hillary_react_1.ogg"
          },
          {
            "text": "What, like with a cloth?!",
            "audio": "res://assets/audio/heroes/hillary_react_2.ogg"
          },
          {
            "text": "Well, I don't know!",
            "audio": "res://assets/audio/heroes/hillary_react_3.ogg"
          },
          {
            "text": "No personal!",
            "audio": "res://assets/audio/heroes/hillary_react_4.ogg"
          },
          {
            "text": "What difference?!",
            "audio": "res://assets/audio/heroes/hillary_react_5.ogg"
          },
          {
            "text": "Thank you very much!",
            "audio": "res://assets/audio/heroes/hillary_react_6.ogg"
          }
        ],
        "defended": [
          {
            "text": "Ha ha ha!",
            "audio": "res://assets/audio/heroes/hillary_react_1.ogg"
          },
          {
            "text": "What, like with a cloth?!",
            "audio": "res://assets/audio/heroes/hillary_react_2.ogg"
