    {
      "@id": "urn:robos:library:robos-llm",
      "@type": [
        "robos:Library",
        "oslc:Resource",
        "schema:SoftwareApplication"
      ],
      "dcterms:description": "Opt-in direct model calls for quick one-shot requests and embeddings through LangChain.js: Anthropic, OpenAI, Google Gemini and local Ollama. Off by default; the coding-agent CLIs (Claude Code, Codex, Gemini CLI / Antigravity, GitHub Copilot) stay the default path and the fallback. Packages install on request into ~/.local/share/robos/llm-deps; API keys are read from pass (robos/ai/<provider>-key); prompts pass through the Prompt Security Guard; LangSmith tracing is forced off.",
      "dcterms:title": "RobOS LLM (optional API mode)",
      "robos:defaultEnabled": false,
      "robos:dependsOn": [
        "urn:robos:security:prompt-security-guard"
      ],
      "robos:domainStandard": "https://js.langchain.com/",
      "robos:namespace": "robos.core",
      "robos:package": "core-platform",
      "robos:refersFrom": "https://schema.org/SoftwareSourceCode",
      "robos:repository": "github.com/nddipiazza/robos",
      "robos:schemaOrgType": "https://schema.org/SoftwareApplication",
      "robos:sourcePath": "packages/robos-llm",
      "robos:supportedProviders": [
        "anthropic",
        "openai",
        "gemini",
        "ollama"
      ],
      "robos:tags": [
        "ai",
        "llm",
        "api-mode",
        "embeddings",
        "semantic-search",
        "langchain",
        "optional"
      ],
      "robos:technology": "Node.js 20 / LangChain.js"
    },
    {
      "@id": "urn:robos:mcp:context-engine",
      "@type": [
        "oslc_am:Resource",
        "robos:MCPServer",
        "robos:ToolProvider",
        "schema:SoftwareApplication"
      ],
      "dcterms:description": "Stdio MCP server exposing AST symbols, codebase indexing, and symbol resolution.",
      "dcterms:title": "RobOS Code Context MCP Server",
      "robos:command": "/usr/local/bin/robos-context-mcp",
      "robos:domainStandard": "https://modelcontextprotocol.io/specification",
      "robos:namespace": "robos.platform",
      "robos:package": "core-platform",
      "robos:schemaOrgType": "https://schema.org/SoftwareApplication",
      "robos:tools": [
        {
          "description": "Perform structural AST pattern matching across source files",
          "inputSchema": {
            "properties": {
              "filePattern": {
                "description": "Glob filter (e.g. **/*.js)",
                "type": "string"
              },
              "maxResults": {
                "default": 10,
                "type": "integer"
              },
              "query": {
                "description": "AST pattern or symbol name",
                "type": "string"
              }
            },
            "required": [
              "query"
            ],
            "type": "object"
          },
          "name": "ast_search"
        },
        {
          "description": "Resolve declaration location, signature, and usages of a code symbol",
          "inputSchema": {
            "properties": {
              "includeReferences": {
                "default": true,
                "type": "boolean"
              },
              "symbol": {
                "description": "Identifier name",
                "type": "string"
              }
            },
            "required": [
              "symbol"
            ],
            "type": "object"
          },
          "name": "symbol_lookup"
        },
        {
          "description": "Calculate import and call graph for target module or package",
          "inputSchema": {
            "properties": {
              "depth": {
                "default": 2,
                "type": "integer"
              },
              "entrypoint": {
                "description": "Path to entrypoint file",
                "type": "string"
              }
            },
            "required": [
              "entrypoint"
            ],
            "type": "object"
          },
          "name": "dependency_graph"
        }
      ],
      "robos:toolsProvided": [
        "ast_search",
        "symbol_lookup",
        "dependency_graph"
      ],
      "robos:transport": "stdio"
    },
    {
      "@id": "urn:robos:mcp:kgraph-navigator",
      "@type": [
        "oslc_am:Resource",
        "robos:MCPServer",
        "robos:ToolProvider",
        "schema:SoftwareApplication"
      ],
      "dcterms:description": "Model Context Protocol server allowing autonomous agents to query and validate SDLC graph nodes.",
      "dcterms:title": "RobOS Knowledge Graph MCP Server",
      "robos:command": "/usr/local/bin/robos-kgraph-mcp",
      "robos:domainStandard": "https://modelcontextprotocol.io/specification",
      "robos:namespace": "robos.platform",
      "robos:package": "core-platform",
      "robos:schemaOrgType": "https://schema.org/SoftwareApplication",
      "robos:tools": [
        {
          "description": "Search and filter knowledge graph nodes by type or keyword",
          "inputSchema": {
            "properties": {
              "limit": {
                "default": 20,
                "type": "integer"
              },
              "text": {
                "description": "Full-text search query",
                "type": "string"
              },
              "type": {
                "description": "RDF type filter",
                "type": "string"
              }
            },
            "type": "object"
          },
          "name": "query_nodes"
        },
        {
          "description": "Perform recursive dependency and impact traversal for a graph node",
          "inputSchema": {
            "properties": {
              "direction": {
                "default": "downstream",
                "enum": [
                  "upstream",
                  "downstream"
                ],
                "type": "string"
              },
              "nodeId": {
                "description": "Target URN",
                "type": "string"
              }
            },
            "required": [
              "nodeId"
            ],
            "type": "object"
          },
          "name": "blast_radius"
        }
      ],
      "robos:toolsProvided": [
        "query_nodes",
        "get_blast_radius",
        "validate_shacl"
      ],
      "robos:transport": "stdio"
    },
