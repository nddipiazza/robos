[Desktop Entry]
Version=1.5
Type=Application
Name=RobOS cRPG Maker
GenericName=cRPG Map & Level Designer
Comment=Visual map builder, static scene background image creator, and KGraph level designer for RobOS cRPG
Exec=/usr/bin/electron /usr/local/share/robos/crpg-maker/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/crpg-maker/icon.svg
Terminal=false
Categories=Development;Game;RolePlaying;
Keywords=robos;crpg;maker;level;map;editor;godot;blockout;scene;
StartupWMClass=robos-crpg-maker
StartupNotify=true
X-RobOS-App=true
X-RobOS-Category=Games
