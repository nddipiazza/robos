# ── Boot splash: show static screen + suppress tty1 getty until runcmd splash ─
bootcmd:
  - [ cloud-init-per, once, robos-splash, sh, -c, "chvt 1 2>/dev/null; printf '\033c\033[?25l\n\n\n     \033[96m██████╗  ██████╗ ██████╗  ██████╗ ███████╗\033[0m\n     \033[96m██╔══██╗██╔═══██╗██╔══██╗██╔═══██╗██╔════╝\033[0m\n     \033[96m██████╔╝██║   ██║██████╔╝██║   ██║███████╗\033[0m\n     \033[96m██╔══██╗██║   ██║██╔══██╗██║   ██║╚════██║\033[0m\n     \033[96m██║  ██║╚██████╔╝██████╔╝╚██████╔╝███████║\033[0m\n     \033[96m╚═╝  ╚═╝ ╚═════╝ ╚═════╝  ╚═════╝ ╚══════╝\033[0m\n\n     \033[93mAI-Powered SDLC Operating System\033[0m\n\n     Preparing installation...\n' >/dev/tty1 2>&1" ]
  # Suppress the getty login prompt on tty1 so RobOS splash stays visible
  # until the Python progress script takes over in runcmd
  - [ cloud-init-per, once, robos-mask-getty, sh, -c, "systemctl stop getty@tty1 2>/dev/null; systemctl mask getty@tty1 2>/dev/null || true" ]

# ── Minimal packages (only guaranteed-safe; everything else in runcmd) ───────
packages:
  - curl
  - wget
  - gnupg
  - python3
  - python3-pip
  - unzip

package_update: true
package_upgrade: false

# ── Write files (all via /etc/skel/ — NO owner: fields) ──────────────────────
write_files:

  # SSH hardening
  - path: /etc/ssh/sshd_config.d/50-robos.conf
    permissions: '0644'
    content: |
      PasswordAuthentication yes
      PubkeyAuthentication yes

  # ── Install progress splash (Python, runs from runcmd on tty1) ──────────────
  - path: /usr/local/share/robos/install_splash.py
    permissions: '0755'
    content: |
      #!/usr/bin/env python3
      import sys, os, time, signal

      CYAN   = '\033[96m'
      YELLOW = '\033[93m'
      GREEN  = '\033[92m'
      WHITE  = '\033[97m'
      GREY   = '\033[90m'
      RESET  = '\033[0m'
      HIDE_CURSOR = '\033[?25l'
      SHOW_CURSOR = '\033[?25h'

      LOGO = [
          r"  ██████╗  ██████╗ ██████╗  ██████╗ ███████╗",
          r"  ██╔══██╗██╔═══██╗██╔══██╗██╔═══██╗██╔════╝",
          r"  ██████╔╝██║   ██║██████╔╝██║   ██║███████╗",
          r"  ██╔══██╗██║   ██║██╔══██╗██║   ██║╚════██║",
          r"  ██║  ██║╚██████╔╝██████╔╝╚██████╔╝███████║",
          r"  ╚═╝  ╚═╝ ╚═════╝ ╚═════╝  ╚═════╝ ╚══════╝",
      ]

      STEPS = [
          "Setting up base system",
          "Installing GNOME desktop",
          "Configuring display manager",
          "Installing shell (zsh)",
          "Installing GitHub CLI",
          "Installing VS Code",
          "Installing Google Chrome",
          "Installing Node.js + Electron",
          "Finalising",
      ]
      TOTAL = len(STEPS)

      def bar(done, total, width=40):
          filled = int(width * done / total)
          pct = int(100 * done / total)
          b = GREEN + '█' * filled + GREY + '░' * (width - filled) + RESET
          return f"  [{b}] {WHITE}{pct}%{RESET}"

      def draw(status_text, step_idx):
          try:
              cols, rows = os.get_terminal_size()
          except Exception:
              cols, rows = 80, 24
          out = [HIDE_CURSOR, '\033[2J\033[H']
          pad = max(0, (cols - 48) // 2)
          margin = ' ' * pad
          out.append('\n')
          for line in LOGO:
              out.append(margin + CYAN + line + RESET + '\n')
          out.append('\n')
          out.append(f"  {YELLOW}AI-Powered SDLC Operating System{RESET}\n\n")
          out.append(f"  {WHITE}Installing RobOS GNOME Edition...{RESET}\n\n")
          out.append(bar(step_idx, TOTAL) + '\n\n')
          for i, step in enumerate(STEPS):
              if i < step_idx:
                  out.append(f"  {GREEN}✓{RESET}  {GREY}{step}{RESET}\n")
              elif i == step_idx:
                  out.append(f"  {YELLOW}▶{RESET}  {WHITE}{step}{RESET}\n")
              else:
                  out.append(f"     {GREY}{step}{RESET}\n")
          out.append(f"\n  {GREY}{status_text}{RESET}\n")
          sys.stdout.write(''.join(out))
          sys.stdout.flush()

      signal.signal(signal.SIGTERM, lambda *_: (sys.stdout.write(SHOW_CURSOR), sys.exit(0)))
      signal.signal(signal.SIGINT,  lambda *_: (sys.stdout.write(SHOW_CURSOR), sys.exit(0)))

      STATUS_FILE = '/tmp/robos-install-status'
      last = ''
      step = 0
      while not os.path.exists('/tmp/robos-install-done'):
          try:
              lines = open(STATUS_FILE).read().strip().splitlines()
              text = lines[0] if lines else 'Working...'
              try:
                  step = min(int(lines[-1]), TOTAL - 1)
              except Exception:
                  pass
          except Exception:
              text = 'Working...'
          if text != last:
              draw(text, step)
              last = text
          time.sleep(0.5)
      draw('Installation complete!', TOTAL)
      time.sleep(2)
      sys.stdout.write(SHOW_CURSOR)

  # Hello World Electron app — skipped for now, add later

