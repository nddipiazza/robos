[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Point of Sale
Comment=Open-source cash register for retail, cafés and bars with touchscreen ordering and self-checkout
Exec=/usr/bin/electron /usr/local/share/robos/point-of-sale/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/point-of-sale/icon.svg
Terminal=false
Categories=Office;Finance;
X-RobOS-Category=Retail
StartupWMClass=robos-point-of-sale
