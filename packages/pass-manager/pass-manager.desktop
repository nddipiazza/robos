[Desktop Entry]
X-RobOS-Category=Security
X-RobOS-App=true
Name=Pass Manager
Comment=GUI for GPG-encrypted password store
Exec=/usr/bin/electron /usr/local/share/robos/pass-manager/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/pass-manager/icon.svg
Terminal=false
Type=Application
Categories=Utility;Security;
StartupWMClass=robos-pass-manager
