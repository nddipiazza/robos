      "robos:equippedWeapon": "Broadsword (3 Combat Dice)",
      "robos:equippedArmor": "Natural Toughness (2 Defend Dice)",
      "robos:inventory": [
        {
          "id": "item-pot-heal-1",
          "name": "Potion of Healing",
          "type": "potion",
          "effect": "Restores up to 4 BP",
          "value": 100
        },
        {
          "id": "item-rope-1",
          "name": "Heavy Rope (30 ft)",
          "type": "tool",
          "effect": "Climb pits & gaps",
          "value": 25
        }
      ],
      "robos:specialAbility": "",
      "robos:icon": "\ud83d\udee1\ufe0f",
      "robos:startingPosition": [
        1,
        1
      ],
      "robos:category": "Base Game",
      "robos:tokenAsset": "assets/tokens/token_barbarian.png",
      "robos:portraitAsset": "assets/portraits/card_bg_barbarian.png",
      "robos:audioLines": {
        "turnStart": [
          {
            "text": "By my broadsword, clear a path!",
            "audio": "res://assets/audio/heroes/barbarian_turn_start.ogg"
          }
        ],
        "attacking": [
          {
            "text": "Taste cold Cimmerian steel!",
            "audio": "res://assets/audio/heroes/barbarian_attacking.ogg"
          }
        ],
        "attacked": [
          {
            "text": "Aagh! Only a flesh wound!",
            "audio": "res://assets/audio/heroes/barbarian_attacked.ogg"
          }
        ],
        "defended": [
          {
            "text": "Ha! Your feeble blow bounces off my iron muscles!",
            "audio": "res://assets/audio/heroes/barbarian_defended.ogg"
          }
        ],
        "castingMagic": [
          {
            "text": "The ancient battle-spirit surges through my blade!",
            "audio": "res://assets/audio/heroes/barbarian_casting_magic.ogg"
          }
        ]
      }
    },
    {
      "@id": "urn:robos:tabletop:hero:dwarf",
      "@type": [
        "oslc_am:Resource",
        "robos:TabletopHero",
        "robos:GameCharacter",
        "schema:Person"
      ],
      "dcterms:title": "Dwarf",
      "robos:bodyPoints": 7,
      "robos:mindPoints": 3,
      "robos:attackDice": 2,
      "robos:defendDice": 2,
      "robos:specialAbility": "Disarm Traps",
