// RobOS Plymouth Boot Theme
// Uses Plymouth script plugin — requires plymouth-themes package

sw = Window.GetWidth();
sh = Window.GetHeight();

// ── Background ────────────────────────────────────────────────────────────
Window.SetBackgroundTopColor(0.07, 0.07, 0.14);
Window.SetBackgroundBottomColor(0.04, 0.04, 0.09);

// ── Logo ──────────────────────────────────────────────────────────────────
title_img = Image.Text("RobOS", 0.0, 0.75, 0.83, 1.0, "Sans Bold 52");
title_spr = Sprite(title_img);
title_spr.SetX(sw / 2 - title_img.GetWidth() / 2);
title_spr.SetY(sh / 2 - 110);
title_spr.SetOpacity(1);

// ── Subtitle ──────────────────────────────────────────────────────────────
sub_img = Image.Text("AI-Powered SDLC Operating System", 0.4, 0.4, 0.55, 1.0, "Sans 16");
sub_spr = Sprite(sub_img);
sub_spr.SetX(sw / 2 - sub_img.GetWidth() / 2);
sub_spr.SetY(sh / 2 - 45);
sub_spr.SetOpacity(1);

// ── Version ───────────────────────────────────────────────────────────────
ver_img = Image.Text("v0.1.0", 0.3, 0.3, 0.42, 1.0, "Sans 11");
ver_spr = Sprite(ver_img);
ver_spr.SetX(sw / 2 - ver_img.GetWidth() / 2);
ver_spr.SetY(sh / 2 - 10);
ver_spr.SetOpacity(1);

// ── Progress bar ──────────────────────────────────────────────────────────
bar_w   = 420;
bar_h   = 4;
bar_x   = sw / 2 - bar_w / 2;
bar_y   = sh / 2 + 55;

// Track (dark grey)
track_img = Image("bar-bg.png");
track_scl = track_img.Scale(bar_w, bar_h);
track_spr = Sprite(track_scl);
track_spr.SetX(bar_x);
track_spr.SetY(bar_y);
track_spr.SetOpacity(1);

// Fill (cyan — starts at 0 width)
fill_img = Image("bar-fill.png");
fill_spr = Sprite();
fill_spr.SetX(bar_x);
fill_spr.SetY(bar_y);
fill_spr.SetOpacity(0);

// ── Message ───────────────────────────────────────────────────────────────
msg_spr = Sprite();
msg_spr.SetX(sw / 2);
msg_spr.SetY(bar_y + 16);
msg_spr.SetOpacity(0);

// ── Callbacks ─────────────────────────────────────────────────────────────
fun boot_progress_fn(duration, progress) {
    fill_w = Math.Int(progress * bar_w);
    if (fill_w > 0) {
        scaled = fill_img.Scale(fill_w, bar_h);
        fill_spr.SetImage(scaled);
        fill_spr.SetOpacity(1);
    }
}

fun message_fn(text) {
    mi = Image.Text(text, 0.6, 0.6, 0.73, 1.0, "Sans 12");
    msg_spr.SetImage(mi);
    msg_spr.SetX(sw / 2 - mi.GetWidth() / 2);
    msg_spr.SetOpacity(1);
}

Plymouth.SetBootProgressFunction(boot_progress_fn);
Plymouth.SetMessageFunction(message_fn);
