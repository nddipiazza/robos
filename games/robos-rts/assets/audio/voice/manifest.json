{
  "pioneer": {
    "unit_name": "Pioneer",
    "voice": "en-US-BrianMultilingualNeural",
    "categories": {
      "select": [
        {
          "id": "pioneer_select_1",
          "text": "What's up, Commander?",
          "path": "res://assets/audio/voice/pioneer_select_1.wav"
        },
        {
          "id": "pioneer_select_2",
          "text": "Talk to me, boss. Welding rig's hot.",
          "path": "res://assets/audio/voice/pioneer_select_2.wav"
        },
        {
          "id": "pioneer_select_3",
          "text": "Pioneer here. Whatcha need built?",
          "path": "res://assets/audio/voice/pioneer_select_3.wav"
        },
        {
          "id": "pioneer_select_4",
          "text": "Yeah? Clock's ticking, point me at a job.",
          "path": "res://assets/audio/voice/pioneer_select_4.wav"
        },
        {
          "id": "pioneer_select_5",
          "text": "Arc torch is charged and ready. What's the plan?",
          "path": "res://assets/audio/voice/pioneer_select_5.wav"
        },
        {
          "id": "pioneer_select_6",
          "text": "Need something bolted together, or taken apart?",
          "path": "res://assets/audio/voice/pioneer_select_6.wav"
        }
      ],
      "move": [
        {
          "id": "pioneer_move_1",
          "text": "On my way.",
          "path": "res://assets/audio/voice/pioneer_move_1.wav"
        },
        {
          "id": "pioneer_move_2",
          "text": "You got it, chief.",
          "path": "res://assets/audio/voice/pioneer_move_2.wav"
        },
        {
          "id": "pioneer_move_3",
          "text": "Hauling gear over there now.",
          "path": "res://assets/audio/voice/pioneer_move_3.wav"
        },
        {
          "id": "pioneer_move_4",
          "text": "Copy that, rolling out.",
          "path": "res://assets/audio/voice/pioneer_move_4.wav"
        },
        {
          "id": "pioneer_move_5",
          "text": "Heading to the site.",
          "path": "res://assets/audio/voice/pioneer_move_5.wav"
        }
      ],
      "job_done": [
        {
          "id": "pioneer_job_done_1",
          "text": "Job's done! Not a bad weld if I say so myself.",
          "path": "res://assets/audio/voice/pioneer_job_done_1.wav"
        },
        {
          "id": "pioneer_job_done_2",
          "text": "All finished up, boss. What's next?",
          "path": "res://assets/audio/voice/pioneer_job_done_2.wav"
        },
        {
          "id": "pioneer_job_done_3",
          "text": "Structure's online and solid as bedrock.",
          "path": "res://assets/audio/voice/pioneer_job_done_3.wav"
        },
        {
          "id": "pioneer_job_done_4",
          "text": "Construction complete. That'll hold through an orbital drop.",
          "path": "res://assets/audio/voice/pioneer_job_done_4.wav"
        },
        {
          "id": "pioneer_job_done_5",
          "text": "Another masterpiece off the checklist.",
          "path": "res://assets/audio/voice/pioneer_job_done_5.wav"
        },
        {
          "id": "pioneer_job_done_6",
          "text": "Wrapped it up! Ready for the next blueprint.",
          "path": "res://assets/audio/voice/pioneer_job_done_6.wav"
        }
      ],
      "attack": [
        {
          "id": "pioneer_attack_1",
          "text": "Guess this arc welder does overtime on hostiles!",
          "path": "res://assets/audio/voice/pioneer_attack_1.wav"
        },
        {
          "id": "pioneer_attack_2",
          "text": "Hold still, I'm gonna spot-weld your armor shut!",
          "path": "res://assets/audio/voice/pioneer_attack_2.wav"
        },
        {
          "id": "pioneer_attack_3",
          "text": "Nobody messes with the union! Eat plasma sparks!",
          "path": "res://assets/audio/voice/pioneer_attack_3.wav"
        },
        {
          "id": "pioneer_attack_4",
          "text": "This wasn't in my job description, but here we go!",
          "path": "res://assets/audio/voice/pioneer_attack_4.wav"
        },
        {
          "id": "pioneer_attack_5",
          "text": "Consider this an unscheduled demolition!",
          "path": "res://assets/audio/voice/pioneer_attack_5.wav"
        }
      ]
    }
  },
  "rifleman": {
    "unit_name": "Rifleman",
    "voice": "en-US-AndrewMultilingualNeural",
