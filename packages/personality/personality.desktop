[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Personality
Comment=Talk to an AI personality with a face, a voice, ears and eyes
Exec=/usr/bin/electron /usr/local/share/robos/personality/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/personality/icon.svg
Terminal=false
Categories=Utility;
X-RobOS-Category=AI
StartupWMClass=robos-personality
