    {
      "@id": "urn:robos:jrpg:fantasy-light-warriors:menu:battle-screen-example",
      "@type": [
        "oslc_am:Resource",
        "jrpg:MenuScreen"
      ],
      "dcterms:title": "Fantasy: Light Warriors Battle Screen (Chaos Boss Fight)",
      "robos:package": "ui",
      "dcterms:description": "View combat execution as party member Arus attacks Chaos while monitoring party HP",
      "jrpg:windows": [
        {
          "name": "Enemy View",
          "x": 0.03,
          "y": 0.02,
          "width": 0.5,
          "height": 0.62,
          "contents": "Chaos boss sprite in front of temple pillars background"
        },
        {
          "name": "Party View",
          "x": 0.53,
          "y": 0.02,
          "width": 0.25,
          "height": 0.62,
          "contents": "Four party character sprites in vertical formation under temple pillars, with the top character (Arus) stepping forward swinging a sword"
        },
        {
          "name": "Attacker Message Box",
          "x": 0.03,
          "y": 0.66,
          "width": 0.31,
          "height": 0.1,
          "contents": "Acting character name: Arus"
        },
        {
          "name": "Target Message Box",
          "x": 0.03,
          "y": 0.77,
          "width": 0.31,
          "height": 0.12,
          "contents": "Target enemy name: CHAOS"
        },
        {
          "name": "Party Member 1 Status",
          "x": 0.78,
          "y": 0.09,
          "width": 0.19,
          "height": 0.23,
          "contents": "Arus HP 659"
        },
        {
          "name": "Party Member 2 Status",
          "x": 0.78,
          "y": 0.32,
          "width": 0.19,
          "height": 0.21,
          "contents": "Baku HP 358"
        },
        {
          "name": "Party Member 3 Status",
          "x": 0.78,
          "y": 0.54,
          "width": 0.19,
          "height": 0.21,
          "contents": "Sara HP 667"
        },
        {
          "name": "Party Member 4 Status",
          "x": 0.78,
          "y": 0.75,
          "width": 0.19,
          "height": 0.21,
          "contents": "Koko HP 452"
        }
      ],
