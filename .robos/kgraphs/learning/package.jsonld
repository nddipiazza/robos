    {
      "@id": "urn:robos:elearning:course:how-to-recreate-classic-jrpg-using-kgraph-parsing-with-automated-playthrough",
      "@type": [
        "oslc_am:Resource",
        "robos:ELearningCourse",
        "robos:ELearning",
        "schema:Course"
      ],
      "dcterms:title": "How to Recreate a Classic JRPG Using KGraph Parsing with Automated Playthrough",
      "dcterms:description": "Complete step-by-step interactive masterclass on using a browser and Python tools to harvest classic JRPG maps, wikis, PDF manuals, and 6502 ROM tables into a private local workspace, parsing them into an OSLC JSON-LD Knowledge Graph with robos-jrpg-parser, slicing 16x16 tile grids with indoor/outdoor palette decoding, and running headless Xvfb Cucumber (behave) video playthroughs in Godot 4.",
      "robos:difficulty": "Advanced",
      "robos:domainStandard": "https://schema.org/Course",
      "robos:estimatedDuration": "110 minutes",
      "robos:gitopsFile": ".robos/elearning.yaml",
      "robos:docPath": "docs/elearning/how-to-recreate-classic-jrpg-using-kgraph-parsing-with-automated-playthrough.md",
      "robos:applicationTitle": "RobOS JRPG Parser & Godot 4 Playthrough Harness",
      "robos:technology": "Python 3 / robos-jrpg-parser / OSLC KGraph / Godot 4.3 / Cucumber Xvfb",
      "robos:ogImage": "https://rowbose.com/assets/elearning/jrpg-kgraph/jrpg-acquisition-and-rom-pipeline.png",
      "robos:modulesCount": 6,
      "robos:namespace": "robos.learning",
      "robos:package": "learning",
      "robos:schemaOrgType": "https://schema.org/Course",
      "robos:status": "published",
      "robos:targetApplication": "urn:robos:app:kgraph-parse-portal",
      "robos:targetAudience": "Game Developers, Retro Preservationists, AI Agent Engineers, Context Engineers",
      "robos:topic": "Context-Engineered Classic JRPG Reconstruction & Automated Video Verification",
      "robos:updatedAt": "2026-11-04T18:30:52.686Z",
      "robos:modules": [
        {
          "id": "mod-01-browser-and-python-harvesting",
          "title": "Module 1: Browser Discovery & Python Multi-Source Asset Harvesting",
          "durationMinutes": 20,
          "overview": "Learn how to inspect classic JRPG archives in a browser and write deterministic Python scripts (urllib.request + custom User-Agent + SHA-256 verification) to download pixel-exact map atlases (VGMaps), StrategyWiki HTML tables, official PDF manuals, and .NSF/MP3 audio into a private local workspace (~/Downloads/<game-id>) outside the public Git repo.",
          "lessonHtml": "\n        <div class=\"lesson-section\">\n          <h4 class=\"lesson-subtitle\">🌐 1. The 5 Essential Browser Resource Categories for Classic JRPGs</h4>\n          <p class=\"lesson-text\">\n            When reconstructing an 8-bit or 16-bit JRPG (such as NES <em>Final Fantasy</em>), no single website holds all the data needed for a playable engine. A RobOS agent or developer inspects five complementary sources in the browser and downloads them into a <strong>private local workspace</strong> (<code>/home/ndipiazza/Downloads/ff1</code>) that is never committed to the public repository:\n          </p>\n          <table style=\"width:100%; border-collapse:collapse; font-size:12px; margin:12px 0;\">\n            <thead>\n              <tr style=\"background:#21262d; color:#f0f6fc;\">\n                <th style=\"padding:8px 10px; border:1px solid #30363d;\">Category</th>\n                <th style=\"padding:8px 10px; border:1px solid #30363d;\">Primary Source</th>\n                <th style=\"padding:8px 10px; border:1px solid #30363d;\">What We Harvest</th>\n                <th style=\"padding:8px 10px; border:1px solid #30363d;\">Local Subdirectory</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>1. Pixel-Exact Map Atlases</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><code>vgmaps.com/Atlas/NES/</code></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">1:1 pixel rips of Overworld, Coneria, Castle Coneria, Temple of Fiends, Marsh Cave, Earth Cave, Gurgu Volcano, Ice Cave, Castle of Ordeals, Sea Shrine, Mirage Tower &amp; Floating Castle</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><code>~/Downloads/ff1/maps/</code></td>\n              </tr>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>2. Wiki HTML Tables</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><code>strategywiki.org/wiki/Final_Fantasy</code></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">Shops, Weapons, Armor, Spells, Enemies, and Walkthrough HTML pages + shop UI screenshots</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><code>~/Downloads/ff1/ui_shops/</code></td>\n              </tr>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>3. Official Pack-In Manuals</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><code>nintendo.co.jp/.../CLV-P-NAAAE.pdf</code></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">Official 84-page NES Classic Mini manual &amp; fold-out equipment/magic charts</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><code>~/Downloads/ff1/manuals/</code></td>\n              </tr>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>4. Chiptune &amp; OST Audio</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><code>zophar.net/music/nintendo-nes-nsf/</code></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">Original 2A03 <code>.nsf</code> archive + track-split MP3s (Prelude, Town, Cornelia Castle, Temple of Chaos)</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><code>~/Downloads/ff1/audio/</code></td>\n              </tr>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>5. Mechanics &amp; ROM LUTs</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">AstralEsper Guide (v0.85) &amp; Disch 6502 Disassembly</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">Verified NES monster bytes, 8-slot encounter tables, class growth &amp; XP tables, spell routines, and 48-byte map palettes</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><code>~/Downloads/ff1/rom_data/</code></td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n\n        <div class=\"lesson-section\">\n          <h4 class=\"lesson-subtitle\">🐍 2. Deterministic Python Downloader (Bypassing 403 User-Agent Filters)</h4>\n          <p class=\"lesson-text\">\n            Retro map archives such as VGMaps and Zophar reject Python's default <code>Python-urllib/3.x</code> header with <code>HTTP 403 Forbidden</code>. Our Python harvester uses a standard desktop Chrome <code>User-Agent</code>, polite 250ms rate limiting, and SHA-256 hashing so every file is verified on disk:\n          </p>\n          <pre class=\"code-snippet\"><code>#!/usr/bin/env python3\nimport os, time, hashlib, urllib.request\n\nBASE_DIR = \"/home/ndipiazza/Downloads/ff1\"\nHEADERS = {\n    \"User-Agent\": \"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36\",\n    \"Accept\": \"text/html,application/xhtml+xml,image/avif,image/webp,*/*;q=0.8\",\n}\n\nVGMAPS_FILES = [\n    \"FinalFantasy-World.png\",\n    \"FinalFantasy-Coneria.png\",\n    \"FinalFantasy-CastleConeria.png\",\n    \"FinalFantasy-TempleOfFiends.png\",\n    \"FinalFantasy-MarshCave.png\",\n    \"FinalFantasy-EarthCave.png\",\n    \"FinalFantasy-GurguVolcano.png\",\n    \"FinalFantasy-IceCave.png\",\n    \"FinalFantasy-CastleOfOrdeals.png\",\n    \"FinalFantasy-SeaShrine.png\",\n    \"FinalFantasy-FloatingCastle.png\",\n    \"FinalFantasy-TempleOfFiendsRevisited.png\",\n]\n\ndef download_file(url: str, dest: str) -> str:\n    os.makedirs(os.path.dirname(dest), exist_ok=True)\n    req = urllib.request.Request(url, headers=HEADERS)\n    with urllib.request.urlopen(req, timeout=30) as resp:\n        data = resp.read()\n    with open(dest, \"wb\") as f:\n        f.write(data)\n    return hashlib.sha256(data).hexdigest()\n\nfor fname in VGMAPS_FILES:\n    url = f\"https://vgmaps.com/Atlas/NES/{fname}\"\n    sha = download_file(url, os.path.join(BASE_DIR, \"maps\", fname))\n    print(f\"[OK] {fname} -> sha256:{sha[:12]}\")\n    time.sleep(0.25)</code></pre>\n        </div>\n\n        <div class=\"lesson-section\">\n          <h4 class=\"lesson-subtitle\">📐 3. End-to-End Stage 1 Acquisition Pipeline</h4>\n          <div class=\"mermaid\">\nflowchart LR\n    Browser[\"Browser Inspection<br/>(VGMaps, StrategyWiki, Nintendo PDF, Zophar)\"] --> PyScript[\"download_ff1_assets.py<br/>(Custom User-Agent + SHA-256 Check)\"]\n    PyScript --> MapsDir[\"~/Downloads/ff1/maps/<br/>(27 Pixel-Exact PNG Atlases)\"]\n    PyScript --> WikiDir[\"~/Downloads/ff1/ui_shops/<br/>(Shops, Weapons, Armor, Spells HTML)\"]\n    PyScript --> PdfDir[\"~/Downloads/ff1/manuals/<br/>(CLV-P-NAAAE.pdf 84-Page Manual)\"]\n    PyScript --> AudioDir[\"~/Downloads/ff1/audio/<br/>(.NSF + Track-Split MP3 OST)\"]\n          </div>\n          <div class=\"doc-figure\">\n            <img src=\"/assets/elearning/jrpg-kgraph/jrpg-acquisition-and-rom-pipeline.png\" alt=\"Stage 1: Browser and Python Multi-Source JRPG Asset Acquisition Pipeline\" class=\"doc-img\" onclick=\"openLightbox(this.src, this.alt)\">\n            <div class=\"doc-caption\">Figure 1.1: Stage 1 technical schematic — multi-source browser &amp; Python acquisition pipeline feeding the private ~/Downloads/&lt;game-id&gt; workspace.</div>\n          </div>\n        </div>\n      ",
          "labSteps": [
            "Create the private workspace folders outside the Git repository: `mkdir -p ~/Downloads/ff1/{maps,ui_shops,manuals,audio,rom_data}`",
            "Run the Python harvester `download_ff1_assets.py` with a Chrome `User-Agent` header to fetch all 12 primary VGMaps PNGs (`FinalFantasy-World.png` through `FinalFantasy-TempleOfFiendsRevisited.png`)",
            "Download the StrategyWiki HTML tables (`Shops.html`, `Weapons.html`, `Armor.html`, `Spells.html`, `Walkthrough.html`) and official Nintendo Classic Mini manual (`CLV-P-NAAAE.pdf`)",
            "Verify SHA-256 digests and image dimensions (`1024x1024` for single 64x64 tile maps, `4096x4096` for Overworld) using Python `PIL.Image`"
          ],
          "quiz": [
            {
              "question": "Why must downloaded reference assets (such as VGMaps PNGs, PDF manuals, and .NSF audio) be stored in ~/Downloads/<game-id> rather than inside the RobOS Git repository?",
              "options": [
                "To keep copyrighted third-party reference materials strictly private on the user machine while publishing only clean-room parser code and synthetic fixtures in Git",
                "Because Git cannot store binary PNG files larger than 1 MB",
                "Because Godot 4 can only load files from ~/Downloads",
                "To prevent Node.js from indexing the files during npm install"
              ],
              "answer": "To keep copyrighted third-party reference materials strictly private on the user machine while publishing only clean-room parser code and synthetic fixtures in Git",
              "explanation": "RobOS separates private user-collected reference materials (~/Downloads/<game-id>) from the open-source parser and synthetic unit-test fixtures committed to Git."
            },
            {
              "question": "Why does a default urllib.request.urlopen(url) call fail with HTTP 403 Forbidden on retro archives like VGMaps and Zophar, and how do we fix it?",
              "options": [
                "They block the default Python-urllib User-Agent; passing a standard browser User-Agent header in urllib.request.Request resolves it",
                "They require OAuth2 bearer tokens generated via Google Cloud",
                "They only serve files over FTP rather than HTTPS",
                "They require WebSocket handshakes before downloading PNGs"
              ],
              "answer": "They block the default Python-urllib User-Agent; passing a standard browser User-Agent header in urllib.request.Request resolves it",
              "explanation": "Passing a standard desktop browser User-Agent header with polite rate limiting allows deterministic Python downloads without 403 blocks."
            }
          ]
        },
        {
          "id": "mod-02-jrpg-kgraph-parser-and-gap-matrix",
          "title": "Module 2: Parsing Raw Folders into the KGraph (robos-jrpg-parser) & Completeness Gap Analysis",
          "durationMinutes": 20,
          "overview": "Run the jrpg-parse-assets skill (packages/robos-jrpg-parser) to ingest raw folders into an OSLC JSON-LD Knowledge Graph (~/kgraphs/final-fantasy-nes/knowledge-graph.jsonld) across 11 JRPG ontology classes, and audit the 11-Area Completeness Gap Matrix to see what still blocks battles, progression, magic, and walking.",
          "lessonHtml": "\n        <div class=\"lesson-section\">\n          <h4 class=\"lesson-subtitle\">🧠 1. Invoking the RobOS JRPG Parser (jrpg-parse-assets Skill)</h4>\n          <p class=\"lesson-text\">\n            With raw files collected in <code>/home/ndipiazza/Downloads/ff1</code>, the RobOS agent invokes <code>packages/robos-jrpg-parser/bin/jrpg-parse.js</code> to classify every artifact and emit an OSLC JSON-LD Knowledge Graph at <code>/home/ndipiazza/kgraphs/final-fantasy-nes/knowledge-graph.jsonld</code>:\n          </p>\n          <pre class=\"code-snippet\"><code># Parse collected JRPG resources into an OSLC JSON-LD Knowledge Graph\nnode packages/robos-jrpg-parser/bin/jrpg-parse.js \\\n  --input /home/ndipiazza/Downloads/ff1 \\\n  --out /home/ndipiazza/kgraphs/final-fantasy-nes \\\n  --game-id final-fantasy-nes \\\n  --title \"Final Fantasy (NES)\"\n\n# Run the 63 unit tests verifying robos-jrpg-parser\nnode --test packages/robos-test/tests/jrpg-parser/unit.test.js</code></pre>\n          <div class=\"mermaid\">\nflowchart TD\n    InputDir[\"~/Downloads/ff1<br/>(Maps, HTML Tables, PDF, Audio, ROM Markdown)\"] --> Classify[\"lib/classify.js<br/>(SHA-256 + Role Classification)\"]\n    Classify --> MapsMod[\"lib/maps.js<br/>(robos:JRPGMap + Composite Sub-Maps)\"]\n    Classify --> ChartsMod[\"lib/charts.js<br/>(Weapons, Armor, Spells, Shops, Classes, Enemies, Encounters, Chests)\"]\n    Classify --> WalkMod[\"lib/walkthrough.js<br/>(30 Ordered robos:JRPGStoryMilestone Nodes)\"]\n    MapsMod --> KGraphOut[\"lib/kgraph.js<br/>~/kgraphs/final-fantasy-nes/knowledge-graph.jsonld (1,206 Nodes)\"]\n    ChartsMod --> KGraphOut\n    WalkMod --> KGraphOut\n          </div>\n        </div>\n\n        <div class=\"lesson-section\">\n          <h4 class=\"lesson-subtitle\">📊 2. The 11-Area Completeness Gap Matrix (Why Wiki Scrapes Alone Cannot Run a Game)</h4>\n          <p class=\"lesson-text\">\n            After the first parse of the VGMaps PNGs, StrategyWiki pages, and Nintendo manual PDF, the RobOS agent audited the Knowledge Graph against what a real game engine needs to run battles, level-ups, magic, walking, and story triggers. This audit revealed five critical blockers:\n          </p>\n          <table style=\"width:100%; border-collapse:collapse; font-size:12px; margin:12px 0;\">\n            <thead>\n              <tr style=\"background:#21262d; color:#f0f6fc;\">\n                <th style=\"padding:8px 10px; border:1px solid #30363d;\">Area</th>\n                <th style=\"padding:8px 10px; border:1px solid #30363d;\">Have from Initial Scrape</th>\n                <th style=\"padding:8px 10px; border:1px solid #30363d;\">Missing for Playable Game</th>\n                <th style=\"padding:8px 10px; border:1px solid #30363d;\">Effect</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>Weapons, armor, shops</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">Stats and prices for 80 pieces, 50 shops</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">5 disputed numbers across ports</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d; color:#3fb950;\"><strong>Ready</strong></td>\n              </tr>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>Battle rules</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">37 formulas, including NES bugs</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">Unconfirmed author &amp; 3 NES quirks</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d; color:#f1e05a;\"><strong>Usable once verified</strong></td>\n              </tr>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>Enemies</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">124 with HP, XP, gold, weakness</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">ATK, DEF, ACC, Hits, CRT, EVA, M.D, MOR, spells</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d; color:#f85149;\"><strong>Blocks battles</strong></td>\n              </tr>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>Encounters</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">Nothing</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">Which enemy groups appear where (8-slot zone table)</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d; color:#f85149;\"><strong>Blocks battles</strong></td>\n              </tr>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>Classes</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">12 with upgrades</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">Starting stats, level-up growth, XP table</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d; color:#f85149;\"><strong>Blocks progression</strong></td>\n              </tr>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>Spells</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">64 with level, price, school, effect</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">Power and accuracy, which the formulas need</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d; color:#f85149;\"><strong>Blocks magic</strong></td>\n              </tr>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>Maps</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">27 real map files, 28 generated images</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">16x16 tile grids, walkable tiles, doors, stairs, warps</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d; color:#f85149;\"><strong>Blocks walking</strong></td>\n              </tr>\n              <tr>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\"><strong>World contents</strong></td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">Partial chest locations from StrategyWiki</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d;\">Exact chest (x,y) + contents, NPC positions, dialogue</td>\n                <td style=\"padding:8px 10px; border:1px solid #30363d; color:#f85149;\"><strong>Blocks the story</strong></td>\n              </tr>\n            </tbody>\n          </table>\n          <div class=\"doc-figure\">\n            <img src=\"/assets/elearning/jrpg-kgraph/jrpg-kgraph-parser-and-gap-analysis.png\" alt=\"Stage 2: robos-jrpg-parser Ingestion, KGraph Ontology and Completeness Gap Matrix\" class=\"doc-img\" onclick=\"openLightbox(this.src, this.alt)\">\n            <div class=\"doc-caption\">Figure 2.1: Stage 2 architecture — OSLC JSON-LD node types produced by robos-jrpg-parser and the Completeness Audit Table.</div>\n          </div>\n        </div>\n      ",
          "labSteps": [
            "Run `node packages/robos-jrpg-parser/bin/jrpg-parse.js --input ~/Downloads/ff1 --out ~/kgraphs/final-fantasy-nes` to generate the initial Knowledge Graph",
            "Inspect `~/kgraphs/final-fantasy-nes/SUMMARY.md` and `parse-report.json` to review node counts by `robos:JRPG*` class",
            "Identify the 5 data gaps that block gameplay (Monster combat stats, Encounter zone tables, Class starting stats & XP tables, Spell power & accuracy, and Chest/NPC coordinates)",
            "Run `node --test packages/robos-test/tests/jrpg-parser/unit.test.js` and verify all 63 unit tests pass using synthetic clean-room fixtures"
          ],
          "quiz": [
            {
              "question": "Why did the initial StrategyWiki and PDF manual parse still block battles in the Completeness Gap Matrix?",
              "options": [
                "Because basic enemy summary lists only had HP, XP, and Gold, lacking ATK, DEF, ACC, Hits, CRT, EVA, Magic Defense, and map encounter zone tables",
                "Because StrategyWiki did not list weapon prices",
                "Because the NES game had no random encounters",
                "Because JSON-LD does not support integer properties"
              ],
              "answer": "Because basic enemy summary lists only had HP, XP, and Gold, lacking ATK, DEF, ACC, Hits, CRT, EVA, Magic Defense, and map encounter zone tables",
              "explanation": "Executing actual NES combat formulas requires each enemy’s ATK, ACC, Hits, CRT, DEF, EVA, Magic Defense, Morale, and the 8-slot encounter formation tables per map."
            },
            {
              "question": "Which ontology class in packages/robos-jrpg-parser/lib/ontology.js represents an area’s random encounter rate and 8 weighted monster formation slots?",
              "options": [
                "robos:JRPGEncounterZone",
                "robos:JRPGShop",
                "robos:JRPGStoryMilestone",
                "robos:JRPGArmor"
              ],
              "answer": "robos:JRPGEncounterZone",
              "explanation": "robos:JRPGEncounterZone models the map/overworld domain, encounter rate out of 256, and the 8 weighted formation slots ([77, 77, 48, 48, 24, 24, 6, 2]/306)."
            }
          ]
        },
        {
          "id": "mod-03-nes-rom-tables-and-battle-quirks",
          "title": "Module 3: Reverse-Engineering NES Battle Formulas, Quirks & ROM Data Tables",
          "durationMinutes": 20,
          "overview": "Verify battle math against AstralEsper’s NES Game Mechanics Guide (v0.85) and Disch’s 6502 Disassembly, resolve the 3 classic NES combat bugs, and extend robos-jrpg-parser/lib/charts.js to ingest complete monster stats, encounter tables, class growth, and spell routines into the KGraph.",
          "lessonHtml": "\n        <div class=\"lesson-section\">\n          <h4 class=\"lesson-subtitle\">⚔️ 1. Resolving the 3 Classic NES Final Fantasy Engine Quirks</h4>\n          <p class=\"lesson-text\">\n            Cross-referencing <strong>AstralEsper's NES Game Mechanics Guide</strong> (v0.85, GameFAQs ID 57009) and <strong>Disch's 6502 NES Disassembly</strong> (<code>ff1_disassembly</code>) resolved three famous NES ROM behaviors that any faithful recreation must model:\n          </p>\n          <div class=\"formula-box\">\n            1. Weapon Critical Hit Index Bug:<br>\n            &nbsp;&nbsp;&nbsp;Weapon Base Crit Rate = Weapon 1-Based Inventory Index ID (1..40) / 201<br>\n            &nbsp;&nbsp;&nbsp;(e.g. Nunchaku = ID 1 = 1/201; Rapier = ID 6 = 6/201; Masamune = ID 40 = 40/201)<br>\n            &nbsp;&nbsp;&nbsp;Unarmed Black Belt Crit Rate = (Character Level * 2) / 201<br><br>\n            2. Level-Up HP Gain Formula:<br>\n            &nbsp;&nbsp;&nbsp;Base HP Gain = floor(VIT / 4) + 1<br>\n            &nbsp;&nbsp;&nbsp;Strong HP Level Bonus = +20 + rand(0..5)  (20 to 25 extra HP)<br><br>\n            3. Magic Hit Chance (Base 148 Formula):<br>\n            &nbsp;&nbsp;&nbsp;Base = 148 (0x94) | 0 if target resists element | 188 (148 + 40) if target is weak to element<br>\n            &nbsp;&nbsp;&nbsp;Chance to Hit = Base + Spell Accuracy - Target Magic Defense  (Roll 0..200; 200 always misses)\n          </div>\n        </div>\n\n        <div class=\"lesson-section\">\n          <h4 class=\"lesson-subtitle\">👾 2. Opening Area NES Monster &amp; Boss Table (Coneria &amp; Temple of Fiends)</h4>\n          <p class=\"lesson-text\">\n            In the NES ROM, monsters do not have a separate Agility stat—<strong>Evade (<code>EVA</code>)</strong> serves as both physical evasion and turn-order initiative modifier ($\text{EVA} + \text{rand}(0..49)$):\n          </p>\n          <table style=\"width:100%; border-collapse:collapse; font-size:12px; margin:12px 0;\">\n            <thead>\n              <tr style=\"background:#21262d; color:#f0f6fc;\">\n                <th style=\"padding:6px 8px; border:1px solid #30363d;\">ID</th>\n                <th style=\"padding:6px 8px; border:1px solid #30363d;\">Name</th>\n                <th style=\"padding:6px 8px; border:1px solid #30363d;\">HP</th>\n                <th style=\"padding:6px 8px; border:1px solid #30363d;\">ATK</th>\n                <th style=\"padding:6px 8px; border:1px solid #30363d;\">ACC</th>\n                <th style=\"padding:6px 8px; border:1px solid #30363d;\">Hits</th>\n                <th style=\"padding:6px 8px; border:1px solid #30363d;\">CRT</th>\n                <th style=\"padding:6px 8px; border:1px solid #30363d;\">DEF</th>\n                <th style=\"padding:6px 8px; border:1px solid #30363d;\">EVA</th>\n                <th style=\"padding:6px 8px; border:1px solid #30363d;\">M.D</th>\n                <th style=\"padding:6px 8px; border:1px solid #30363d;\">MOR</th>\n                <th style=\"padding:6px 8px; border:1px solid #30363d;\">XP</th>\n                <th style=\"padding:6px 8px; border:1px solid #30363d;\">Gold</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr><td style=\"padding:6px 8px; border:1px solid #30363d;\">00</td><td style=\"padding:6px 8px; border:1px solid #30363d;\"><strong>IMP</strong></td><td style=\"padding:6px 8px; border:1px solid #30363d;\">8</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">4</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">2</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">1</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">1</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">4</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">6</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">16</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">106</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">6</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">6</td></tr>\n              <tr><td style=\"padding:6px 8px; border:1px solid #30363d;\">01</td><td style=\"padding:6px 8px; border:1px solid #30363d;\"><strong>GrIMP</strong></td><td style=\"padding:6px 8px; border:1px solid #30363d;\">16</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">8</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">4</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">1</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">1</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">6</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">9</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">23</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">120</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">18</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">18</td></tr>\n              <tr><td style=\"padding:6px 8px; border:1px solid #30363d;\">02</td><td style=\"padding:6px 8px; border:1px solid #30363d;\"><strong>WOLF</strong></td><td style=\"padding:6px 8px; border:1px solid #30363d;\">20</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">8</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">5</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">1</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">1</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">0</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">36</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">28</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">102</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">24</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">6</td></tr>\n              <tr><td style=\"padding:6px 8px; border:1px solid #30363d;\">105</td><td style=\"padding:6px 8px; border:1px solid #30363d;\"><strong>GARLAND (Boss)</strong></td><td style=\"padding:6px 8px; border:1px solid #30363d;\">106</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">15</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">27</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">1</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">1</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">10</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">12</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">64</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">200</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">130</td><td style=\"padding:6px 8px; border:1px solid #30363d;\">250</td></tr>\n            </tbody>\n          </table>\n        </div>\n\n        <div class=\"lesson-section\">\n          <h4 class=\"lesson-subtitle\">📈 3. Extending packages/robos-jrpg-parser/lib/charts.js</h4>\n          <p class=\"lesson-text\">\n            We updated <code>packages/robos-jrpg-parser/lib/charts.js</code> and <code>lib/kgraph.js</code> so that Markdown tables containing <code>ATK</code>/<code>ACC</code>/<code>Hits</code>/<code>CRT</code>/<code>DEF</code>/<code>EVA</code>/<code>M.D</code>/<code>MOR</code>, 8-slot encounter tables, class starting stats, XP tables, and chest/NPC coordinates are parsed into first-class KGraph properties and merged by normalized entity slug—bringing the graph to <strong>1,206 nodes</strong>.\n          </p>\n        </div>\n      ",
          "labSteps": [
            "Inspect `packages/robos-jrpg-parser/lib/charts.js` to see how monster `ATK`, `ACC`, `Hits`, `CRT`, `DEF`, `EVA`, `M.D`, and `MOR` columns are parsed and merged into `robos:JRPGEnemy` nodes",
            "Verify the 3 NES combat quirks in `~/kgraphs/final-fantasy-nes/knowledge-graph.jsonld` (`Weapon Critical Hit Bug`, `Level-Up HP Formula`, and `Magic Hit Chance Base 148`)",
            "Inspect `~/Downloads/ff1/rom_data/enemies.json`, `encounters.json`, `classes_and_xp.json`, and `spells.json` extracted from the 6502 ROM",
            "Re-run `jrpg-parse.js` and verify `~/kgraphs/final-fantasy-nes/knowledge-graph.jsonld` contains 1,206 nodes with zero missing combat blockers"
          ],
          "quiz": [
            {
              "question": "Due to a pointer bug in the NES Final Fantasy combat routine, what value is actually used as a weapon’s base critical hit rate out of 201?",
              "options": [
                "The weapon’s 1-based Inventory Index ID (1 to 40)",
                "The weapon’s Gold price divided by 100",
                "The wielder’s Intelligence stat multiplied by 2",
                "A hardcoded 5% (10/201) for all weapons"
              ],
              "answer": "The weapon’s 1-based Inventory Index ID (1 to 40)",
              "explanation": "In the NES ROM, the combat routine reads the weapon’s 1-based index ID (1..40) instead of a crit column, giving Masamune (ID 40) a 40/201 base critical hit rate."
            },
            {
              "question": "In the NES ROM, which monster stat doubles as both physical evasion and turn-order initiative modifier (Stat + rand(0..49))?",
              "options": [
                "Evade (EVA)",
                "Morale (MOR)",
                "Magic Defense (M.D)",
                "Critical Rate (CRT)"
              ],
              "answer": "Evade (EVA)",
              "explanation": "Monsters in NES Final Fantasy do not have a separate Agility byte; Evade (EVA) is used for both physical evasion and turn-order initiative."
            }
          ]
        },
        {
          "id": "mod-04-tile-grid-slicing-and-nes-palettes",
          "title": "Module 4: Slicing Map Atlases into 16×16 Tile Grids & Decoding NES Palettes",
          "durationMinutes": 20,
          "overview": "Slice 1024×1024 (64×64 tiles) map PNGs into deduplicated 16×16 tilesets and 2D walkability grids using Python Pillow and SHA-1 hashing, map entrance teleport coordinates (lut_EntrTele_X/Y), and solve the NES Inside-Room vs. Outside-Room Palette 0 ceiling mask so treasure chests render properly.",
          "lessonHtml": "\n        <div class=\"lesson-section\">\n          <h4 class=\"lesson-subtitle\">🧩 1. Slicing 16×16 Tile Grids with SHA-1 Tile Deduplication</h4>\n          <p class=\"lesson-text\">\n            Every standard town or dungeon map in NES <em>Final Fantasy</em> is a <code>64 &times; 64</code> grid of <code>16 &times; 16</code> pixel metatiles (<code>1024 &times; 1024</code> pixels). Using Python <code>Pillow</code>, we slice each map into 4,096 cells, hash each <code>16 &times; 16</code> RGBA byte buffer with SHA-1 to build a deduplicated <code>tileset.png</code> atlas, and combine it with the ROM tile properties (<code>walkable</code>, <code>special: \"treasure_chest\"</code>, <code>teleport</code>):\n          </p>\n          <pre class=\"code-snippet\"><code>for ty in range(64):\n    row_ids = []\n    for tx in range(64):\n        tile_img = img.crop((tx * 16, ty * 16, (tx + 1) * 16, (ty + 1) * 16))\n        digest = hashlib.sha1(tile_img.tobytes()).hexdigest()\n        if digest not in unique_tiles:\n            unique_tiles[digest] = len(tile_images)\n            tile_images.append(tile_img)\n        row_ids.append(unique_tiles[digest])\n    grid.append(row_ids)</code></pre>\n        </div>\n\n        <div class=\"lesson-section\">\n          <h4 class=\"lesson-subtitle\">🎨 2. The Critical NES Palette Discovery: Outside-Room vs. Inside-Room Palette 0</h4>\n          <p class=\"lesson-text\">\n            In the NES ROM (<code>lut_SMPalettes</code> at <code>$A000</code> in <code>bank_00.dat</code>, 48 bytes per map):\n          </p>\n          <ul style=\"margin-left: 20px; margin-bottom: 14px; font-size: 13px;\">\n            <li><strong>Bytes <code>0..15</code> (Outside-Room Background Palettes)</strong>: Palette 0 is <code>[0x0F, 0x30, 0x30, 0x30]</code> where all three non-zero colors are <code>0x30</code> (solid white)! Why? Because on the NES, indoor rooms and treasure chests (which use <code>tsa_attr == 0</code>, Palette 0) are hidden behind a solid white roof ceiling until the player steps through a doorway!</li>\n            <li><strong>Bytes <code>32..47</code> (<code>+0x20</code>, Inside-Room Background Palettes)</strong>: Palette 0 is <code>[0x0F, 0x10, 0x17, 0x0F]</code>—black (<code>0x0F</code>), silver/gray (<code>0x10</code>), and rich wood brown (<code>0x17</code>). Those three colors render the actual <code>16 &times; 16</code> NES treasure chest pixel art (CHR tiles <code>ul=0x2A, ur=0x2B, dl=0x3A, dr=0x3B</code>)!</li>\n          </ul>\n          <pre class=\"code-snippet\"><code># Render maps using Inside-Room Palette 0 so indoor rooms & treasure chests are visible:\nmap_pal = list(b00[0x2000 + map_id * 0x30 : 0x2000 + map_id * 0x30 + 16])\nin_room_pal = list(b00[0x2000 + map_id * 0x30 + 0x20 : 0x2000 + map_id * 0x30 + 0x30])\nif map_pal[1] == 0x30 and map_pal[2] == 0x30 and map_pal[3] == 0x30:\n    map_pal[0:4] = in_room_pal[0:4]  # [0x0F, 0x10, 0x17, 0x0F] -> silver & brown chest pixels!</code></pre>\n        </div>\n\n        <div class=\"lesson-section\">\n          <h4 class=\"lesson-subtitle\">🚪 3. NES Standard Map Entrance Coordinates (lut_EntrTele_X / lut_EntrTele_Y)</h4>\n          <p class=\"lesson-text\">\n            When transitioning from the Overworld into a town, castle, or dungeon, the NES ROM looks up arrival coordinates in <code>lut_EntrTele_X</code> (<code>$AC00</code>) and <code>lut_EntrTele_Y</code> (<code>$AC20</code>):\n          </p>\n          <div class=\"formula-box\">\n            • Coneria Town (Map 0): Entrance X = 16, Y = 23 (or (16, 21) on the central brick path; x=15 and x=17 are unwalkable trees!)<br>\n            • Coneria Castle 1F (Map 8): Entrance X = 12, Y = 35<br>\n            • Temple of Fiends Present (Map 12): Entrance X = 20, Y = 30\n          </div>\n        </div>\n      ",
          "labSteps": [
            "Run `slice_maps_to_tiles.py` on `FinalFantasy-Coneria.png` and `FinalFantasy-TempleOfFiends.png` to generate `64x64` tile grids and deduplicated tileset strips",
            "Inspect `lut_SMPalettes` (`$A000` in `bank_00.dat`) for Map 12 (`Temple of Fiends`) and compare `bytes[0..3]` (`[0x0f, 0x30, 0x30, 0x30]`) against `bytes[32..35]` (`[0x0f, 0x10, 0x17, 0x0f]`)",
            "Render `temple_of_fiends.png` using `in_room_pal[0:4]` and verify tile `(3, 3)` contains silver `(152, 150, 152)`, brown `(120, 60, 0)`, and black `(0, 0, 0)` chest pixels",
            "Verify Coneria Town (`map_00_coneria.json`) walkability around the south gate (`x=16` is `tileId=16` walkable brick path; `x=15` and `x=17` are `tileId=14` unwalkable trees)"
          ],
          "quiz": [
            {
              "question": "Why did rendering Temple of Fiends with the first 16 bytes of lut_SMPalettes cause treasure chests at (2, 3) and (3, 3) to appear as solid white/blank squares?",
              "options": [
                "Because bytes 0..3 are the outside-room Palette 0 ([0x0F, 0x30, 0x30, 0x30]) which masks indoor rooms and chests in solid white (0x30) until the inside-room palette at +0x20 ([0x0F, 0x10, 0x17, 0x0F]) is applied",
                "Because treasure chests in NES Final Fantasy are drawn as sprites rather than background metatiles",
                "Because the PNG file was saved in grayscale mode",
                "Because Temple of Fiends has no treasure chests in the NES version"
              ],
              "answer": "Because bytes 0..3 are the outside-room Palette 0 ([0x0F, 0x30, 0x30, 0x30]) which masks indoor rooms and chests in solid white (0x30) until the inside-room palette at +0x20 ([0x0F, 0x10, 0x17, 0x0F]) is applied",
              "explanation": "The NES ROM stores outside-room palettes at +0x00 and inside-room palettes at +0x20 (32 bytes); using +0x20 for Palette 0 restores the silver (0x10) and brown (0x17) chest colors."
            },
            {
              "question": "In Coneria Town (map_00_coneria.json), why did spawning the hero at (15, 22) trap the hero in a tree, and what is the correct entrance column?",
              "options": [
                "Column x=15 (and x=17) is a row of unwalkable trees (tileId=14) flanking the central walkable brick entrance road at column x=16 (tileId=16)",
                "The entire bottom half of Coneria is water tiles",
                "Coneria is only 10x10 tiles wide",
                "Tile (15, 22) is inside the Castle throne room"
              ],
              "answer": "Column x=15 (and x=17) is a row of unwalkable trees (tileId=14) flanking the central walkable brick entrance road at column x=16 (tileId=16)",
              "explanation": "Column x=16 is the walkable brick entrance street (matching lut_EntrTele_X = 16), whereas x=15 and x=17 are tree columns bordering the road."
            }
          ]
        },
        {
          "id": "mod-05-godot-runtime-and-http-control-bridge",
          "title": "Module 5: Clean-Room Art Generation (jrpg-generate-art) & Scaffolding the Godot 4 Runtime",
          "durationMinutes": 15,
          "overview": "Synthesize clean-room sprites and battle backdrops with jrpg-generate-art, scaffold the Godot 4.3 GL Compatibility runtime (TitleScreen, PartyCreate, FF1MapScene, GameState), and expose the port 8090 HTTP/JSON GameControlServer.gd automation bridge.",
          "lessonHtml": "\n        <div class=\"lesson-section\">\n          <h4 class=\"lesson-subtitle\">🎨 1. Generating Clean-Room Art with jrpg-generate-art</h4>\n          <p class=\"lesson-text\">\n            When creating redistributable assets from a parsed JRPG Knowledge Graph, the <code>jrpg-generate-art</code> skill invokes <code>packages/robos-jrpg-parser/bin/jrpg-generate-art.js</code> (backed by <code>robos-lib/ai-image</code>) to synthesize clean-room class battle sprites, enemies, and battle backdrops while keeping reference rips strictly local:\n          </p>\n          <pre class=\"code-snippet\"><code>node packages/robos-jrpg-parser/bin/jrpg-generate-art.js \\\n  --kgraph /home/ndipiazza/kgraphs/final-fantasy-nes \\\n  --only classes,backdrops</code></pre>\n        </div>\n\n        <div class=\"lesson-section\">\n          <h4 class=\"lesson-subtitle\">🎮 2. Data-Driven Godot 4.3 Scene Architecture (Zero Hardcoded Stats)</h4>\n          <p class=\"lesson-text\">\n            The Godot 4 project in <code>/home/ndipiazza/Downloads/ff1/ff1-game</code> is generated by <code>build_ff1_godot_game.py</code> using four core scripts:\n          </p>\n          <ul style=\"margin-left: 20px; margin-bottom: 14px; font-size: 13px;\">\n            <li><strong><code>GameState.gd</code></strong>: Loads <code>res://data/classes_and_xp.json</code>, <code>res://data/enemies.json</code>, and <code>res://data/spells.json</code> on boot. Builds the 4 Light Warriors (<code>ZEST</code> Fighter, <code>SAIL</code> Thief, <code>ROBO</code> White Mage, <code>MAGE</code> Black Mage) with exact NES Lv.1 stats and <code>400 G</code>.</li>\n            <li><strong><code>TitleScreen.gd</code> &amp; <code>PartyCreate.gd</code></strong>: Classic NES blue-bordered prologue screen and 4-slot party creation UI that transitions into <code>res://scenes/Coneria.tscn</code> at <code>Vector2i(16, 21)</code>.</li>\n            <li><strong><code>FF1MapScene.gd</code></strong>: Unified 2D map, NPC dialogue, chest search (<code>SEARCH</code>), status menu, and turn-based NES battle engine shared across <code>Coneria.tscn</code>, <code>ConeriaCastle1F.tscn</code>, <code>ConeriaCastle2F.tscn</code>, and <code>TempleOfFiends.tscn</code>.</li>\n            <li><strong><code>GameControlServer.gd</code></strong>: Non-blocking TCP HTTP/JSON server on <code>127.0.0.1:8090</code> enabling external agents and Cucumber step definitions to inspect game state and inject input actions.</li>\n          </ul>\n          <pre class=\"code-snippet\"><code># GameControlServer.gd REST Endpoints on 127.0.0.1:8090\nGET  /api/v1/health   -> {\"status\": \"ok\", \"game\": \"Final Fantasy NES\", \"fps\": 60}\nGET  /api/v1/state    -> {\"scene_shown\": {...}, \"hero_position\": {\"x\":16,\"y\":18}, \"dialog_box\": {...}, \"battle\": {...}, \"game_state\": {...}}\nPOST /api/v1/input    -> {\"action\": \"ui_accept\" | \"move_up\" | \"move_down\" | \"move_left\" | \"move_right\"}\nPOST /api/v1/command  -> {\"command\": \"load_scene\" | \"teleport\" | \"select_command\", \"args\": {...}}</code></pre>\n        </div>\n      ",
          "labSteps": [
            "Run `python3 /home/ndipiazza/Downloads/ff1/build_ff1_godot_game.py` to generate `project.godot`, `scripts/*.gd`, and `scenes/*.tscn`",
            "Run `godot4 --headless --path /home/ndipiazza/Downloads/ff1/ff1-game --import` so Godot imports all map PNGs, class/NPC/enemy sprites, and MP3 tracks",
            "Inspect `scripts/GameControlServer.gd` to trace how `POST /api/v1/input` synthesizes `InputEventAction` presses (`ui_accept`, `move_up`, etc.) across frames",
            "Inspect `scripts/FF1MapScene.gd` to verify how `_cmd_talk()`, `_cmd_search()`, and `_start_battle(\"GARLAND\")` update `GameState` flags (`garland_defeated`, `princess_rescued`, `bridge_built`)"
          ],
          "quiz": [
            {
              "question": "How does the external Cucumber (behave) test runner communicate with the running Godot 4 game inside Xvfb?",
              "options": [
                "Via the embedded HTTP/JSON server in GameControlServer.gd listening on 127.0.0.1:8090 (/api/v1/state, /api/v1/input, /api/v1/command)",
                "By reading raw process memory with gdb",
                "By simulating physical USB keyboard hardware interrupts in the Linux kernel",
                "By modifying .tscn files while the game is running"
              ],
              "answer": "Via the embedded HTTP/JSON server in GameControlServer.gd listening on 127.0.0.1:8090 (/api/v1/state, /api/v1/input, /api/v1/command)",
              "explanation": "GameControlServer.gd runs as a Godot autoload singleton listening on 127.0.0.1:8090, exposing deterministic JSON state queries and input injection."
            },
            {
              "question": "Why must you run godot4 --headless --path <project> --import after updating map PNG textures on disk?",
              "options": [
                "So Godot regenerates its internal .godot/imported/*.ctex compressed texture cache from the updated PNG files",
                "To compile GDScript files into Windows .dll libraries",
                "To upload the textures to GitHub Pages",
                "Because Godot deletes PNG files after reading them once"
              ],
              "answer": "So Godot regenerates its internal .godot/imported/*.ctex compressed texture cache from the updated PNG files",
              "explanation": "Godot 4 loads imported .ctex resources from .godot/imported/; running --import ensures modified PNGs (such as re-rendered inside-room palette maps) are updated in the cache."
            }
          ]
        },
        {
          "id": "mod-06-cucumber-playthrough-and-visual-debugging",
          "title": "Module 6: Automated Cucumber (behave) Playthroughs & Visual Frame Debugging by RobOS Agents",
          "durationMinutes": 15,
          "overview": "Execute the 3 end-to-end Gherkin scenarios inside headless Xvfb :98 with Godot --write-movie and FFmpeg H.264 MP4 recording, and walk through the exact frame-extraction debugging loop used by RobOS agents to fix the Coneria tree-spawn bug and the Temple of Fiends teal-box treasure chest bug.",
          "lessonHtml": "\n        <div class=\"lesson-section\">\n          <h4 class=\"lesson-subtitle\">🎬 1. Headless Xvfb + Godot Movie Maker (--write-movie) Pipeline</h4>\n          <p class=\"lesson-text\">\n            Every Cucumber scenario in <code>tests/e2e/features/</code> launches Godot inside virtual display <code>Xvfb :98</code> with <code>--write-movie</code>, records a deterministic 60 FPS AVI with audio, and transcodes it via <code>ffmpeg</code> into an H.264 MP4 proof-of-work video:\n          </p>\n          <pre class=\"code-snippet\"><code># Run all 3 Cucumber E2E scenarios and record MP4 proof videos\ncd /home/ndipiazza/Downloads/ff1/ff1-game\nbehave tests/e2e/features --no-capture\n\n# Output videos in tests/e2e/reports/videos/:\n# 1. start_a_new_game_from_title_screen_create_4_light_warriors_and_enter_coneria.mp4\n# 2. speak_to_coneria_townsfolk_and_the_king_of_coneria_in_the_throne_room.mp4\n# 3. open_a_treasure_chest_in_the_temple_of_fiends_and_defeat_garland.mp4</code></pre>\n        </div>\n\n        <div class=\"lesson-section\">\n          <h4 class=\"lesson-subtitle\">🔍 2. Visual Debugging Case Studies: Why Passing Assertions Are Not Enough</h4>\n          <p class=\"lesson-text\">\n            Even when all 29 Cucumber steps pass functionally, visual defects can still appear in the rendered video. Here is the exact 4-step visual debugging loop our RobOS agent executed to fix two visual bugs spotted in the initial MP4 recordings:\n          </p>\n          <div class=\"formula-box\">\n            Case Study 1 — Hero Stuck in a Tree at End of Scenario 1:<br>\n            • Observation: In start_a_new_game_...mp4, the hero spawned at (15, 22) on top of a green tree tile.<br>\n            • KGraph Tile Check: In map_00_coneria.json, column x=16 (tileId=16) is the central brick entrance street; x=15 and x=17 (tileId=14) are unwalkable trees.<br>\n            • Fix: Changed spawn_tile to Vector2i(16, 21) and added \"When the hero moves up 3 tiles\" to walk cleanly up the brick road to (16, 18).<br><br>\n            Case Study 2 — Treasure Chest Showing as a Teal Box in Scenario 3:<br>\n            • Observation: In open_a_treasure_chest_...mp4, chests at (2, 3) and (3, 3) appeared as solid teal squares.<br>\n            • Root Cause: (1) temple_of_fiends.png used outside-room Palette 0 ([0x0F, 0x30, 0x30, 0x30] white ceiling), and (2) FF1MapScene.gd drew a semi-transparent green/yellow ColorRect (_chest_markers) on top of every chest tile.<br>\n            • Fix: Re-rendered maps with inside-room Palette 0 (+0x20: [0x0F, 0x10, 0x17, 0x0F]), removed the ColorRect overlay in FF1MapScene.gd, and re-ran godot4 --import + behave.\n          </div>\n          <pre class=\"code-snippet\"><code># Extract verification frames from recorded MP4 videos using FFmpeg:\nffmpeg -y -sseof -0.3 -i tests/e2e/reports/videos/start_a_new_game_from_title_screen_create_4_light_warriors_and_enter_coneria.mp4 -frames:v 1 /tmp/verify_coneria.png\nffmpeg -y -ss 0.5 -i tests/e2e/reports/videos/open_a_treasure_chest_in_the_temple_of_fiends_and_defeat_garland.mp4 -frames:v 1 /tmp/verify_chest.png</code></pre>\n          <div class=\"doc-figure\">\n            <img src=\"/assets/elearning/jrpg-kgraph/jrpg-godot-cucumber-playthrough-harness.png\" alt=\"Stage 3: Godot 4 Scene Engine, HTTP Control Bridge and Xvfb Cucumber Video Proof-of-Work\" class=\"doc-img\" onclick=\"openLightbox(this.src, this.alt)\">\n            <div class=\"doc-caption\">Figure 3.1: Stage 3 technical schematic — Cucumber BDD runner, HTTP control bridge on port 8090, headless Xvfb Godot 4 execution, and FFmpeg visual frame inspection loop.</div>\n          </div>\n        </div>\n      ",
          "labSteps": [
            "Execute `cd /home/ndipiazza/Downloads/ff1/ff1-game && behave tests/e2e/features --no-capture` and confirm `3 features passed, 3 scenarios passed, 29 steps passed`",
            "Extract the final frame of Scenario 1 (`ffmpeg -sseof -0.3 -i ... -frames:v 1`) and verify the hero is standing on the central brick path at `(16, 18)` in Coneria",
            "Extract the opening frame of Scenario 3 (`ffmpeg -ss 0.5 -i ... -frames:v 1`) and verify the wooden-and-silver NES treasure chests at `(2, 3)` and `(3, 3)` are clearly visible in front of the hero at `(3, 4)`",
            "Complete all module quizzes with >= 80% score to unlock and claim your W3C SHACL-verified RobOS Certificate of Completion!"
          ],
          "quiz": [
            {
              "question": "What combination of two issues caused the treasure chests in Temple of Fiends to appear as solid teal boxes before our fix?",
              "options": [
                "Rendering the map with the outside-room 0x30 white ceiling Palette 0 AND drawing a semi-transparent colored ColorRect overlay (_chest_markers) on top of chest tiles in FF1MapScene.gd",
                "Missing OpenGL drivers in Xvfb and a corrupted font file",
                "Using a 16-color GIF instead of a 24-bit PNG",
                "Setting Camera2D zoom to 0.1x"
              ],
              "answer": "Rendering the map with the outside-room 0x30 white ceiling Palette 0 AND drawing a semi-transparent colored ColorRect overlay (_chest_markers) on top of chest tiles in FF1MapScene.gd",
              "explanation": "Using the inside-room Palette 0 (+0x20: [0x0F, 0x10, 0x17, 0x0F]) baked the authentic silver/brown chest pixel art into temple_of_fiends.png, and removing the ColorRect overlay let the pixel art show cleanly."
            },
            {
              "question": "How does a RobOS agent visually verify that a recorded Cucumber MP4 video has no sprite-placement or palette defects after all Gherkin assertions pass?",
              "options": [
                "By extracting key frames from the MP4 with ffmpeg (-frames:v 1) and visually inspecting the rendered PNG frames alongside the KGraph tile coordinates",
                "By checking only the process exit code (0)",
                "By counting the file size of the MP4 in bytes",
                "By grepping project.godot for syntax errors"
              ],
              "answer": "By extracting key frames from the MP4 with ffmpeg (-frames:v 1) and visually inspecting the rendered PNG frames alongside the KGraph tile coordinates",
              "explanation": "Extracting key frames with ffmpeg allows the agent to visually inspect the rendered scene and verify that sprites, tiles, and palettes match the KGraph specification."
            }
          ]
        }
      ]
    }
  ],
  "robos:package": "learning",
  "robos:version": "1.0.0"
}
