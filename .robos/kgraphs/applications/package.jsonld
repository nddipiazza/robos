      "dcterms:description": "Provider-agnostic Zero-Trust App & IPC Port Mesh that securely bridges RobOS application IPC/snapshot ports (19100–19231) and service ports (:3410, :19210, :19213, :63343) across machines on the same or different networks using built-in Mutual TLS 1.3 peer pinning, OpenZiti, Tailscale/Headscale, NetBird, or WireGuard.",
      "dcterms:title": "RobOS App Mesh",
      "robos:desktopFramework": "Electron",
      "robos:namespace": "robos.applications",
      "robos:package": "applications",
      "robos:repository": "packages/app-mesh",
      "robos:schemaOrgType": "https://schema.org/SoftwareApplication",
      "robos:technology": "Electron 28 / Mutual TLS 1.3 / OpenZiti / Tailscale / NetBird / WireGuard"
    },
