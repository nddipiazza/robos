{
  "name": "robos-auto-center",
  "version": "0.1.0",
  "description": "RobOS Auto Center: public vehicle reference data and local maintenance records",
  "main": "main.js",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron . --no-sandbox --disable-gpu --disable-dev-shm-usage",
    "collect": "python3 collect.py",
    "import": "node --max-old-space-size=8192 cli.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/electron.e2e.js tests/modes.e2e.js tests/reports.e2e.js",
    "recalls": "node --max-old-space-size=8192 recalls-cli.js",
    "e2e:lifecycle": "cucumber-js --config tests/e2e/cucumber.cjs"
  },
  "dependencies": {
    "electron": "^33.2.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "marked": "^12.0.2"
  }
}
