[Desktop Entry]
X-RobOS-Category=Security
X-RobOS-App=true
Name=Git Login Manager
Comment=Monitor and manage GitHub authentication and SSH credentials
Exec=/usr/bin/electron /usr/local/share/robos/git-login-manager/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/git-login-manager/icon.svg
Terminal=false
Type=Application
Categories=Utility;Network;
StartupWMClass=robos-git-login-manager
