{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dragonwarrior.org/schemas/v1/locations.schema.json",
  "title": "LocationsDataStoreV1",
  "description": "Schema for Dragon Warrior world locations (towns, castles, dungeons, shrines), floor counts, services, NPCs, and shops.",
  "type": "array",
  "items": {
    "type": "object",
    "title": "LocationEntity",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$",
        "description": "Unique location ID."
      },
      "name": {
        "type": "string",
        "description": "Display name of location."
      },
      "type": {
        "$ref": "common.schema.json#/$defs/LocationType"
      },
      "description": {
        "type": "string"
      },
      "inn_price": {
        "type": ["integer", "null"],
        "minimum": 0
      },
      "has_save": {
        "type": "boolean"
      },
      "floors": {
        "type": "integer",
        "minimum": 1
      },
      "npcs": {
        "type": "array",
        "items": { "type": "object" }
      },
      "shops": {
        "type": "array",
        "items": { "type": "object" }
      },
      "chests": {
        "type": "array",
        "items": { "type": "object" }
      },
      "floor_data": {
        "type": "array",
        "items": { "type": "object" }
      }
    },
    "required": ["id", "name", "type"]
  }
}
