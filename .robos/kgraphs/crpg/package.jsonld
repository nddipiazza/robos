    {
      "@id": "urn:robos:crpg:qa-player:virtual-tester",
      "@type": [
        "oslc_am:Resource",
        "robos:QAPlayer",
        "robos:AutonomousVirtualTester",
        "schema:SoftwareApplication"
      ],
      "dcterms:description": "Autonomous virtual human user simulation engine that plays the cRPG game via screen perception and simulated user inputs (mouse clicks, typing, UI button selections) with zero backend cheats.",
      "dcterms:title": "RobOS Video Game QA Player (Virtual User Tester)",
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:supportsScenarios": [
        "urn:robos:crpg:qa-scenario:character-creation-and-first-scene"
      ],
      "robos:zeroCheatsEnforced": true
    },
    {
      "@id": "urn:robos:crpg:qa-scenario:character-creation-and-first-scene",
      "@type": [
        "robos:Scenario",
        "robos:QAScenario",
        "schema:Action"
      ],
      "dcterms:description": "Simulates a user selecting Fighter Lieutenant Vance, embarking into the Homestead, talking with partner Elora, looting the footlocker, and exiting into Oakhaven Village.",
      "dcterms:title": "QA User Simulation: Character Creation and First Scene (Homestead)",
      "robos:evidenceVideo": "games/crpg-realm/tests/e2e/reports/videos/qa_evidence_character_creation_and_homestead.mp4",
      "robos:inFeature": "urn:robos:crpg:feature:qa-player-user-simulation",
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:steps": [
        "Typing hero name",
        "Selecting Fighter class archetype",
        "Clicking Embark",
        "Arriving in Homestead",
        "Interacting with partner Elora and progressing dialogue",
        "Looting footlocker for equipment",
        "Exiting through front door into Village Square"
      ]
    },
    {
      "@id": "urn:robos:crpg:quest:dreppin-sick-cow",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGQuest",
        "oslc_cm:ChangeRequest"
      ],
      "dcterms:title": "Dreppin's Sick Cow",
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:questCategory": "Miscellaneous Favors",
      "robos:questGiver": "Dreppin",
