  "dcterms:title": "Tabletop Dungeon Crawler & HeroQuest Ruleset Package",
  "dcterms:description": "Turn-based dungeon crawler board game mechanics, 26x19 tactical board layout, 4 classic heroes (Barbarian, Dwarf, Elf, Wizard), 8 monster types, 12 elemental spell cards, furniture props, and The Trial quest scenario.",
  "robos:nodes": [
