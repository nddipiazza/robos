          "characterName": "Donald Trump",
          "dcterms:title": "Donald Trump",
          "defendDice": 2,
          "equippedArmor": "Gold-Plated Rune Mail (2 Defend Dice)",
          "equippedWeapon": "Gilded Dwarven Battle-Axe (2 Combat Dice)",
          "gold": 250,
          "heroClass": "Dwarf",
          "icon": "🪓",
          "id": "urn:robos:tabletop:hero:trump",
          "inventory": [
            {
              "effect": "Disarms any pit, boulder, or bureaucratic trap",
              "id": "item-toolkit-trump",
              "name": "Golden Dwarven Trap Toolkit",
              "type": "tool",
              "value": 150
            },
            {
              "effect": "Restores up to 4 BP",
              "id": "item-pot-heal-trump",
              "name": "Elixir of Tremendous Stamina",
              "type": "potion",
              "value": 100
            }
          ],
          "mindPoints": 3,
          "name": "Donald Trump",
          "portraitAsset": "assets/portraits/card_bg_trump.png",
          "robos:attackDice": 4,
          "robos:audioLines": {
            "attacked": [
              {
                "audio": "res://assets/audio/heroes/trump_quote_1.ogg",
                "text": "They're eating the dogs! Sleepy Crooked Joe Biden — I really don't know what he said!"
              },
              {
                "audio": "res://assets/audio/heroes/trump_quote_2.ogg",
                "text": "Threatening me with 400 years in prison for possessing my own presidential papers, which just about every other president has done!"
              },
              {
                "audio": "res://assets/audio/heroes/trump_quote_3.ogg",
                "text": "A crooked New York state judge just ruled that I have to pay a fine of $355 million for having built a perfect company! It's a disgrace — I don't even know who this woman is!"
              },
              {
                "audio": "res://assets/audio/heroes/trump_quote_4.ogg",
                "text": "I do like my garbage truck! Crooked Joe Biden finally said what he and Kamala really think of our supporters — he called them garbage, no way!"
              },
              {
                "audio": "res://assets/audio/heroes/trump_quote_5.ogg",
                "text": "Well, I took two tests — cognitive tests. I aced them, both of them! He took none! I'd like to see him take one, just one, a real easy one!"
              },
              {
                "audio": "res://assets/audio/heroes/trump_quote_6.ogg",
                "text": "I won two regular club championships! To do that, you have to be quite smart and hit the ball a long way. And I do it! He can't hit a ball 50 yards!"
              },
              {
                "audio": "res://assets/audio/heroes/trump_quote_7.ogg",
                "text": "She did things that nobody would ever think of! Now she wants to do transgender operations on illegal aliens that are in prison!"
              },
              {
                "audio": "res://assets/audio/heroes/trump_quote_8.ogg",
                "text": "Well, we need Greenland for national security purposes! People really don't even know if Denmark has any legal right to it, but if they do, they should give it up!"
              }
            ],
            "attacking": [
              {
                "audio": "res://assets/audio/heroes/trump_quote_1.ogg",
