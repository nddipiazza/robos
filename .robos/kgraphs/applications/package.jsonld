      "@type": [
        "oslc_am:Resource",
        "robos:FrontEndApp"
      ],
      "dcterms:title": "Billing Web Portal",
      "robos:framework": "React 19 / Vite",
      "robos:package": "applications",
      "robos:namespace": "robos.applications",
      "robos:repository": "github.com/acme/billing-portal",
