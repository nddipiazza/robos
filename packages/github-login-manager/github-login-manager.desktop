[Desktop Entry]
X-RobOS-Category=RobOS Security
X-RobOS-App=true
Name=RobOS GitHub Login Manager
Comment=Monitor GitHub authentication and re-login when needed
Exec=/usr/local/bin/robos-launch github-login-manager
Icon=/usr/local/share/robos/github-login-manager/icon.svg
Terminal=false
Type=Application
Categories=Utility;Network;
StartupWMClass=github-login-manager
