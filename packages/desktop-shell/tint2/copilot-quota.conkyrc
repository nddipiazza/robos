-- RobOS Copilot Quota Desktop Widget
-- Displays GitHub Copilot premium request usage on the desktop

conky.config = {
    -- Refresh every 30s (data itself refreshes every 120s via background script)
    update_interval = 30,
    total_run_times = 0,

    -- Sit on the desktop (below windows, above wallpaper)
    own_window = true,
    own_window_type = 'desktop',
    own_window_transparent = false,
    own_window_argb_visual = true,
    own_window_argb_value = 220,
    own_window_colour = '#0d1a2e',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',

    double_buffer = true,

    -- Top-right corner, 20px from edge, 20px from top
    alignment = 'top_right',
    gap_x = 20,
    gap_y = 20,

    minimum_width = 300,
    maximum_width = 300,

    -- Fonts
    use_xft = true,
    font = 'DejaVu Sans:size=9',
    xftalpha = 0.9,

    -- Base colors
    default_color = '#c9d1d9',

    -- Named colors:
    --  color1 = cyan accent
    --  color2 = green (healthy)
    --  color3 = yellow (warning)
    --  color4 = orange (danger)
    --  color5 = red (critical)
    --  color6 = dim/muted
    color1 = '#00bcd4',
    color2 = '#4caf50',
    color3 = '#ffeb3b',
    color4 = '#ff9800',
    color5 = '#f44336',
    color6 = '#484f58',

    -- Borders
    draw_borders = false,
    draw_outline = false,
    draw_shades = false,

    border_width = 1,
    border_outer_margin = 8,

    -- No background drawn by conky (own_window_colour handles it)
    draw_graph_borders = true,

    -- Disable default text
    out_to_x = true,
    out_to_console = false,
}

conky.text = [[
${color1}${font DejaVu Sans:bold:size=10}>> COPILOT PREMIUM REQUESTS${font}${color}
${color1}${hr 1}${color}
${color6}Remaining   ${color1}${font DejaVu Sans:bold:size=14}${execp cat /tmp/robos-cop-remaining.txt 2>/dev/null || echo --}${font}${color6} / ${execp cat /tmp/robos-cop-entitlement.txt 2>/dev/null || echo --}
${color6}Used        ${color}${execp cat /tmp/robos-cop-used.txt 2>/dev/null || echo --} requests
${color6}Resets      ${color}${execp cat /tmp/robos-cop-reset.txt 2>/dev/null || echo --}
${color1}${hr 1}${color}
${color6}${execbar 8,284 cat /tmp/robos-cop-pct.txt 2>/dev/null || echo 0}
${color6}${execp PCT=$(cat /tmp/robos-cop-pct.txt 2>/dev/null); echo "${PCT}% remaining"}${color}
${exec /usr/local/share/robos/copilot-quota-refresh.sh}]]
