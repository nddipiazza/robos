{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dragonwarrior.org/schemas/v1/spells.schema.json",
  "title": "SpellsDataStoreV1",
  "description": "Schema for Quest: Warrior Dragon player spells, MP costs, learned levels, targeting rules, and spell effects.",
  "type": "array",
  "items": {
    "type": "object",
    "title": "SpellEntity",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$",
        "description": "Unique machine-readable spell ID."
      },
      "name": {
        "type": "string",
        "description": "Display name of the spell."
      },
      "mp_cost": {
        "type": "integer",
        "minimum": 0,
        "description": "Magic points required to cast."
      },
      "level_learned": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30,
        "description": "Hero level required to learn this spell."
      },
      "target": {
        "$ref": "common.schema.json#/$defs/SpellTarget"
      },
      "effect": {
        "type": "string",
        "description": "Human-readable description of spell effect."
      },
      "hp_restore_min": {
        "type": "integer",
        "minimum": 0
      },
      "hp_restore_max": {
        "type": "integer",
        "minimum": 0
      },
      "damage_min": {
        "type": "integer",
        "minimum": 0
      },
      "damage_max": {
        "type": "integer",
        "minimum": 0
      },
      "formula": {
        "type": "string"
      },
      "blocked_by": {
        "type": "string"
      },
      "mechanics": {
        "type": "string"
      },
      "duration_steps": {
        "type": "integer",
        "minimum": 0
      },
      "radius_stages": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "radius": { "type": "integer" },
            "steps": { "type": "integer" }
          },
          "required": ["radius", "steps"]
        }
      },
      "note": {
        "type": "string"
      },
      "repel_condition": {
        "type": "string"
      }
    },
    "required": ["id", "name", "mp_cost", "level_learned", "target", "effect"]
  }
}
