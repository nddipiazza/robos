[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=Report Builder
Comment=AI-generated reports from natural language queries
Exec=/usr/bin/electron /usr/local/share/robos/report-builder/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/report-builder/icon.svg
Terminal=false
Categories=Development;
X-RobOS-Category=Management
StartupWMClass=report-builder
