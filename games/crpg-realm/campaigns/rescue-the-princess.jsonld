        "act": "Act I",
        "summary": "King Alden tasks Sir Caleb with rescuing Princess Jennifer, and Caleb proves his valor at the Dragonclaw Forge."
      },
      {
        "id": "page-2",
        "name": "Act II: The Journey & Slaying Malakor",
        "act": "Act II",
        "summary": "Sir Caleb journeys across the World Realm, enters the Lair, and slays Dark Lord Malakor."
      },
      {
        "id": "page-3",
        "name": "Act III: The Triumphant Return",
        "act": "Act III",
        "summary": "Princess Jennifer is safely returned to the Throne Room, achieving total campaign victory."
      }
    ],
    "robos:storyNodes": [
      {
        "id": "node-kings-plea",
        "dcterms:title": "The King's Royal Decree",
        "robos:nodeType": "game_start",
        "robos:act": "Act I",
        "robos:flowPage": "page-1",
        "robos:location": "throne-room",
        "robos:giver": "King Alden",
        "robos:summary": "King Alden reveals that Princess Jennifer has been abducted by Dark Lord Malakor. He commands Sir Caleb to obtain the Hero's Sword from Master Torvald before entering the dungeon.",
        "robos:choices": [
          {
            "id": "choice-accept-decree",
            "label": "Accept King's decree and go to Dragonclaw Forge",
            "targetNodeId": "node-dragonclaw-forge-trial"
          }
        ]
      },
      {
        "id": "node-dragonclaw-forge-trial",
        "dcterms:title": "Master Torvald's Crucible",
        "robos:nodeType": "quest_stage",
        "robos:act": "Act I",
        "robos:flowPage": "page-1",
        "robos:location": "main-castle",
        "robos:giver": "Master Torvald",
        "robos:summary": "Master Torvald at the Dragonclaw Forge requires proof of valor before yielding the rune-forged Hero's Sword. He conjures a Projection Goblin.",
        "robos:choices": [
          {
            "id": "choice-fight-projection",
            "label": "Draw steel and duel the astral projection",
            "targetNodeId": "node-slay-projection-goblin"
          }
        ]
      },
      {
        "id": "node-slay-projection-goblin",
        "dcterms:title": "Trial of the Projection Goblin",
        "robos:nodeType": "combat_trial",
        "robos:act": "Act I",
        "robos:flowPage": "page-1",
        "robos:location": "main-castle",
        "robos:giver": "Master Torvald",
        "robos:summary": "Sir Caleb slays the weak Projection Goblin with ease. Master Torvald awards the legendary Hero's Sword and opens the castle gate.",
        "robos:choices": [
          {
            "id": "choice-claim-sword",
            "label": "Claim Hero's Sword and depart through the gate into the World",
            "targetNodeId": "node-journey-through-world"
          }
        ]
      },
      {
        "id": "node-journey-through-world",
        "dcterms:title": "Wilderness Trek to the Cavern Maw",
        "robos:nodeType": "quest_stage",
        "robos:act": "Act II",
        "robos:flowPage": "page-2",
        "robos:location": "world-overworld",
        "robos:summary": "Equipped with the Hero's Sword, Sir Caleb journeys across the wilderness and crags of the World Realm, discovering the entrance to the Dark Lord's Lair.",
        "robos:choices": [
          {
            "id": "choice-enter-lair",
            "label": "Descend into the darkness to confront Dark Lord Malakor",
            "targetNodeId": "node-confront-dark-lord"
          }
        ]
      },
      {
        "id": "node-confront-dark-lord",
        "dcterms:title": "Slaying the Dark Lord",
        "robos:nodeType": "combat_trial",
        "robos:act": "Act II",
        "robos:flowPage": "page-2",
        "robos:location": "dark-lord-lair",
        "robos:giver": "Dark Lord Malakor",
        "robos:summary": "Sir Caleb battles Dark Lord Malakor. The Hero's Sword shatters Malakor's shadow ward and slays the Dark Lord, liberating Princess Jennifer from her cage.",
        "robos:choices": [
          {
            "id": "choice-rescue-princess",
            "label": "Unlock the gilded cage and escort Princess Jennifer home",
            "targetNodeId": "node-triumphant-return"
          }
        ]
      },
      {
        "id": "node-triumphant-return",
        "dcterms:title": "Victory: The Kingdom Celebrates",
        "robos:nodeType": "end_game_state",
        "robos:act": "Act III",
        "robos:flowPage": "page-3",
        "robos:location": "throne-room",
        "robos:giver": "King Alden",
        "robos:summary": "Sir Caleb returns Princess Jennifer to King Alden in the Throne Room. King Alden declares Sir Caleb the Savior of the Realm, and victory is proclaimed across the land.",
        "robos:endingType": "triumph",
        "robos:victoryStatus": "victory",
        "robos:epilogueText": "With Dark Lord Malakor vanquished and Princess Jennifer safely restored to the throne, the bells of the High Kingdom chime in celebration of Sir Caleb's valor."
      }
    ]
  },
