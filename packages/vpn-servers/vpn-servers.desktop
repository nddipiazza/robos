[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS VPN Servers
Comment=Manage OpenVPN providers (IPVanish built-in), VPN accounts, and server locations (.ovpn profiles)
Exec=/usr/bin/electron /usr/local/share/robos/vpn-servers/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/vpn-servers/icon.svg
Terminal=false
Categories=Security;Network;Settings;
X-RobOS-Category=Security
StartupWMClass=robos-vpn-servers
