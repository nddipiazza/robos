[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Git Projects
Comment=Manage your git project workspaces
Exec=/usr/bin/electron /usr/local/share/robos/git-projects/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/git-projects/icon.svg
Terminal=false
Categories=Development;
X-RobOS-Category=RobOS Dev
StartupWMClass=git-projects
