-- RobOS Pass Status Desktop Widget
-- Shows pass lock state, remaining time, and today's access count

conky.config = {
    update_interval = 5,
    total_run_times = 0,

    own_window = true,
    own_window_type = 'desktop',
    own_window_transparent = false,
    own_window_argb_visual = true,
    own_window_argb_value = 220,
    own_window_colour = '#0d1a2e',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',

    double_buffer = true,

    -- Below copilot quota widget (quota widget ~170px tall + 20px gap)
    alignment = 'top_right',
    gap_x = 20,
    gap_y = 199,

    minimum_width = 300,
    maximum_width = 300,

    use_xft = true,
    font = 'DejaVu Sans:size=9',
    xftalpha = 0.9,

    default_color = '#c9d1d9',
    color1 = '#00bcd4',
    color2 = '#4caf50',
    color3 = '#f44336',
    color6 = '#484f58',

    draw_borders = false,
    draw_outline = false,
    draw_shades = false,
    border_outer_margin = 8,

    out_to_x = true,
    out_to_console = false,
}

conky.text = [[
${color1}${font DejaVu Sans:bold:size=10}>> AGENT PASS STORE PERMISSION${font}${color}
${color1}${hr 1}${color}
${execp ~/.local/bin/pass-status.sh}
${color1}${hr 1}${color}
${color6}Secrets managed by pass + gpg-agent${color}]]
