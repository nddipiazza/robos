<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RobosSmartHome" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/robos_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.RobosSmartHome.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/robos_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.RobosSmartHome</item>
    </style>
</resources>
