[Desktop Entry]
Type=Application
Name=RobOS AI Provider Check
Comment=Opens Agents Manager if no AI provider is configured and working
Exec=/usr/local/share/robos/agents-manager/node_modules/electron/dist/electron /usr/local/share/robos/agents-manager --no-sandbox --disable-gpu --disable-dev-shm-usage --check-provider
Terminal=false
Hidden=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=5
