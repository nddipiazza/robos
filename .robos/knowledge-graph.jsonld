          "description": "Create User Directory Sync record"
        },
        {
          "path": "/api/v1/user-directory-sync/{id}",
          "method": "GET",
          "description": "Get User Directory Sync by ID"
        },
        {
          "path": "/healthz",
          "method": "GET",
          "description": "Health check"
        }
      ],
