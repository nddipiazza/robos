  "steps": [
    "Sum the values of the first 4 characters: name_sum = char_val[0] + char_val[1] + char_val[2] + char_val[3]",
    "growth_type = name_sum % 4",
    "bonus = floor(name_sum / 4) % 4"
  ],
  "growth_types": {
    "0": {
      "long_term": [
        "hp",
        "mp"
      ],
      "short_term": [
        "strength",
        "agility"
      ]
    },
    "1": {
      "long_term": [
        "strength",
