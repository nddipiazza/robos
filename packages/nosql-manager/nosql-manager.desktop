[Desktop Entry]
Name=NoSQL DB Manager
Comment=RobOS NoSQL Database Management Studio
Exec=/usr/local/share/robos/nosql-manager/node_modules/.bin/electron /usr/local/share/robos/nosql-manager --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/nosql-manager/icon.svg
Terminal=false
Type=Application
Categories=Development;Database;
StartupWMClass=nosql-manager
