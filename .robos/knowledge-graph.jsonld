      "robos:specFile": "specs/contracts/order-service-v1.yaml",
      "robos:protocol": "OpenAPI 3.1",
      "robos:contractYaml": "openapi: 3.1.0\ninfo:\n  title: Order Service (Local) REST API\n  description: High-performance microservice contract for Order Service (Local) in RobOS Universe.\n  version: 1.0.0\nservers:\n  - url: https://github.com/api/v1/order-service\n    description: Production Gateway\n  - url: http://localhost:8080\n    description: Local Dev Container\ntags:\n  - name: Core\n    description: Primary operations\n  - name: Health\n    description: Service diagnostics and liveliness\npaths:\n  /api/v1/order-service:\n    get:\n      tags: [Core]\n      summary: Retrieve all order-service items\n      operationId: listOrder-serviceItems\n      parameters:\n        - name: limit\n          in: query\n          required: false\n          schema:\n            type: integer\n            default: 50\n      responses:\n        '200':\n          description: Successful query result\n          content:\n            application/json:\n              schema:\n                type: array\n                items:\n                  $ref: '#/components/schemas/Order-serviceItem'\n    post:\n      tags: [Core]\n      summary: Create new order-service entry\n      operationId: createOrder-serviceItem\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/Order-serviceItem'\n      responses:\n        '201':\n          description: Resource created successfully\n  /api/v1/order-service/{id}:\n    get:\n      tags: [Core]\n      summary: Get order-service by identifier\n      operationId: getOrder-serviceById\n      parameters:\n        - name: id\n          in: path\n          required: true\n          schema:\n            type: string\n      responses:\n        '200':\n          description: Resource found\n        '404':\n          description: Item not found\n  /healthz:\n    get:\n      tags: [Health]\n      summary: Liveness and readiness probe\n      responses:\n        '200':\n          description: Service is healthy and operational\ncomponents:\n  schemas:\n    Order-serviceItem:\n      type: object\n      required:\n        - id\n        - name\n        - createdAt\n      properties:\n        id:\n          type: string\n          format: uuid\n        name:\n          type: string\n          example: 'Primary order-service record'\n        status:\n          type: string\n          enum: [ACTIVE, PENDING, ARCHIVED]\n          default: ACTIVE\n        createdAt:\n          type: string\n          format: date-time\n",
      "robos:repository": "github.com/acme/order-service",
      "robos:endpoints": [
        {
          "path": "/api/v1/order-service",
          "method": "GET",
          "description": "List Order Service (Local) records"
        },
        {
          "path": "/api/v1/order-service",
          "method": "POST",
          "description": "Create Order Service (Local) record"
        },
        {
          "path": "/api/v1/order-service/{id}",
          "method": "GET",
          "description": "Get Order Service (Local) by ID"
        },
        {
          "path": "/healthz",
          "method": "GET",
          "description": "Health check"
        }
      ],
      "robos:package": "services",
      "robos:namespace": "robos.services"
    },
    {
      "@id": "urn:robos:service:order-service",
      "@type": [
        "oslc_am:Resource",
        "c4:Container",
        "robos:Microservice"
      ],
      "dcterms:title": "Order Service (Local) Service",
      "dcterms:description": "Backend microservice powering Order Service (Local) capabilities with containerized deployment.",
      "robos:repository": "github.com/acme/order-service",
      "robos:technology": "Node.js 20 / TypeScript",
      "robos:implementsContract": "urn:robos:contract:order-service-v1",
      "robos:ownerTeam": "urn:robos:team:core-platform",
      "robos:hasProject": "urn:robos:project:enterprise-core",
      "robos:ports": [
        8080
      ],
      "robos:healthCheckUrl": "/healthz",
      "robos:inOrganization": "urn:robos:git-org:acme",
      "robos:localPath": "/home/developer/source/repos/order-service",
      "robos:package": "services",
      "robos:namespace": "robos.services"
    },
