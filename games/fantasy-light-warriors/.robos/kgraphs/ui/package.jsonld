        "jrpg:MenuScreen"
      ],
      "dcterms:title": "Armor Menu",
      "robos:package": "ui",
      "dcterms:description": "View, equip, trade, and drop armor pieces held by each of the four party members.",
      "jrpg:commands": [
        "EQUIP",
        "TRADE",
        "DROP"
      ],
      "jrpg:windows": [
        {
          "name": "Header Window",
          "x": 0.03,
          "y": 0.01,
          "width": 0.22,
          "height": 0.13,
          "contents": "Screen title 'ARMOR'"
        },
        {
          "name": "Command Window",
          "x": 0.25,
          "y": 0.01,
          "width": 0.72,
          "height": 0.13,
          "contents": "Horizontal action menu: EQUIP, TRADE, DROP"
        },
        {
          "name": "Character 1 Name Window",
          "x": 0.03,
          "y": 0.16,
          "width": 0.25,
          "height": 0.13,
          "contents": "First party member name ('AAAA')"
        },
        {
          "name": "Character 1 Armor Window",
          "x": 0.25,
          "y": 0.16,
          "width": 0.72,
          "height": 0.2,
          "contents": "2x2 grid of AAAA's armor slots showing equipped status ('E-'): E-Dragon (Armor), E-Aegis (Shield), E-Heal (Helm)"
        },
        {
          "name": "Character 2 Name Window",
          "x": 0.03,
          "y": 0.37,
          "width": 0.25,
          "height": 0.13,
          "contents": "Second party member name ('BBBB')"
        },
        {
          "name": "Character 2 Armor Window",
          "x": 0.25,
          "y": 0.37,
          "width": 0.72,
          "height": 0.2,
          "contents": "2x2 grid of BBBB's armor slots: Dragon (Armor), E-Zeus (Gauntlet), Power (Gauntlet), Opal (Gauntlet)"
        },
        {
          "name": "Character 3 Name Window",
          "x": 0.03,
          "y": 0.59,
          "width": 0.25,
          "height": 0.13,
          "contents": "Third party member name ('CCCC')"
        },
        {
          "name": "Character 3 Armor Window",
          "x": 0.25,
          "y": 0.59,
          "width": 0.72,
          "height": 0.2,
          "contents": "2x2 grid of CCCC's armor slots: E-White (Shirt), E-ProRing, Heal (Helm)"
        },
        {
          "name": "Character 4 Name Window",
          "x": 0.03,
          "y": 0.8,
          "width": 0.25,
          "height": 0.13,
          "contents": "Fourth party member name ('DDDD')"
        },
        {
          "name": "Character 4 Armor Window",
          "x": 0.25,
          "y": 0.8,
          "width": 0.72,
          "height": 0.2,
          "contents": "2x2 grid of DDDD's armor slots: Heal (Helm), E-Black (Shirt), E-ProRing"
        }
      ],
      "jrpg:cursor": "A white gloved hand pointing right with gray shading and a drop shadow, moving horizontally between top commands (EQUIP, TRADE, DROP) and in a 2-column grid across the 4 armor slots of each character.",
