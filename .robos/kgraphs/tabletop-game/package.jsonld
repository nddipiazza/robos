      "robos:portraitAsset": "assets/portraits/card_bg_elf.png",
      "robos:audioLines": {
        "turnStart": [
          {
            "text": "With elven grace, I step into the shadows.",
            "audio": "res://assets/audio/heroes/elf_turn_start.ogg"
          }
        ],
        "attacking": [
          {
            "text": "Swift as the wind, strike true!",
            "audio": "res://assets/audio/heroes/elf_attacking.ogg"
          }
        ],
        "attacked": [
          {
            "text": "Ah! Darkness stings, yet my spirit endures!",
            "audio": "res://assets/audio/heroes/elf_attacked.ogg"
          }
        ],
        "defended": [
          {
            "text": "Too slow, creature! The forest shields me!",
            "audio": "res://assets/audio/heroes/elf_defended.ogg"
          }
        ],
        "castingMagic": [
          {
            "text": "Ancient weave of earth and water, heed my call!",
            "audio": "res://assets/audio/heroes/elf_casting_magic.ogg"
          }
        ]
      }
    },
