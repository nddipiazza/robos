{
  "@context": {
    "oslc": "http://open-services.net/ns/core#",
    "oslc_am": "http://open-services.net/ns/am#",
    "oslc_cm": "http://open-services.net/ns/cm#",
    "oslc_rm": "http://open-services.net/ns/rm#",
    "oslc_qm": "http://open-services.net/ns/qm#",
    "robos": "https://robos.dev/ns/sdlc#",
    "infinity": "https://robos.dev/ns/infinity#",
    "c4": "https://c4model.com/ns#",
    "dcterms": "http://purl.org/dc/terms/",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@id": "urn:robos:package:infinity-engine",
  "@type": [
    "oslc:ServiceProvider",
    "robos:Package"
  ],
  "robos:package": "infinity-engine",
  "robos:namespace": "robos.infinity",
  "robos:version": "1.0.0",
  "dcterms:title": "BioWare Infinity Engine & GemRB Architecture Specification",
  "dcterms:description": "Comprehensive engineering knowledge graph and architectural blueprint for the open-source BioWare Infinity Engine runtime (GemRB). Contains detailed subsystem decompositions, IESDP binary file format contracts, RTwP 100-tick round loop, AD&D 2e combat and rules engine, BCS script virtual machine, dialogue state graphs, and dual-tier pathfinding, enabling autonomous AI code generation.",
  "robos:nodes": [
    {
      "@id": "urn:robos:infinity:engine:gemrb-infinity",
      "@type": [
        "oslc_am:Resource",
        "c4:SoftwareSystem",
        "robos:GameEngine",
        "schema:SoftwareApplication"
      ],
      "dcterms:title": "GemRB: Open-Source Infinity Engine Architecture",
      "dcterms:description": "A modular, portable, clean-room reimplementation of BioWare's 2D Infinity Engine (originally powering Baldur's Gate 1 & 2, Icewind Dale 1 & 2, and Planescape: Torment). Decouples engine logic and execution runtime from proprietary BioWare game assets.",
      "robos:repository": "github.com/gemrb/gemrb",
      "robos:technology": "C++20, Python 3, SDL2, OpenAL Soft, OpenGL / Vulkan",
      "robos:architecturalStyle": "Modular Microkernel with Dynamic Plugin Subsystems",
      "robos:license": "GNU General Public License v2.0 or later",
      "robos:assetRequirements": "Requires original BioWare game data files (CHITIN.KEY and BIF archives) for copyrighted content (maps, sounds, character sprites, and dialogue texts). Contains 100% clean-room game logic, rules engine, bytecode interpreter, and rendering pipeline without BioWare binaries.",
      "robos:supportedTitles": [
        "Baldur's Gate 1: Tales of the Sword Coast",
        "Baldur's Gate 2: Shadows of Amn & Throne of Bhaal",
        "Icewind Dale 1: Heart of Winter",
        "Icewind Dale 2",
        "Planescape: Torment"
      ],
      "robos:rulesets": [
        "Advanced Dungeons & Dragons 2nd Edition (AD&D 2e)",
        "Dungeons & Dragons 3rd Edition (D&D 3e for IWD2)"
      ],
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity",
      "robos:hasSubsystems": [
        "urn:robos:infinity:subsystem:kernel-interface",
        "urn:robos:infinity:subsystem:vfs-resource-manager",
        "urn:robos:infinity:subsystem:binary-codec-pipeline",
        "urn:robos:infinity:subsystem:rtwp-game-loop",
        "urn:robos:infinity:subsystem:bcs-script-vm",
        "urn:robos:infinity:subsystem:dialogue-state-machine",
        "urn:robos:infinity:subsystem:rules-combat-engine",
        "urn:robos:infinity:subsystem:effect-opcode-queue",
        "urn:robos:infinity:subsystem:pathfinding-spatial-grid",
        "urn:robos:infinity:subsystem:isometric-compositor",
        "urn:robos:infinity:subsystem:spatial-audio-engine",
        "urn:robos:infinity:subsystem:gui-window-system",
        "urn:robos:infinity:subsystem:save-load-serializer"
      ]
    },
    {
      "@id": "urn:robos:infinity:subsystem:kernel-interface",
      "@type": [
        "oslc_am:Resource",
        "c4:Component",
        "robos:EngineSubsystem"
      ],
      "dcterms:title": "Core Kernel, Lifecycle & Plugin Manager Subsystem",
      "dcterms:description": "The central engine orchestrator (Interface / PluginManager). Bootstraps configuration files (gemrb.cfg), handles game type discovery (BG1 vs BG2 vs IWD), dynamically loads shared library driver plugins (.so/.dll), initializes platform windows via SDL2, and routes global events.",
      "robos:sourceModule": "gemrb/core/Interface.cpp",
      "robos:coreResponsibilities": [
        "Engine bootstrap and command line / config argument ingestion",
        "Plugin discovery, dynamic linking, and lifecycle management (PluginManager)",
        "Platform abstraction layer (window creation, OS input events via SDL2)",
        "Inter-subsystem event publishing and subscriber notification bus",
        "GameType state configuration (sets active ruleset, max party size, slot counts)"
      ],
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:subsystem:vfs-resource-manager",
      "@type": [
        "oslc_am:Resource",
        "c4:Component",
        "robos:EngineSubsystem"
      ],
      "dcterms:title": "Virtual File System (VFS) & Key/BIF Resource Manager",
      "dcterms:description": "Indexes BioWare archive files and resolves resource queries by 8-character ResRef and 16-bit resource type. Implements strict lookup precedence: Override Directory -> User Mods / DLC -> CHITIN.KEY BIF Archives -> CD Archives, backed by thread-safe LRU caching.",
      "robos:sourceModule": "gemrb/core/ResourceManager.cpp, gemrb/plugins/KEYImporter/",
      "robos:coreResponsibilities": [
        "Parsing CHITIN.KEY master index containing BIF file table and resource descriptor table",
        "Mapping 32-bit Resource ID (ResRef 8-char string + 16-bit Type) to physical BIF offset and uncompressed length",
        "Transparent filesystem override resolution: checks override/ directory first before querying BIF archives",
        "LRU resource memory cache with reference counting and automatic eviction under memory pressure",
        "Case-insensitive cross-platform path normalization for Linux, macOS, and Windows"
      ],
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:subsystem:binary-codec-pipeline",
      "@type": [
        "oslc_am:Resource",
        "c4:Component",
        "robos:EngineSubsystem"
      ],
      "dcterms:title": "IESDP Binary Resource Codec & Streaming Parser Pipeline",
      "dcterms:description": "High-performance deserializers and encoders for all proprietary BioWare formats defined in the Infinity Engine Structures Description Project (IESDP). Handles little-endian binary decoding, RLE compression, and typed model instantiation.",
      "robos:sourceModule": "gemrb/core/ResourceFactory.cpp, gemrb/plugins/*Importer/",
      "robos:supportedCodecs": [
        "2DA: Whitespace-delimited 2D rule matrix reader",
        "ARE: Area / Map geometry, triggers, ambient emitters, and actor spawn parser",
        "WED: Wall, Elevation & Door polygon clipping mask parser",
        "TIS: 64x64 pixel PVRTC / paletted background tilemap decoder",
        "MOS: Full-screen UI and backdrop image decoder",
        "BAM: BioWare Animation Manager multi-frame sprite decoder with RLE decompression",
        "CRE: Creature stat block, equipment slot, and script attachment parser",
        "ITM: Weapon, armor, and consumable item definition parser",
        "SPL: Spell headers, casting time, and projectile trajectory decoder",
        "DLG: Dialogue state graph, response condition, and action trigger parser",
        "BCS: BioWare Compiled Script bytecode and operand parser",
        "IDS: Identifier dictionary symbol mapper",
        "EFF / VVC / PRO: Direct effect definitions, visual vector controls, and projectile arcs",
        "GAM / SAV: Savegame state and global variable table serializer"
      ],
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:subsystem:rtwp-game-loop",
      "@type": [
        "oslc_am:Resource",
        "c4:Component",
        "robos:EngineSubsystem"
      ],
      "dcterms:title": "Real-Time with Pause (RTwP) 100-Tick Game Loop Coordinator",
      "dcterms:description": "Quantizes continuous real-time execution into synchronized rounds and combat turns. Regulates actor initiative, action recovery periods, casting phase intervals, and automated pause arbitration.",
      "robos:sourceModule": "gemrb/core/GameControl.cpp",
      "robos:timingSpecifications": {
        "roundDurationSeconds": 6.0,
        "ticksPerRound": 100,
        "tickDurationMilliseconds": 60,
        "phasesPerRound": 10,
        "ticksPerPhase": 10
      },
      "robos:coreResponsibilities": [
        "Regulating 100-tick round counter; resets actor round action counters upon tick 100",
        "Action speed factor and weapon delay calculation: delays action execution by (SpeedFactor * 10) ticks within round",
        "Spell casting timing: spells require (CastingTime * 10) uninterrupted ticks; actor takes damage during casting triggers disruption",
        "Auto-pause event triggers: Enemy Sighted, Character Injured, Weapon Ineffective, Spell Cast, Target Destroyed, Trap Found",
        "Modal pause state handling: distinguishes between user pause, inventory pause, dialogue pause, and cutscene pause"
      ],
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:subsystem:bcs-script-vm",
      "@type": [
        "oslc_am:Resource",
        "c4:Component",
        "robos:EngineSubsystem"
      ],
      "dcterms:title": "BioWare Compiled Script (BCS) Virtual Machine",
      "dcterms:description": "Event-driven bytecode interpreter executing AI scripts for actors, areas, and cutscenes. Evaluates condition triggers against the world state and dispatches action queues according to TRIGGER.IDS and ACTION.IDS registries.",
      "robos:sourceModule": "gemrb/core/ScriptEngine.cpp",
      "robos:executionModel": "Condition-Action Block Loop: IF [Triggers] THEN RESPONSE #weight [Actions] END",
      "robos:coreResponsibilities": [
        "Trigger evaluator: queries world state using TRIGGER.IDS opcodes (See, Range, HPPercentLT, Global, HasItem, Dead)",
        "Object resolution: resolves symbolic object specifiers using OBJECT.IDS (Myself, LeaderOf, NearestEnemyOf, LastAttackerOf)",
        "Action queue dispatcher: queues commands into actor ActionQueue using ACTION.IDS (Attack, Spell, MoveToObject, Dialog, Wait)",
        "Script priority hierarchy: Override Script -> Class Script -> Race Script -> General Script -> Default Script",
        "Cutscene execution: blocks player inputs and executes deterministic scripted choreographies"
      ],
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:subsystem:dialogue-state-machine",
      "@type": [
        "oslc_am:Resource",
        "c4:Component",
        "robos:EngineSubsystem"
      ],
      "dcterms:title": "Dialogue State Machine & Conversation Runner",
      "dcterms:description": "Processes interactive DLG state trees. Evaluates transition condition triggers, presents filtered dialogue choices to the player, executes script actions on selection, and logs entries into the quest journal.",
      "robos:sourceModule": "gemrb/core/DialogHandler.cpp",
      "robos:coreResponsibilities": [
        "State tree traversal: starts at initial State matching highest-priority trigger condition",
        "Transition filtering: evaluates trigger expressions on each transition to hide unavailable dialogue options",
        "Response presentation: formats text, speaker portraits, and player choice numbers in GUI",
        "Action execution: executes attached BCS action blocks upon transition selection (TakePartyItem, GiveGoldForce, Enemy)",
        "Journal & Quest synchronization: appends narrative entries to Quest Journal referenced from DIALOG.TLK"
      ],
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:subsystem:rules-combat-engine",
      "@type": [
        "oslc_am:Resource",
        "c4:Component",
        "robos:EngineSubsystem"
      ],
      "dcterms:title": "AD&D 2nd Edition / D&D Rules & Combat Resolution Engine",
      "dcterms:description": "Faithfully calculates Tabletop AD&D 2e and 3e mechanics: D20 attack rolls against THAC0 and Armor Class, damage rolls with type mitigation, saving throws across 5 classic categories, and weapon proficiency bonuses.",
      "robos:sourceModule": "gemrb/core/RulesEngine.cpp, gemrb/core/Combat.cpp",
      "robos:coreFormulas": [
        "Attack Hit Resolution: Roll d20. If Roll == 20: Critical Hit (Auto-hit, 2x damage). If Roll == 1: Critical Miss (Auto-miss). Hit Condition: Roll + AttackBonuses >= AttackerTHAC0 - TargetAC",
        "Armor Class Calculation: Base AC 10 - ArmorBonus - ShieldBonus - DexBonus - MagicBuffs (lower AC is better in 2e)",
        "Damage Resolution: Base Dice Roll + StrDamageMod + WeaponEnchantmentMod. Mitigated by Target Resistance percentage for specific damage type (Slashing, Piercing, Crushing, Missile, Fire, Cold, Acid, Electricity, Magic)",
        "Saving Throw Resolution: Roll d20 + SaveMods >= TargetCategorySave (5 Categories: Poison/Death, Rod/Staff/Wand, Petrification/Polymorph, Breath Weapon, Spell)",
        "Magic Resistance Check: Roll d100. If Roll <= TargetMagicResistancePercent: Spell Completely Negated"
      ],
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:subsystem:effect-opcode-queue",
      "@type": [
        "oslc_am:Resource",
        "c4:Component",
        "robos:EngineSubsystem"
      ],
      "dcterms:title": "Effect Opcode Queue & Dynamic Modifier Pipeline",
      "dcterms:description": "The central entity modifier pipeline handling over 350 standard Infinity Engine opcodes. Every spell buff, potion effect, poison damage over time, or curse is represented as an Effect node attached to an Actor.",
      "robos:sourceModule": "gemrb/core/EffectQueue.cpp, gemrb/plugins/Effect*",
      "robos:coreResponsibilities": [
        "Opcode dispatch: applies opcode handlers (Opcode 0: AC Bonus, Opcode 12: Damage, Opcode 20: Invisibility, Opcode 39: Sleep, Opcode 58: Dispel)",
        "Duration countdown: decrements duration ticks per heartbeat; auto-purges expired effects",
        "Modifier stacking rules: manages modifier modes (cumulative addition, absolute value override, percentage modifier)",
        "Dispel Magic resolution: rolls Dispel check based on caster level vs effect creator level",
        "Saving throw attachments: executes saving throw on application; negates or halves effect on successful save",
        "Stat recomputation trigger: notifies Actor to recalculate derived stats (max HP, current AC, saving throws, THAC0)"
      ],
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:subsystem:pathfinding-spatial-grid",
      "@type": [
        "oslc_am:Resource",
        "c4:Component",
        "robos:EngineSubsystem"
      ],
      "dcterms:title": "Dual-Tier Pathfinding & Spatial Collision Grid",
      "dcterms:description": "Dual-layer spatial navigation engine combining global waypoint A* search across expansive pre-rendered maps with high-resolution 16x12 pixel search map bitmasks and circular actor collision bounds.",
      "robos:sourceModule": "gemrb/core/Pathfinder.cpp, gemrb/core/SearchMap.cpp",
      "robos:coreResponsibilities": [
        "Global Tier: A* waypoint graph traversal across area sectors for long-distance path planning",
        "Local Tier: 16x12 pixel cell passability bitmask extracted from ARE/WED (Passable, Impassable, Water, Flying-Only)",
        "Dynamic Collision Avoidance: circular personal space radius per Actor; checks overlap with moving entities",
        "Bumping and formation nudging: allows party members to soft-push adjacent allies when walking in formations",
        "Doorway dynamic updates: flips passability bits on search grid when doors open or close"
      ],
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:subsystem:isometric-compositor",
      "@type": [
        "oslc_am:Resource",
        "c4:Component",
        "robos:EngineSubsystem"
      ],
      "dcterms:title": "Pre-Rendered Isometric Compositor & WED Occlusion Pipeline",
      "dcterms:description": "Composites 2D pre-rendered background tiles (TIS/MOS) with animated sprite sheets (BAM), 2.5D Y-sorting, palette color remapping (PLT), 3-tier Fog of War, and WED wall polygon depth clipping.",
      "robos:sourceModule": "gemrb/core/Video.cpp, gemrb/core/TileRenderer.cpp",
      "robos:coreResponsibilities": [
        "Background tile blitting: streams 64x64 pixel tiles from TIS archives into viewport buffers",
        "WED Wall & Elevation Occlusion: clips actor sprite fragments behind wall polygons so characters walk behind pillars and archways without 3D geometry",
        "Y-Sorting: dynamically sorts actors, projectiles, and visual effects by Y-coordinate for authentic 2.5D depth",
        "PLT Palette Translation: remaps grayscale clothing, skin, and hair pixels into customizable player RGB palettes",
        "3-Tier Fog of War: maintains bitmask grid representing Unexplored (Black), Explored (Fogged), and Visible (Fully Lit)"
      ],
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:subsystem:spatial-audio-engine",
      "@type": [
        "oslc_am:Resource",
        "c4:Component",
        "robos:EngineSubsystem"
      ],
      "dcterms:title": "Spatial Audio & Interactive Dynamic Music Subsystem",
      "dcterms:description": "Positional 2D/3D audio pipeline supporting ambient environment emitters, footstep surface acoustic response, character voice barks, and interactive music with peace/battle crossfading.",
      "robos:sourceModule": "gemrb/core/Audio.cpp, gemrb/plugins/OpenALAudioDriver/",
      "robos:coreResponsibilities": [
        "Spatial ambient emitters: volume attenuation based on listener party distance to coordinates in ARE file",
        "Surface acoustic response: maps terrain tile codes to footstep sounds (stone, dirt, grass, wood, shallow water)",
        "Voice selection barks: plays randomized WAV/ACM voice lines upon actor selection, move orders, and battle cries",
        "Dynamic interactive music: crossfades between exploratory ambient music and high-tempo combat music upon enemy encounter"
      ],
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:subsystem:gui-window-system",
      "@type": [
        "oslc_am:Resource",
        "c4:Component",
        "robos:EngineSubsystem"
      ],
      "dcterms:title": "GUI, Paperdoll Inventory & Windowing Subsystem",
      "dcterms:description": "Parses CHU binary window layouts to construct the Baldur's Gate user interface: drag-and-drop paperdoll equipment slots, spell memorization grids, party portrait sidebars, and dialogue selection boxes.",
      "robos:sourceModule": "gemrb/core/GUI/Window.cpp, gemrb/GUIScripts/",
      "robos:coreResponsibilities": [
        "CHU window layout parsing: loads window coordinates, buttons, sliders, text areas, and scrollbars",
        "Paperdoll inventory management: enforces equipment slot types (helmet, armor, shield, gloves, 2 rings, boots, cloak, 4 weapon slots, 3 quick item slots, 16 backpack slots)",
        "Spell memorization interface: manages spell slot grids by spell level, memorization queues, and rest recovery",
        "Party sidebar: renders portrait icons with health progress bars and affliction status icons",
        "Floating combat text: renders rolls, damage numbers, and critical hit alerts above actor heads"
      ],
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:subsystem:save-load-serializer",
      "@type": [
        "oslc_am:Resource",
        "c4:Component",
        "robos:EngineSubsystem"
      ],
      "dcterms:title": "Game State & Save/Load Serialization Subsystem",
      "dcterms:description": "Serializes the complete runtime state into SAV and GAM archive bundles: party attributes, inventories, global variable dictionary, local area variables, fog-of-war masks, and dead creature persistence.",
      "robos:sourceModule": "gemrb/core/SaveGame.cpp",
      "robos:coreResponsibilities": [
        "Serialization of world variables: stores Global, Area, and Local variable scopes",
        "Creature delta serialization: persists current HP, active effects, equipment modifications, and inventory state",
        "Dead actor tracking: persists dead creature lists to prevent re-spawning upon area reload",
        "Fog of War mask serialization: preserves explored area visibility maps",
        "Save archive bundling: packages SAV and GAM structures into compressed archive files"
      ],
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:contract:chitin-key",
      "@type": [
        "oslc_am:Resource",
        "robos:Contract"
      ],
      "dcterms:title": "CHITIN.KEY Master Resource Index Contract",
      "robos:specFile": "schemas/iesdp/CHITIN_KEY.md",
      "robos:protocol": "Binary/IESDP",
      "robos:magicHeader": "KEY V1  ",
      "robos:binaryLayout": {
        "headerBytes": 24,
        "fields": [
          {
            "offset": 0,
            "size": 4,
            "name": "signature",
            "expected": "KEY "
          },
          {
            "offset": 4,
            "size": 4,
            "name": "version",
            "expected": "V1  "
          },
          {
            "offset": 8,
            "size": 4,
            "name": "bif_entry_count",
            "type": "uint32"
          },
          {
            "offset": 12,
            "size": 4,
            "name": "resource_entry_count",
            "type": "uint32"
          },
          {
            "offset": 16,
            "size": 4,
            "name": "bif_entries_offset",
            "type": "uint32"
          },
          {
            "offset": 20,
            "size": 4,
            "name": "resource_entries_offset",
            "type": "uint32"
          }
        ],
        "resourceEntrySize": 14,
        "resourceEntryFields": [
          {
            "offset": 0,
            "size": 8,
            "name": "resref",
            "type": "char[8]"
          },
          {
            "offset": 8,
            "size": 2,
            "name": "resource_type",
            "type": "uint16"
          },
          {
            "offset": 10,
            "size": 4,
            "name": "resource_locator",
            "type": "uint32 (bits 31-20: bif_index, bits 13-0: bif_resource_index)"
          }
        ]
      },
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:contract:bif",
      "@type": [
        "oslc_am:Resource",
        "robos:Contract"
      ],
      "dcterms:title": "BIF (BioWare Archive File) Contract",
      "robos:specFile": "schemas/iesdp/BIF.md",
      "robos:protocol": "Binary/IESDP",
      "robos:magicHeader": "BIFFV1  ",
      "robos:binaryLayout": {
        "headerBytes": 20,
        "fields": [
          {
            "offset": 0,
            "size": 4,
            "name": "signature",
            "expected": "BIFF"
          },
          {
            "offset": 4,
            "size": 4,
            "name": "version",
            "expected": "V1  "
          },
          {
            "offset": 8,
            "size": 4,
            "name": "file_entry_count",
            "type": "uint32"
          },
          {
            "offset": 12,
            "size": 4,
            "name": "tileset_entry_count",
            "type": "uint32"
          },
          {
            "offset": 16,
            "size": 4,
            "name": "file_entries_offset",
            "type": "uint32"
          }
        ],
        "fileEntrySize": 16,
