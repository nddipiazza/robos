    {
      "@id": "urn:robos:infinity:contract:bcs",
      "@type": [
        "oslc_am:Resource",
        "robos:Contract"
      ],
      "dcterms:title": "BCS (BioWare Compiled Script Bytecode) Contract",
      "robos:specFile": "schemas/iesdp/BCS.md",
      "robos:protocol": "Binary/IESDP",
      "robos:formatSpecification": "Hierarchical block structure representing Condition-Response rules. Each block contains: 1) Trigger count and Trigger evaluation tuples (opcode, integer arg, string arg, object target specifier); 2) Action list and Action execution tuples (opcode, target coordinates, integer param, resref string, object target). Compiled from human-readable BAF source files.",
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:contract:ids",
      "@type": [
        "oslc_am:Resource",
        "robos:Contract"
      ],
      "dcterms:title": "IDS (Identifier Symbol Mapping Table) Contract",
      "robos:specFile": "schemas/iesdp/IDS.md",
      "robos:protocol": "ASCII/IESDP",
      "robos:formatSpecification": "Text dictionary mapping symbolic strings to 16-bit or 32-bit numeric values. Includes ACTION.IDS (engine actions), TRIGGER.IDS (script conditions), OBJECT.IDS (target selectors), SPELL.IDS (spell names to ResRefs), and ANIMATE.IDS (animation indices).",
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:adr:001-pre-rendered-wed-occlusion",
      "@type": [
        "oslc_am:Resource",
        "robos:ArchitectureDecisionRecord"
      ],
      "dcterms:title": "ADR-001: Pre-Rendered Isometric Projection with WED Wall Polygon Depth Masks",
      "robos:status": "accepted",
      "robos:context": "Infinity Engine games use pre-rendered 2D backgrounds created in 3D modeling packages (Softimage/3ds Max), rendered to flat 2D tilemaps. To create the illusion of depth without real-time 3D geometry, sprites must be dynamically occluded when passing behind walls, arches, and pillars.",
      "robos:decision": "Store 2D convex wall polygons in the WED (Wall & Elevation Description) format. During the rendering pass, compute the intersection of moving sprites with active wall polygons. Pixels within the polygon boundary are clipped against the background buffer using hardware stencil/scissor tests or software rasterization, allowing 2.5D visual occlusion with negligible computational overhead.",
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:adr:002-rtwp-100-tick-round-cycle",
      "@type": [
        "oslc_am:Resource",
        "robos:ArchitectureDecisionRecord"
      ],
      "dcterms:title": "ADR-002: RTwP 100-Tick Round Cycle with Action Speed Quanta",
      "robos:status": "accepted",
      "robos:context": "Tabletop AD&D 2nd Edition uses discrete 1-minute combat rounds. A real-time computer RPG requires fast, tactile feedback while faithfully preserving tabletop turn mechanics and spell casting times.",
      "robos:decision": "Establish a fixed 6.0-second round divided into exactly 100 engine ticks (1 tick = 60ms). Each actor executes up to their allotted attacks per round within those 100 ticks, with attack timing distributed according to weapon speed factors. Spells require a discrete casting time (CastingTime * 10 ticks); any damage sustained before the tick countdown finishes results in spell disruption and lost spell slot.",
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:adr:003-opcode-driven-modifier-pipeline",
      "@type": [
        "oslc_am:Resource",
        "robos:ArchitectureDecisionRecord"
      ],
      "dcterms:title": "ADR-003: Opcode-Driven Modifier Stacking & Dispel System",
      "robos:status": "accepted",
      "robos:context": "Infinity Engine games feature hundreds of overlapping spells, magical items, curses, and environmental conditions. Hardcoding special cases into character attributes leads to exponential complexity and bugs.",
      "robos:decision": "Implement a generalized Effect Opcode Queue attached to each Actor. All modifications (AC bonuses, stat drains, invisibility, haste, poison ticks) are decoupled into discrete Effect instances containing Opcode number, duration, target parameter, and source caster level. When an effect is added, removed, or dispelled, the engine re-evaluates the queue to recompute net derived statistics dynamically.",
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:adr:004-dual-tier-pathfinding",
      "@type": [
        "oslc_am:Resource",
        "robos:ArchitectureDecisionRecord"
      ],
      "dcterms:title": "ADR-004: Dual-Tier A* Waypoint and 16x12 Search Bitmask Navigation",
      "robos:status": "accepted",
      "robos:context": "Infinity Engine areas can measure up to 5,000x5,000 pixels with up to 6 party members and dozens of monsters pathfinding simultaneously. Running per-pixel A* across such vast maps causes severe CPU bottlenecking.",
      "robos:decision": "Employ a dual-tier navigation system: 1) High-level waypoint graph A* for planning coarse paths across area sectors; 2) Low-level 16x12 pixel search map bitmask for fine-grained obstacle and wall avoidance. Actors possess circular collision hulls at their feet and perform dynamic local avoidance when encountering allies or moving monsters.",
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
      "@id": "urn:robos:infinity:blueprint:cplusplus-interfaces",
      "@type": [
        "oslc_am:Resource",
        "robos:CodeSnippet"
      ],
      "dcterms:title": "Core Subsystem C++ Interfaces for Autonomous AI Engine Generation",
      "robos:language": "cpp",
      "robos:codeContent": "// GemRB Core Architectural Interfaces for Autonomous Implementation\n\n#include <string>\n#include <vector>\n#include <memory>\n#include <cstdint>\n\nnamespace GemRB {\n\nstruct ResRef {\n    char name[8];\n    uint16_t type;\n};\n\nstruct ResourceBuffer {\n    const uint8_t* data;\n    size_t size;\n};\n\nclass IResourceManager {\npublic:\n    virtual ~IResourceManager() = default;\n    virtual bool Initialize(const std::string& chitinKeyPath, const std::string& overrideDir) = 0;\n    virtual std::shared_ptr<ResourceBuffer> LoadResource(const ResRef& resRef) = 0;\n    virtual bool Exists(const ResRef& resRef) = 0;\n};\n\nclass IGameControl {\npublic:\n    virtual ~IGameControl() = default;\n    virtual void StepTick(uint32_t deltaMs) = 0;\n    virtual void TogglePause(bool userTriggered) = 0;\n    virtual bool IsPaused() const = 0;\n    virtual uint32_t GetCurrentTick() const = 0;\n    virtual uint32_t GetCurrentRound() const = 0;\n};\n\nclass IScriptEngine {\npublic:\n    virtual ~IScriptEngine() = default;\n    virtual bool EvaluateTrigger(uint32_t triggerId, const std::vector<int32_t>& intArgs, const std::string& strArg) = 0;\n    virtual void ExecuteAction(uint32_t actionId, const std::vector<int32_t>& intArgs, const std::string& strArg) = 0;\n};\n\nclass IRulesEngine {\npublic:\n    virtual ~IRulesEngine() = default;\n    virtual bool ResolveAttack(int32_t attackerThac0, int32_t targetAc, int32_t attackBonus, int32_t& outDamage) = 0;\n    virtual bool ResolveSavingThrow(int32_t saveCategory, int32_t targetValue, int32_t modifier) = 0;\n};\n\nclass IPathfinder {\npublic:\n    virtual ~IPathfinder() = default;\n    virtual std::vector<std::pair<int, int>> FindPath(int startX, int startY, int endX, int endY, int actorRadius) = 0;\n    virtual bool IsPassable(int x, int y, uint32_t passabilityMask) = 0;\n};\n\n} // namespace GemRB",
      "robos:package": "infinity-engine",
      "robos:namespace": "robos.infinity"
    },
    {
