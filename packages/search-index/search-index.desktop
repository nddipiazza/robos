[Desktop Entry]
X-RobOS-Category=RobOS Journal
X-RobOS-App=true
Name=RobOS Search Index
Comment=Manage RobOS file system search indexes
Exec=/usr/local/bin/robos-launch search-index
Icon=/usr/local/share/robos/search-index/icon.svg
Terminal=false
Type=Application
Categories=System;
StartupNotify=true
StartupWMClass=search-index
