# Neon Postgres (Vercel Marketplace injects this). Leave empty locally to use embedded PGlite.
DATABASE_URL=
# Lets E2E runs skip rate limits/honeypot when sent as x-e2e-key (>= 24 chars). Set in Vercel too.
E2E_BYPASS_KEY=
# Bearer secret for any Vercel Cron routes you add
CRON_SECRET=
# reCAPTCHA v3 (wired in, disabled by default)
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
NEXT_PUBLIC_RECAPTCHA_ENABLED=false
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Search engine verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
