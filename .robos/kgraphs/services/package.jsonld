      ],
      "dcterms:title": "Oauth Server Service",
      "dcterms:description": "Backend microservice powering Oauth Server capabilities with containerized deployment.",
      "robos:repository": "github.com/acme-identity/oauth-server",
      "robos:technology": "Node.js 20 / TypeScript",
      "robos:implementsContract": "urn:robos:contract:oauth-server-v1",
