    {
      "@id": "urn:robos:elearning:course:robos-crpg",
      "@type": [
        "oslc_am:Resource",
        "robos:ELearningCourse",
        "robos:ELearning",
        "schema:Course"
      ],
      "dcterms:description": "The definitive deep-dive into party-based tactical isometric cRPGs for video game nerds and D&D dungeon masters. Covers D&D 5e SRD mathematical action economy, Godot 4.3 GL Compatibility 2.5D isometric rendering, physical collision pathfinding, Flare RPG CC-BY-SA paperdoll asset pipelines, 3-mode expandable Activity Log, and autonomous Infinity AI Agent verification with 1080p video proof-of-work.",
      "dcterms:title": "Tactical cRPG Architecture: D&D 5e SRD & Godot 4 Infinity Engine Masterclass",
      "robos:difficulty": "Advanced",
      "robos:domainStandard": "https://schema.org/Course",
      "robos:engineArchitecture": "urn:robos:infinity:engine:gemrb-infinity",
      "robos:estimatedDuration": "60 minutes",
      "robos:gitopsFile": ".robos/elearning.yaml",
      "robos:modules": [
        {
          "durationMinutes": 15,
          "id": "mod-01-dnd5e-rules",
          "labSteps": [
            "Inspect games/crpg-realm/schemas/v1/classes.schema.json and data/v1/classes.json for hit dice (d6/d8/d10) and saving throw proficiencies",
            "Verify d20 attack roll, critical hit multiplier, and advantage roll resolution in games/crpg-realm/scripts/CombatEngine.gd",
            "Run automated D&D rules tests: python3 -m unittest games/crpg-realm/tests/test_dnd_rules.py or inspect dice formulas"
          ],
          "overview": "Master D&D 5e SRD mathematical combat resolution: d20 attack rolls vs AC, ability score modifiers floor((Stat - 10)/2), advantage/disadvantage probability curve, Nat 20 critical double damage dice, strict 6.0-second combat rounds, Action/Bonus Action/Reaction economy, and spell save DC = 8 + prof + modifier.",
          "quiz": [
            {
              "answer": "8 + Proficiency Bonus + Spellcasting Ability Modifier",
              "options": [
                "Armor Class + Wisdom Modifier - Spell Level",
                "8 + Proficiency Bonus + Spellcasting Ability Modifier",
                "d20 + Proficiency Bonus + Caster Level",
                "10 + Spell Level + Intelligence Modifier"
              ],
              "question": "In D&D 5e SRD, what is the exact formula for a character's Spell Save DC?"
            },
            {
              "answer": "6.0 seconds with visual round progress timer",
              "options": [
                "1.0 second real-time tick",
                "Variable based on Agility stat",
                "6.0 seconds with visual round progress timer",
                "10.0 seconds turn-based phase"
              ],
              "question": "How long is a standard D&D 5e combat round in the tactical RTwP engine?"
            },
            {
              "answer": "Roll 2d20 and take the higher value",
              "options": [
                "Roll 2d20 and sum both values together",
                "Double the damage dice if the roll hits",
                "Roll 1d20 and add a flat +5 modifier",
                "Roll 2d20 and take the higher value"
              ],
              "question": "When an attacker has Advantage on a d20 attack roll, how is the roll evaluated?"
            }
          ],
          "title": "Module 1: D&D 5e Ruleset & Mathematical Action Economy"
        },
        {
          "durationMinutes": 15,
          "id": "mod-02-godot-engine",
          "labSteps": [
            "Inspect games/crpg-realm/scenes/VillageSquare.tscn to analyze physical building StaticBody2D collision geometry across the 2560x1440 map",
            "Trace Pathfinder.gd raycast line-of-sight checks and A* corridor waypoint fallbacks avoiding house bounding boxes",
            "Inspect games/crpg-realm/shaders/FogOfWar.gdshader and verify light occluder vision reveals",
            "Launch headless Godot test runner: ./games/crpg-realm/debug.sh --scene TestRunner --headless"
          ],
          "overview": "Examine Godot 4.3's GL Compatibility renderer profile, pre-rendered 2560x1440 2.5D isometric plates with camera clamping at 1920x1080, Layer 1 StaticBody2D physical building collision footprints preventing walk-through clipping, dual-tier Pathfinder.gd obstacle avoidance, and custom FogOfWar.gdshader with circular vision masks.",
          "quiz": [
            {
              "answer": "Guarantees seamless execution across low-spec hardware, virtualized Xvfb displays (:99), and avoids shader compilation stutter",
              "options": [
