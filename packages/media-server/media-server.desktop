[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Media Server
Comment=Unified web media streaming server, transcode engine, eBook reader, and MCP server for movies, TV shows, music, and books
Exec=/usr/bin/electron /usr/local/share/robos/media-server/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/media-server/icon.svg
Terminal=false
Categories=AudioVideo;Network;
X-RobOS-Category=System
StartupWMClass=robos-media-server
