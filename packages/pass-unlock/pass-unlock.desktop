[Desktop Entry]
X-RobOS-Category=Security
X-RobOS-App=true
Name=Pass Unlock
Comment=Daily GPG passphrase unlock for all-day access
Exec=/usr/bin/electron /usr/local/share/robos/pass-unlock/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/pass-unlock/icon.svg
Terminal=false
Type=Application
Categories=Utility;Security;
StartupWMClass=robos-pass-unlock
