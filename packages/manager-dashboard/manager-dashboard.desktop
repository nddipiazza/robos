[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=Manager Dashboard
Comment=Team metrics, velocity charts, cycle time, and deployment frequency
Exec=/usr/bin/electron /usr/local/share/robos/manager-dashboard/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/manager-dashboard/icon.svg
Terminal=false
Categories=Development;
X-RobOS-Category=Management
StartupWMClass=manager-dashboard
