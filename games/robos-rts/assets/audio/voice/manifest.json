      "attack": [
        {
          "id": "rifleman_attack_1",
          "text": "Say hello to three-round burst diplomacy!",
          "path": "res://assets/audio/voice/rifleman_attack_1.wav"
        },
        {
          "id": "rifleman_attack_2",
          "text": "Free lead delivery, no signature required!",
          "path": "res://assets/audio/voice/rifleman_attack_2.wav"
        },
        {
          "id": "rifleman_attack_3",
          "text": "Keep your heads down, or don't, makes my job easier!",
          "path": "res://assets/audio/voice/rifleman_attack_3.wav"
        },
        {
          "id": "rifleman_attack_4",
          "text": "Target locked! Let's ventilate 'em!",
          "path": "res://assets/audio/voice/rifleman_attack_4.wav"
        },
        {
          "id": "rifleman_attack_5",
          "text": "Hope they brought an umbrella for this hailstorm!",
          "path": "res://assets/audio/voice/rifleman_attack_5.wav"
        }
      ],
      "ready": [
        {
          "id": "rifleman_ready_1",
          "text": "Rifleman locked and loaded!",
          "path": "res://assets/audio/voice/rifleman_ready_1.wav"
        },
        {
          "id": "rifleman_ready_2",
          "text": "Fresh boots on the ground, Commander.",
          "path": "res://assets/audio/voice/rifleman_ready_2.wav"
        }
      ]
    }
  },
