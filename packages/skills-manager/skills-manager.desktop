[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Skills Manager
Comment=Browse and manage OS skills for RobOS AI
Exec=/usr/bin/electron /usr/local/share/robos/skills-manager/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/skills-manager/icon.svg
Terminal=false
Categories=Development;
X-RobOS-Category=AI
StartupWMClass=robos-skills-manager
