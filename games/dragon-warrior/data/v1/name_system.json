    "3": {
      "long_term": [
        "strength",
        "agility"
      ],
      "short_term": [
        "hp",
        "mp"
      ]
    }
  },
  "stat_formula": {
    "long_term_stat": "base_stat (unchanged from table)",
    "short_term_stat": "floor(base_stat * 9 / 10) + bonus"
  },
