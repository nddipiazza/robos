[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Tabletop Blockmap Creator
Comment=Calibrate grid tile size, offsets, borders, and draw corridors and rooms from any dungeon image
Exec=/usr/bin/electron /usr/local/share/robos/tabletop-blockmap-creator/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/tabletop-blockmap-creator/icon.svg
Terminal=false
Categories=Development;Game;
X-RobOS-Category=Dev
StartupWMClass=robos-tabletop-blockmap-creator
