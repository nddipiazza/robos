        {
          "id": "obj-deliver-firebead",
          "isOptional": false,
          "status": "unstarted",
          "targetEntity": "firebead",
          "text": "Deliver scroll to Firebead at Candlekeep Inn"
        }
      ],
      "robos:questStages": [
        {
          "description": "Fetch the scroll of identify from Tethtoril and bring it to Firebead inside Candlekeep Inn.",
          "stage": 1
        },
        {
          "description": "Deliver the identified scroll back to Firebead for a protection ward.",
          "stage": 2
        }
      ],
      "robos:questType": "side",
      "robos:rewards": {
        "experience": 150,
        "gold": 50,
        "items": [
          "potion-healing"
        ]
      },
      "robos:status": "active",
      "robos:targetMap": "candlekeep"
    },
    {
      "@id": "urn:robos:crpg:quest:harpers-covert-rendezvous",
      "@type": [
        "oslc_am:Resource",
        "robos:CRPGQuest",
