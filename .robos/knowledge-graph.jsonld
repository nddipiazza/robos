    },
    {
      "@id": "urn:robos:tabletop:item:middle-east-teleprompter",
      "@type": [
        "oslc_am:Resource",
        "robos:TabletopItem",
        "robos:TabletopArtifact",
        "robos:GameItem",
        "schema:Product"
