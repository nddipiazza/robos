[Desktop Entry]
X-RobOS-App=true
Version=1.0
Type=Application
Name=RobOS Hardware Keys
Comment=YubiKey & FIDO2 physical push keys, touch verification, ed25519-sk SSH keys, Passkeys, and PAM U2F security studio
Exec=/usr/bin/electron /usr/local/share/robos/hardware-keys/main.js --no-sandbox --disable-gpu --disable-dev-shm-usage
Icon=/usr/local/share/robos/hardware-keys/icon.svg
Terminal=false
Categories=Utility;Security;
X-RobOS-Category=Security
StartupWMClass=robos-hardware-keys
