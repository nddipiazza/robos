	1: Color("#4f8cf0"),
	2: Color("#e0453a"),
	3: Color("#f0c43c")
}

func _ready() -> void:
	var voice_manifest: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://assets/audio/voice/manifest.json"))
	if voice_manifest is Dictionary:
		for unit_type in voice_manifest:
			if not units.has(unit_type):
				named_voice_profiles[unit_type] = voice_manifest[unit_type]
			elif not units[unit_type].has("dialogues"):
				units[unit_type]["dialogues"] = voice_manifest[unit_type].get("categories", {})
	var assault: Dictionary = units.kestrel_interceptor.duplicate()
	assault.merge({
		"id": "kestrel_assault", "name": "Kestrel Assault",
		"blurb": "Ground mode of the Kestrel. Twin autocannons engage ground targets.",
		"attributes": ["Armored", "Mechanical"], "flight_height": 0.0, "speed": 5.8,
		"weapon": {"name": "Twin Autocannons", "sfx": "autocannon_fire", "attack_type": "ranged",
			"damage": 12.0, "attacks": 2, "range": 10.0, "period": 1.3, "damage_point": 0.18,
			"backswing": 0.28, "targets_air": false, "targets_ground": true},
		"abilities": ["move", "stop", "hold_position", "attack", "fighter_intercept"],
	}, true)
	units[assault.id] = assault
	for unit_type in LadderRules.HALLUCINATIONS:
		var spec: Dictionary = LadderRules.HALLUCINATIONS[unit_type]
		var id := "hallucinate_" + str(unit_type)
		abilities[id] = {
			"id": id, "name": "Hallucinate %s" % units[unit_type].name, "hotkey": spec.hotkey,
			"target": "none", "hallucination_unit": unit_type,
			"desc": "Spend 75 energy to create %d temporary copies." % spec.count,
		}

func get_faction_name(faction_id: String) -> String:
	return str(faction_info.get(faction_id, {}).get("name", faction_id.capitalize()))

func get_player_color(owner_id: int) -> Color:
	return player_colors.get(owner_id, Color("#9ca3af"))

func get_unit_def(unit_type: String) -> Dictionary:
	var id := unit_type.to_lower()
	if ladder_active and (LadderRules.UNITS.has(id) or LadderRules.BURROW_TIMINGS.has(id)):
		if not _ladder_units.has(id):
			var definition: Dictionary = units[id].duplicate()
			var overrides: Dictionary = LadderRules.UNITS.get(id, {})
			definition.merge(overrides, true)
			if overrides.has("additional_abilities"):
				definition["abilities"] = definition.abilities + overrides.additional_abilities
			if LadderRules.BURROW_TIMINGS.has(id) and not definition.abilities.has("burrow"):
				definition["abilities"] = definition.abilities + ["burrow"]
			if overrides.has("weapon"):
				var weapon: Dictionary = units[id].get("weapon", {}).duplicate()
				weapon.merge(overrides.weapon, true)
				definition["weapon"] = weapon
			if overrides.get("support", null) == {}:
				definition.erase("support")
			if overrides.get("lifetime_seconds", -1) == 0:
				definition.erase("lifetime_seconds")
			_ladder_units[id] = definition
		return _ladder_units[id]
	return units.get(id, {})

func get_ability_def(ability_id: String) -> Dictionary:
	var definition: Dictionary = abilities.get(ability_id.to_lower(), {})
	if ladder_active and ability_id in ["recon_sweep", "reinforce_supply", "upgrade_hub", "deploy_prospector"]:
		definition = definition.duplicate()
		match ability_id:
			"recon_sweep":
				definition.hotkey = "C"
				definition.desc = "Spend 50 energy to grant vision and detection for 11.43 seconds."
			"reinforce_supply":
				definition.hotkey = "X"
				definition.desc = "Spend 50 energy to add eight supply and restore a Silo to 500 HP."
			"upgrade_hub":
				definition.desc = "Unlock recon sweeps, supply reinforcements and Prospector drops. Starts with 50 energy."
			"deploy_prospector":
				definition.hotkey = "E"
				definition.desc = "Spend 50 energy to deploy a Prospector for 63 seconds. Target visible ground or a crystal field."
	if ladder_active and ability_id in ["fighter_assault", "fighter_intercept", "train_kestrel_interceptor"]:
		definition = definition.duplicate()
		if ability_id == "train_kestrel_interceptor":
			definition.hotkey = "V"
		else:
			definition.hotkey = "D" if ability_id == "fighter_assault" else "E"
			definition.desc = "Switch combat modes in 2.14 seconds, or 1.07 seconds with Smart Servos."
	if ladder_active and ability_id == "salvage":
		definition = definition.duplicate()
		definition.name = "Salvage Structure"
		definition.desc = "Recover 75% of the cost after 3.57 seconds. Incoming damage interrupts salvage."
	if ladder_active and ability_id in ["research_brood_melee", "research_brood_carapace"]:
		definition = definition.duplicate()
		definition.producer = "adaptation_chamber"
		if ability_id == "research_brood_melee":
			definition.desc = "Improves Gnarl melee weapon damage, including Sporeburst detonation."
	if ladder_active and ability_id in ["burrow", "surface"]:
		definition = definition.duplicate()
		definition.hotkey = "R"
	if ladder_active and ability_id == "inject_brood":
		definition = definition.duplicate()
		definition.desc = "Spend 25 energy to add three larvae after about 29 seconds. Additional injects queue. Each Nest holds up to 19 larvae."
	elif ladder_active and ability_id == "phase_barrier":
		definition = definition.duplicate()
		definition.desc = "Spend 50 energy to block ground paths in a 3.75-unit radius for 11 seconds."
	elif ladder_active and ability_id == "production_boost":
		definition = definition.duplicate()
		definition.desc = "Spend 50 Heartstone energy to accelerate friendly production or research by 50% for 20 seconds."
	elif ladder_active and ability_id == "defensive_recall":
		definition = definition.duplicate()
		definition.desc = "Spend 50 energy to recall friendly units to this Heartstone. Units cannot move or fight during the four-second channel. Shares a 130-second cooldown."
	elif ladder_active and ability_id == "charge":
		definition = definition.duplicate()
		definition.target = "unit"
		definition.desc = "Rush a nearby enemy after researching Charge. Right-click to toggle automatic use."
	elif ladder_active and ability_id == "build_aegis_relay":
		definition = definition.duplicate()
		definition.hotkey = "C"
	elif ladder_active and ability_id == "build_tunnel_mouth":
		definition = definition.duplicate()
		definition.name = "Grow Brood Tunnel Network"
	elif ladder_active and ability_id == "research_rolling_spores":
		definition = definition.duplicate()
		definition.hotkey = "C"
		definition.desc = "Sporebursts roll faster and gain 5 maximum health. Requires Lair tech."
	elif ladder_active and ability_id == "train_crownspire":
		definition = definition.duplicate()
		definition.hotkey = "M"
	return definition

func get_unit_dialogues(unit_type: String, category: String) -> Array:
	if named_voice_profiles.has(unit_type):
		return named_voice_profiles[unit_type].categories.get(category.to_lower(), [])
	var u_def: Dictionary = get_unit_def(DIALOGUE_BASE_FORMS.get(unit_type, unit_type))
	var dlgs: Dictionary = u_def.get("dialogues", {})
	return dlgs.get(category.to_lower(), [])
