      "robos:supportedStandards": [
        "Gitleaks v8+",
        "TruffleHog",
        "Microsoft Presidio",
        "OWASP LLM01: Prompt Injection",
        "OWASP LLM02: Sensitive Information Disclosure",
        "NIST SP 800-53"
      ],
      "robos:supportedModes": [
        "redact",
        "block",
        "warn",
        "audit-only",
        "off"
      ]
    },
    {
      "@id": "urn:robos:service:barista-order-api",
