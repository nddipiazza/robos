          {
            "audio": "res://assets/audio/heroes/bernie_react_6.ogg",
            "text": "Out on the street!"
          }
        ],
        "moving": [
          {
            "audio": "res://assets/audio/heroes/bernie_move_1.ogg",
            "text": "From 46 states in America!"
          },
          {
            "audio": "res://assets/audio/heroes/bernie_move_2.ogg",
            "text": "What we are saying very loud and clear!"
          },
          {
            "audio": "res://assets/audio/heroes/bernie_move_3.ogg",
            "text": "80 or 90% of the people voting!"
          },
          {
            "audio": "res://assets/audio/heroes/bernie_move_4.ogg",
            "text": "Getting tough on crime!"
          },
          {
            "audio": "res://assets/audio/heroes/bernie_move_5.ogg",
            "text": "Jobs for the jobless!"
          },
          {
            "audio": "res://assets/audio/heroes/bernie_move_6.ogg",
            "text": "Who is gaining that income?!"
          }
        ],
        "turnStart": [
          {
            "audio": "res://assets/audio/heroes/bernie_quote_1.ogg",
            "text": "They're starving to death right now!"
          },
          {
            "audio": "res://assets/audio/heroes/bernie_quote_2.ogg",
            "text": "You have to be a wealthy person to send your kid to college!"
          },
          {
            "audio": "res://assets/audio/heroes/bernie_quote_3.ogg",
            "text": "They've had socialist governments for decades!"
          },
          {
            "audio": "res://assets/audio/heroes/bernie_quote_4.ogg",
            "text": "Mr. Speaker, I've got a problem!"
          },
          {
            "audio": "res://assets/audio/heroes/bernie_quote_5.ogg",
            "text": "Two million people sleeping out on the streets!"
          },
          {
            "audio": "res://assets/audio/heroes/bernie_quote_6.ogg",
            "text": "Let's not keep putting poor people into jail!"
          },
          {
            "audio": "res://assets/audio/heroes/bernie_quote_7.ogg",
            "text": "The rich get richer, the poor get poorer!"
          },
          {
            "audio": "res://assets/audio/heroes/bernie_quote_8.ogg",
            "text": "Let's talk about welfare for the rich and the powerful!"
          }
        ]
      },
