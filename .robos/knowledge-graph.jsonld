            {
              "title": "Boot the game headlessly and inspect the 4 Light Warriors over port 8090",
              "who": "Your AI agent runs a program",
              "description": "Start the Godot game inside Xvfb, advance past TitleScreen and PartyCreate into Coneria, and query GET http://127.0.0.1:8090/api/v1/state.",
              "agentPrompt": "Launch ~/Downloads/ff1/ff1-game under Xvfb, advance from TitleScreen through PartyCreate into Coneria, and run curl -s http://127.0.0.1:8090/api/v1/state | jq . to inspect the party.",
              "explain": "GameControlServer.gd listens on 127.0.0.1:8090 and returns a complete JSON snapshot of the current scene, tile coordinates, Gold, party stats, and walkable neighbor tiles.",
              "code": "curl -s http://127.0.0.1:8090/api/v1/state | jq .",
