{
  "@context": {
    "c4": "https://c4model.com/ns#",
    "crpg": "https://robos.dev/ns/crpg#",
    "dcterms": "http://purl.org/dc/terms/",
    "game": "https://robos.dev/ns/game#",
    "oslc": "http://open-services.net/ns/core#",
    "oslc_am": "http://open-services.net/ns/am#",
    "oslc_cm": "http://open-services.net/ns/cm#",
    "oslc_qm": "http://open-services.net/ns/qm#",
    "oslc_rm": "http://open-services.net/ns/rm#",
    "pact": "https://pact.io/ns#",
    "robos": "https://robos.dev/ns/sdlc#",
    "robos:annotations": {
      "@id": "robos:annotations",
      "@type": "@json"
    },
    "robos:arguments": {
      "@id": "robos:arguments",
      "@type": "@json"
    },
    "robos:classification": {
      "@container": "@set",
      "@id": "robos:classification",
      "@type": "@id"
    },
    "robos:evidence": {
      "@container": "@set",
      "@context": {
        "line": {
          "@id": "robos:sourceLine",
          "@type": "xsd:integer"
        },
        "path": "robos:sourcePath",
        "repository": "robos:sourceRepository",
        "revision": "robos:sourceRevision",
        "sha256": "robos:sourceHash",
        "workingTreeStatus": "robos:workingTreeStatus"
      },
      "@id": "robos:evidence"
    },
    "robos:inputSchema": {
      "@id": "robos:inputSchema",
      "@type": "@json"
    },
    "robos:mcpServer": {
      "@id": "robos:mcpServer",
      "@type": "@id"
    },
    "robos:outputSchema": {
      "@id": "robos:outputSchema",
      "@type": "@json"
    },
    "robos:parameters": {
      "@id": "robos:parameters",
      "@type": "@json"
    },
    "robos:promptsProvided": {
      "@container": "@set",
      "@id": "robos:promptsProvided",
      "@type": "@id"
    },
    "robos:protocolReference": {
      "@id": "robos:protocolReference",
      "@type": "@id"
    },
    "robos:provenance": {
      "@id": "robos:provenance",
      "@type": "@json"
    },
    "robos:relationshipEvidence": {
      "@container": "@set",
      "@context": {
        "condition": "robos:condition",
        "evidence": {
          "@container": "@set",
          "@context": {
            "line": {
              "@id": "robos:sourceLine",
              "@type": "xsd:integer"
            },
            "path": "robos:sourcePath",
            "repository": "robos:sourceRepository",
            "revision": "robos:sourceRevision",
            "sha256": "robos:sourceHash",
            "workingTreeStatus": "robos:workingTreeStatus"
          },
          "@id": "robos:evidence"
        },
        "note": "dcterms:description",
        "predicate": {
          "@id": "robos:predicate",
          "@type": "@vocab"
        },
        "status": "robos:evidenceStatus",
        "target": {
          "@id": "robos:target",
          "@type": "@id"
        }
      },
      "@id": "robos:relationshipEvidence"
    },
    "robos:resourcesProvided": {
      "@container": "@set",
      "@id": "robos:resourcesProvided",
      "@type": "@id"
    },
    "robos:sourceSummary": {
      "@id": "robos:sourceSummary",
      "@type": "@json"
    },
    "robos:technologyReference": {
      "@id": "robos:technologyReference",
      "@type": "@id"
    },
    "robos:toolAnnotations": {
      "@id": "robos:toolAnnotations",
      "@type": "@json"
    },
    "schema": "https://schema.org/",
    "tabletop": "https://robos.dev/ns/tabletop#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "urn:robos:crpg:agent-session:xvfb-e2e-runner",
      "@type": [
        "oslc_am:Resource",
        "robos:AgentSession"
      ],
      "dcterms:description": "Autonomous RobOS agent execution harness running Godot 4 in Xvfb virtual display :99 with GameControlServer HTTP REST telemetry and FFmpeg 1080p video recording.",
      "dcterms:title": "cRPG Headless Xvfb Video Proof-of-Work & Cucumber Test Runner Session",
      "robos:captureVideo": true,
      "robos:executesSuite": "urn:robos:crpg:testsuite:e2e-playthrough",
      "robos:gameControlServerPort": 18090,
      "robos:namespace": "robos.crpg",
      "robos:package": "crpg",
      "robos:targetGame": "urn:robos:crpg:game:realm-of-heroes",
      "robos:videoFramerate": 30,
      "robos:videoResolution": "1280x720",
      "robos:virtualDisplay": ":99"
    },
