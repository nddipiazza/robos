  "@graph": [
    {
      "@id": "urn:robos:contract:catalog-graphql",
      "@type": [
        "robos:Contract",
        "robos:GraphQLContract",
        "robos:GraphQLSchema",
        "schema:DigitalDocument"
      ],
      "dcterms:description": "Apollo Federation subgraph schema defining products, pricing, and category queries.",
      "dcterms:title": "Acme Catalog GraphQL SDL Schema",
      "robos:domainStandard": "http://open-services.net/ns/am#Resource",
      "robos:graphqlOperations": [
        {
          "name": "ListCatalogProducts",
          "query": "query ListCatalogProducts {\n  products(limit: 5) {\n    id\n    name\n    price\n    inStock\n  }\n}",
          "type": "query"
        },
        {
          "name": "GetProductById",
          "query": "query GetProductById($id: ID!) {\n  product(id: $id) {\n    id\n    name\n    sku\n    price\n    inStock\n  }\n}",
          "type": "query",
          "variables": {
            "id": "prod_101"
          }
        }
      ],
      "robos:namespace": "robos.services",
      "robos:package": "services",
      "robos:protocol": "graphql",
      "robos:schemaOrgType": "https://schema.org/DigitalDocument",
      "robos:schemaType": "federated-subgraph",
      "robos:sdlSchema": "type Query {\n  product(id: ID!): Product\n  products(category: String, limit: Int = 20): [Product!]!\n  searchCatalog(term: String!): [Product!]!\n}\n\ntype Mutation {\n  createProduct(input: ProductInput!): Product!\n  updatePrice(id: ID!, newPrice: Float!): Product!\n}\n\ntype Product {\n  id: ID!\n  name: String!\n  sku: String!\n  category: String!\n  price: Float!\n  inStock: Boolean!\n}\n\ninput ProductInput {\n  name: String!\n  sku: String!\n  category: String!\n  price: Float!\n}",
      "robos:specFile": "schemas/catalog.graphql"
    },
    {
      "@id": "urn:robos:contract:checkout-api-v1",
      "@type": [
        "robos:Contract",
        "c4:Component",
        "oslc:Resource"
      ],
      "dcterms:title": "Checkout API Microservice OpenAPI 3.1 Spec",
      "robos:contractYaml": "openapi: 3.1.0\ninfo:\n  title: Checkout API Microservice REST API\n  description: High-performance microservice contract for Checkout API Microservice in RobOS Universe.\n  version: 1.0.0\nservers:\n  - url: https://github.com/api/v1/checkout-api\n    description: Production Gateway\n  - url: http://localhost:8080\n    description: Local Dev Container\ntags:\n  - name: Core\n    description: Primary operations\n  - name: Health\n    description: Service diagnostics and liveliness\npaths:\n  /api/v1/checkout-api:\n    get:\n      tags: [Core]\n      summary: Retrieve all checkout-api items\n      operationId: listCheckout-apiItems\n      parameters:\n        - name: limit\n          in: query\n          required: false\n          schema:\n            type: integer\n            default: 50\n      responses:\n        '200':\n          description: Successful query result\n          content:\n            application/json:\n              schema:\n                type: array\n                items:\n                  $ref: '#/components/schemas/Checkout-apiItem'\n    post:\n      tags: [Core]\n      summary: Create new checkout-api entry\n      operationId: createCheckout-apiItem\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/Checkout-apiItem'\n      responses:\n        '201':\n          description: Resource created successfully\n  /api/v1/checkout-api/{id}:\n    get:\n      tags: [Core]\n      summary: Get checkout-api by identifier\n      operationId: getCheckout-apiById\n      parameters:\n        - name: id\n          in: path\n          required: true\n          schema:\n            type: string\n      responses:\n        '200':\n          description: Resource found\n        '404':\n          description: Item not found\n  /healthz:\n    get:\n      tags: [Health]\n      summary: Liveness and readiness probe\n      responses:\n        '200':\n          description: Service is healthy and operational\ncomponents:\n  schemas:\n    Checkout-apiItem:\n      type: object\n      required:\n        - id\n        - name\n        - createdAt\n      properties:\n        id:\n          type: string\n          format: uuid\n        name:\n          type: string\n          example: 'Primary checkout-api record'\n        status:\n          type: string\n          enum: [ACTIVE, PENDING, ARCHIVED]\n          default: ACTIVE\n        createdAt:\n          type: string\n          format: date-time\n",
      "robos:domainStandard": "http://open-services.net/ns/am#Resource",
      "robos:endpoints": [
        {
          "description": "List Checkout API Microservice records",
          "method": "GET",
          "path": "/api/v1/checkout-api"
        },
        {
          "description": "Create Checkout API Microservice record",
          "method": "POST",
          "path": "/api/v1/checkout-api"
        },
        {
          "description": "Get Checkout API Microservice by ID",
          "method": "GET",
          "path": "/api/v1/checkout-api/{id}"
        },
        {
          "description": "Health check",
          "method": "GET",
          "path": "/healthz"
        }
      ],
      "robos:namespace": "robos.services",
      "robos:package": "services",
      "robos:protocol": "OpenAPI 3.1",
      "robos:repository": "github.com/acme-retail/checkout-api",
      "robos:schemaOrgType": "https://schema.org/DigitalDocument",
      "robos:specFile": "specs/contracts/checkout-api-v1.yaml"
    },
    {
      "@id": "urn:robos:contract:forms-api-v1",
      "@type": [
        "robos:Contract",
        "c4:Component"
      ],
      "dcterms:title": "Forms API OpenAPI 3.1 Spec",
      "robos:contractYaml": "openapi: 3.1.0\ninfo:\n  title: Forms API Spec\n  version: 1.0.0\npaths:\n  /api/v1/forms:\n    get:\n      summary: List forms\n      responses:\n        \"200\":\n          description: Success\n",
      "robos:namespace": "robos.services",
      "robos:package": "services",
      "robos:protocol": "OpenAPI 3.1",
      "robos:specFile": "specs/contracts/forms-api-v1.yaml"
    },
    {
      "@id": "urn:robos:contract:fraud-detector-v1",
      "@type": [
        "robos:Contract",
        "c4:Component",
        "oslc:Resource"
      ],
      "dcterms:title": "Fraud Detector OpenAPI 3.1 Spec",
      "robos:contractYaml": "openapi: 3.1.0\ninfo:\n  title: Fraud Detector REST API\n  description: High-performance microservice contract for Fraud Detector in RobOS Universe.\n  version: 1.0.0\nservers:\n  - url: https://github.com/api/v1/fraud-detector\n    description: Production Gateway\n  - url: http://localhost:8080\n    description: Local Dev Container\ntags:\n  - name: Core\n    description: Primary operations\n  - name: Health\n    description: Service diagnostics and liveliness\npaths:\n  /api/v1/fraud-detector:\n    get:\n      tags: [Core]\n      summary: Retrieve all fraud-detector items\n      operationId: listFraud-detectorItems\n      parameters:\n        - name: limit\n          in: query\n          required: false\n          schema:\n            type: integer\n            default: 50\n      responses:\n        '200':\n          description: Successful query result\n          content:\n            application/json:\n              schema:\n                type: array\n                items:\n                  $ref: '#/components/schemas/Fraud-detectorItem'\n    post:\n      tags: [Core]\n      summary: Create new fraud-detector entry\n      operationId: createFraud-detectorItem\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/Fraud-detectorItem'\n      responses:\n        '201':\n          description: Resource created successfully\n  /api/v1/fraud-detector/{id}:\n    get:\n      tags: [Core]\n      summary: Get fraud-detector by identifier\n      operationId: getFraud-detectorById\n      parameters:\n        - name: id\n          in: path\n          required: true\n          schema:\n            type: string\n      responses:\n        '200':\n          description: Resource found\n        '404':\n          description: Item not found\n  /healthz:\n    get:\n      tags: [Health]\n      summary: Liveness and readiness probe\n      responses:\n        '200':\n          description: Service is healthy and operational\ncomponents:\n  schemas:\n    Fraud-detectorItem:\n      type: object\n      required:\n        - id\n        - name\n        - createdAt\n      properties:\n        id:\n          type: string\n          format: uuid\n        name:\n          type: string\n          example: 'Primary fraud-detector record'\n        status:\n          type: string\n          enum: [ACTIVE, PENDING, ARCHIVED]\n          default: ACTIVE\n        createdAt:\n          type: string\n          format: date-time\n",
      "robos:domainStandard": "http://open-services.net/ns/am#Resource",
      "robos:endpoints": [
        {
          "description": "List Fraud Detector records",
          "method": "GET",
          "path": "/api/v1/fraud-detector"
        },
        {
          "description": "Create Fraud Detector record",
          "method": "POST",
          "path": "/api/v1/fraud-detector"
        },
        {
          "description": "Get Fraud Detector by ID",
          "method": "GET",
          "path": "/api/v1/fraud-detector/{id}"
        },
        {
          "description": "Health check",
          "method": "GET",
          "path": "/healthz"
        }
      ],
      "robos:inOrganization": "urn:robos:git-org:acme-payments",
      "robos:namespace": "robos.services",
      "robos:package": "services",
      "robos:protocol": "OpenAPI 3.1",
      "robos:repository": "github.com/acme-payments/fraud-detector",
      "robos:schemaOrgType": "https://schema.org/DigitalDocument",
      "robos:specFile": "specs/contracts/fraud-detector-v1.yaml"
    },
    {
      "@id": "urn:robos:contract:oauth-server-v1",
      "@type": [
        "robos:Contract",
        "c4:Component",
        "oslc:Resource"
      ],
      "dcterms:title": "Oauth Server OpenAPI 3.1 Spec",
      "robos:contractYaml": "openapi: 3.1.0\ninfo:\n  title: Oauth Server REST API\n  description: High-performance microservice contract for Oauth Server in RobOS Universe.\n  version: 1.0.0\nservers:\n  - url: https://github.com/api/v1/oauth-server\n    description: Production Gateway\n  - url: http://localhost:8080\n    description: Local Dev Container\ntags:\n  - name: Core\n    description: Primary operations\n  - name: Health\n    description: Service diagnostics and liveliness\npaths:\n  /api/v1/oauth-server:\n    get:\n      tags: [Core]\n      summary: Retrieve all oauth-server items\n      operationId: listOauth-serverItems\n      parameters:\n        - name: limit\n          in: query\n          required: false\n          schema:\n            type: integer\n            default: 50\n      responses:\n        '200':\n          description: Successful query result\n          content:\n            application/json:\n              schema:\n                type: array\n                items:\n                  $ref: '#/components/schemas/Oauth-serverItem'\n    post:\n      tags: [Core]\n      summary: Create new oauth-server entry\n      operationId: createOauth-serverItem\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/Oauth-serverItem'\n      responses:\n        '201':\n          description: Resource created successfully\n  /api/v1/oauth-server/{id}:\n    get:\n      tags: [Core]\n      summary: Get oauth-server by identifier\n      operationId: getOauth-serverById\n      parameters:\n        - name: id\n          in: path\n          required: true\n          schema:\n            type: string\n      responses:\n        '200':\n          description: Resource found\n        '404':\n          description: Item not found\n  /healthz:\n    get:\n      tags: [Health]\n      summary: Liveness and readiness probe\n      responses:\n        '200':\n          description: Service is healthy and operational\ncomponents:\n  schemas:\n    Oauth-serverItem:\n      type: object\n      required:\n        - id\n        - name\n        - createdAt\n      properties:\n        id:\n          type: string\n          format: uuid\n        name:\n          type: string\n          example: 'Primary oauth-server record'\n        status:\n          type: string\n          enum: [ACTIVE, PENDING, ARCHIVED]\n          default: ACTIVE\n        createdAt:\n          type: string\n          format: date-time\n",
      "robos:domainStandard": "http://open-services.net/ns/am#Resource",
      "robos:endpoints": [
        {
          "description": "List Oauth Server records",
          "method": "GET",
          "path": "/api/v1/oauth-server"
        },
        {
          "description": "Create Oauth Server record",
          "method": "POST",
          "path": "/api/v1/oauth-server"
        },
        {
          "description": "Get Oauth Server by ID",
          "method": "GET",
          "path": "/api/v1/oauth-server/{id}"
        },
        {
          "description": "Health check",
          "method": "GET",
          "path": "/healthz"
        }
      ],
      "robos:inOrganization": "urn:robos:git-org:acme-identity",
      "robos:namespace": "robos.services",
      "robos:package": "services",
      "robos:protocol": "OpenAPI 3.1",
      "robos:repository": "github.com/acme-identity/oauth-server",
      "robos:schemaOrgType": "https://schema.org/DigitalDocument",
      "robos:specFile": "specs/contracts/oauth-server-v1.yaml"
    },
    {
      "@id": "urn:robos:contract:order-service-v1",
      "@type": [
        "robos:Contract",
        "c4:Component",
        "oslc:Resource"
      ],
      "dcterms:title": "Order Service (Local) OpenAPI 3.1 Spec",
      "robos:contractYaml": "openapi: 3.1.0\ninfo:\n  title: Order Service (Local) REST API\n  description: High-performance microservice contract for Order Service (Local) in RobOS Universe.\n  version: 1.0.0\nservers:\n  - url: https://github.com/api/v1/order-service\n    description: Production Gateway\n  - url: http://localhost:8080\n    description: Local Dev Container\ntags:\n  - name: Core\n    description: Primary operations\n  - name: Health\n    description: Service diagnostics and liveliness\npaths:\n  /api/v1/order-service:\n    get:\n      tags: [Core]\n      summary: Retrieve all order-service items\n      operationId: listOrder-serviceItems\n      parameters:\n        - name: limit\n          in: query\n          required: false\n          schema:\n            type: integer\n            default: 50\n      responses:\n        '200':\n          description: Successful query result\n          content:\n            application/json:\n              schema:\n                type: array\n                items:\n                  $ref: '#/components/schemas/Order-serviceItem'\n    post:\n      tags: [Core]\n      summary: Create new order-service entry\n      operationId: createOrder-serviceItem\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/Order-serviceItem'\n      responses:\n        '201':\n          description: Resource created successfully\n  /api/v1/order-service/{id}:\n    get:\n      tags: [Core]\n      summary: Get order-service by identifier\n      operationId: getOrder-serviceById\n      parameters:\n        - name: id\n          in: path\n          required: true\n          schema:\n            type: string\n      responses:\n        '200':\n          description: Resource found\n        '404':\n          description: Item not found\n  /healthz:\n    get:\n      tags: [Health]\n      summary: Liveness and readiness probe\n      responses:\n        '200':\n          description: Service is healthy and operational\ncomponents:\n  schemas:\n    Order-serviceItem:\n      type: object\n      required:\n        - id\n        - name\n        - createdAt\n      properties:\n        id:\n          type: string\n          format: uuid\n        name:\n          type: string\n          example: 'Primary order-service record'\n        status:\n          type: string\n          enum: [ACTIVE, PENDING, ARCHIVED]\n          default: ACTIVE\n        createdAt:\n          type: string\n          format: date-time\n",
      "robos:endpoints": [
        {
          "description": "List Order Service (Local) records",
          "method": "GET",
          "path": "/api/v1/order-service"
        },
        {
          "description": "Create Order Service (Local) record",
          "method": "POST",
          "path": "/api/v1/order-service"
        },
        {
          "description": "Get Order Service (Local) by ID",
          "method": "GET",
          "path": "/api/v1/order-service/{id}"
        },
        {
          "description": "Health check",
          "method": "GET",
          "path": "/healthz"
        }
      ],
      "robos:namespace": "robos.services",
      "robos:package": "services",
      "robos:protocol": "OpenAPI 3.1",
      "robos:repository": "github.com/acme/order-service",
      "robos:specFile": "specs/contracts/order-service-v1.yaml"
    },
    {
      "@id": "urn:robos:contract:orders-grpc",
      "@type": [
        "robos:Contract",
        "robos:ProtobufContract",
        "robos:GRPCContract",
        "schema:DigitalDocument"
      ],
      "dcterms:description": "High-performance binary gRPC interface definition for transactional order lifecycle.",
      "dcterms:title": "Acme Orders gRPC Protobuf Contract",
      "robos:domainStandard": "http://open-services.net/ns/am#Resource",
      "robos:namespace": "robos.services",
      "robos:package": "services",
      "robos:packageName": "acme.orders.v1",
      "robos:protocol": "grpc-protobuf",
      "robos:rpcDetails": {
        "CancelOrder": {
          "description": "Abort pending order prior to carrier dispatch",
          "request": {
            "orderId": "ord_99014",
            "reason": "Customer requested cancellation"
          },
          "response": {
            "orderId": "ord_99014",
            "status": "CANCELLED"
          }
        },
        "CreateOrder": {
          "description": "Submit cart for payment processing and fulfillment",
          "request": {
            "customerId": "cust_88190",
            "items": [
              {
                "quantity": 1,
                "sku": "SKU-PRO-42",
                "unitPrice": 89
              }
            ],
            "shippingAddress": "123 Market St, San Francisco CA"
          },
          "response": {
            "orderId": "ord_99014",
            "status": "ORDER_PLACED",
            "total": 89
          }
        },
        "GetOrderStatus": {
          "description": "Query order status and tracking number",
          "request": {
            "orderId": "ord_99014"
          },
          "response": {
            "estimatedDelivery": "2026-09-15",
            "orderId": "ord_99014",
            "status": "PROCESSING"
          }
        },
        "StreamOrderEvents": {
          "description": "Server-side stream of live fulfillment and tracking telemetry",
          "request": {
            "orderId": "ord_99014"
          },
          "response": {
            "carrier": "FedEx Express",
            "eventId": "evt_7701",
            "state": "CARRIER_PICKED_UP"
          }
        }
      },
      "robos:rpcMethods": [
        "CreateOrder",
        "GetOrderStatus",
        "CancelOrder",
        "StreamOrderEvents"
      ],
      "robos:schemaOrgType": "https://schema.org/DigitalDocument",
      "robos:specFile": "proto/orders/v1/orders.proto"
    },
    {
      "@id": "urn:robos:contract:payment-gateway-v1",
      "@type": [
        "robos:Contract",
        "c4:Component",
        "oslc:Resource"
      ],
      "dcterms:title": "Payment Gateway OpenAPI 3.1 Spec",
      "robos:contractYaml": "openapi: 3.1.0\ninfo:\n  title: Payment Gateway REST API\n  description: High-performance microservice contract for Payment Gateway in RobOS Universe.\n  version: 1.0.0\nservers:\n  - url: https://github.com/api/v1/payment-gateway\n    description: Production Gateway\n  - url: http://localhost:8080\n    description: Local Dev Container\ntags:\n  - name: Core\n    description: Primary operations\n  - name: Health\n    description: Service diagnostics and liveliness\npaths:\n  /api/v1/payment-gateway:\n    get:\n      tags: [Core]\n      summary: Retrieve all payment-gateway items\n      operationId: listPayment-gatewayItems\n      parameters:\n        - name: limit\n          in: query\n          required: false\n          schema:\n            type: integer\n            default: 50\n      responses:\n        '200':\n          description: Successful query result\n          content:\n            application/json:\n              schema:\n                type: array\n                items:\n                  $ref: '#/components/schemas/Payment-gatewayItem'\n    post:\n      tags: [Core]\n      summary: Create new payment-gateway entry\n      operationId: createPayment-gatewayItem\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/Payment-gatewayItem'\n      responses:\n        '201':\n          description: Resource created successfully\n  /api/v1/payment-gateway/{id}:\n    get:\n      tags: [Core]\n      summary: Get payment-gateway by identifier\n      operationId: getPayment-gatewayById\n      parameters:\n        - name: id\n          in: path\n          required: true\n          schema:\n            type: string\n      responses:\n        '200':\n          description: Resource found\n        '404':\n          description: Item not found\n  /healthz:\n    get:\n      tags: [Health]\n      summary: Liveness and readiness probe\n      responses:\n        '200':\n          description: Service is healthy and operational\ncomponents:\n  schemas:\n    Payment-gatewayItem:\n      type: object\n      required:\n        - id\n        - name\n        - createdAt\n      properties:\n        id:\n          type: string\n          format: uuid\n        name:\n          type: string\n          example: 'Primary payment-gateway record'\n        status:\n          type: string\n          enum: [ACTIVE, PENDING, ARCHIVED]\n          default: ACTIVE\n        createdAt:\n          type: string\n          format: date-time\n",
      "robos:domainStandard": "http://open-services.net/ns/am#Resource",
      "robos:endpoints": [
        {
          "description": "List Payment Gateway records",
          "method": "GET",
          "path": "/api/v1/payment-gateway"
        },
        {
          "description": "Create Payment Gateway record",
          "method": "POST",
          "path": "/api/v1/payment-gateway"
        },
        {
          "description": "Get Payment Gateway by ID",
          "method": "GET",
          "path": "/api/v1/payment-gateway/{id}"
        },
        {
          "description": "Health check",
          "method": "GET",
          "path": "/healthz"
        }
      ],
      "robos:inOrganization": "urn:robos:git-org:acme-payments",
      "robos:namespace": "robos.services",
      "robos:package": "services",
      "robos:protocol": "OpenAPI 3.1",
      "robos:repository": "github.com/acme-payments/payment-gateway",
      "robos:schemaOrgType": "https://schema.org/DigitalDocument",
      "robos:specFile": "specs/contracts/payment-gateway-v1.yaml"
    },
    {
      "@id": "urn:robos:contract:user-directory-sync-v1",
      "@type": [
        "robos:Contract",
        "c4:Component",
        "oslc:Resource"
      ],
      "dcterms:title": "User Directory Sync OpenAPI 3.1 Spec",
      "robos:contractYaml": "openapi: 3.1.0\ninfo:\n  title: User Directory Sync REST API\n  description: High-performance microservice contract for User Directory Sync in RobOS Universe.\n  version: 1.0.0\nservers:\n  - url: https://github.com/api/v1/user-directory-sync\n    description: Production Gateway\n  - url: http://localhost:8080\n    description: Local Dev Container\ntags:\n  - name: Core\n    description: Primary operations\n  - name: Health\n    description: Service diagnostics and liveliness\npaths:\n  /api/v1/user-directory-sync:\n    get:\n      tags: [Core]\n      summary: Retrieve all user-directory-sync items\n      operationId: listUser-directory-syncItems\n      parameters:\n        - name: limit\n          in: query\n          required: false\n          schema:\n            type: integer\n            default: 50\n      responses:\n        '200':\n          description: Successful query result\n          content:\n            application/json:\n              schema:\n                type: array\n                items:\n                  $ref: '#/components/schemas/User-directory-syncItem'\n    post:\n      tags: [Core]\n      summary: Create new user-directory-sync entry\n      operationId: createUser-directory-syncItem\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/User-directory-syncItem'\n      responses:\n        '201':\n          description: Resource created successfully\n  /api/v1/user-directory-sync/{id}:\n    get:\n      tags: [Core]\n      summary: Get user-directory-sync by identifier\n      operationId: getUser-directory-syncById\n      parameters:\n        - name: id\n          in: path\n          required: true\n          schema:\n            type: string\n      responses:\n        '200':\n          description: Resource found\n        '404':\n          description: Item not found\n  /healthz:\n    get:\n      tags: [Health]\n      summary: Liveness and readiness probe\n      responses:\n        '200':\n          description: Service is healthy and operational\ncomponents:\n  schemas:\n    User-directory-syncItem:\n      type: object\n      required:\n        - id\n        - name\n        - createdAt\n      properties:\n        id:\n          type: string\n          format: uuid\n        name:\n          type: string\n          example: 'Primary user-directory-sync record'\n        status:\n          type: string\n          enum: [ACTIVE, PENDING, ARCHIVED]\n          default: ACTIVE\n        createdAt:\n          type: string\n          format: date-time\n",
      "robos:domainStandard": "http://open-services.net/ns/am#Resource",
      "robos:endpoints": [
        {
          "description": "List User Directory Sync records",
          "method": "GET",
          "path": "/api/v1/user-directory-sync"
        },
        {
          "description": "Create User Directory Sync record",
          "method": "POST",
          "path": "/api/v1/user-directory-sync"
        },
        {
          "description": "Get User Directory Sync by ID",
          "method": "GET",
          "path": "/api/v1/user-directory-sync/{id}"
        },
        {
          "description": "Health check",
          "method": "GET",
          "path": "/healthz"
        }
      ],
